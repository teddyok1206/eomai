{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/api/v1/execution-preset-draft-request/1.0",
  "title": "Execution Preset Draft Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "target_revision_schema_version", "preset_key", "display_name",
    "description", "role_policies", "capacity_policy_revision_id",
    "general_knowledge_policy", "compatible_workflow_protocols"
  ],
  "properties": {
    "schema_version": {"const": "execution-preset-draft-request/1.0"},
    "target_revision_schema_version": {
      "enum": ["execution-preset-revision/1.0", "execution-preset-revision/2.0"]
    },
    "preset_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "role_policies": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {"$ref": "#/$defs/role_policy"}
    },
    "capacity_policy_revision_id": {
      "type": "string", "pattern": "^capacityrev_[0-9a-f]{32}$"
    },
    "general_knowledge_policy": {"enum": ["DENY", "ALLOW_WITH_PROVENANCE"]},
    "compatible_workflow_protocols": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "string"}
    },
    "retrieval_policy": {"oneOf": [{"$ref": "#/$defs/retrieval_policy"}, {"type": "null"}]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"target_revision_schema_version": {"const": "execution-preset-revision/1.0"}},
        "required": ["target_revision_schema_version"]
      },
      "then": {
        "properties": {
          "retrieval_policy": {"type": "null"},
          "role_policies": {
            "items": {"properties": {"evidence_access": {"type": "null"}}}
          }
        }
      },
      "else": {
        "required": ["retrieval_policy"],
        "properties": {
          "retrieval_policy": {"$ref": "#/$defs/retrieval_policy"},
          "role_policies": {
            "items": {
              "required": ["evidence_access"],
              "properties": {"evidence_access": {"enum": ["NONE", "EVIDENCE_CONTEXT"]}}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"},
    "artifact_pointer": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_revision_id", "sha256", "schema_ref", "media_type", "logical_name"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "logical_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"}
      }
    },
    "bundle_pointer": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_id", "bundle_revision_id", "manifest_artifact", "manifest_sha256"],
      "properties": {
        "bundle_id": {"type": "string", "pattern": "^(?:instrbundle|refbundle)_[0-9a-f]{32}$"},
        "bundle_revision_id": {"type": "string", "pattern": "^(?:instrrev|refrev)_[0-9a-f]{32}$"},
        "manifest_artifact": {"$ref": "#/$defs/artifact_pointer"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "reasoning_effort"],
      "properties": {
        "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh"]}
      }
    },
    "role_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "model_candidates", "instruction_bundle", "reference_bundle", "worker_pool_key", "timeout_seconds", "sandbox", "network"],
      "properties": {
        "role": {"enum": ["authoring", "image", "review", "item_management", "support"]},
        "model_candidates": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/model_candidate"}},
        "instruction_bundle": {"$ref": "#/$defs/bundle_pointer"},
        "reference_bundle": {"oneOf": [{"$ref": "#/$defs/bundle_pointer"}, {"type": "null"}]},
        "worker_pool_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 7200},
        "sandbox": {"const": "read-only"},
        "network": {"const": "disabled"},
        "evidence_access": {"oneOf": [{"enum": ["NONE", "EVIDENCE_CONTEXT"]}, {"type": "null"}]}
      }
    },
    "evidence_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_documents", "max_item_revisions", "max_graph_nodes", "max_claims", "max_context_tokens"],
      "properties": {
        "max_documents": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_item_revisions": {"type": "integer", "minimum": 0, "maximum": 64},
        "max_graph_nodes": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_claims": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_context_tokens": {"type": "integer", "minimum": 1000, "maximum": 32000}
      }
    },
    "retrieval_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["access_policy_revision_id", "access_policy_sha256", "allowed_corpus_keys", "allowed_query_kinds", "allowed_source_classes", "maximum_budget"],
      "properties": {
        "access_policy_revision_id": {"type": "string", "pattern": "^accessrev_[0-9a-f]{32}$"},
        "access_policy_sha256": {"$ref": "#/$defs/sha256"},
        "allowed_corpus_keys": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}},
        "allowed_query_kinds": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["CURRICULUM_COMPONENTS", "APPROVED_ITEM_STRUCTURE", "ITEM_PREPARATION"]}},
        "allowed_source_classes": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["CURRICULUM", "TEXTBOOK", "APPROVED_ITEM", "PAST_EXAM", "INTERNAL_GUIDE"]}},
        "maximum_budget": {"$ref": "#/$defs/evidence_budget"}
      }
    }
  }
}
