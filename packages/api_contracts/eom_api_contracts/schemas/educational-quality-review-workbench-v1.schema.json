{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eom.local/schemas/api/v1/educational-quality-review-workbench-v1.schema.json",
  "title": "Educational Quality Review Workbench V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_assemblies", "plans", "selected_plan"],
  "properties": {
    "schema_version": {"const": "educational-quality-review-workbench/1.0"},
    "candidate_assemblies": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/candidate"}},
    "plans": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/planSummary"}},
    "selected_plan": {"oneOf": [{"$ref": "#/$defs/planDetail"}, {"type": "null"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["assembly_id", "assembly_revision_id", "manifest_sha256", "revision_state", "item_count", "created_at", "existing_plan_id"],
      "properties": {
        "assembly_id": {"type": "string", "pattern": "^assembly_[0-9a-f]{32}$"},
        "assembly_revision_id": {"type": "string", "pattern": "^assemblyrev_[0-9a-f]{32}$"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "revision_state": {"enum": ["RELEASED", "SUPERSEDED", "WITHDRAWN"]},
        "item_count": {"type": "integer", "minimum": 1, "maximum": 200},
        "created_at": {"$ref": "#/$defs/utc"},
        "existing_plan_id": {"oneOf": [{"type": "string", "pattern": "^qualityplan_[0-9a-f]{32}$"}, {"type": "null"}]}
      }
    },
    "planSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "plan_sha256", "assembly_revision_id", "assembly_manifest_sha256", "item_count", "primary_finalized", "secondary_finalized", "resolved_count", "created_at"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^qualityplan_[0-9a-f]{32}$"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "assembly_revision_id": {"type": "string", "pattern": "^assemblyrev_[0-9a-f]{32}$"},
        "assembly_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "item_count": {"type": "integer", "minimum": 1, "maximum": 200},
        "primary_finalized": {"type": "boolean"},
        "secondary_finalized": {"type": "boolean"},
        "resolved_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "created_at": {"$ref": "#/$defs/utc"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "display_number", "item_id", "item_revision_id", "item_manifest_sha256", "material_type", "difficulty_band"],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 200},
        "display_number": {"type": "string", "minLength": 1, "maxLength": 32},
        "item_id": {"type": "string", "pattern": "^item_[0-9a-f]{32}$"},
        "item_revision_id": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
        "item_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "material_type": {"type": "string", "minLength": 1, "maxLength": 64},
        "difficulty_band": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "item_revision_id", "preview_checked", "hwpx_checked", "evidence_checked", "science_score", "critical_error", "unique_answer", "evidence_score", "authoring_value_score", "visual_score", "visual_not_applicable_reason", "explanation_quality_score", "disposition", "edit_minutes", "short_reason", "updated_at"],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 200},
        "item_revision_id": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
        "preview_checked": {"type": "boolean"}, "hwpx_checked": {"type": "boolean"}, "evidence_checked": {"type": "boolean"},
        "science_score": {"type": "integer", "minimum": 1, "maximum": 5}, "critical_error": {"type": "boolean"},
        "unique_answer": {"enum": ["PASS", "FAIL", "AMBIGUOUS"]},
        "evidence_score": {"type": "integer", "minimum": 1, "maximum": 5}, "authoring_value_score": {"type": "integer", "minimum": 1, "maximum": 5},
        "visual_score": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}, "visual_not_applicable_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
        "explanation_quality_score": {"type": "integer", "minimum": 1, "maximum": 5}, "disposition": {"enum": ["NO_EDIT", "MINOR_EDIT", "MAJOR_EDIT", "DISCARD"]},
        "edit_minutes": {"type": "integer", "minimum": 0, "maximum": 1440}, "short_reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "updated_at": {"$ref": "#/$defs/utc"}
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "reviewer_id", "reviewer_role", "state", "lock_version", "required_positions", "observations", "created_at", "finalized_at"],
      "properties": {
        "session_id": {"type": "string", "pattern": "^qualitysession_[0-9a-f]{32}$"},
        "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "reviewer_role": {"enum": ["PRIMARY", "SECONDARY"]},
        "state": {"enum": ["DRAFT", "FINALIZED"]},
        "lock_version": {"type": "integer", "minimum": 1},
        "required_positions": {"type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 200}},
        "observations": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/observation"}},
        "created_at": {"$ref": "#/$defs/utc"},
        "finalized_at": {"oneOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]}
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "chosen_session_id", "resolved_by", "notes", "resolved_at"],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 200},
        "chosen_session_id": {"type": "string", "pattern": "^qualitysession_[0-9a-f]{32}$"},
        "resolved_by": {"type": "string", "minLength": 1, "maxLength": 128},
        "notes": {"type": "string", "minLength": 1, "maxLength": 1000},
        "resolved_at": {"$ref": "#/$defs/utc"}
      }
    },
    "scoreMetrics": {
      "type": "object", "additionalProperties": false,
      "required": ["item_count", "no_edit_count", "minor_edit_count", "major_edit_count", "discard_count", "adoptable_count", "critical_error_count", "unique_answer_pass_count", "unique_answer_ambiguous_count", "unique_answer_fail_count", "total_edit_minutes", "mean_edit_minutes_milli", "science_score_milli", "evidence_score_milli", "authoring_value_score_milli", "explanation_quality_score_milli", "visual_scored_item_count", "visual_score_milli"],
      "properties": {
        "item_count": {"type": "integer", "minimum": 1, "maximum": 200},
        "no_edit_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "minor_edit_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "major_edit_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "discard_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "adoptable_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "critical_error_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "unique_answer_pass_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "unique_answer_ambiguous_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "unique_answer_fail_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "total_edit_minutes": {"type": "integer", "minimum": 0, "maximum": 288000},
        "mean_edit_minutes_milli": {"type": "integer", "minimum": 0, "maximum": 1440000},
        "science_score_milli": {"type": "integer", "minimum": 1000, "maximum": 5000},
        "evidence_score_milli": {"type": "integer", "minimum": 1000, "maximum": 5000},
        "authoring_value_score_milli": {"type": "integer", "minimum": 1000, "maximum": 5000},
        "explanation_quality_score_milli": {"type": "integer", "minimum": 1000, "maximum": 5000},
        "visual_scored_item_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "visual_score_milli": {"type": ["integer", "null"], "minimum": 1000, "maximum": 5000}
      }
    },
    "scorecard": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "primary_observation_count", "secondary_observation_count", "unresolved_disagreement_count", "metrics"],
      "properties": {
        "state": {"enum": ["IN_PROGRESS", "READY"]},
        "primary_observation_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "secondary_observation_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "unresolved_disagreement_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "metrics": {"oneOf": [{"$ref": "#/$defs/scoreMetrics"}, {"type": "null"}]}
      }
    },
    "planDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "assembly_id", "secondary_positions", "items", "sessions", "resolutions", "scorecard"],
      "properties": {
        "summary": {"$ref": "#/$defs/planSummary"},
        "assembly_id": {"type": "string", "pattern": "^assembly_[0-9a-f]{32}$"},
        "secondary_positions": {"type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 200}},
        "items": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/item"}},
        "sessions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/session"}},
        "resolutions": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/resolution"}},
        "scorecard": {"$ref": "#/$defs/scorecard"}
      }
    }
  }
}
