{
  "$id": "https://eom.local/schemas/api/assessment-item-occurrence-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "properties": {
          "administration_month": {"const": 3},
          "target_grade": {"const": 1},
          "target_school_level": {"const": "HIGH_SCHOOL"}
        },
        "required": ["administration_month", "target_grade", "target_school_level"]
      }
    }
  ],
  "properties": {
    "administration_month": {"maximum": 12, "minimum": 1, "type": "integer"},
    "administration_year": {"maximum": 2200, "minimum": 1900, "type": "integer"},
    "analysis_run_id": {"pattern": "^analysisrun_[0-9a-f]{32}$", "type": "string"},
    "assessment_occurrence_id": {
      "pattern": "^occurrence_[0-9a-f]{32}$",
      "type": "string"
    },
    "assessment_occurrence_revision_id": {
      "pattern": "^occurrev_[0-9a-f]{32}$",
      "type": "string"
    },
    "assessment_occurrence_revision_sha256": {
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "curriculum_unit_ids": {
      "items": {"pattern": "^currunit_[0-9a-f]{32}$", "type": "string"},
      "maxItems": 8,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "graph_snapshot_revision_id": {
      "pattern": "^graphrev_[0-9a-f]{32}$",
      "type": "string"
    },
    "item_id": {"pattern": "^item_[0-9a-f]{32}$", "type": "string"},
    "item_node_id": {"pattern": "^knode_[0-9a-f]{32}$", "type": "string"},
    "item_number": {"maximum": 200, "minimum": 1, "type": "integer"},
    "item_revision_id": {"pattern": "^itemrev_[0-9a-f]{32}$", "type": "string"},
    "occurrence_display_label": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "occurrence_node_id": {"pattern": "^knode_[0-9a-f]{32}$", "type": "string"},
    "placement_node_id": {"pattern": "^knode_[0-9a-f]{32}$", "type": "string"},
    "placement_sha256": {
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {"const": "assessment-item-occurrence-view/2.0"},
    "subject_key": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,159}$",
      "type": "string"
    },
    "target_grade": {"maximum": 6, "minimum": 1, "type": "integer"},
    "target_school_level": {
      "enum": ["ELEMENTARY", "MIDDLE_SCHOOL", "HIGH_SCHOOL"]
    }
  },
  "required": [
    "schema_version",
    "graph_snapshot_revision_id",
    "placement_node_id",
    "occurrence_node_id",
    "item_node_id",
    "analysis_run_id",
    "assessment_occurrence_id",
    "assessment_occurrence_revision_id",
    "assessment_occurrence_revision_sha256",
    "occurrence_display_label",
    "administration_year",
    "administration_month",
    "target_school_level",
    "target_grade",
    "subject_key",
    "item_number",
    "item_id",
    "item_revision_id",
    "curriculum_unit_ids",
    "placement_sha256"
  ],
  "title": "Assessment Item Occurrence View V2",
  "type": "object"
}
