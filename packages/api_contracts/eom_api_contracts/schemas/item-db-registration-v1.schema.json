{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/api/item-db-registration/1.0",
  "title": "Canonical registration enrichment for the Item DB",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_id", "item_revision_id", "item_manifest_sha256", "approval_state", "difficulty_band", "item_type_key"],
  "properties": {
    "item_id": {"type": "string", "pattern": "^item_[0-9a-f]{32}$"},
    "item_revision_id": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
    "item_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "approval_state": {"enum": ["DRAFT", "IN_REVIEW", "APPROVED", "REJECTED", "SUPERSEDED", "RETIRED"]},
    "difficulty_band": {"type": ["string", "null"], "maxLength": 64},
    "item_type_key": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
