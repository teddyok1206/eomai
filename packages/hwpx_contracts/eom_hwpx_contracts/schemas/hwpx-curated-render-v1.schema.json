{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/hwpx/curated-render/1.0",
  "$ref": "#/$defs/request",
  "$defs": {
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "local_file", "source_format", "sha256", "size_bytes"],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 200},
        "local_file": {"type": "string", "pattern": "^inputs/[0-9]{3}\\.(hwpx|hwp)$"},
        "source_format": {"enum": ["HWP", "HWPX"]},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 52428800}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "build_id", "assembly_revision_id", "assembly_manifest_sha256", "profile", "segments"],
      "properties": {
        "schema_version": {"const": "curated-hwpx-render-request/1.0"},
        "build_id": {"type": "string", "pattern": "^hwpxbuild_[0-9a-f]{32}$"},
        "assembly_revision_id": {"type": "string", "pattern": "^assemblyrev_[0-9a-f]{32}$"},
        "assembly_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "profile": {"const": "NATIVE_EDITABLE_PRESERVATION_V1"},
        "segments": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/segment"}}
      }
    }
  }
}
