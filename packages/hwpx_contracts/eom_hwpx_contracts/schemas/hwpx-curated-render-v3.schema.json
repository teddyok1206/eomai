{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/hwpx/curated-render-request/3.0",
  "title": "Mixed editable curated assembly local render request V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build_id",
    "assembly_revision_id",
    "assembly_manifest_sha256",
    "input_plan_sha256",
    "profile",
    "segments",
    "handoff",
    "converter"
  ],
  "properties": {
    "schema_version": {
      "const": "curated-hwpx-render-request/3.0"
    },
    "build_id": {
      "type": "string",
      "pattern": "^hwpxbuild_[0-9a-f]{32}$"
    },
    "assembly_revision_id": {
      "type": "string",
      "pattern": "^assemblyrev_[0-9a-f]{32}$"
    },
    "assembly_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_plan_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile": {
      "const": "CURATED_EDITABLE_MIXED_V1"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/NativeDocument"
          },
          {
            "$ref": "#/$defs/CanonicalItem"
          },
          {
            "$ref": "#/$defs/EditorialItem"
          }
        ]
      }
    },
    "handoff": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentTeamHandoffSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "converter": {
      "anyOf": [
        {
          "$ref": "#/$defs/converter"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "NativeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "position",
        "local_file",
        "source_format",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "local_file": {
          "type": "string",
          "pattern": "^inputs/[0-9]{3}\\.(hwpx|hwp)$"
        },
        "source_format": {
          "enum": [
            "HWP",
            "HWPX"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "kind": {
          "const": "NATIVE_DOCUMENT"
        }
      }
    },
    "CanonicalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "position",
        "item_revision_id",
        "source_sha256",
        "effective_content_sha256",
        "blueprint_file",
        "blueprint_sha256",
        "blueprint_size_bytes"
      ],
      "properties": {
        "kind": {
          "const": "CANONICAL_ITEM"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "item_revision_id": {
          "type": "string",
          "pattern": "^itemrev_[0-9a-f]{32}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effective_content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "blueprint_file": {
          "type": "string",
          "pattern": "^input/items/[0-9]{3}/native-item\\.json$"
        },
        "blueprint_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "blueprint_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      }
    },
    "EditorialItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "position",
        "item_revision_id",
        "source_schema_ref",
        "json_file",
        "source_sha256",
        "json_size_bytes",
        "markdown_file",
        "markdown_sha256",
        "markdown_size_bytes",
        "images"
      ],
      "properties": {
        "kind": {
          "const": "CONTENT_TEAM_ITEM"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "item_revision_id": {
          "type": "string",
          "pattern": "^itemrev_[0-9a-f]{32}$"
        },
        "source_schema_ref": {
          "enum": [
            "eom.assessment.item-content/2.0",
            "eom.assessment.item-content/3.0"
          ]
        },
        "json_file": {
          "type": "string",
          "pattern": "^input/items/[0-9]{3}/item-content\\.json$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "json_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "markdown_file": {
          "type": "string",
          "pattern": "^input/items/[0-9]{3}/content-team-item\\.md$"
        },
        "markdown_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "markdown_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "images": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/EditorialImage"
          }
        }
      }
    },
    "EditorialImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "local_file",
        "size_bytes"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/ContentTeamImageSource"
        },
        "local_file": {
          "type": "string",
          "pattern": "^images/[0-9a-f]{64}\\.png$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 24,
          "maximum": 2097152
        }
      }
    },
    "ContentTeamImageSource": {
      "additionalProperties": false,
      "properties": {
        "alt_text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Alt Text",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^artifact_[a-f0-9]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_member": {
          "const": "generated-stimulus.png",
          "title": "Artifact Member",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[a-f0-9]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "file_name": {
          "pattern": "^input/visual-[01]\\.png$",
          "title": "File Name",
          "type": "string"
        },
        "height_px": {
          "const": 500,
          "title": "Height Px",
          "type": "integer"
        },
        "label": {
          "enum": [
            "",
            "(가)",
            "(나)"
          ],
          "title": "Label",
          "type": "string"
        },
        "media_type": {
          "const": "image/png",
          "title": "Media Type",
          "type": "string"
        },
        "schema_ref": {
          "const": "eom://schemas/generated-item/stimulus-png/3.0",
          "title": "Schema Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "visual_ordinal": {
          "maximum": 1,
          "minimum": 0,
          "title": "Visual Ordinal",
          "type": "integer"
        },
        "width_px": {
          "const": 800,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "visual_ordinal",
        "label",
        "artifact_id",
        "artifact_revision_id",
        "artifact_member",
        "sha256",
        "schema_ref",
        "media_type",
        "width_px",
        "height_px",
        "alt_text",
        "file_name"
      ],
      "title": "ContentTeamImageSource",
      "type": "object"
    },
    "ContentTeamHandoffSnapshot": {
      "additionalProperties": false,
      "description": "Immutable source/archive identity used by every renderer attempt.",
      "properties": {
        "archive_file": {
          "const": "input/handoff.zip",
          "title": "Archive File",
          "type": "string"
        },
        "archive_sha256": {
          "const": "sha256:dc1c9e254a31fc235824eddbb366a5fac52a4d03e3b334bd5e325fb52391ea91",
          "title": "Archive Sha256",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^artifact_[a-f0-9]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[a-f0-9]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "entry_count": {
          "const": 606,
          "title": "Entry Count",
          "type": "integer"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/ContentTeamHandoffMember"
          },
          "maxItems": 10,
          "minItems": 10,
          "title": "Members",
          "type": "array"
        },
        "profile_sha256": {
          "const": "sha256:ce08671ad433026ec51e68ddfc6a4d7ffe33ae8a792c1791dfa26b9b62e78863",
          "title": "Profile Sha256",
          "type": "string"
        },
        "uncompressed_bytes": {
          "const": 49280719,
          "title": "Uncompressed Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "archive_sha256",
        "archive_file",
        "entry_count",
        "uncompressed_bytes",
        "profile_sha256",
        "members"
      ],
      "title": "ContentTeamHandoffSnapshot",
      "type": "object"
    },
    "ContentTeamHandoffMember": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "automation-template",
            "equation-prototypes",
            "visual-slots-left-right",
            "visual-slots-two-tables",
            "labeled-data-condition",
            "table-2-column",
            "table-3-column",
            "table-3-column-long-equation",
            "table-4-column",
            "inquiry-experiment-box"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 26214400,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "purpose",
        "sha256",
        "size"
      ],
      "title": "ContentTeamHandoffMember",
      "type": "object"
    },
    "converter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "source_commit",
        "bundle_sha256"
      ],
      "properties": {
        "profile": {
          "const": "HWP2HWPX_NATIVE_V1"
        },
        "source_commit": {
          "const": "62d95b980a4e3a6766877dd3fb6f7f45f4afcf3d"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
