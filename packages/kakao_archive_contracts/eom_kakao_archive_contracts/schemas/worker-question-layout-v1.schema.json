{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/worker-question-layout/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_sha256",
    "manifest_sha256",
    "font_sha256",
    "layout_policy",
    "renderer_release_sha256",
    "mode",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": "kakao-question-layout-receipt/1.0"
    },
    "command_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "font_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "layout_policy": {
      "const": "student-question-a4/1.0"
    },
    "renderer_release_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mode": {
      "enum": [
        "DRAFT",
        "FINAL"
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 842
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_id",
        "start_codepoint",
        "end_codepoint",
        "bounds_pt"
      ],
      "properties": {
        "span_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start_codepoint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "end_codepoint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "bounds_pt": {
          "$ref": "#/$defs/bounds"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment_occurrence_id",
        "attachment_revision_id",
        "source_sha256",
        "display_transform",
        "availability",
        "bounds_pt",
        "crop",
        "transform",
        "display_sha256",
        "display_size_bytes",
        "display_width_px",
        "display_height_px"
      ],
      "properties": {
        "attachment_occurrence_id": {
          "type": "string",
          "pattern": "^kakaoattachment_[0-9a-f]{32}$"
        },
        "attachment_revision_id": {
          "type": "string",
          "pattern": "^kakaoattachmentrev_[0-9a-f]{32}$"
        },
        "source_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_transform": {
          "enum": [
            null,
            "exif-rotate-crop-to-png/1.0"
          ]
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "MISSING",
            "UNRESOLVED",
            "EXPIRED"
          ]
        },
        "bounds_pt": {
          "$ref": "#/$defs/bounds"
        },
        "crop": {
          "oneOf": [
            {
              "$ref": "#/$defs/crop"
            },
            {
              "type": "null"
            }
          ]
        },
        "transform": {
          "oneOf": [
            {
              "$ref": "#/$defs/transform"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 67108864
        },
        "display_width_px": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 67108864
        },
        "display_height_px": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_revision_id",
        "page_number",
        "font_size_pt",
        "image_columns",
        "text_blocks",
        "image_blocks"
      ],
      "properties": {
        "question_revision_id": {
          "type": "string",
          "pattern": "^kakaoquestionrev_[0-9a-f]{32}$"
        },
        "page_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "font_size_pt": {
          "enum": [
            10,
            11
          ]
        },
        "image_columns": {
          "enum": [
            1,
            2
          ]
        },
        "text_blocks": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "image_blocks": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/image"
          }
        }
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_ppm",
        "top_ppm",
        "right_ppm",
        "bottom_ppm"
      ],
      "properties": {
        "left_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "top_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "right_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "bottom_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transform_revision_id",
        "operation_order",
        "rotate_clockwise",
        "crop"
      ],
      "properties": {
        "transform_revision_id": {
          "type": "string",
          "pattern": "^kakaotransformrev_[0-9a-f]{32}$"
        },
        "operation_order": {
          "const": "EXIF_THEN_ROTATE_THEN_CROP"
        },
        "rotate_clockwise": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "crop": {
          "oneOf": [
            {
              "$ref": "#/$defs/crop"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
