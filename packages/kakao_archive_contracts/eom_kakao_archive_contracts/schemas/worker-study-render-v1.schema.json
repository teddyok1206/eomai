{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/worker-study-render/1.0",
  "$defs": {
    "execution": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/execution"
    },
    "sha256": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/sha256"
    },
    "member": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/member"
    },
    "text": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/text"
    },
    "image": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/image"
    },
    "binding": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/binding"
    },
    "packetrev": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/packetrev"
    },
    "student": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/student"
    },
    "questionrev": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/questionrev"
    },
    "attachment": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/attachment"
    },
    "attachmentrev": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/attachmentrev"
    },
    "export": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/export"
    },
    "crop": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/crop"
    },
    "transform": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/transform"
    },
    "block_ref": {
      "$ref": "eom://schemas/kakao-archive/worker-question-render/1.0#/$defs/block_ref"
    },
    "occurrence": {
      "type": "string",
      "pattern": "^kakaomessage_[0-9a-f]{32}$"
    },
    "studyrev": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^kakaostudyrev_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_occurrence_id",
        "value"
      ],
      "properties": {
        "source_occurrence_id": {
          "$ref": "#/$defs/occurrence"
        },
        "value": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "source_image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_occurrence_id",
        "value"
      ],
      "properties": {
        "source_occurrence_id": {
          "$ref": "#/$defs/occurrence"
        },
        "value": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "source_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_blocks",
        "images",
        "ordered_blocks"
      ],
      "properties": {
        "text_blocks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/source_text"
          }
        },
        "images": {
          "type": "array",
          "minItems": 0,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/source_image"
          }
        },
        "ordered_blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 230,
          "items": {
            "$ref": "#/$defs/block_ref"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "text_blocks": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "images": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "message_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_occurrence_id",
        "role",
        "kind",
        "raw_date",
        "source_timezone",
        "sent_at_utc"
      ],
      "properties": {
        "source_occurrence_id": {
          "$ref": "#/$defs/occurrence"
        },
        "role": {
          "enum": [
            "student",
            "staff"
          ]
        },
        "raw_date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source_timezone": {
          "enum": [
            "Asia/Seoul",
            "unknown"
          ]
        },
        "sent_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "text",
            "attachment",
            "deleted",
            "system",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_timezone": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "sent_at_utc": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "sent_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_title",
        "page_label",
        "source_sha256"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "page_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "supplement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplement_id",
        "title",
        "origin",
        "text_blocks",
        "images",
        "ordered_blocks",
        "citations"
      ],
      "properties": {
        "supplement_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "origin": {
          "enum": [
            "USER_NOTE",
            "SOURCE_EXCERPT",
            "MODEL_DRAFT"
          ]
        },
        "text_blocks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "images": {
          "type": "array",
          "minItems": 0,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "ordered_blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 230,
          "items": {
            "$ref": "#/$defs/block_ref"
          }
        },
        "citations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "text_blocks": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "images": {
              "minItems": 1
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "SOURCE_EXCERPT"
              }
            }
          },
          "then": {
            "properties": {
              "citations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_revision_id",
        "header_date",
        "student",
        "staff",
        "messages",
        "supplements"
      ],
      "properties": {
        "question_revision_id": {
          "$ref": "#/$defs/questionrev"
        },
        "header_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "student": {
          "$ref": "#/$defs/source_content"
        },
        "staff": {
          "oneOf": [
            {
              "$ref": "#/$defs/source_content"
            },
            {
              "type": "null"
            }
          ]
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 230,
          "items": {
            "$ref": "#/$defs/message_metadata"
          }
        },
        "supplements": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/supplement"
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_binding_id",
        "packet_revision_id",
        "study_revision_id",
        "student_id",
        "student_display_name",
        "subset_sha256",
        "mode",
        "questions"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-study-render-manifest/1.0"
        },
        "source_binding_id": {
          "$ref": "#/$defs/binding"
        },
        "packet_revision_id": {
          "$ref": "#/$defs/packetrev"
        },
        "study_revision_id": {
          "$ref": "#/$defs/studyrev"
        },
        "student_id": {
          "$ref": "#/$defs/student"
        },
        "student_display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mode": {
          "enum": [
            "DRAFT",
            "FINAL"
          ]
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "questions": {
                "contains": {
                  "properties": {
                    "supplements": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "study_revision_id": {
                "type": "string",
                "pattern": "^kakaostudyrev_[0-9a-f]{32}$"
              }
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "schema_version",
        "export_id",
        "source_binding_id",
        "packet_revision_id",
        "student_id",
        "subset_sha256",
        "mode",
        "renderer_release_sha256",
        "layout_policy",
        "manifest",
        "font",
        "study_revision_id"
      ],
      "properties": {
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "schema_version": {
          "const": "kakao-study-render/1.0"
        },
        "export_id": {
          "$ref": "#/$defs/export"
        },
        "source_binding_id": {
          "$ref": "#/$defs/binding"
        },
        "packet_revision_id": {
          "$ref": "#/$defs/packetrev"
        },
        "student_id": {
          "$ref": "#/$defs/student"
        },
        "subset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mode": {
          "enum": [
            "DRAFT",
            "FINAL"
          ]
        },
        "renderer_release_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "layout_policy": {
          "const": "student-study-a4/1.0"
        },
        "manifest": {
          "$ref": "#/$defs/member"
        },
        "font": {
          "$ref": "#/$defs/member"
        },
        "study_revision_id": {
          "$ref": "#/$defs/studyrev"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "schema_version",
        "export_id",
        "command_sha256",
        "manifest_sha256",
        "status",
        "page_count",
        "outputs",
        "error_code",
        "question_revision_id"
      ],
      "properties": {
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "schema_version": {
          "const": "kakao-study-render-result/1.0"
        },
        "export_id": {
          "$ref": "#/$defs/export"
        },
        "command_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "COMPLETED",
            "NEEDS_LAYOUT_REVIEW",
            "INVALID_INPUT"
          ]
        },
        "page_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "outputs": {
          "type": "array",
          "maxItems": 202,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "question_revision_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/questionrev"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/result"
    }
  ]
}
