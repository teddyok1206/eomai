{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/codex-reviewed-capability-policy/3.0",
  "title": "EOM Codex Reviewed Capability Policy V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "expected_codex_cli_version",
    "compatibility_runtime",
    "models"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "expected_codex_cli_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "compatibility_runtime": {
      "$ref": "eom://schemas/workflow/codex-compatibility-report/1.0#/properties/runtime"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "reasoning_efforts"
        ],
        "properties": {
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "reasoning_efforts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          },
          "bindings": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "binding_id",
                    "assignment_revision_id",
                    "slot_id",
                    "role"
                  ],
                  "properties": {
                    "binding_id": {
                      "type": "string",
                      "pattern": "^authbinding_[0-9a-f]{32}$"
                    },
                    "assignment_revision_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^authassignrev_[0-9a-f]{32}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "slot_id": {
                      "enum": [
                        "01",
                        "02",
                        "03",
                        "04",
                        "05",
                        "06"
                      ]
                    },
                    "role": {
                      "enum": [
                        "authoring",
                        "review",
                        "image",
                        "item_management",
                        "support"
                      ]
                    }
                  },
                  "oneOf": [
                    {
                      "properties": {
                        "slot_id": {
                          "const": "01"
                        },
                        "role": {
                          "const": "authoring"
                        }
                      }
                    },
                    {
                      "properties": {
                        "slot_id": {
                          "const": "02"
                        },
                        "role": {
                          "const": "review"
                        }
                      }
                    },
                    {
                      "properties": {
                        "slot_id": {
                          "const": "03"
                        },
                        "role": {
                          "const": "image"
                        }
                      }
                    },
                    {
                      "properties": {
                        "slot_id": {
                          "const": "04"
                        },
                        "role": {
                          "const": "item_management"
                        }
                      }
                    },
                    {
                      "properties": {
                        "slot_id": {
                          "enum": [
                            "05",
                            "06"
                          ]
                        },
                        "role": {
                          "const": "support"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
