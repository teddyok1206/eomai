{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/codex-compatibility-invocation/1.0",
  "title": "EOM Codex Compatibility Invocation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "request_sha256",
    "job_id",
    "model",
    "reasoning_effort",
    "image_sha256",
    "invocation_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-compatibility-invocation/1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^codexcompat_[0-9a-f]{32}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^compatcase_[0-9a-f]{32}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{32}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reasoning_effort": {
      "enum": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "invocation_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
