{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/codex-auth-health-view/1.0",
  "title": "EOM Codex Authentication Health View V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "slot_key",
    "account_label",
    "state",
    "reason_code",
    "codex_cli_version",
    "observed_at",
    "valid_until"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-auth-health-view/1.0"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^authbinding_[0-9a-f]{32}$"
    },
    "slot_key": {
      "type": "string",
      "pattern": "^slot[0-9]{2}$"
    },
    "account_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "state": {
      "type": "string",
      "enum": ["READY", "STALE", "AUTH_REQUIRED", "DEGRADED", "DRAINING", "DISABLED"]
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "codex_cli_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "observed_at": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/utcTimestamp"
    },
    "valid_until": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/utcTimestamp"
    }
  }
}
