{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/codex-compatibility-request/1.0",
  "title": "EOM Codex Compatibility Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_commit",
    "created_at",
    "expires_at",
    "max_model_calls",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-compatibility-request/1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^codexcompat_[0-9a-f]{32}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "max_model_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "slot_id",
          "binding_id",
          "expected_resource_version",
          "model",
          "reasoning_effort",
          "assignment_revision_id"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^compatcase_[0-9a-f]{32}$"
          },
          "slot_id": {
            "enum": [
              "01",
              "02",
              "03",
              "04",
              "05",
              "06"
            ]
          },
          "binding_id": {
            "type": "string",
            "pattern": "^authbinding_[0-9a-f]{32}$"
          },
          "expected_resource_version": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "reasoning_effort": {
            "enum": [
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh"
            ]
          },
          "assignment_revision_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^authassignrev_[0-9a-f]{32}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
