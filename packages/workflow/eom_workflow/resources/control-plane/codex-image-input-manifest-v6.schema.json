{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/codex-image-input-manifest/6.0",
  "title": "Pinned Kakao concept original image inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "images", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "codex-image-input-manifest/6.0"},
    "plan_id": {"type": "string", "pattern": "^execplan_[0-9a-f]{32}$"},
    "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "images": {
      "type": "array", "minItems": 1, "maxItems": 72,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["input_index", "relative_path", "media_type", "sha256", "bytes", "width_pixels", "height_pixels"],
        "properties": {
          "input_index": {"type": "integer", "minimum": 1, "maximum": 72},
          "relative_path": {"type": "string", "pattern": "^source/concepts/files/[A-Za-z0-9_-]+(?:[/.][A-Za-z0-9_-]+)*$", "maxLength": 262},
          "media_type": {"enum": ["image/png", "image/jpeg", "image/webp"]},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
          "width_pixels": {"type": "integer", "minimum": 1, "maximum": 30000},
          "height_pixels": {"type": "integer", "minimum": 1, "maximum": 30000}
        }
      }
    }
  }
}
