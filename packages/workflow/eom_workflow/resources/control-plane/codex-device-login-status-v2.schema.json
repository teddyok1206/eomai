{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/control-plane/codex-device-login-status/1.1",
  "title": "Codex Device Login Status V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enrollment_id", "slot_key", "state", "reason_code", "updated_at"],
  "properties": {
    "schema_version": {"const": "codex-device-login-status/1.1"},
    "enrollment_id": {"type": "string", "pattern": "^authflow_[0-9a-f]{32}$"},
    "slot_key": {"type": "string", "pattern": "^slot0[1-6]$"},
    "state": {"enum": ["STARTING", "WAITING_FOR_USER", "SUCCEEDED", "FAILED", "EXPIRED"]},
    "reason_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
