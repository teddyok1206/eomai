{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/resolved-execution-plan/25.0",
  "title": "EOM Textbook-Grounded Single Document Review Execution Plan V25",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "workflow_id", "workload_class", "preset_id",
    "preset_revision_id", "preset_sha256", "workflow_definition_key",
    "workflow_definition_version", "workflow_definition_sha256",
    "review_request_sha256", "document", "textbook_evidence",
    "capacity_policy_revision_id", "steps", "resolver_version", "resolved_at",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": { "const": "resolved-execution-plan/25.0" },
    "plan_id": { "type": "string", "pattern": "^execplan_[0-9a-f]{32}$" },
    "workflow_id": { "type": "string", "pattern": "^workflow_[0-9a-f]{32}$" },
    "workload_class": { "const": "CODEX" },
    "preset_id": { "type": "string", "pattern": "^execpreset_[0-9a-f]{32}$" },
    "preset_revision_id": { "type": "string", "pattern": "^execpresetrev_[0-9a-f]{32}$" },
    "preset_sha256": { "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256" },
    "workflow_definition_key": { "const": "pdf-document-review" },
    "workflow_definition_version": { "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/semver" },
    "workflow_definition_sha256": { "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256" },
    "review_request_sha256": { "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256" },
    "document": { "$ref": "eom://schemas/workflow/resolved-execution-plan/13.0#/$defs/document" },
    "textbook_evidence": { "$ref": "eom://schemas/knowledge/review-textbook-evidence/1.0" },
    "capacity_policy_revision_id": { "type": "string", "pattern": "^capacityrev_[0-9a-f]{32}$" },
    "steps": { "$ref": "eom://schemas/workflow/resolved-execution-plan/13.0#/properties/steps" },
    "resolver_version": { "const": "25.0.0" },
    "resolved_at": { "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/utcTimestamp" },
    "plan_sha256": { "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256" }
  }
}
