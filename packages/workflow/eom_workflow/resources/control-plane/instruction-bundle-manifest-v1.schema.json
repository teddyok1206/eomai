{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/instruction-bundle-manifest/1.0",
  "title": "EOM Instruction Bundle Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_revision_id",
    "revision_number",
    "state",
    "components",
    "content_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "instruction-bundle-manifest/1.0"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^instrbundle_[0-9a-f]{32}$"
    },
    "bundle_revision_id": {
      "type": "string",
      "pattern": "^instrrev_[0-9a-f]{32}$"
    },
    "revision_number": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": ["DRAFT", "RELEASED", "DEPRECATED"]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "relative_path", "artifact"],
        "properties": {
          "layer": {
            "type": "string",
            "enum": ["PLATFORM", "ROLE"]
          },
          "relative_path": {
            "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/safeRelativeMarkdownPath"
          },
          "artifact": {
            "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/artifactPointer"
          }
        }
      }
    },
    "content_sha256": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
    },
    "created_at": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/utcTimestamp"
    }
  }
}
