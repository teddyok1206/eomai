{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/execution-preset-revision/1.0",
  "title": "EOM Execution Preset Revision V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preset_id",
    "preset_revision_id",
    "revision_number",
    "state",
    "display_name",
    "description",
    "role_policies",
    "capacity_policy_revision_id",
    "general_knowledge_policy",
    "compatible_workflow_protocols",
    "content_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "execution-preset-revision/1.0"
    },
    "preset_id": {
      "type": "string",
      "pattern": "^execpreset_[0-9a-f]{32}$"
    },
    "preset_revision_id": {
      "type": "string",
      "pattern": "^execpresetrev_[0-9a-f]{32}$"
    },
    "revision_number": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": ["DRAFT", "RELEASED", "DEPRECATED"]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "role_policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "model_candidates",
          "instruction_bundle",
          "reference_bundle",
          "worker_pool_key",
          "timeout_seconds",
          "sandbox",
          "network"
        ],
        "properties": {
          "role": {
            "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/role"
          },
          "model_candidates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/modelCandidate"
            }
          },
          "instruction_bundle": {
            "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/bundleRevisionPointer"
          },
          "reference_bundle": {
            "anyOf": [
              {
                "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/bundleRevisionPointer"
              },
              {
                "type": "null"
              }
            ]
          },
          "worker_pool_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 7200
          },
          "sandbox": {
            "const": "read-only"
          },
          "network": {
            "const": "disabled"
          }
        }
      }
    },
    "capacity_policy_revision_id": {
      "type": "string",
      "pattern": "^capacityrev_[0-9a-f]{32}$"
    },
    "general_knowledge_policy": {
      "type": "string",
      "enum": ["DENY", "ALLOW_WITH_PROVENANCE"]
    },
    "compatible_workflow_protocols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^workflow-role/[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
    },
    "content_sha256": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
    },
    "created_at": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/utcTimestamp"
    }
  }
}
