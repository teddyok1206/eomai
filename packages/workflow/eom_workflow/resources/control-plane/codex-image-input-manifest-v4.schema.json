{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/codex-image-input-manifest/4.0",
  "title": "EOM Codex Creative Learning Image Input Manifest V4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "images", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "codex-image-input-manifest/4.0"},
    "plan_id": {"type": "string", "pattern": "^execplan_[0-9a-f]{32}$"},
    "images": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/image"}},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_page", "relative_path", "media_type", "sha256", "bytes", "width_pixels", "height_pixels"],
      "properties": {
        "physical_page": {"type": "integer", "minimum": 1, "maximum": 32},
        "relative_path": {"type": "string", "maxLength": 32, "pattern": "^source/pages/page-[0-9]{4}\\.png$"},
        "media_type": {"const": "image/png"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 24, "maximum": 16777216},
        "width_pixels": {"type": "integer", "minimum": 64, "maximum": 2400},
        "height_pixels": {"type": "integer", "minimum": 64, "maximum": 2400}
      }
    }
  }
}
