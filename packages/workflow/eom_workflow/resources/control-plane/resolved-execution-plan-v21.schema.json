{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/resolved-execution-plan/21.0",
  "title": "Purpose-pinned inference-transfer execution plan V21",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "comparisonStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_key": {"const": "compare_pair"},
        "role": {"const": "support"},
        "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh"]},
        "instruction_bundle": {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/bundleRevisionPointer"},
        "reference_bundle": {"type": "null"},
        "worker_pool_key": {"const": "customer-support"},
        "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 900},
        "sandbox": {"const": "read-only"},
        "network": {"const": "disabled"},
        "general_knowledge_mode": {"const": "DENIED"}
      },
      "required": ["step_key", "role", "model", "reasoning_effort", "instruction_bundle", "reference_bundle", "worker_pool_key", "timeout_seconds", "sandbox", "network", "general_knowledge_mode"]
    },
    "rubricArtifact": {
      "allOf": [
        {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/artifactPointer"},
        {
          "properties": {
            "schema_ref": {"const": "eom://schemas/workflow/instruction-member/1.0"},
            "media_type": {"const": "text/markdown"},
            "logical_name": {"const": "instructions/transfer-rubric.md"}
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "resolved-execution-plan/21.0"},
    "plan_id": {"type": "string", "pattern": "^execplan_[0-9a-f]{32}$"},
    "workflow_id": {"type": "string", "pattern": "^workflow_[0-9a-f]{32}$"},
    "workload_class": {"const": "CODEX"},
    "preset_id": {"type": "string", "pattern": "^execpreset_[0-9a-f]{32}$"},
    "preset_revision_id": {"type": "string", "pattern": "^execpresetrev_[0-9a-f]{32}$"},
    "preset_sha256": {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"},
    "workflow_definition_key": {"const": "item-inference-transfer-comparison"},
    "workflow_definition_version": {"const": "1.0.0"},
    "workflow_definition_sha256": {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"},
    "comparison_request_sha256": {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"},
    "left_profile": {"$ref": "eom://schemas/knowledge/item-inference-transfer/1.0#/$defs/profilePointer"},
    "right_profile": {"$ref": "eom://schemas/knowledge/item-inference-transfer/1.0#/$defs/profilePointer"},
    "graph_snapshot": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/graphSnapshotPointer"},
    "access_policy_revision_id": {"type": "string", "pattern": "^accessrev_[0-9a-f]{32}$"},
    "access_policy_sha256": {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"},
    "requester_permissions_sha256": {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"},
    "rubric": {"$ref": "eom://schemas/knowledge/item-inference-transfer/1.0#/$defs/rubricPointer"},
    "rubric_artifact": {"$ref": "#/$defs/rubricArtifact"},
    "core_prompt_sha256": {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"},
    "prompt_sha256": {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"},
    "capacity_policy_revision_id": {"type": "string", "pattern": "^capacityrev_[0-9a-f]{32}$"},
    "steps": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/comparisonStep"}},
    "resolver_version": {"const": "21.0.0"},
    "resolved_at": {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/utcTimestamp"},
    "plan_sha256": {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"}
  },
  "required": ["schema_version", "plan_id", "workflow_id", "workload_class", "preset_id", "preset_revision_id", "preset_sha256", "workflow_definition_key", "workflow_definition_version", "workflow_definition_sha256", "comparison_request_sha256", "left_profile", "right_profile", "graph_snapshot", "access_policy_revision_id", "access_policy_sha256", "requester_permissions_sha256", "rubric", "rubric_artifact", "core_prompt_sha256", "prompt_sha256", "capacity_policy_revision_id", "steps", "resolver_version", "resolved_at", "plan_sha256"]
}
