    "workflow_definition_sha256": { "$ref": "eom://schemas/workflow/resolved-execution-plan/14.0#/properties/workflow_definition_sha256" },
    "review_request_sha256": { "$ref": "eom://schemas/workflow/resolved-execution-plan/14.0#/properties/review_request_sha256" },
