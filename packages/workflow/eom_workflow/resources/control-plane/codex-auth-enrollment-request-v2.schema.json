{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/control-plane/codex-auth-enrollment-request/1.1",
  "title": "Codex Auth Enrollment Request V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "enrollment_id", "binding_id", "expected_binding_resource_version",
    "slot_key", "requested_account_label", "requested_by_operator_id",
    "requested_by_api_session_id", "requested_at", "expires_at", "request_sha256"
  ],
  "properties": {
    "schema_version": {"const": "codex-auth-enrollment-request/1.1"},
    "enrollment_id": {"type": "string", "pattern": "^authflow_[0-9a-f]{32}$"},
    "binding_id": {"type": "string", "pattern": "^authbinding_[0-9a-f]{32}$"},
    "expected_binding_resource_version": {"type": "integer", "minimum": 1},
    "slot_key": {"type": "string", "pattern": "^slot0[1-6]$"},
    "requested_account_label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "requested_by_operator_id": {"type": "string", "pattern": "^operator_[0-9a-f]{32}$"},
    "requested_by_api_session_id": {"type": "string", "pattern": "^apisession_[0-9a-f]{32}$"},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
