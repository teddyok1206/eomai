{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/resolved-execution-plan/14.0",
  "title": "EOM Paired Document Review Resolved Execution Plan V14",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "workflow_id",
    "workload_class",
    "preset_id",
    "preset_revision_id",
    "preset_sha256",
    "workflow_definition_key",
    "workflow_definition_version",
    "workflow_definition_sha256",
    "review_request_sha256",
    "documents",
    "capacity_policy_revision_id",
    "steps",
    "resolver_version",
    "resolved_at",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "resolved-execution-plan/14.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^execplan_[0-9a-f]{32}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^workflow_[0-9a-f]{32}$"
    },
    "workload_class": {
      "const": "CODEX"
    },
    "preset_id": {
      "type": "string",
      "pattern": "^execpreset_[0-9a-f]{32}$"
    },
    "preset_revision_id": {
      "type": "string",
      "pattern": "^execpresetrev_[0-9a-f]{32}$"
    },
    "preset_sha256": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
    },
    "workflow_definition_key": {
      "const": "pdf-document-review"
    },
    "workflow_definition_version": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/semver"
    },
    "workflow_definition_sha256": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
    },
    "review_request_sha256": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
    },
    "capacity_policy_revision_id": {
      "type": "string",
      "pattern": "^capacityrev_[0-9a-f]{32}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_key",
          "role",
          "model",
          "reasoning_effort",
          "instruction_bundle",
          "reference_bundle",
          "worker_pool_key",
          "timeout_seconds",
          "sandbox",
          "network",
          "general_knowledge_mode"
        ],
        "properties": {
          "step_key": {
            "const": "review_document"
          },
          "role": {
            "const": "support"
          },
          "model": {
            "const": "gpt-5.6-terra"
          },
          "reasoning_effort": {
            "const": "xhigh"
          },
          "instruction_bundle": {
            "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/bundleRevisionPointer"
          },
          "reference_bundle": {
            "type": "null"
          },
          "worker_pool_key": {
            "const": "customer-support"
          },
          "timeout_seconds": {
            "const": 3600
          },
          "sandbox": {
            "const": "read-only"
          },
          "network": {
            "const": "disabled"
          },
          "general_knowledge_mode": {
            "const": "ALLOWED_WITH_PROVENANCE"
          }
        }
      }
    },
    "resolver_version": {
      "const": "14.0.0"
    },
    "resolved_at": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/utcTimestamp"
    },
    "plan_sha256": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
    },
    "documents": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/review_document"
            },
            {
              "properties": {
                "role": {
                  "const": "QUESTION"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/review_document"
            },
            {
              "properties": {
                "role": {
                  "const": "SOLUTION"
                }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "sha256",
        "schema_ref",
        "media_type",
        "content_length"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "artifact_revision_id": {
          "type": "string",
          "pattern": "^rev_[0-9a-f]{32}$"
        },
        "member_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^eom://schemas/document-review/[a-z0-9-]+/1\\.0$"
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "image/png",
            "application/json"
          ]
        },
        "content_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "width_px",
        "height_px",
        "rotation_degrees",
        "page_image",
        "text_layer"
      ],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "width_px": {
          "type": "integer",
          "minimum": 64,
          "maximum": 16384
        },
        "height_px": {
          "type": "integer",
          "minimum": 64,
          "maximum": 16384
        },
        "rotation_degrees": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "page_image": {
          "allOf": [
            {
              "$ref": "#/$defs/member"
            },
            {
              "properties": {
                "media_type": {
                  "const": "image/png"
                },
                "content_length": {
                  "maximum": 16777216
                }
              }
            }
          ]
        },
        "text_layer": {
          "oneOf": [
            {
              "$ref": "#/$defs/member"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "document_revision_id",
        "original_filename",
        "source_pdf",
        "page_count",
        "pages"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^document_[0-9a-f]{32}$"
        },
        "document_revision_id": {
          "type": "string",
          "pattern": "^documentrev_[0-9a-f]{32}$"
        },
        "original_filename": {
          "type": "string",
          "minLength": 5,
          "maxLength": 240,
          "pattern": "^[^/\\\\\\u0000-\\u001f]+\\.[Pp][Dd][Ff]$"
        },
        "source_pdf": {
          "$ref": "#/$defs/member"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/page"
          }
        }
      }
    },
    "review_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "document"
      ],
      "properties": {
        "role": {
          "enum": [
            "QUESTION",
            "SOLUTION"
          ]
        },
        "document": {
          "$ref": "#/$defs/document"
        }
      }
    }
  }
}
