{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/reference-query-owner-configuration/1.0",
  "title": "Fixed non-secret reference QUERY owner selection; never authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_source_commit", "corpus_id", "namespace", "recipe", "source_classes", "native_execution_policy", "native_execution_policy_sha256", "runtime_bundle", "database_owner", "runtime_verifier", "cpu_environment_raw_sha256", "owner_environment_raw_sha256", "api_provider"],
  "properties": {
    "schema_version": {"const": "reference-query-owner-configuration/1.0"},
    "owner_source_commit": {"$ref": "#/$defs/commit"},
    "corpus_id": {"type": "string", "pattern": "^corpus_[0-9a-f]{32}$"},
    "namespace": {"$ref": "eom://schemas/knowledge/embedding-registry/1.0#/$defs/namespace"},
    "recipe": {"$ref": "eom://schemas/knowledge/item-inference-transfer-experiment/1.0#/$defs/recipe"},
    "source_classes": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["APPROVED_ITEM", "PAST_EXAM"]}},
    "native_execution_policy": {"$ref": "eom://schemas/workflow/reference-query-execution/1.0#/$defs/request/properties/native_execution_policy"},
    "native_execution_policy_sha256": {"$ref": "#/$defs/hash"},
    "runtime_bundle": {"$ref": "eom://schemas/knowledge/embedding-runtime-bundle/1.0#/$defs/bundlePointer"},
    "database_owner": {
      "type": "object", "additionalProperties": false, "required": ["role_name", "role_oid"],
      "properties": {"role_name": {"const": "eom_app"}, "role_oid": {"type": "integer", "minimum": 1, "maximum": 4294967295}}
    },
    "runtime_verifier": {
      "type": "object", "additionalProperties": false, "required": ["source_commit", "script_raw_sha256"],
      "properties": {"source_commit": {"$ref": "#/$defs/commit"}, "script_raw_sha256": {"$ref": "#/$defs/hash"}}
    },
    "cpu_environment_raw_sha256": {"$ref": "#/$defs/hash"},
    "owner_environment_raw_sha256": {"$ref": "#/$defs/hash"},
    "api_provider": {"$ref": "#/$defs/provider"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "minLength": 40, "maxLength": 40},
    "code": {
      "type": "object", "additionalProperties": false, "required": ["member", "sha256"],
      "properties": {
        "member": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)+\\.py$", "maxLength": 240},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "wheel_sha256", "configuration_sha256", "code_members"],
      "properties": {
        "source_commit": {"$ref": "#/$defs/commit"},
        "wheel_sha256": {"$ref": "#/$defs/hash"},
        "configuration_sha256": {"$ref": "#/$defs/hash"},
        "code_members": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/code"}}
      }
    }
  }
}
