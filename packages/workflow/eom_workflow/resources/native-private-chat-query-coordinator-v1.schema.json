{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/native-private-chat-query-coordinator/1.0",
  "title": "Original private Chat QUERY checkpoint history",
  "description": "Text-free original observations, never current Chat ownership, native admission or permission to retry.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "native_launch_job_id", "association_sha256", "payload", "checkpoint_sha256"],
  "properties": {
    "schema_version": {"const": "native-private-chat-query-coordinator/1.0"},
    "record_type": {"enum": ["ALLOCATION", "EXECUTED", "PUBLISHED", "COMPLETED"]},
    "native_launch_job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
    "association_sha256": {"$ref": "#/$defs/hash"},
    "checkpoint_sha256": {"$ref": "#/$defs/hash"},
    "payload": {"oneOf": [{"$ref": "#/$defs/allocation"}, {"$ref": "#/$defs/executed"}, {"$ref": "#/$defs/published"}, {"$ref": "#/$defs/completed"}]}
  },
  "allOf": [
    {"if": {"properties": {"record_type": {"const": "ALLOCATION"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/allocation"}}}},
    {"if": {"properties": {"record_type": {"const": "EXECUTED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/executed"}}}},
    {"if": {"properties": {"record_type": {"const": "PUBLISHED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/published"}}}},
    {"if": {"properties": {"record_type": {"const": "COMPLETED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/completed"}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
    "unit": {"$ref": "eom://schemas/workflow/native-reference-query-coordinator/1.0#/$defs/unit"},
    "member": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/artifactMember"},
    "allocation": {
      "type": "object", "additionalProperties": false, "required": ["allocation", "origin"],
      "properties": {
        "allocation": {"$ref": "eom://schemas/workflow/native-reference-query-coordinator/1.0#/$defs/allocation"},
        "origin": {"$ref": "eom://schemas/knowledge/general-chat-private-query-read/1.0#/$defs/origin"}
      }
    },
    "executed": {
      "type": "object", "additionalProperties": false,
      "required": ["boot_id", "prepare", "query", "prepare_template_sha256", "query_template_sha256", "cpu_environment_sha256", "owner_environment_sha256", "result_sha256", "completed_observed_at"],
      "properties": {
        "boot_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "prepare": {"$ref": "#/$defs/unit"}, "query": {"$ref": "#/$defs/unit"},
        "prepare_template_sha256": {"const": "sha256:f3c9d2bad306b0f3f1ac35272d2af8d8957c7f8cfd16866695403da0cd4d7227"},
        "query_template_sha256": {"const": "sha256:cecb3128eaf33b0e897a813aab7ec4559ca26e63291fb7622a5c429826538bde"},
        "cpu_environment_sha256": {"$ref": "#/$defs/hash"}, "owner_environment_sha256": {"$ref": "#/$defs/hash"},
        "result_sha256": {"$ref": "#/$defs/hash"}, "completed_observed_at": {"$ref": "#/$defs/utc"}
      }
    },
    "published": {
      "type": "object", "additionalProperties": false,
      "required": ["query_owner_job_id", "execution_record", "result", "shard", "binary", "manifest_sha256", "published_observed_at"],
      "properties": {
        "query_owner_job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
        "execution_record": {"$ref": "#/$defs/member"}, "result": {"$ref": "#/$defs/member"},
        "shard": {"$ref": "#/$defs/member"}, "binary": {"$ref": "#/$defs/member"},
        "manifest_sha256": {"$ref": "#/$defs/hash"}, "published_observed_at": {"$ref": "#/$defs/utc"}
      }
    },
    "completed": {
      "type": "object", "additionalProperties": false, "required": ["output"],
      "properties": {"output": {"$ref": "eom://schemas/workflow/private-chat-query-runner/1.0#/$defs/step-output"}}
    }
  }
}
