{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/knowledge-item-brief-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "topic",
    "task_type",
    "difficulty",
    "authoring_guidance",
    "authoring_guidance_sha256",
    "curriculum_scope",
    "original_request_sha256"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 80},
    "topic": {"type": "string", "minLength": 1, "maxLength": 160},
    "task_type": {"type": "string", "minLength": 1, "maxLength": 80},
    "difficulty": {"type": "string", "minLength": 1, "maxLength": 80},
    "authoring_guidance": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "pattern": "^(?!.*[\\u0000-\\u001f\\u007f])(?!\\s)(?!.*\\s$)(?!.*\\s{2}).+$"
    },
    "authoring_guidance_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "curriculum_scope": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/integrated_science_curriculum_scope"}
      ]
    },
    "mock_exam_slot": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/mock_exam_slot"}
      ]
    },
    "original_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "mock_exam_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "assembly_policy_revision_id",
        "assembly_policy_sha256",
        "layout_policy_revision_id",
        "layout_policy_sha256",
        "slot_id",
        "position",
        "points_milli",
        "coverage_role",
        "coverage_requirement_id",
        "balance_large_unit_key",
        "curriculum_selected_unit_key",
        "large_unit_key",
        "inquiry_required",
        "preferred_difficulty",
        "preferred_material_profiles",
        "slot_sha256"
      ],
      "properties": {
        "schema_version": {"const": "mock-exam-slot/1.0"},
        "assembly_policy_revision_id": {
          "type": "string",
          "pattern": "^assemblypolicyrev_[0-9a-f]{32}$"
        },
        "assembly_policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "layout_policy_revision_id": {
          "type": "string",
          "pattern": "^layoutpolicyrev_[0-9a-f]{32}$"
        },
        "layout_policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "slot_id": {"type": "string", "pattern": "^slot-[0-9]{2,3}$"},
        "position": {"type": "integer", "minimum": 1, "maximum": 200},
        "points_milli": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "coverage_role": {"enum": ["REQUIRED", "BALANCE"]},
        "coverage_requirement_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"}
          ]
        },
        "balance_large_unit_key": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^eom\\.is\\.large\\.[1-6]$"}
          ]
        },
        "curriculum_selected_unit_key": {
          "type": "string",
          "pattern": "^eom\\.is\\.middle\\.[1-6]-[1-7]$"
        },
        "large_unit_key": {"type": "string", "pattern": "^eom\\.is\\.large\\.[1-6]$"},
        "inquiry_required": {"type": "boolean"},
        "preferred_difficulty": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "preferred_material_profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["TEXT", "DATA", "TABLE", "IMAGE", "MIXED", "INQUIRY"]}
        },
        "slot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"coverage_role": {"const": "REQUIRED"}}},
          "then": {
            "properties": {
              "coverage_requirement_id": {"type": "string"},
              "balance_large_unit_key": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "coverage_requirement_id": {"type": "null"},
              "balance_large_unit_key": {"type": "string"}
            }
          }
        },
        {
          "if": {"properties": {"inquiry_required": {"const": true}}},
          "then": {
            "properties": {"preferred_material_profiles": {"contains": {"const": "INQUIRY"}}}
          }
        }
      ]
    },
    "integrated_science_curriculum_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outline_key",
        "outline_revision",
        "outline_sha256",
        "selected_unit_key",
        "selected_level",
        "volume_key",
        "large_unit_key",
        "middle_unit_key",
        "graph_root_stable_key",
        "breadcrumb"
      ],
      "properties": {
        "outline_key": {"const": "eom-integrated-science-editorial-outline"},
        "outline_revision": {"const": "1.0"},
        "outline_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "selected_unit_key": {
          "type": "string",
          "pattern": "^eom\\.is\\.(large\\.[1-6]|middle\\.[1-6]-[1-7])$"
        },
        "selected_level": {"enum": ["LARGE", "MIDDLE"]},
        "volume_key": {"type": "string", "pattern": "^eom\\.is\\.volume\\.(i|ii)$"},
        "large_unit_key": {"type": "string", "pattern": "^eom\\.is\\.large\\.[1-6]$"},
        "middle_unit_key": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^eom\\.is\\.middle\\.[1-6]-[1-7]$"}
          ]
        },
        "graph_root_stable_key": {
          "type": "string",
          "pattern": "^curriculum\\.eom\\.editorial\\.integrated-science\\.volume-(i|ii)\\.large-[1-6](?:\\.middle-[1-7])?$"
        },
        "breadcrumb": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"selected_level": {"const": "LARGE"}},
            "required": ["selected_level"]
          },
          "then": {
            "properties": {
              "selected_unit_key": {"pattern": "^eom\\.is\\.large\\.[1-6]$"},
              "middle_unit_key": {"type": "null"},
              "graph_root_stable_key": {
                "pattern": "^curriculum\\.eom\\.editorial\\.integrated-science\\.volume-(i|ii)\\.large-[1-6]$"
              }
            }
          },
          "else": {
            "properties": {
              "selected_unit_key": {"pattern": "^eom\\.is\\.middle\\.[1-6]-[1-7]$"},
              "middle_unit_key": {"type": "string"},
              "graph_root_stable_key": {
                "pattern": "^curriculum\\.eom\\.editorial\\.integrated-science\\.volume-(i|ii)\\.large-[1-6]\\.middle-[1-7]$"
              }
            }
          }
        }
      ]
    }
  }
}
