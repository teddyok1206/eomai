{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/native-private-chat-query-coordinator/2.1",
  "title": "Private common QUERY2 original finite CUDA continuation",
  "description": "One private receipt1.1 child, not a CPU unit observation or source authority. Original request2/launch and producer history remain pinned; no question, vectors or permission payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "native_launch_job_id", "association_sha256", "payload", "checkpoint_sha256"],
  "properties": {
    "schema_version": {"const": "native-private-chat-query-coordinator/2.1"},
    "record_type": {"enum": ["ALLOCATION", "EXECUTED", "PUBLISHED", "COMPLETED"]},
    "native_launch_job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
    "association_sha256": {"$ref": "#/$defs/hash"},
    "checkpoint_sha256": {"$ref": "#/$defs/hash"},
    "payload": {"oneOf": [{"$ref": "#/$defs/allocation"}, {"$ref": "#/$defs/executed"}, {"$ref": "#/$defs/published"}, {"$ref": "#/$defs/completed"}]}
  },
  "allOf": [
    {"if": {"properties": {"record_type": {"const": "ALLOCATION"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/allocation"}}}},
    {"if": {"properties": {"record_type": {"const": "EXECUTED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/executed"}}}},
    {"if": {"properties": {"record_type": {"const": "PUBLISHED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/published"}}}},
    {"if": {"properties": {"record_type": {"const": "COMPLETED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/completed"}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "allocation": {"$ref": "eom://schemas/workflow/native-private-chat-query-coordinator/1.0#/$defs/allocation"},
    "executed": {
      "allOf": [
        {"$ref": "eom://schemas/workflow/native-reference-query-coordinator/1.2#/$defs/executed"},
        {"type": "object", "properties": {
          "child_ordinal": {"const": 0},
          "batch_receipt": {"type": "object", "properties": {
            "member_path": {"const": "receipt.json"},
            "schema_ref": {"const": "eom://schemas/workflow/embedding-batch-execution-receipt/1.1"},
            "media_type": {"const": "application/json"}
          }}
        }}
      ]
    },
    "published": {"$ref": "eom://schemas/workflow/native-private-chat-query-coordinator/2.0#/$defs/published"},
    "completed": {"$ref": "eom://schemas/workflow/native-private-chat-query-coordinator/2.0#/$defs/completed"}
  }
}
