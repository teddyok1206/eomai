{
  "$defs": {
    "ArtifactSpec": {
      "additionalProperties": false,
      "properties": {
        "file_name": {
          "const": "result.json",
          "type": "string"
        },
        "logical_artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "required": [
        "logical_artifact_id",
        "revision_id",
        "file_name",
        "media_type"
      ],
      "type": "object"
    },
    "KnowledgeRegistration": {
      "additionalProperties": false,
      "properties": {
        "result": {
          "const": "ready_for_registration",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "result",
        "summary"
      ],
      "type": "object"
    },
    "KnowledgeRegistrationOutput": {
      "additionalProperties": false,
      "properties": {
        "registration": {
          "$ref": "#/$defs/KnowledgeRegistration"
        }
      },
      "required": [
        "registration"
      ],
      "type": "object"
    }
  },
  "$id": "https://eom.local/schemas/workflow/roles/registration-result-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactSpec"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "job_id": {
      "pattern": "^job_[0-9a-f]{32}$",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/KnowledgeRegistrationOutput"
    },
    "protocol_version": {
      "const": "workflow-role/1.2.0",
      "type": "string"
    },
    "role": {
      "const": "item_management",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "status": {
      "const": "ok",
      "type": "string"
    },
    "step_run_id": {
      "pattern": "^steprun_[0-9a-f]{32}$",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^workflow_[0-9a-f]{32}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "job_id",
    "workflow_id",
    "step_run_id",
    "status",
    "artifact",
    "completed_at",
    "role",
    "output"
  ],
  "type": "object"
}
