{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/knowledge-item-brief-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "topic", "task_type", "difficulty", "choice_count", "equation_required", "image_required", "quality_profile", "original_request_sha256"],
  "properties": {
    "subject": {"type": "string", "minLength": 1, "maxLength": 80},
    "topic": {"type": "string", "minLength": 1, "maxLength": 160},
    "task_type": {"enum": ["calculation", "conceptual", "data_interpretation"]},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "choice_count": {"const": 5},
    "equation_required": {"const": true},
    "image_required": {"const": true},
    "quality_profile": {"enum": ["fast", "balanced", "deep"]},
    "original_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
