{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/private-chat-query-owner-configuration/1.0",
  "title": "Optional pinned private QUERY service selection; never source or execution authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_configuration_raw_sha256", "corpus_id", "namespace", "recipe", "source_classes", "native_execution_policy", "native_execution_policy_sha256", "runtime_bundle", "owner_environment_raw_sha256"],
  "properties": {
    "schema_version": {"const": "private-chat-query-owner-configuration/1.0"},
    "reference_configuration_raw_sha256": {"$ref": "#/$defs/hash"},
    "corpus_id": {"type": "string", "pattern": "^corpus_[0-9a-f]{32}$"},
    "namespace": {
      "allOf": [
        {"$ref": "eom://schemas/knowledge/embedding-registry/1.0#/$defs/namespace"},
        {"properties": {"view": {"const": "CONTENT_ONLY"}}}
      ]
    },
    "recipe": {"$ref": "eom://schemas/knowledge/item-inference-transfer-experiment/1.0#/$defs/recipe"},
    "source_classes": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["APPROVED_ITEM", "PAST_EXAM"]}},
    "native_execution_policy": {"$ref": "eom://schemas/workflow/private-chat-query-execution/1.0#/$defs/request/properties/native_execution_policy"},
    "native_execution_policy_sha256": {"$ref": "#/$defs/hash"},
    "runtime_bundle": {"$ref": "eom://schemas/knowledge/embedding-runtime-bundle/1.0#/$defs/bundlePointer"},
    "owner_environment_raw_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
