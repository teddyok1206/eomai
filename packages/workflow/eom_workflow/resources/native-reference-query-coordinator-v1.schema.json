{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/native-reference-query-coordinator/1.0",
  "title": "Native reference QUERY continuation metadata 1.0",
  "description": "Owner observations in existing Job history, not authority or a launch grant. No source text, vectors, credentials, filesystem paths or worker output bytes.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "native_launch_job_id", "association_sha256", "payload", "checkpoint_sha256"],
  "properties": {
    "schema_version": {"const": "native-reference-query-coordinator/1.0"},
    "record_type": {"enum": ["ALLOCATION", "EXECUTED", "PUBLISHED", "COMPLETED"]},
    "native_launch_job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
    "association_sha256": {"$ref": "#/$defs/hash"},
    "checkpoint_sha256": {"$ref": "#/$defs/hash"},
    "payload": {"oneOf": [{"$ref": "#/$defs/allocation"}, {"$ref": "#/$defs/executed"}, {"$ref": "#/$defs/published"}, {"$ref": "#/$defs/completed"}]}
  },
  "allOf": [
    {"if": {"properties": {"record_type": {"const": "ALLOCATION"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/allocation"}}}},
    {"if": {"properties": {"record_type": {"const": "EXECUTED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/executed"}}}},
    {"if": {"properties": {"record_type": {"const": "PUBLISHED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/published"}}}},
    {"if": {"properties": {"record_type": {"const": "COMPLETED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/completed"}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
    "producer": {"$ref": "eom://schemas/workflow/native-embedding-coordinator/1.0#/$defs/producer"},
    "member": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/artifactMember"},
    "allocation": {
      "type": "object", "additionalProperties": false,
      "required": ["query_producer", "receipt_producer", "created_at", "source_commit"],
      "properties": {
        "query_producer": {"$ref": "#/$defs/producer"},
        "receipt_producer": {"$ref": "#/$defs/producer"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "created_at": {"$ref": "#/$defs/utc"}
      }
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["invocation_id", "started_monotonic", "exited_monotonic"],
      "properties": {
        "invocation_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "started_monotonic": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "exited_monotonic": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      }
    },
    "executed": {
      "type": "object", "additionalProperties": false,
      "required": ["boot_id", "prepare", "query", "prepare_template_sha256", "query_template_sha256", "cpu_environment_sha256", "owner_environment_sha256", "result_sha256", "completed_observed_at"],
      "properties": {
        "boot_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "prepare": {"$ref": "#/$defs/unit"}, "query": {"$ref": "#/$defs/unit"},
        "prepare_template_sha256": {"const": "sha256:4194d01ea9cffbc5468aac5f5f174303952e1008f8a8621ad1adea07ef76905f"},
        "query_template_sha256": {"const": "sha256:1bd18e257988df4b3e39eb486e208b999ae7e9e897905ca07f513fc5f3e7893b"},
        "cpu_environment_sha256": {"$ref": "#/$defs/hash"},
        "owner_environment_sha256": {"$ref": "#/$defs/hash"},
        "result_sha256": {"$ref": "#/$defs/hash"},
        "completed_observed_at": {"$ref": "#/$defs/utc"}
      }
    },
    "published": {
      "type": "object", "additionalProperties": false,
      "required": ["query_owner_job_id", "input", "result", "shard", "binary", "manifest_sha256", "published_observed_at"],
      "properties": {
        "query_owner_job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
        "input": {"$ref": "#/$defs/member"}, "result": {"$ref": "#/$defs/member"},
        "shard": {"$ref": "#/$defs/member"}, "binary": {"$ref": "#/$defs/member"},
        "manifest_sha256": {"$ref": "#/$defs/hash"},
        "published_observed_at": {"$ref": "#/$defs/utc"}
      }
    },
    "completed": {
      "type": "object", "additionalProperties": false,
      "required": ["output"],
      "properties": {"output": {"$ref": "eom://schemas/workflow/reference-query-execution/1.0#/$defs/step-output"}}
    }
  }
}
