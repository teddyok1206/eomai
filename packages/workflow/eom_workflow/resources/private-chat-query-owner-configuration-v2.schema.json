{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/private-chat-query-owner-configuration/2.0",
  "title": "Pinned private QUERY2 over the common public Item corpus; never an authority grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_configuration_raw_sha256",
    "corpus_id",
    "namespace",
    "recipe",
    "source_classes",
    "native_execution_policy",
    "native_execution_policy_sha256",
    "runtime_bundle",
    "owner_environment_raw_sha256",
    "cuda_native_execution_policy",
    "cuda_native_execution_policy_sha256",
    "routing_policy",
    "routing_policy_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "private-chat-query-owner-configuration/2.0"
    },
    "reference_configuration_raw_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "corpus_id": {
      "type": "string",
      "pattern": "^corpus_[0-9a-f]{32}$"
    },
    "namespace": {
      "$ref": "eom://schemas/knowledge/public-solution-embedding-registry/3.0#/$defs/PublicSolutionIndexNamespace"
    },
    "recipe": {
      "$ref": "eom://schemas/knowledge/public-solution-embedding-entry/1.0#/$defs/recipe"
    },
    "source_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "APPROVED_ITEM",
          "PAST_EXAM"
        ]
      }
    },
    "native_execution_policy": {
      "allOf": [
        {
          "$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/artifactMember"
        },
        {
          "properties": {
            "member_path": {
              "const": "policy.json"
            },
            "schema_ref": {
              "const": "eom://schemas/workflow/private-chat-query-execution-policy/2.0"
            },
            "media_type": {
              "const": "application/json"
            }
          },
          "required": [
            "member_path",
            "schema_ref",
            "media_type"
          ]
        }
      ]
    },
    "native_execution_policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtime_bundle": {
      "$ref": "eom://schemas/knowledge/embedding-runtime-bundle/1.0#/$defs/bundlePointer"
    },
    "owner_environment_raw_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cuda_native_execution_policy": {
      "allOf": [
        {
          "$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/artifactMember"
        },
        {
          "properties": {
            "member_path": {
              "const": "policy.json"
            },
            "schema_ref": {
              "const": "eom://schemas/workflow/private-chat-query-execution-policy/2.0"
            },
            "media_type": {
              "const": "application/json"
            }
          },
          "required": [
            "member_path",
            "schema_ref",
            "media_type"
          ]
        }
      ]
    },
    "cuda_native_execution_policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "routing_policy": {
      "allOf": [
        {
          "$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/artifactMember"
        },
        {
          "properties": {
            "member_path": {
              "const": "policy.json"
            },
            "schema_ref": {
              "const": "eom://schemas/workflow/embedding-device-routing/1.0"
            },
            "media_type": {
              "const": "application/json"
            }
          },
          "required": [
            "member_path",
            "schema_ref",
            "media_type"
          ]
        }
      ]
    },
    "routing_policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
