{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/review-rework-directive/1.0",
  "title": "Workflow Review Rework Directive V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_rework_cycle_count",
    "max_rework_cycles",
    "outcome",
    "prior_authoring",
    "source_review",
    "verified_blocking_finding_codes",
    "repairable_finding_codes",
    "human_required_finding_codes",
    "disregarded_finding_codes",
    "decision_sha256"
  ],
  "properties": {
    "schema_version": {"const": "workflow-review-rework-directive/1.0"},
    "observed_rework_cycle_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "max_rework_cycles": {"const": 3},
    "outcome": {
      "enum": ["READY_FOR_HUMAN", "REWORK_AUTHORING", "HUMAN_REVIEW_REQUIRED"]
    },
    "prior_authoring": {"$ref": "#/$defs/authoringPointer"},
    "source_review": {"$ref": "#/$defs/reviewPointer"},
    "verified_blocking_finding_codes": {"$ref": "#/$defs/findingCodes"},
    "repairable_finding_codes": {"$ref": "#/$defs/findingCodes"},
    "human_required_finding_codes": {"$ref": "#/$defs/findingCodes"},
    "disregarded_finding_codes": {"$ref": "#/$defs/findingCodes"},
    "decision_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "findingCodes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
    },
    "basePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_key",
        "attempt",
        "job_id",
        "logical_artifact_id",
        "revision_id",
        "content_hash",
        "result_schema"
      ],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1, "maximum": 10},
        "job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
        "logical_artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "step_key": {"type": "string"},
        "result_schema": {"type": "string"}
      }
    },
    "authoringPointer": {
      "allOf": [
        {"$ref": "#/$defs/basePointer"},
        {
          "properties": {
            "step_key": {"const": "authoring"},
            "result_schema": {"const": "authoring-result@11.0"}
          }
        }
      ]
    },
    "reviewPointer": {
      "allOf": [
        {"$ref": "#/$defs/basePointer"},
        {
          "properties": {
            "step_key": {"const": "review"},
            "result_schema": {"const": "review-result@11.0"}
          }
        }
      ]
    }
  }
}
