{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/embedding-batch-plan/1.7",
  "title": "Owned private Chat question over the common Item corpus",
  "description": "Source-selection metadata, not authority or a native allocation. No approved Item anchor, question text, runtime path, worker role or new queue. One original question creates at most one numerical child. INDEX1.6 and all predecessors remain immutable.",
  "oneOf": [
    {
      "$ref": "#/$defs/selection"
    },
    {
      "$ref": "#/$defs/request"
    }
  ],
  "$defs": {
    "queryOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_purpose",
        "context_request_id",
        "maximum_sources",
        "top_k"
      ],
      "properties": {
        "consumer_purpose": {
          "const": "GENERAL_CHAT_READ"
        },
        "context_request_id": {
          "type": "string",
          "pattern": "^similarityrequest_[0-9a-f]{32}$"
        },
        "maximum_sources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "indexPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "cuda"
      ],
      "properties": {
        "cpu": {
          "$ref": "eom://schemas/knowledge/system-rag-private-chat-similarity/2.0#/$defs/view"
        },
        "cuda": {
          "allOf": [
            {
              "$ref": "eom://schemas/knowledge/system-rag-private-chat-similarity/2.0#/$defs/view"
            },
            {
              "properties": {
                "index": {
                  "$ref": "eom://schemas/knowledge/public-solution-similarity/4.0#/$defs/indexPin"
                }
              }
            }
          ]
        }
      }
    },
    "policyPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member",
        "policy_sha256"
      ],
      "properties": {
        "member": {
          "allOf": [
            {
              "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/member"
            },
            {
              "properties": {
                "member_path": {
                  "const": "policy.json"
                },
                "schema_ref": {
                  "const": "eom://schemas/workflow/private-chat-query-execution-policy/2.0"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        },
        "policy_sha256": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
        }
      }
    },
    "privatePolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "cuda"
      ],
      "properties": {
        "cpu": {
          "$ref": "#/$defs/policyPin"
        },
        "cuda": {
          "$ref": "#/$defs/policyPin"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "purpose",
        "scope",
        "corpus_id",
        "graph_snapshot",
        "access_policy_revision_id",
        "origin",
        "recipe",
        "views",
        "query",
        "source_classes",
        "index_pair",
        "private_policies",
        "selection_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "embedding-batch-plan/1.7"
        },
        "message_type": {
          "const": "SELECTION"
        },
        "purpose": {
          "const": "PRIVATE_CHAT_QUERY"
        },
        "scope": {
          "allOf": [
            {
              "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/scope"
            },
            {
              "properties": {
                "actor_kind": {
                  "const": "OPERATOR"
                }
              }
            }
          ]
        },
        "corpus_id": {
          "type": "string",
          "pattern": "^corpus_[0-9a-f]{32}$"
        },
        "graph_snapshot": {
          "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/graphSnapshotPointer"
        },
        "access_policy_revision_id": {
          "type": "string",
          "pattern": "^accessrev_[0-9a-f]{32}$"
        },
        "origin": {
          "$ref": "eom://schemas/knowledge/general-chat-private-query-read/1.0#/$defs/origin"
        },
        "recipe": {
          "$ref": "eom://schemas/knowledge/public-solution-embedding-entry/1.0#/$defs/recipe"
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "CONCRETE_FACETS"
          }
        },
        "query": {
          "$ref": "#/$defs/queryOptions"
        },
        "source_classes": {
          "$ref": "eom://schemas/knowledge/system-rag-private-chat-similarity/2.0#/$defs/request/properties/source_classes"
        },
        "index_pair": {
          "$ref": "#/$defs/indexPair"
        },
        "private_policies": {
          "$ref": "#/$defs/privatePolicies"
        },
        "selection_sha256": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "purpose",
        "scope",
        "batch_id",
        "parent_request_sha256",
        "selection_manifest",
        "selection_sha256",
        "routing_policy",
        "routing_policy_sha256",
        "child_selection_sha256s",
        "request_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "embedding-batch-plan/1.7"
        },
        "message_type": {
          "const": "REQUEST"
        },
        "purpose": {
          "const": "PRIVATE_CHAT_QUERY"
        },
        "scope": {
          "allOf": [
            {
              "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/scope"
            },
            {
              "properties": {
                "actor_kind": {
                  "const": "OPERATOR"
                }
              }
            }
          ]
        },
        "batch_id": {
          "type": "string",
          "pattern": "^embeddingbatch_[0-9a-f]{32}$"
        },
        "parent_request_sha256": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
        },
        "selection_manifest": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/member"
        },
        "selection_sha256": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
        },
        "routing_policy": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/member"
        },
        "routing_policy_sha256": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
        },
        "child_selection_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
          }
        },
        "request_sha256": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
        }
      }
    }
  }
}
