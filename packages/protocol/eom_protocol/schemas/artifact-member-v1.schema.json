{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/artifact-member/1.0",
  "title": "ArtifactMemberPointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_revision_id",
    "member_path",
    "schema_ref",
    "media_type",
    "sha256"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{32}$"
    },
    "artifact_revision_id": {
      "type": "string",
      "pattern": "^rev_[0-9a-f]{32}$"
    },
    "member_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\u0000)[^/]+(?:/[^/]+)*$"
    },
    "schema_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
