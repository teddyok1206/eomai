{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eom.local/protocol/1.0.1/artifact-manifest.schema.json",
  "title": "EOM ArtifactManifest 1.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "manifest_version", "job_id", "logical_artifact_id", "revision_id", "content_hash", "content_bytes", "file_name", "media_type", "worker_slot", "created_at"],
  "properties": {
    "protocol_version": {"type": "string", "const": "1.0.1"},
    "manifest_version": {"type": "string", "const": "1.0.0"},
    "job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
    "logical_artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
    "revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "content_bytes": {"type": "integer", "minimum": 1},
    "file_name": {"type": "string", "const": "result.json"},
    "media_type": {"type": "string", "const": "application/json"},
    "worker_slot": {"type": "string", "pattern": "^[0-9]{2}$"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
