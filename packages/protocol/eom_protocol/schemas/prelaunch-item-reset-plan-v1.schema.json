{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/operations/prelaunch-item-reset-plan/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "database", "item_ids", "item_revision_ids", "workflow_ids", "job_ids", "graph_pins", "protected_sha256", "baseline_sha256", "backup", "created_at_utc", "plan_sha256"],
  "properties": {
    "schema_version": {"const": "prelaunch-item-reset-plan/1.0"},
    "scope": {"const": "AI_PRELAUNCH_20261028"},
    "database": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"},
    "item_ids": {"type": "array", "minItems": 110, "maxItems": 110, "uniqueItems": true, "items": {"type": "string", "pattern": "^item_[0-9a-f]{32}$"}},
    "item_revision_ids": {"type": "array", "minItems": 111, "maxItems": 111, "uniqueItems": true, "items": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"}},
    "workflow_ids": {"type": "array", "minItems": 170, "maxItems": 2500, "uniqueItems": true, "items": {"type": "string", "pattern": "^workflow_[0-9a-f]{32}$"}},
    "job_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"}},
    "graph_pins": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["revision_id", "sha256"], "properties": {"revision_id": {"type": "string", "pattern": "^graphrev_[0-9a-f]{32}$"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "protected_sha256": {"$ref": "#/$defs/hash"},
    "baseline_sha256": {"$ref": "#/$defs/hash"},
    "backup": {"type": "object", "additionalProperties": false, "required": ["file_name", "sha256", "size_bytes"], "properties": {"file_name": {"type": "string", "pattern": "^eom_[0-9]{8}T[0-9]{6}Z_[0-9a-f]{12}\\.dump$"}, "sha256": {"$ref": "#/$defs/hash"}, "size_bytes": {"type": "integer", "minimum": 1}}},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "plan_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
