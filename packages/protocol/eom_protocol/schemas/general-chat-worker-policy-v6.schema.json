{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/general-chat/worker-policy/6.0",
  "title": "Per-turn administrator model settings with unchanged isolated native runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "native_profile",
    "native_runtime",
    "prompt_revision",
    "prompt_sha256",
    "grounded_prompt_sha256",
    "agent_prompt_sha256",
    "rag_prompt_sha256",
    "reasoning_effort",
    "model_settings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "general-chat-worker-policy/6.0"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "native_profile": {
      "type": "string",
      "const": "codex-app-server/environment-free/2.0"
    },
    "native_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_version",
        "cli_launcher_sha256",
        "cli_binary_sha256"
      ],
      "properties": {
        "cli_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "cli_launcher_sha256": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cli_binary_sha256": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "prompt_revision": {
      "type": "string",
      "const": "general-chat/1.0.0"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "grounded_prompt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "agent_prompt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rag_prompt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reasoning_effort": {
      "enum": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "model_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "sha256"
      ],
      "properties": {
        "revision_id": {
          "type": "string",
          "pattern": "^chatmodelrev_[0-9a-f]{32}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
