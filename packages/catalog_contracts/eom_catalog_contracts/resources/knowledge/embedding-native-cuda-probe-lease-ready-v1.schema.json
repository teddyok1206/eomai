{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/embedding-native-cuda-probe-lease-ready/1.0",
  "title": "Pre-initialization untrusted lease readiness; not store acceptance or CUDA admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_state",
    "configuration",
    "fdstore_name",
    "execution_id",
    "input_raw_sha256",
    "pid",
    "start_time_ticks",
    "worker_uid",
    "worker_gid",
    "supplementary_gids",
    "payload_file_set_sha256",
    "resource_fds",
    "expected_device_capture",
    "cuda_initialization_calls",
    "cuda_synchronize_calls",
    "model_constructor_calls",
    "tokenizer_constructor_calls",
    "forward_calls"
  ],
  "properties": {
    "schema_version": {
      "const": "embedding-native-cuda-probe-lease-ready/1.0"
    },
    "evidence_state": {
      "const": "RETENTION_REQUESTED_NOT_CUDA_ADMITTED"
    },
    "configuration": {
      "$ref": "eom://schemas/knowledge/embedding-native-cuda-probe/1.0#/$defs/configurationPin"
    },
    "fdstore_name": {
      "const": "eom-gpu0-lease"
    },
    "execution_id": {
      "$ref": "eom://schemas/knowledge/embedding-native-cuda-probe/1.0#/$defs/result/properties/execution_id"
    },
    "input_raw_sha256": {
      "$ref": "eom://schemas/knowledge/embedding-native-cuda-probe/1.0#/$defs/result/properties/input_raw_sha256"
    },
    "pid": {
      "$ref": "eom://schemas/knowledge/embedding-native-cuda-probe/1.0#/$defs/result/properties/pid"
    },
    "start_time_ticks": {
      "$ref": "eom://schemas/knowledge/embedding-native-cuda-probe/1.0#/$defs/result/properties/start_time_ticks"
    },
    "worker_uid": {
      "$ref": "eom://schemas/knowledge/embedding-native-cuda-probe/1.0#/$defs/result/properties/worker_uid"
    },
    "worker_gid": {
      "$ref": "eom://schemas/knowledge/embedding-native-cuda-probe/1.0#/$defs/result/properties/worker_gid"
    },
    "supplementary_gids": {
      "$ref": "eom://schemas/knowledge/embedding-native-cuda-probe/1.0#/$defs/result/properties/supplementary_gids"
    },
    "payload_file_set_sha256": {
      "$ref": "eom://schemas/knowledge/embedding-native-cuda-probe/1.0#/$defs/result/properties/payload_file_set_sha256"
    },
    "resource_fds": {
      "$ref": "eom://schemas/knowledge/embedding-native-cuda-probe/1.0#/$defs/result/properties/resource_fds"
    },
    "expected_device_capture": {
      "$ref": "eom://schemas/knowledge/embedding-installed-runtime-proof/1.0#/$defs/cudaDeviceCapture"
    },
    "cuda_initialization_calls": {
      "type": "integer",
      "const": 0
    },
    "cuda_synchronize_calls": {
      "type": "integer",
      "const": 0
    },
    "model_constructor_calls": {
      "type": "integer",
      "const": 0
    },
    "tokenizer_constructor_calls": {
      "type": "integer",
      "const": 0
    },
    "forward_calls": {
      "type": "integer",
      "const": 0
    }
  }
}
