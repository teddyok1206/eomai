{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/item-inference-transfer-metadata/1.0",
  "title": "Exact authorized inference-transfer Graph metadata resolution V1",
  "description": "Known pins only. The full Graph manifest pointer is metadata, not an authorization token or proof that Item content was read. Semantic snapshot hash and raw manifest member hash remain distinct.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "inference-transfer-metadata-request/1.0"
        },
        "graph_snapshot_revision_id": {
          "type": "string",
          "pattern": "^graphrev_[0-9a-f]{32}$"
        },
        "expected_snapshot_sha256": {
          "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
        },
        "access_policy_revision_id": {
          "type": "string",
          "pattern": "^accessrev_[0-9a-f]{32}$"
        },
        "access_policy_sha256": {
          "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
        },
        "source_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "APPROVED_ITEM",
              "PAST_EXAM"
            ]
          }
        },
        "request_sha256": {
          "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "graph_snapshot_revision_id",
        "expected_snapshot_sha256",
        "access_policy_revision_id",
        "access_policy_sha256",
        "source_classes",
        "request_sha256"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "inference-transfer-metadata-result/1.0"
        },
        "request_sha256": {
          "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
        },
        "graph_snapshot": {
          "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/graphSnapshotPointer"
        },
        "snapshot_sha256": {
          "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
        },
        "access_policy_revision_id": {
          "type": "string",
          "pattern": "^accessrev_[0-9a-f]{32}$"
        },
        "access_policy_sha256": {
          "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
        },
        "source_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "APPROVED_ITEM",
              "PAST_EXAM"
            ]
          }
        },
        "result_sha256": {
          "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "request_sha256",
        "graph_snapshot",
        "snapshot_sha256",
        "access_policy_revision_id",
        "access_policy_sha256",
        "source_classes",
        "result_sha256"
      ]
    },
    "bindingRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "inference-transfer-metadata-binding-request/1.0"
        },
        "operation": {
          "const": "INFERENCE_TRANSFER_METADATA_RESOLVE"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^operator_[0-9a-f]{32}$"
        },
        "request": {
          "$ref": "#/$defs/request"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "actor_id",
        "request"
      ]
    },
    "bindingReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "inference-transfer-metadata-binding-reply/1.0"
        },
        "operation": {
          "const": "INFERENCE_TRANSFER_METADATA_RESOLVE"
        },
        "status": {
          "enum": [
            "SUCCESS",
            "FAILED"
          ]
        },
        "actor_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^operator_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_sha256": {
          "anyOf": [
            {
              "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/result"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "INFERENCE_TRANSFER_FORBIDDEN",
                "INFERENCE_TRANSFER_METADATA_NOT_FOUND",
                "INFERENCE_TRANSFER_METADATA_PIN_MISMATCH",
                "INFERENCE_TRANSFER_METADATA_POLICY_INVALID",
                "INFERENCE_TRANSFER_METADATA_REQUEST_INVALID",
                "INFERENCE_TRANSFER_METADATA_UNAVAILABLE",
                "INFERENCE_TRANSFER_METADATA_BUDGET_EXCEEDED"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "operation",
        "status",
        "actor_id",
        "request_sha256",
        "result",
        "error_code"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUCCESS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "actor_id": {
                "type": "string",
                "pattern": "^operator_[0-9a-f]{32}$"
              },
              "request_sha256": {
                "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
              },
              "result": {
                "$ref": "#/$defs/result"
              },
              "error_code": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "result": {
                "type": "null"
              },
              "error_code": {
                "enum": [
                  "INFERENCE_TRANSFER_FORBIDDEN",
                  "INFERENCE_TRANSFER_METADATA_NOT_FOUND",
                  "INFERENCE_TRANSFER_METADATA_PIN_MISMATCH",
                  "INFERENCE_TRANSFER_METADATA_POLICY_INVALID",
                  "INFERENCE_TRANSFER_METADATA_REQUEST_INVALID",
                  "INFERENCE_TRANSFER_METADATA_UNAVAILABLE",
                  "INFERENCE_TRANSFER_METADATA_BUDGET_EXCEEDED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "actor_id": {
                "type": "null"
              }
            },
            "required": [
              "actor_id"
            ]
          },
          "then": {
            "properties": {
              "request_sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "request_sha256": {
                "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/bindingRequest"
    },
    {
      "$ref": "#/$defs/bindingReply"
    }
  ]
}
