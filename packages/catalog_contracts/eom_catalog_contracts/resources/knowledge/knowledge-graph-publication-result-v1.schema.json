{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/knowledge-graph-publication-result/1.0",
  "title": "Knowledge Graph Publication Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication_id",
    "corpus_id",
    "corpus_key",
    "corpus_revision_id",
    "graph_snapshot",
    "revision_number",
    "state",
    "counts",
    "request_sha256",
    "published_at",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "knowledge-graph-publication-result/1.0"},
    "publication_id": {"type": "string", "pattern": "^graphpub_[0-9a-f]{32}$"},
    "corpus_id": {"type": "string", "pattern": "^corpus_[0-9a-f]{32}$"},
    "corpus_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "corpus_revision_id": {"type": "string", "pattern": "^corpusrev_[0-9a-f]{32}$"},
    "graph_snapshot": {
      "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/graphSnapshotPointer"
    },
    "revision_number": {"type": "integer", "minimum": 1},
    "state": {"const": "PUBLISHED"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revisions", "nodes", "edges", "anchors"],
      "properties": {
        "source_revisions": {"type": "integer", "minimum": 1, "maximum": 10000},
        "nodes": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "edges": {"type": "integer", "minimum": 0, "maximum": 50000000},
        "anchors": {"type": "integer", "minimum": 1, "maximum": 20000000}
      }
    },
    "request_sha256": {
      "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
    },
    "published_at": {
      "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/utcTimestamp"
    },
    "result_sha256": {
      "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
    }
  }
}
