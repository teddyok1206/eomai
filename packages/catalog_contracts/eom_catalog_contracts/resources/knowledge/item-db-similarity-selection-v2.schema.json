{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/item-db-similarity-selection/2.0",
  "title": "Ordered DB source list resolved to one existing public QUERY scope",
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "operation", "actor_id", "operation_id", "idempotency_key", "selections", "top_k", "pinned_query"],
      "properties": {
        "schema_version": {"const": "item-db-similarity-selection-request/2.0"},
        "operation": {"const": "RESOLVE_ITEM_DB_SIMILARITY_LIST"},
        "actor_id": {"type": "string", "pattern": "^operator_[0-9a-f]{32}$"},
        "operation_id": {"type": "string", "pattern": "^queryprepare_[0-9a-f]{32}$"},
        "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]{8,128}$"},
        "selections": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "eom://schemas/knowledge/item-db-similarity-selection/1.0#/$defs/selection"}},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 64},
        "pinned_query": {"anyOf": [{"$ref": "eom://schemas/knowledge/system-rag-reference-query-prepare/4.0#/$defs/request"}, {"type": "null"}]}
      }
    },
    "prepared": {
      "type": "object", "additionalProperties": false,
      "required": ["selection_sha256", "anchors", "query", "search_snapshot_sha256"],
      "properties": {
        "selection_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "anchors": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "eom://schemas/knowledge/item-db-similarity-selection/1.0#/$defs/itemPin"}},
        "query": {"$ref": "eom://schemas/knowledge/system-rag-reference-query-prepare/4.0#/$defs/request"},
        "search_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "reply": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "operation", "status", "actor_id", "request_sha256", "result", "error_code"],
      "properties": {
        "schema_version": {"const": "item-db-similarity-selection-reply/2.0"},
        "operation": {"const": "RESOLVE_ITEM_DB_SIMILARITY_LIST"},
        "status": {"enum": ["READY", "UNAVAILABLE", "FAILED"]},
        "actor_id": {"anyOf": [{"type": "string", "pattern": "^operator_[0-9a-f]{32}$"}, {"type": "null"}]},
        "request_sha256": {"anyOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
        "result": {"anyOf": [{"$ref": "#/$defs/prepared"}, {"type": "null"}]},
        "error_code": {"$ref": "eom://schemas/knowledge/item-db-similarity-selection/1.0#/$defs/reply/properties/error_code"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "READY"}}}, "then": {"properties": {"result": {"$ref": "#/$defs/prepared"}, "error_code": {"type": "null"}}}, "else": {"properties": {"result": {"type": "null"}, "error_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}}}}
      ]
    }
  },
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/prepared"}, {"$ref": "#/$defs/reply"}]
}
