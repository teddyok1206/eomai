{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/knowledge-analysis-batch-request/1.2",
  "title": "Knowledge Analysis Batch Request V1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preset_key",
    "general_knowledge_mode",
    "risk_policy_revision_id",
    "review_policy",
    "range_failure_policy",
    "ranges"
  ],
  "properties": {
    "schema_version": {"const": "knowledge-analysis-batch-request/1.2"},
    "preset_key": {"const": "knowledge-analysis"},
    "general_knowledge_mode": {"const": "AUXILIARY_UNATTRIBUTED"},
    "risk_policy_revision_id": {
      "type": "string",
      "pattern": "^analysisriskrev_[0-9a-f]{32}$"
    },
    "review_policy": {"const": "PREAUTHORIZED_APPROVE_VALIDATED"},
    "range_failure_policy": {"const": "CONTINUE_AND_COLLECT"},
    "ranges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/range"}
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "source", "execution"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 999},
        "source": {"$ref": "#/$defs/source"},
        "execution": {
          "oneOf": [
            {"$ref": "#/$defs/execute"},
            {"$ref": "#/$defs/reuseAccepted"}
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_class",
        "document_revision_id",
        "first_physical_page",
        "last_physical_page",
        "curriculum_unit_keys"
      ],
      "properties": {
        "source_kind": {"const": "DOCUMENT_REVISION"},
        "source_class": {"const": "TEXTBOOK"},
        "document_revision_id": {
          "type": "string",
          "pattern": "^edudocrev_[0-9a-f]{32}$"
        },
        "first_physical_page": {"type": "integer", "minimum": 1, "maximum": 10000},
        "last_physical_page": {"type": "integer", "minimum": 1, "maximum": 10000},
        "curriculum_unit_keys": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(1-\\([1-4]\\)|2-\\([1-6]\\)|3-\\([1-7]\\)|4-\\([1-7]\\)|5-\\([1-7]\\)|6-\\([1-4]\\))$"
          }
        }
      }
    },
    "execute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "predecessor_analysis_run_id"],
      "properties": {
        "mode": {"const": "EXECUTE"},
        "predecessor_analysis_run_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^analysisrun_[0-9a-f]{32}$"}
          ]
        }
      }
    },
    "reuseAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "accepted_analysis_run_id"],
      "properties": {
        "mode": {"const": "REUSE_ACCEPTED"},
        "accepted_analysis_run_id": {
          "type": "string",
          "pattern": "^analysisrun_[0-9a-f]{32}$"
        }
      }
    }
  }
}
