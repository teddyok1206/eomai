{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/create-material-knowledge-analysis/1.0",
  "title": "EOM create uploaded material document knowledge analysis",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation": {
      "const": "CREATE_MATERIAL_KNOWLEDGE_ANALYSIS"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "const": "DOCUMENT_REVISION"
        },
        "source_class": {
          "enum": [
            "TEXTBOOK",
            "INTERNAL_GUIDE"
          ]
        },
        "document_revision_id": {
          "type": "string",
          "pattern": "^edudocrev_[0-9a-f]{32}$"
        },
        "first_physical_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "last_physical_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "selected_regions": {
          "type": "array",
          "items": {
            "$ref": "eom://schemas/material-learning/types/1.0#/$defs/region"
          },
          "minItems": 1,
          "maxItems": 128
        },
        "curriculum_unit_keys": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(1-\\([1-4]\\)|2-\\([1-6]\\)|3-\\([1-7]\\)|4-\\([1-7]\\)|5-\\([1-7]\\)|6-\\([1-4]\\))$"
          }
        }
      },
      "required": [
        "source_kind",
        "source_class",
        "document_revision_id",
        "first_physical_page",
        "last_physical_page",
        "selected_regions",
        "curriculum_unit_keys"
      ]
    },
    "preset_key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "general_knowledge_mode": {
      "const": "DISABLED"
    },
    "risk_policy_revision_id": {
      "type": "string",
      "pattern": "^analysisriskrev_[0-9a-f]{32}$"
    },
    "predecessor_analysis_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^analysisrun_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.:-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]+$"
    }
  },
  "required": [
    "operation",
    "source",
    "preset_key",
    "general_knowledge_mode",
    "risk_policy_revision_id",
    "predecessor_analysis_run_id",
    "requested_by",
    "idempotency_key"
  ]
}
