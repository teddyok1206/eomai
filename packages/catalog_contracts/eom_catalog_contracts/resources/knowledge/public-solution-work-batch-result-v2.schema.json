{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/embedding-work-batch-result/2.0",
  "title": "Finite public-solution QUERY2 work batch result",
  "description": "Ordered local QUERY2 child results, not success publication. Native owner validates actual execution and input closure before each canonical commit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "request_sha256",
    "routing_decision_sha256",
    "children",
    "vectors",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "embedding-work-batch-result/2.0"
    },
    "purpose": {
      "const": "REFERENCE_QUERY"
    },
    "request_sha256": {
      "$ref": "eom://schemas/knowledge/embedding-work-batch-input/1.0#/$defs/hash"
    },
    "routing_decision_sha256": {
      "$ref": "eom://schemas/knowledge/embedding-work-batch-input/1.0#/$defs/hash"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/child"
      }
    },
    "vectors": {
      "$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/binary"
    },
    "result_sha256": {
      "$ref": "eom://schemas/knowledge/embedding-work-batch-input/1.0#/$defs/hash"
    }
  },
  "$defs": {
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vector_offset",
        "result"
      ],
      "properties": {
        "vector_offset": {
          "$ref": "eom://schemas/knowledge/embedding-work-batch-result/1.0#/$defs/child/properties/vector_offset"
        },
        "result": {
          "$ref": "eom://schemas/knowledge/public-solution-query/2.0#/$defs/PublicSolutionQueryResult"
        }
      }
    }
  }
}
