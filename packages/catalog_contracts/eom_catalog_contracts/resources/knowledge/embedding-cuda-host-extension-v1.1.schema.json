{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/embedding-cuda-host-extension/1.1",
  "title": "Closed private CUDA host extension V1.1 with NVML",
  "description": "Immutable root-local metadata, not an executable host, GPU, model, kernel, unit, policy or lease grant. Preserve the unchanged base CPU snapshot and separately admit actual bytes, resolution, mappings and devices.",
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "configuration_id",
        "configuration_revision_id",
        "captured_at",
        "base_configuration",
        "base_host_seed_sha256",
        "driver_release",
        "libraries",
        "loader_cache",
        "host_seed_sha256",
        "snapshot_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "embedding-cuda-host-extension/1.1"
        },
        "configuration_id": {
          "type": "string",
          "pattern": "^embeddingcudahost_[0-9a-f]{32}$"
        },
        "configuration_revision_id": {
          "type": "string",
          "pattern": "^embeddingcudahostrev_[0-9a-f]{32}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        },
        "base_configuration": {
          "$ref": "eom://schemas/knowledge/embedding-host-configuration-snapshot/1.0#/$defs/pointer"
        },
        "base_host_seed_sha256": {
          "$ref": "#/$defs/sha"
        },
        "driver_release": {
          "type": "string",
          "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"
        },
        "libraries": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "member_name",
                "byte_count",
                "sha256"
              ],
              "properties": {
                "role": {
                  "const": "CUDA_DRIVER"
                },
                "member_name": {
                  "const": "libcuda.so.1"
                },
                "byte_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 134217728
                },
                "sha256": {
                  "$ref": "#/$defs/sha"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "member_name",
                "byte_count",
                "sha256"
              ],
              "properties": {
                "role": {
                  "const": "RDMACM"
                },
                "member_name": {
                  "const": "librdmacm.so.1"
                },
                "byte_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8388608
                },
                "sha256": {
                  "$ref": "#/$defs/sha"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "member_name",
                "byte_count",
                "sha256"
              ],
              "properties": {
                "role": {
                  "const": "IBVERBS"
                },
                "member_name": {
                  "const": "libibverbs.so.1"
                },
                "byte_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8388608
                },
                "sha256": {
                  "$ref": "#/$defs/sha"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "member_name",
                "byte_count",
                "sha256"
              ],
              "properties": {
                "role": {
                  "const": "MLX5"
                },
                "member_name": {
                  "const": "libmlx5.so.1"
                },
                "byte_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8388608
                },
                "sha256": {
                  "$ref": "#/$defs/sha"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "member_name",
                "byte_count",
                "sha256"
              ],
              "properties": {
                "role": {
                  "const": "NL_CORE"
                },
                "member_name": {
                  "const": "libnl-3.so.200"
                },
                "byte_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8388608
                },
                "sha256": {
                  "$ref": "#/$defs/sha"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "member_name",
                "byte_count",
                "sha256"
              ],
              "properties": {
                "role": {
                  "const": "NL_ROUTE"
                },
                "member_name": {
                  "const": "libnl-route-3.so.200"
                },
                "byte_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8388608
                },
                "sha256": {
                  "$ref": "#/$defs/sha"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "member_name",
                "byte_count",
                "sha256"
              ],
              "properties": {
                "role": {
                  "const": "CUDA_NVML"
                },
                "member_name": {
                  "const": "libnvidia-ml.so.1"
                },
                "byte_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8388608
                },
                "sha256": {
                  "$ref": "#/$defs/sha"
                }
              }
            }
          ],
          "items": false
        },
        "loader_cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "member_name",
            "byte_count",
            "sha256"
          ],
          "properties": {
            "role": {
              "const": "LD_SO_CACHE"
            },
            "member_name": {
              "const": "ld.so.cache"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 48,
              "maximum": 131072
            },
            "sha256": {
              "$ref": "#/$defs/sha"
            }
          }
        },
        "host_seed_sha256": {
          "$ref": "#/$defs/sha"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "configuration_id",
        "configuration_revision_id",
        "manifest_byte_count",
        "manifest_raw_sha256",
        "snapshot_sha256"
      ],
      "properties": {
        "schema_ref": {
          "const": "eom://schemas/knowledge/embedding-cuda-host-extension/1.1#/$defs/snapshot"
        },
        "configuration_id": {
          "type": "string",
          "pattern": "^embeddingcudahost_[0-9a-f]{32}$"
        },
        "configuration_revision_id": {
          "type": "string",
          "pattern": "^embeddingcudahostrev_[0-9a-f]{32}$"
        },
        "manifest_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "manifest_raw_sha256": {
          "$ref": "#/$defs/sha"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/pointer"
    }
  ]
}
