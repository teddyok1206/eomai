{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/education-retrieval-access-policy/1.2",
  "title": "EOM mixed-projection local indexing data policy; not runtime authentication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "access_policy_revision_id", "state", "purpose", "service",
    "runtime_configuration_sha256", "source_access_policy_revision_id",
    "source_access_policy_sha256", "corpus_id", "graph_id", "source_classes",
    "namespaces", "space", "recipe", "native_execution_policy_sha256",
    "resource_profile_sha256", "maximum_sources", "answer_bearing_use", "created_at",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "education-retrieval-access-policy/1.2"},
    "access_policy_revision_id": {"type": "string", "pattern": "^accessrev_[0-9a-f]{32}$"},
    "state": {"const": "RELEASED"},
    "purpose": {"const": "LOCAL_EMBEDDING_INDEX"},
    "service": {"$ref": "#/$defs/serviceReference"},
    "runtime_configuration_sha256": {"$ref": "#/$defs/hash"},
    "source_access_policy_revision_id": {"type": "string", "pattern": "^accessrev_[0-9a-f]{32}$"},
    "source_access_policy_sha256": {"$ref": "#/$defs/hash"},
    "corpus_id": {"type": "string", "pattern": "^corpus_[0-9a-f]{32}$"},
    "graph_id": {"type": "string", "pattern": "^graph_[0-9a-f]{32}$"},
    "source_classes": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["APPROVED_ITEM", "PAST_EXAM"]}
    },
    "namespaces": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": {"$ref": "eom://schemas/knowledge/embedding-registry/2.0#/$defs/namespace"}
    },
    "space": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/space"},
    "recipe": {"$ref": "eom://schemas/knowledge/item-inference-transfer-experiment/1.0#/$defs/recipe"},
    "native_execution_policy_sha256": {"$ref": "#/$defs/hash"},
    "resource_profile_sha256": {"$ref": "#/$defs/hash"},
    "maximum_sources": {"type": "integer", "minimum": 1, "maximum": 1024},
    "answer_bearing_use": {"const": "ACCEPTED_SOLUTION_OR_REGISTERED_REVIEW_PROJECTION_ONLY"},
    "created_at": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/utcTimestamp"},
    "content_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "serviceReference": {
      "type": "object", "additionalProperties": false,
      "required": ["service_id", "service_revision_id", "service_identity_sha256"],
      "properties": {
        "service_id": {"type": "string", "pattern": "^localindexservice_[0-9a-f]{32}$"},
        "service_revision_id": {"type": "string", "pattern": "^localindexservicerev_[0-9a-f]{32}$"},
        "service_identity_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
