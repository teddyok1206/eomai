{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/education-retrieval-access-policy/1.0",
  "title": "EOM Education Retrieval Access Policy V1",
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_documents", "max_item_revisions", "max_graph_nodes", "max_claims", "max_context_tokens"],
      "properties": {
        "max_documents": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_item_revisions": {"type": "integer", "minimum": 0, "maximum": 64},
        "max_graph_nodes": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_claims": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_context_tokens": {"type": "integer", "minimum": 1000, "maximum": 32000}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "access_policy_revision_id",
    "state",
    "allowed_query_kinds",
    "allowed_requester_roles",
    "allowed_source_classes",
    "answer_bearing_roles",
    "maximum_budget",
    "created_at",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "education-retrieval-access-policy/1.0"},
    "access_policy_revision_id": {"type": "string", "pattern": "^accessrev_[0-9a-f]{32}$"},
    "state": {"const": "RELEASED"},
    "allowed_query_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["CURRICULUM_COMPONENTS", "APPROVED_ITEM_STRUCTURE", "ITEM_PREPARATION"]}
    },
    "allowed_requester_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["ADMIN", "EDITOR", "REVIEWER", "WORKER"]}
    },
    "allowed_source_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["CURRICULUM", "TEXTBOOK", "APPROVED_ITEM", "PAST_EXAM", "INTERNAL_GUIDE"]}
    },
    "answer_bearing_roles": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["ADMIN", "EDITOR", "REVIEWER"]}
    },
    "maximum_budget": {"$ref": "#/$defs/budget"},
    "created_at": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/utcTimestamp"},
    "content_sha256": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"}
  }
}
