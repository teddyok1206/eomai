{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/education-retrieval-request/2.0",
  "title": "EOM Education Retrieval Request V2",
  "$defs": {
    "curriculumScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_revision_id", "root_unit_id", "include_descendants"],
      "properties": {
        "framework_revision_id": {"type": "string", "pattern": "^curriculumrev_[0-9a-f]{32}$"},
        "root_unit_id": {"type": "string", "pattern": "^currunit_[0-9a-f]{32}$"},
        "include_descendants": {"type": "boolean"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_documents", "max_item_revisions", "max_graph_nodes", "max_claims", "max_context_tokens"],
      "properties": {
        "max_documents": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_item_revisions": {"type": "integer", "minimum": 0, "maximum": 64},
        "max_graph_nodes": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_claims": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_context_tokens": {"type": "integer", "minimum": 1000, "maximum": 32000}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "retrieval_request_id",
    "graph_snapshot",
    "query_kind",
    "curriculum_scope",
    "topic_keys",
    "target_item_revision_id",
    "required_item_elements",
    "source_classes",
    "retrieval_mode",
    "evidence_budget",
    "access_policy_revision_id",
    "access_policy_sha256",
    "requester_role",
    "requester_operator_id",
    "requester_permission_keys",
    "requester_permissions_sha256",
    "requested_at",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {"const": "education-retrieval-request/2.0"},
    "retrieval_request_id": {"type": "string", "pattern": "^retrieval_[0-9a-f]{32}$"},
    "graph_snapshot": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/graphSnapshotPointer"},
    "query_kind": {"enum": ["CURRICULUM_COMPONENTS", "APPROVED_ITEM_STRUCTURE", "ITEM_PREPARATION"]},
    "curriculum_scope": {"anyOf": [{"$ref": "#/$defs/curriculumScope"}, {"type": "null"}]},
    "topic_keys": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"}
    },
    "target_item_revision_id": {
      "anyOf": [
        {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
        {"type": "null"}
      ]
    },
    "required_item_elements": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["paragraph", "table", "image", "equation", "statement_set", "choice"]}
    },
    "source_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["CURRICULUM", "TEXTBOOK", "APPROVED_ITEM", "PAST_EXAM", "INTERNAL_GUIDE"]}
    },
    "retrieval_mode": {"const": "HYBRID_LOCAL_MULTIHOP"},
    "evidence_budget": {"$ref": "#/$defs/budget"},
    "access_policy_revision_id": {"type": "string", "pattern": "^accessrev_[0-9a-f]{32}$"},
    "access_policy_sha256": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"},
    "requester_role": {"enum": ["ADMIN", "EDITOR", "REVIEWER", "WORKER"]},
    "requester_operator_id": {"type": "string", "pattern": "^operator_[0-9a-f]{32}$"},
    "requester_permission_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$", "maxLength": 128}
    },
    "requester_permissions_sha256": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"},
    "requested_at": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/utcTimestamp"},
    "request_sha256": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"}
  }
}
