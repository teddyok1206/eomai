{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/system-rag-similarity-reader-configuration/1.0",
  "title": "Non-secret fixed Catalog similarity reader configuration V1",
  "description": "Trusted installed selection only. Neither config fields nor owner OID authenticate an operator or install/grant the Identity function.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "namespace", "document_space", "recipe", "source_classes", "native_execution_policy", "native_execution_policy_sha256", "runtime_bundle", "database_owner"],
  "properties": {
    "schema_version": {"const": "system-rag-similarity-reader-configuration/1.0"},
    "corpus_id": {"type": "string", "pattern": "^corpus_[0-9a-f]{32}$"},
    "namespace": {"$ref": "eom://schemas/knowledge/embedding-registry/1.0#/$defs/namespace"},
    "document_space": {"allOf": [
      {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/space"},
      {"properties": {"purpose": {"const": "DOCUMENT"}}}
    ]},
    "recipe": {"$ref": "eom://schemas/knowledge/item-inference-transfer-experiment/1.0#/$defs/recipe"},
    "source_classes": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["APPROVED_ITEM", "PAST_EXAM"]}},
    "native_execution_policy": {"allOf": [
      {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/artifactMember"},
      {"properties": {
        "member_path": {"const": "policy.json"},
        "schema_ref": {"const": "eom://schemas/workflow/reference-query-execution-policy/1.0"},
        "media_type": {"const": "application/json"}
      }}
    ]},
    "native_execution_policy_sha256": {"$ref": "eom://schemas/knowledge/embedding-registry/1.0#/$defs/hash"},
    "runtime_bundle": {"$ref": "eom://schemas/knowledge/embedding-runtime-bundle/1.0#/$defs/bundlePointer"},
    "database_owner": {
      "type": "object", "additionalProperties": false,
      "required": ["role_name", "role_oid"],
      "properties": {
        "role_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$", "not": {"const": "eom_catalog_manager_runtime"}},
        "role_oid": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      }
    }
  }
}
