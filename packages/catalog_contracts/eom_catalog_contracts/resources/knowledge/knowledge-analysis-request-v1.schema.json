{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/knowledge-analysis-request/1.0",
  "title": "EOM Knowledge Analysis Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_request_id",
    "source",
    "execution_preset_id",
    "execution_preset_revision_id",
    "execution_preset_sha256",
    "result_schema_ref",
    "prior_graph_snapshot",
    "requested_outputs",
    "general_knowledge_mode",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-analysis-request/1.0"
    },
    "analysis_request_id": {
      "type": "string",
      "pattern": "^knowledgeanalysis_[0-9a-f]{32}$"
    },
    "source": {
      "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sourceRevisionPointer"
    },
    "execution_preset_id": {
      "type": "string",
      "pattern": "^execpreset_[0-9a-f]{32}$"
    },
    "execution_preset_revision_id": {
      "type": "string",
      "pattern": "^execpresetrev_[0-9a-f]{32}$"
    },
    "execution_preset_sha256": {
      "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"
    },
    "result_schema_ref": {
      "const": "eom://schemas/knowledge/knowledge-analysis-result/1.0"
    },
    "prior_graph_snapshot": {
      "anyOf": [
        {
          "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/graphSnapshotPointer"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["NORMALIZED_MARKDOWN", "SOURCE_ANCHORS", "NODES", "EDGES", "COMPONENT_OBSERVATIONS"]
      }
    },
    "general_knowledge_mode": {
      "type": "string",
      "enum": ["DISABLED", "AUXILIARY_UNATTRIBUTED"]
    },
    "created_at": {
      "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/utcTimestamp"
    }
  }
}
