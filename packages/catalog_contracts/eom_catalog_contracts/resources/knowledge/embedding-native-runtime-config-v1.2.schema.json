{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/embedding-native-runtime-config/1.2",
  "title": "CUDA-only native embedding configuration V1.2 with a pinned private host extension",
  "description": "Explicit CUDA successor metadata only. Does not authorize installation, kernel, device, GPU lease or native execution; strict CPU-only acceptance receipts remain insufficient.",
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resources": {
      "$ref": "eom://schemas/knowledge/embedding-native-runtime-config/1.0#/$defs/resources"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "configuration_id",
        "configuration_revision_id",
        "profile",
        "bundle",
        "installed_proof",
        "runtime_sha256",
        "resources",
        "config_sha256",
        "cuda_host_extension"
      ],
      "properties": {
        "schema_version": {
          "const": "embedding-native-runtime-config/1.2"
        },
        "configuration_id": {
          "type": "string",
          "pattern": "^embeddingnativeconfig_[0-9a-f]{32}$"
        },
        "configuration_revision_id": {
          "type": "string",
          "pattern": "^embeddingnativeconfigrev_[0-9a-f]{32}$"
        },
        "profile": {
          "const": "CUDA_INDEX_FP32"
        },
        "bundle": {
          "$ref": "eom://schemas/knowledge/embedding-runtime-bundle/1.0#/$defs/bundlePointer"
        },
        "installed_proof": {
          "$ref": "eom://schemas/knowledge/embedding-installed-runtime-proof/1.0#/$defs/pointer"
        },
        "runtime_sha256": {
          "$ref": "#/$defs/sha"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha"
        },
        "cuda_host_extension": {
          "$ref": "eom://schemas/knowledge/embedding-cuda-host-extension/1.0#/$defs/pointer"
        }
      },
      "allOf": [
        {
          "properties": {
            "installed_proof": {
              "properties": {
                "profile": {
                  "const": "CUDA_INDEX_FP32"
                }
              }
            },
            "resources": {
              "properties": {
                "vram_limit_bytes": {
                  "const": 8589934592
                }
              }
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/config"
}
