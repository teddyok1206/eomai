{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/system-rag-workflow-similarity-read/2.0",
  "title": "Stored role public-solution similarity materialization V2",
  "$defs": {
    "context": {
      "oneOf": [
        {"$ref": "eom://schemas/knowledge/public-solution-similarity/3.0#/$defs/context"},
        {"$ref": "eom://schemas/knowledge/public-solution-similarity/4.0#/$defs/context"}
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "selection"],
      "properties": {
        "schema_version": {"const": "system-rag-workflow-similarity-read-request/2.0"},
        "operation": {"const": "READ_WORKFLOW_SIMILARITY_MATERIALS"},
        "selection": {"$ref": "eom://schemas/knowledge/system-rag-workflow-similarity-read/1.0#/$defs/selection"}
      }
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "status", "request_sha256", "operator_id", "context", "materials", "error_code"],
      "properties": {
        "schema_version": {"const": "system-rag-workflow-similarity-read-reply/2.0"},
        "operation": {"const": "READ_WORKFLOW_SIMILARITY_MATERIALS"},
        "status": {"enum": ["SUCCESS", "FAILED"]},
        "request_sha256": {"anyOf": [{"$ref": "eom://schemas/knowledge/system-rag-workflow-similarity-read/1.0#/$defs/hash"}, {"type": "null"}]},
        "operator_id": {"anyOf": [{"type": "string", "pattern": "^operator_[0-9a-f]{32}$"}, {"type": "null"}]},
        "context": {"anyOf": [{"$ref": "#/$defs/context"}, {"type": "null"}]},
        "materials": {"anyOf": [{"$ref": "eom://schemas/knowledge/system-rag-similarity-materials/3.0"}, {"type": "null"}]},
        "error_code": {"anyOf": [{"$ref": "eom://schemas/knowledge/system-rag-workflow-similarity-read/1.0#/$defs/error"}, {"type": "null"}]}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "SUCCESS"}}, "required": ["status"]},
        "then": {
          "properties": {
            "request_sha256": {"$ref": "eom://schemas/knowledge/system-rag-workflow-similarity-read/1.0#/$defs/hash"},
            "operator_id": {"type": "string", "pattern": "^operator_[0-9a-f]{32}$"},
            "context": {"allOf": [{"$ref": "#/$defs/context"}, {"properties": {"status": {"not": {"const": "FAILED"}}}}]},
            "materials": {"$ref": "eom://schemas/knowledge/system-rag-similarity-materials/3.0"},
            "error_code": {"type": "null"}
          }
        },
        "else": {
          "properties": {
            "operator_id": {"type": "null"},
            "context": {"type": "null"},
            "materials": {"type": "null"},
            "error_code": {"$ref": "eom://schemas/knowledge/system-rag-workflow-similarity-read/1.0#/$defs/error"}
          }
        }
      }]
    }
  },
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/reply"}]
}
