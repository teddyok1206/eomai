{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eom.local/schemas/knowledge/review-textbook-usage-v1.schema.json",
  "title": "EOM Review Textbook Evidence Usage V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_sha256",
    "citations",
    "usage_sha256"
  ],
  "properties": {
    "schema_version": { "const": "review-textbook-usage/1.0" },
    "binding_sha256": { "$ref": "#/$defs/sha256" },
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/citation" }
    },
    "usage_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "anchor_ids", "conclusion_paths"],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^evidenceitem_[0-9a-f]{32}$"
        },
        "anchor_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^anchor_[a-z0-9][a-z0-9_-]{0,63}$"
          }
        },
        "conclusion_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 512,
            "pattern": "^/[^/]+(?:/[^/]+)*$"
          }
        }
      }
    }
  }
}
