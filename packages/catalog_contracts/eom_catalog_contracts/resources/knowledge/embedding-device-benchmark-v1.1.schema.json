{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/embedding-device-benchmark/1.1",
  "title": "Fixed native device benchmark execution-budget successor V1.1",
  "description": "Explicit 600-second benchmark budget only. Shared model/input/recipe/numerical/resource definitions retain their immutable V1.0 meaning. No authentication extension, compute authority, automatic retry or GPU activation follows from validation.",
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "purpose",
        "policy_id",
        "policy_revision_id",
        "timeout_seconds",
        "cpu_quota_percent",
        "tasks_max",
        "rss_limit_bytes",
        "gpu_limit_bytes",
        "maximum_envelope_bytes",
        "maximum_staged_bytes",
        "maximum_output_bytes",
        "maximum_output_members",
        "policy_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "embedding-device-benchmark-policy/1.1"
        },
        "purpose": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/purpose"
        },
        "policy_id": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/policy_id"
        },
        "policy_revision_id": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/policy_revision_id"
        },
        "timeout_seconds": {
          "type": "integer",
          "const": 600
        },
        "cpu_quota_percent": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/cpu_quota_percent"
        },
        "tasks_max": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/tasks_max"
        },
        "rss_limit_bytes": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/rss_limit_bytes"
        },
        "gpu_limit_bytes": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/gpu_limit_bytes"
        },
        "maximum_envelope_bytes": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/maximum_envelope_bytes"
        },
        "maximum_staged_bytes": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/maximum_staged_bytes"
        },
        "maximum_output_bytes": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/maximum_output_bytes"
        },
        "maximum_output_members": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/maximum_output_members"
        },
        "policy_sha256": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/policy/properties/policy_sha256"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "purpose",
        "benchmark_id",
        "benchmark_revision_id",
        "operator_audit_id",
        "graph_snapshot",
        "policy_revision_id",
        "policy_sha256",
        "sources",
        "document_rows",
        "query_rows",
        "input_manifest",
        "input_set_sha256",
        "view_recipe",
        "family",
        "cpu",
        "cuda",
        "recipe",
        "execution_policy",
        "request_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "embedding-device-benchmark-request/1.1"
        },
        "kind": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/kind"
        },
        "purpose": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/purpose"
