        },
        "benchmark_revision_id": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/benchmark_revision_id"
        },
        "operator_audit_id": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/operator_audit_id"
        },
        "graph_snapshot": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/graph_snapshot"
        },
        "policy_revision_id": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/policy_revision_id"
        },
        "policy_sha256": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/policy_sha256"
        },
        "sources": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/sources"
        },
        "document_rows": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/document_rows"
        },
        "query_rows": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/query_rows"
        },
        "input_manifest": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/input_manifest"
        },
        "input_set_sha256": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/input_set_sha256"
        },
        "view_recipe": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/view_recipe"
        },
        "family": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/family"
        },
        "cpu": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/cpu"
        },
        "cuda": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/cuda"
        },
        "recipe": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/recipe"
        },
        "execution_policy": {
          "$ref": "#/$defs/policy"
        },
        "request_sha256": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/request/properties/request_sha256"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "purpose",
        "benchmark_id",
        "benchmark_revision_id",
        "job_id",
        "execution_id",
        "owner_request_sha256",
        "launch_ordinal",
        "device",
        "local_input",
        "input_set_sha256",
        "family",
        "runtime",
        "recipe",
        "execution_policy",
        "invocation_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "embedding-device-benchmark-invocation/1.1"
        },
        "kind": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/kind"
        },
        "purpose": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/purpose"
        },
        "benchmark_id": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/benchmark_id"
        },
        "benchmark_revision_id": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/benchmark_revision_id"
        },
        "job_id": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/job_id"
        },
        "execution_id": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/execution_id"
        },
        "owner_request_sha256": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/owner_request_sha256"
        },
        "launch_ordinal": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/launch_ordinal"
        },
        "device": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/device"
        },
        "local_input": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/local_input"
        },
        "input_set_sha256": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/input_set_sha256"
        },
        "family": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/family"
        },
        "runtime": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/runtime"
        },
        "recipe": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/recipe"
        },
        "execution_policy": {
          "$ref": "#/$defs/policy"
        },
        "invocation_sha256": {
          "$ref": "eom://schemas/knowledge/embedding-device-benchmark/1.0#/$defs/invocation/properties/invocation_sha256"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/policy"
    },
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/invocation"
    }
  ]
}
