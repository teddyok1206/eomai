{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/past-exam-variation-request/1.0",
  "title": "EOM Past Exam Variation Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_item_revision_id",
    "variation_axes",
    "preserve_core_concept",
    "preserve_cognitive_target",
    "copy_policy"
  ],
  "properties": {
    "schema_version": {"const": "past-exam-variation-request/1.0"},
    "source_item_revision_id": {
      "type": "string",
      "pattern": "^itemrev_[0-9a-f]{32}$"
    },
    "variation_axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CONTEXT",
          "DIFFICULTY",
          "DISTRACTORS",
          "REASONING_PATH",
          "REPRESENTATION",
          "VALUES"
        ]
      }
    },
    "preserve_core_concept": {"const": true},
    "preserve_cognitive_target": {"const": true},
    "copy_policy": {"const": "NO_STEM_CHOICE_ANSWER_COPY"}
  }
}
