{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/system-rag-similarity-read/3.0",
  "title": "Exact public-solution completed QUERY read V3",
  "description": "Authenticated API supplies actor. Read an exact completed public-solution QUERY using current Catalog source authority; no new computation or latest fallback.",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "pattern": "^operator_[0-9a-f]{32}$"
    },
    "error": {
      "enum": [
        "SOURCE_ACCESS_DENIED",
        "SOURCE_REVOKED",
        "SOURCE_POINTER_INVALID",
        "SOURCE_HASH_MISMATCH",
        "INDEX_POINTER_INVALID",
        "INDEX_HASH_MISMATCH",
        "QUERY_RESULT_INVALID",
        "AUTHORITY_UNAVAILABLE",
        "SIMILARITY_CONTEXT_REQUEST_INVALID",
        "SIMILARITY_CONTEXT_UNAVAILABLE",
        "SIMILARITY_CONTEXT_BUDGET_EXCEEDED"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "workflow_request_sha256",
        "context_request_sha256"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^workflow_[0-9a-f]{32}$"
        },
        "workflow_request_sha256": {
          "$ref": "#/$defs/hash"
        },
        "context_request_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "actor_id",
        "selection"
      ],
      "properties": {
        "schema_version": {
          "const": "system-rag-similarity-read-request/3.0"
        },
        "operation": {
          "const": "READ_SIMILARITY_CONTEXT"
        },
        "actor_id": {
          "$ref": "#/$defs/actor"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      }
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "status",
        "actor_id",
        "request_sha256",
        "result",
        "error_code"
      ],
      "properties": {
        "schema_version": {
          "const": "system-rag-similarity-read-reply/3.0"
        },
        "operation": {
          "const": "READ_SIMILARITY_CONTEXT"
        },
        "status": {
          "enum": [
            "SUCCESS",
            "FAILED"
          ]
        },
        "actor_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "eom://schemas/knowledge/public-solution-similarity/3.0#/$defs/context"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUCCESS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "actor_id": {
                "$ref": "#/$defs/actor"
              },
              "request_sha256": {
                "$ref": "#/$defs/hash"
              },
              "result": {
                "allOf": [
                  {
                    "$ref": "eom://schemas/knowledge/public-solution-similarity/3.0#/$defs/context"
                  },
                  {
                    "properties": {
                      "status": {
                        "not": {
                          "const": "FAILED"
                        }
                      }
                    }
                  }
                ]
              },
              "error_code": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "result": {
                "type": "null"
              },
              "error_code": {
                "$ref": "#/$defs/error"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "actor_id": {
                "type": "null"
              }
            },
            "required": [
              "actor_id"
            ]
          },
          "then": {
            "properties": {
              "request_sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "request_sha256": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        }
      ]
    },
    "publicSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workflow_id",
        "workflow_request_sha256",
        "context_request_sha256"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^workflow_[0-9a-f]{32}$"
        },
        "workflow_request_sha256": {
          "$ref": "#/$defs/hash"
        },
        "context_request_sha256": {
          "$ref": "#/$defs/hash"
        },
        "schema_version": {
          "const": "system-rag-similarity-read-selection/3.0"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/selection"
    },
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/reply"
    },
    {
      "$ref": "#/$defs/publicSelection"
    }
  ]
}
