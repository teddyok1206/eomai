{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/knowledge-graph-publication/6.0",
  "title": "Publish origin-scoped automatic Item Graph snapshot V6",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "knowledge-graph-publication/6.0"},
    "corpus_key": {
      "$ref": "eom://schemas/knowledge/knowledge-graph-publication/5.0#/properties/corpus_key"
    },
    "display_name": {
      "$ref": "eom://schemas/knowledge/knowledge-graph-publication/5.0#/properties/display_name"
    },
    "accepted_analysis_run_ids": {
      "$ref": "eom://schemas/knowledge/knowledge-graph-publication/5.0#/properties/accepted_analysis_run_ids"
    },
    "structure_manifest": {
      "allOf": [
        {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/artifactMemberPointer"},
        {
          "properties": {
            "logical_name": {"const": "graph-structure-manifest.json"},
            "media_type": {"const": "application/json"},
            "member_path": {"const": "evidence/graph-structure-manifest.json"},
            "schema_ref": {
              "const": "eom://schemas/knowledge/knowledge-graph-structure-manifest/6.0"
            }
          }
        }
      ]
    },
    "expected_current_snapshot_revision_id": {
      "$ref": "eom://schemas/knowledge/knowledge-graph-publication/5.0#/properties/expected_current_snapshot_revision_id"
    },
    "publisher_version": {
      "$ref": "eom://schemas/knowledge/knowledge-graph-publication/5.0#/properties/publisher_version"
    },
    "published_by_operator_id": {
      "$ref": "eom://schemas/knowledge/knowledge-graph-publication/5.0#/properties/published_by_operator_id"
    },
    "idempotency_key": {
      "$ref": "eom://schemas/knowledge/knowledge-graph-publication/5.0#/properties/idempotency_key"
    },
    "requested_at": {
      "$ref": "eom://schemas/knowledge/knowledge-graph-publication/5.0#/properties/requested_at"
    },
    "request_sha256": {
      "$ref": "eom://schemas/knowledge/knowledge-graph-publication/5.0#/properties/request_sha256"
    }
  },
  "required": [
    "schema_version",
    "corpus_key",
    "display_name",
    "accepted_analysis_run_ids",
    "structure_manifest",
    "expected_current_snapshot_revision_id",
    "publisher_version",
    "published_by_operator_id",
    "idempotency_key",
    "requested_at",
    "request_sha256"
  ]
}
