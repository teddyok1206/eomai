{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/legacy-knowledge/legacy-source-selection/1.0",
  "title": "EOM Legacy Source Selection V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "selection_id", "inventory_id", "inventory_sha256",
    "selected_sources", "comparison_evidence", "reviewed_at", "reviewed_by",
    "selection_sha256"
  ],
  "properties": {
    "schema_version": {"const": "legacy-source-selection/1.0"},
    "selection_id": {"type": "string", "pattern": "^legacyselection_[0-9a-f]{32}$"},
    "inventory_id": {"type": "string", "pattern": "^legacyinventory_[0-9a-f]{32}$"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "selected_sources": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {"$ref": "#/$defs/selectedSource"}
    },
    "comparison_evidence": {
      "type": "array", "maxItems": 500,
      "items": {"$ref": "#/$defs/comparisonEvidence"}
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewed_by": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "selection_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer_type", "artifact_id", "artifact_revision_id", "member_path",
        "schema_ref", "media_type", "sha256"
      ],
      "properties": {
        "pointer_type": {"const": "ARTIFACT_MEMBER"},
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "member_path": {
          "type": "string", "minLength": 3, "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+/[^\\u0000-\\u001f\\u007f]+$"
        },
        "schema_ref": {"const": "eom://schemas/legacy-knowledge/rights-review/1.0"},
        "media_type": {"const": "application/json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selectedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_key", "content_sha256", "canonicality", "reviewed_source_family",
        "declared_intake_role", "intended_corpus_key", "source_owner_reference",
        "rights_state", "rights_review"
      ],
      "properties": {
        "entry_key": {"type": "string", "pattern": "^legacyentry_[0-9a-f]{32}$"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "canonicality": {"const": "ORIGINAL"},
        "reviewed_source_family": {"enum": ["CURRICULUM", "TEXTBOOK", "REFERENCE_BOOK", "GUIDANCE", "ITEM", "USAGE_WORKBOOK"]},
        "declared_intake_role": {"enum": ["REFERENCE", "GUIDELINE", "DATA", "ASSET", "OTHER"]},
        "intended_corpus_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
        "source_owner_reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "rights_state": {"enum": ["CLEARED_INTERNAL", "CLEARED_LICENSED", "RESTRICTED"]},
        "rights_review": {"$ref": "#/$defs/artifactPointer"}
      }
    },
    "comparisonEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_key", "content_sha256", "canonicality"],
      "properties": {
        "entry_key": {"type": "string", "pattern": "^legacyentry_[0-9a-f]{32}$"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "canonicality": {"const": "DERIVED"}
      }
    }
  }
}
