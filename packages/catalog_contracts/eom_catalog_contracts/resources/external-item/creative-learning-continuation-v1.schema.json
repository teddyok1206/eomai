{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/external-item/creative-learning-continuation/1.0",
  "title": "Creative learning source-visual continuation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_id",
    "parent_cohort",
    "requested_by_operator_id",
    "target_set_sha256",
    "source_commit",
    "workflow_definition_version",
    "workflow_definition_sha256",
    "extraction_preset",
    "content_pack_release_id",
    "continuation_reason",
    "cohort_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "creative-learning-continuation/1.0"
    },
    "cohort_id": {
      "type": "string",
      "pattern": "^creativecohort_[0-9a-f]{32}$"
    },
    "parent_cohort": {
      "$ref": "#/$defs/member"
    },
    "requested_by_operator_id": {
      "type": "string",
      "pattern": "^operator_[0-9a-f]{32}$"
    },
    "target_set_sha256": {
      "$ref": "#/$defs/sha"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workflow_definition_version": {
      "const": "2.0.0"
    },
    "workflow_definition_sha256": {
      "$ref": "#/$defs/sha"
    },
    "extraction_preset": {
      "$ref": "#/$defs/preset"
    },
    "content_pack_release_id": {
      "type": "string",
      "pattern": "^packrel_[0-9a-f]{32}$"
    },
    "continuation_reason": {
      "const": "SOURCE_VISUAL_CONTRACT_SUCCESSOR"
    },
    "cohort_sha256": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "artifact_revision_id": {
          "type": "string",
          "pattern": "^rev_[0-9a-f]{32}$"
        },
        "member_path": {
          "const": "cohort.json"
        },
        "schema_ref": {
          "const": "eom://schemas/external-item/creative-learning-cohort/1.0"
        },
        "media_type": {
          "const": "application/json"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset_id",
        "preset_revision_id",
        "sha256"
      ],
      "properties": {
        "preset_id": {
          "type": "string",
          "pattern": "^execpreset_[0-9a-f]{32}$"
        },
        "preset_revision_id": {
          "type": "string",
          "pattern": "^execpresetrev_[0-9a-f]{32}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  }
}
