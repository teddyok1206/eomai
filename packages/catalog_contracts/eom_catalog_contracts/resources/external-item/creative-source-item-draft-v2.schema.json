    "title": {"$ref": "eom://schemas/external-item/source-item-draft/1.0#/properties/title"},
    "body": {"$ref": "eom://schemas/external-item/source-item-draft/1.0#/properties/body"},
    "interaction": {"$ref": "eom://schemas/external-item/source-item-draft/1.0#/properties/interaction"},
    "solution": {"$ref": "eom://schemas/external-item/source-item-draft/1.0#/properties/solution"},
    "score": {"$ref": "eom://schemas/external-item/source-score/2.0"},
