{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/item-registry/item-revision-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "item_id", "item_revision_id", "revision_number", "content_pack", "source_intake", "workflow", "components", "metadata", "provenance", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "item_id": {"type": "string", "pattern": "^item_[0-9a-f]{32}$"},
    "item_revision_id": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
    "revision_number": {"type": "integer", "minimum": 1},
    "content_pack": {
      "type": "object", "additionalProperties": false, "required": ["release_id", "pack_key", "version", "sha256"],
      "properties": {
        "release_id": {"type": "string", "pattern": "^packrel_[0-9a-f]{32}$"},
        "pack_key": {"type": "string"}, "version": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "source_intake": {
      "type": "object", "additionalProperties": false, "required": ["batch_ids"],
      "properties": {"batch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^intake_[0-9a-f]{32}$"}}}
    },
    "workflow": {
      "type": "object", "additionalProperties": false, "required": ["workflow_id", "definition_key", "definition_version"],
      "properties": {
        "workflow_id": {"type": "string", "pattern": "^workflow_[0-9a-f]{32}$"},
        "definition_key": {"type": "string"}, "definition_version": {"type": "string"}
      }
    },
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component_type", "ordinal", "schema_ref", "media_type", "artifact_id", "artifact_revision_id", "sha256", "logical_name", "required"],
        "properties": {
          "component_type": {"type": "string"}, "ordinal": {"type": "integer", "minimum": 0},
          "schema_ref": {"type": "string"}, "media_type": {"type": "string"},
          "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
          "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "logical_name": {"type": "string"}, "required": {"type": "boolean"}
        }
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["schema_ref", "sha256"],
      "properties": {"schema_ref": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "provenance": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
