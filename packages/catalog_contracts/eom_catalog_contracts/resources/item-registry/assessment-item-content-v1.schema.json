{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/item-registry/assessment-item-content-v1",
  "title": "EOM Assessment Item Content V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locale", "title", "body", "interaction", "solution", "score"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
    "title": {"$ref": "#/$defs/text"},
    "body": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/block"}
    },
    "interaction": {
      "oneOf": [
        {"$ref": "#/$defs/singleChoice"},
        {"$ref": "#/$defs/constructedResponse"}
      ]
    },
    "solution": {"$ref": "#/$defs/solution"},
    "score": {"$ref": "#/$defs/score"}
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*$"
    },
    "blockId": {"type": "string", "pattern": "^block_[a-z][a-z0-9_]{0,63}$"},
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_revision_id", "artifact_member", "sha256", "media_type"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "artifact_member": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "media_type": {"enum": ["image/png", "image/jpeg"]}
      }
    },
    "paragraphBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "type", "purpose", "text"],
      "properties": {
        "block_id": {"$ref": "#/$defs/blockId"},
        "type": {"const": "paragraph"},
        "purpose": {"enum": ["stem", "prompt", "context"]},
        "text": {"$ref": "#/$defs/text"}
      }
    },
    "equationBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "type", "purpose", "notation", "source"],
      "properties": {
        "block_id": {"$ref": "#/$defs/blockId"},
        "type": {"const": "equation"},
        "purpose": {"enum": ["stimulus", "stem"]},
        "notation": {"enum": ["latex", "hancom-equation-script"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "tableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "type", "purpose", "headers", "rows"],
      "properties": {
        "block_id": {"$ref": "#/$defs/blockId"},
        "type": {"const": "table"},
        "purpose": {"enum": ["stimulus", "data", "reference"]},
        "caption": {"type": ["string", "null"], "maxLength": 500},
        "headers": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {"type": "string", "maxLength": 500}
        },
        "rows": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "array", "minItems": 1, "maxItems": 20,
            "items": {"type": "string", "maxLength": 1000}
          }
        }
      }
    },
    "imageBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "type", "purpose", "artifact", "alt_text", "width_px", "height_px"],
      "properties": {
        "block_id": {"$ref": "#/$defs/blockId"},
        "type": {"const": "image"},
        "purpose": {"enum": ["stimulus", "reference"]},
        "artifact": {"$ref": "#/$defs/artifactPointer"},
        "alt_text": {"type": "string", "minLength": 1, "maxLength": 1000},
        "width_px": {"type": "integer", "minimum": 1, "maximum": 10000},
        "height_px": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement_id", "label", "text"],
      "properties": {
        "statement_id": {"type": "string", "pattern": "^statement_[a-z][a-z0-9_]{0,31}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 16},
        "text": {"$ref": "#/$defs/text"}
      }
    },
    "statementSetBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "type", "purpose", "statements"],
      "properties": {
        "block_id": {"$ref": "#/$defs/blockId"},
        "type": {"const": "statement_set"},
        "purpose": {"const": "claims"},
        "statements": {
          "type": "array", "minItems": 2, "maxItems": 10,
          "items": {"$ref": "#/$defs/statement"}
        }
      }
    },
    "block": {
      "oneOf": [
        {"$ref": "#/$defs/paragraphBlock"},
        {"$ref": "#/$defs/equationBlock"},
        {"$ref": "#/$defs/tableBlock"},
        {"$ref": "#/$defs/imageBlock"},
        {"$ref": "#/$defs/statementSetBlock"}
      ]
    },
    "choice": {
      "type": "object", "additionalProperties": false,
      "required": ["choice_id", "label", "text"],
      "properties": {
        "choice_id": {"type": "string", "pattern": "^choice_[a-z0-9][a-z0-9_]{0,31}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 16},
        "text": {"$ref": "#/$defs/text"}
      }
    },
    "singleChoice": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "choices"],
      "properties": {
        "type": {"const": "single_choice"},
        "choices": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"$ref": "#/$defs/choice"}}
      }
    },
    "constructedResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "response_format"],
      "properties": {
        "type": {"const": "constructed_response"},
        "response_format": {"enum": ["short_text", "long_text", "numeric"]}
      }
    },
    "statementExplanation": {
      "type": "object", "additionalProperties": false,
      "required": ["statement_id", "text"],
      "properties": {
        "statement_id": {"type": "string", "pattern": "^statement_[a-z][a-z0-9_]{0,31}$"},
        "text": {"$ref": "#/$defs/text"}
      }
    },
    "solution": {
      "type": "object", "additionalProperties": false,
      "required": ["correct_choice_ids", "accepted_answers", "explanation", "authoring_intent", "statement_explanations"],
      "properties": {
        "correct_choice_ids": {
          "type": "array", "maxItems": 10, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^choice_[a-z0-9][a-z0-9_]{0,31}$"}
        },
        "accepted_answers": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "explanation": {"$ref": "#/$defs/text"},
        "authoring_intent": {"$ref": "#/$defs/text"},
        "statement_explanations": {
          "type": "array", "maxItems": 10,
          "items": {"$ref": "#/$defs/statementExplanation"}
        }
      }
    },
    "score": {
      "type": "object", "additionalProperties": false,
      "required": ["points"],
      "properties": {"points": {"type": "integer", "minimum": 0, "maximum": 100}}
    }
  }
}
