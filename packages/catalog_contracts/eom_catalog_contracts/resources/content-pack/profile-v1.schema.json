{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/content-pack/profile-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "template", "input_schema_ref", "output_schema_ref", "required_context"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["type", "key", "version"],
      "properties": {
        "type": {"enum": ["authoring", "review", "image", "registration"]},
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    },
    "template": {"type": "string", "pattern": "^prompt-templates/[A-Za-z0-9._/-]+\\.md$"},
    "input_schema_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "output_schema_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "required_context": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"}}
  }
}
