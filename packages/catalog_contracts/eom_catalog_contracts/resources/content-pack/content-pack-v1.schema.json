{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/content-pack/content-pack-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack", "provenance", "compatibility", "taxonomies", "item_types", "profiles", "metadata_schemas", "rubrics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "pack": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "name", "version", "locale", "domain_key", "description"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
        "domain_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["intake_batch_ids", "mapping_proposal_ids"],
      "properties": {
        "intake_batch_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^intake_[0-9a-f]{32}$"}},
        "mapping_proposal_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"}}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "workflow_definitions", "required_worker_roles"],
      "properties": {
        "protocol": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum", "maximum_exclusive"],
          "properties": {"minimum": {"type": "string"}, "maximum_exclusive": {"type": "string"}}
        },
        "workflow_definitions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["key", "versions"],
            "properties": {"key": {"type": "string"}, "versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}
          }
        },
        "required_worker_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["authoring", "review", "image", "item_management"]}}
      }
    },
    "taxonomies": {"$ref": "#/$defs/pathMap"},
    "item_types": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["key", "source"], "properties": {"key": {"type": "string"}, "source": {"$ref": "#/$defs/path"}}}
    },
    "profiles": {
      "type": "object", "additionalProperties": false,
      "required": ["authoring", "review", "image", "registration"],
      "properties": {
        "authoring": {"$ref": "#/$defs/pathMap"}, "review": {"$ref": "#/$defs/pathMap"},
        "image": {"$ref": "#/$defs/pathMap"}, "registration": {"$ref": "#/$defs/pathMap"}
      }
    },
    "metadata_schemas": {"$ref": "#/$defs/pathMap"},
    "rubrics": {"$ref": "#/$defs/pathMap"}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 512},
    "pathMap": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/path"}}
  }
}
