{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eom.local/schemas/content-pack/content-pack-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack", "provenance", "compatibility", "taxonomies", "item_types", "profiles", "metadata_schemas", "rubrics"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "version", "locale", "domain_key", "description"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"$ref": "#/$defs/semantic_version"},
        "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
        "domain_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "intake_batch_ids", "mapping_proposal_ids"],
          "properties": {
            "mode": {"const": "manual_external_source"},
            "intake_batch_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/intake_id"}},
            "mapping_proposal_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/proposal_id"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "intake_batch_ids", "mapping_proposal_ids"],
          "properties": {
            "mode": {"const": "built_in_general_knowledge"},
            "intake_batch_ids": {"type": "array", "maxItems": 0},
            "mapping_proposal_ids": {"type": "array", "maxItems": 0}
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "workflow_definitions", "required_worker_roles"],
      "properties": {
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum_exclusive"],
          "properties": {
            "minimum": {"type": "string"},
            "maximum_exclusive": {"type": "string"}
          }
        },
        "workflow_definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "versions"],
            "properties": {
              "key": {"type": "string"},
              "versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/semantic_version"}}
            }
          }
        },
        "required_worker_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["authoring", "review", "image", "item_management", "support"]}
        }
      }
    },
    "taxonomies": {"type": "object", "additionalProperties": {"type": "string"}},
    "item_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "source"],
        "properties": {"key": {"type": "string"}, "source": {"type": "string"}}
      }
    },
    "profiles": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}},
    "metadata_schemas": {"type": "object", "additionalProperties": {"type": "string"}},
    "rubrics": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "semantic_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "intake_id": {"type": "string", "pattern": "^intake_[0-9a-f]{32}$"},
    "proposal_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"}
  }
}
