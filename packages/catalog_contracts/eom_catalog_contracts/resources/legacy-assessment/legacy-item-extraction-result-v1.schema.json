{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/legacy-assessment/legacy-item-extraction-result/1.0",
  "title": "EOM Legacy Item Extraction Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_result_id",
    "extraction_request_id",
    "request_sha256",
    "observed_page_input_ids",
    "items",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "legacy-item-extraction-result/1.0"},
    "extraction_result_id": {"type": "string", "pattern": "^itemextractresult_[0-9a-f]{32}$"},
    "extraction_request_id": {"type": "string", "pattern": "^itemextractreq_[0-9a-f]{32}$"},
    "request_sha256": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
    },
    "observed_page_input_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^assessmentpage_[0-9a-f]{32}$"}
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_proposal_id",
          "item_number",
          "item_content",
          "authoring_intent_evidence_state",
          "source_anchors",
          "content_anchor_map",
          "curriculum_observations",
          "linguistic_patterns",
          "visual_patterns",
          "metadata_observations",
          "conflicts",
          "confidence_milli"
        ],
        "properties": {
          "item_proposal_id": {"type": "string", "pattern": "^itemproposal_[0-9a-f]{32}$"},
          "item_number": {"type": "integer", "minimum": 1, "maximum": 10000},
          "item_content": {
            "$ref": "eom://schemas/item-registry/assessment-item-content-v1"
          },
          "authoring_intent_evidence_state": {
            "enum": ["SOURCE_STATED", "ANALYST_RECONSTRUCTED", "UNKNOWN"]
          },
          "source_anchors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sourceAnchor"
            }
          },
          "content_anchor_map": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["content_path", "source_anchor_ids"],
              "properties": {
                "content_path": {
                  "type": "string",
                  "pattern": "^(title|body\\[[0-9]+\\](?:\\.[A-Za-z0-9_\\[\\].-]+)?|interaction(?:\\.[A-Za-z0-9_\\[\\].-]+)?|solution(?:\\.[A-Za-z0-9_\\[\\].-]+)?|score(?:\\.[A-Za-z0-9_\\[\\].-]+)?)$"
                },
                "source_anchor_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^assessmentanchor_[0-9a-f]{32}$"}
                }
              }
            }
          },
          "curriculum_observations": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/curriculumObservation"
            }
          },
          "linguistic_patterns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/linguisticPatternObservation"
            }
          },
          "visual_patterns": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/visualPatternObservation"
            }
          },
          "metadata_observations": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["observation_id", "key", "value", "source_anchor_ids"],
              "properties": {
                "observation_id": {"type": "string", "pattern": "^metadataobservation_[0-9a-f]{32}$"},
                "key": {
                  "enum": [
                    "LEGACY_ITEM_ID",
                    "INTERNAL_DIFFICULTY",
                    "INQUIRY_FLAG",
                    "CURRICULUM_VOLUME",
                    "SCIENCE_DOMAIN",
                    "SOURCE_EXAM_SUBJECT",
                    "SOURCE_DISPLAY_NAME",
                    "SOURCE_TYPE_CODE",
                    "OTHER_REVIEWED"
                  ]
                },
                "value": {"type": "string", "minLength": 1, "maxLength": 1000},
                "source_anchor_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^assessmentanchor_[0-9a-f]{32}$"}
                }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/conflictObservation"
            }
          },
          "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000}
        }
      }
    },
    "result_sha256": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
    }
  }
}
