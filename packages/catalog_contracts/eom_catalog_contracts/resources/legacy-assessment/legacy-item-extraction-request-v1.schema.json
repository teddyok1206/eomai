{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/legacy-assessment/legacy-item-extraction-request/1.0",
  "title": "EOM Legacy Item Extraction Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_request_id",
    "bundle",
    "occurrence",
    "layout_observation",
    "work_unit_ordinal",
    "expected_item_numbers",
    "page_inputs",
    "source_materializations",
    "execution_preset_id",
    "execution_preset_revision_id",
    "execution_preset_sha256",
    "worker_result_schema_ref",
    "created_at",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {"const": "legacy-item-extraction-request/1.0"},
    "extraction_request_id": {"type": "string", "pattern": "^itemextractreq_[0-9a-f]{32}$"},
    "bundle": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/assessmentSourceBundlePointer"
    },
    "occurrence": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/assessmentOccurrencePointer"
    },
    "layout_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_layout_observation_id",
        "artifact",
        "workspace_relative_path",
        "observation_sha256"
      ],
      "properties": {
        "assessment_layout_observation_id": {"type": "string", "pattern": "^assessmentlayout_[0-9a-f]{32}$"},
        "artifact": {
          "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/artifactMemberPointer"
        },
        "workspace_relative_path": {"const": "source/layout-observation.json"},
        "observation_sha256": {
          "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
        }
      }
    },
    "work_unit_ordinal": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "expected_item_numbers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 10000}
    },
    "page_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/pageImageInput"
      }
    },
    "source_materializations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["materialization_id", "source_role", "source", "workspace_relative_path"],
        "properties": {
          "materialization_id": {"type": "string", "pattern": "^assessmaterial_[0-9a-f]{32}$"},
          "source_role": {
            "enum": [
              "STRUCTURED_RECONSTRUCTION",
              "ITEM_CLASSIFICATION_WORKBOOK",
              "TYPE_CODE_REFERENCE",
              "OTHER_REVIEWED_EVIDENCE"
            ]
          },
          "source": {
            "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/artifactMemberPointer"
          },
          "workspace_relative_path": {
            "type": "string",
            "pattern": "^source/[A-Za-z0-9._/-]{1,240}$"
          }
        }
      }
    },
    "execution_preset_id": {"type": "string", "pattern": "^execpreset_[0-9a-f]{32}$"},
    "execution_preset_revision_id": {"type": "string", "pattern": "^execpresetrev_[0-9a-f]{32}$"},
    "execution_preset_sha256": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
    },
    "worker_result_schema_ref": {"const": "eom://schemas/legacy-assessment/legacy-item-extraction-result/1.0"},
    "created_at": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/utcTimestamp"
    },
    "request_sha256": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
    }
  }
}
