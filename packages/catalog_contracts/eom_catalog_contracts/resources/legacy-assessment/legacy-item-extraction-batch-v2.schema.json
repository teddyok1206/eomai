{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/legacy-assessment/legacy-item-extraction-batch/1.1",
  "title": "EOM Legacy Item Extraction Batch V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_batch_id",
    "idempotency_key",
    "inventory_id",
    "inventory_sha256",
    "inventory_artifact",
    "failure_policy",
    "work_units",
    "created_at",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "legacy-item-extraction-batch/1.1"},
    "extraction_batch_id": {"type": "string", "pattern": "^legacybatch_[0-9a-f]{32}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "inventory_id": {"type": "string", "pattern": "^legacyinventory_[0-9a-f]{32}$"},
    "inventory_sha256": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
    },
    "inventory_artifact": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/artifactMemberPointer"
    },
    "failure_policy": {"const": "CONTINUE_AND_COLLECT"},
    "work_units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/workUnit"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "manifest_sha256": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
    }
  },
  "$defs": {
    "workUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_unit_id",
        "ordinal",
        "request",
        "expected_item_numbers_sha256",
        "execution_mode",
        "reuse_accepted",
        "corpus_source_bindings"
      ],
      "properties": {
        "work_unit_id": {"type": "string", "pattern": "^legacyworkunit_[0-9a-f]{32}$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 999999},
        "request": {
          "$ref": "eom://schemas/legacy-assessment/legacy-item-extraction-request/1.0"
        },
        "expected_item_numbers_sha256": {
          "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
        },
        "execution_mode": {"enum": ["EXECUTE", "REUSE_ACCEPTED"]},
        "reuse_accepted": {
          "anyOf": [{"$ref": "#/$defs/acceptancePointer"}, {"type": "null"}]
        },
        "corpus_source_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/corpusSourceBinding"}
        }
      }
    },
    "corpusSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_member_id",
        "reviewed_inventory_source",
        "corpus_inventory_source"
      ],
      "properties": {
        "bundle_member_id": {
          "type": "string",
          "pattern": "^assessbundlemember_[0-9a-f]{32}$"
        },
        "reviewed_inventory_source": {
          "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/inventoryEntryPointer"
        },
        "corpus_inventory_source": {
          "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/inventoryEntryPointer"
        }
      }
    },
    "acceptancePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_id", "acceptance_sha256", "extraction_result"],
      "properties": {
        "acceptance_id": {"type": "string", "pattern": "^itemacceptance_[0-9a-f]{32}$"},
        "acceptance_sha256": {
          "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
        },
        "extraction_result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "extraction_result_id", "result_sha256"],
          "properties": {
            "artifact": {
              "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/artifactMemberPointer"
            },
            "extraction_result_id": {
              "type": "string",
              "pattern": "^itemextractresult_[0-9a-f]{32}$"
            },
            "result_sha256": {
              "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
            }
          }
        }
      }
    }
  }
}
