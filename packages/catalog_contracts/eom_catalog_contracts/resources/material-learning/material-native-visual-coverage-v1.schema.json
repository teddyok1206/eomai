{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/material-learning/native-visual-coverage/1.0",
  "title": "EOM native picture-use representation coverage; not semantic equivalence proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_sha256", "scope_sha256", "dispositions"],
  "properties": {
    "schema_version": {"const": "material-native-visual-coverage/1.0"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "scope_sha256": {"$ref": "#/$defs/sha256"},
    "dispositions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/image"},
          {"$ref": "#/$defs/nativeEquation"},
          {"$ref": "#/$defs/nativeTable"},
          {"$ref": "#/$defs/nonContent"},
          {"$ref": "#/$defs/unresolved"}
        ]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pictureUseId": {"type": "string", "pattern": "^officeobj_[0-9a-f]{32}$"},
    "blockId": {"type": "string", "pattern": "^block_[a-z][a-z0-9_]{0,63}$"},
    "regionId": {"type": "string", "pattern": "^extregion_[0-9a-f]{32}$"},
    "regionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/regionId"}
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500,
      "allOf": [
        {"pattern": "\\S"},
        {"pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"}
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "picture_use_id", "block_id", "source_region_id"],
      "properties": {
        "kind": {"const": "IMAGE"},
        "picture_use_id": {"$ref": "#/$defs/pictureUseId"},
        "block_id": {"$ref": "#/$defs/blockId"},
        "source_region_id": {"$ref": "#/$defs/regionId"}
      }
    },
    "nativeEquation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "picture_use_id", "block_id", "source_region_ids", "justification"],
      "properties": {
        "kind": {"const": "NATIVE_EQUATION"},
        "picture_use_id": {"$ref": "#/$defs/pictureUseId"},
        "block_id": {"$ref": "#/$defs/blockId"},
        "source_region_ids": {"$ref": "#/$defs/regionIds"},
        "justification": {"$ref": "#/$defs/evidence"}
      }
    },
    "nativeTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "picture_use_id", "block_id", "source_region_ids", "justification"],
      "properties": {
        "kind": {"const": "NATIVE_TABLE"},
        "picture_use_id": {"$ref": "#/$defs/pictureUseId"},
        "block_id": {"$ref": "#/$defs/blockId"},
        "source_region_ids": {"$ref": "#/$defs/regionIds"},
        "justification": {"$ref": "#/$defs/evidence"}
      }
    },
    "nonContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "picture_use_id", "reason", "source_region_ids", "evidence"],
      "properties": {
        "kind": {"const": "NON_CONTENT"},
        "picture_use_id": {"$ref": "#/$defs/pictureUseId"},
        "reason": {"enum": ["DECORATION", "PAGE_FURNITURE", "EDITORIAL_MARK"]},
        "source_region_ids": {"$ref": "#/$defs/regionIds"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "picture_use_id", "conflict_index", "source_region_ids"],
      "properties": {
        "kind": {"const": "UNRESOLVED"},
        "picture_use_id": {"$ref": "#/$defs/pictureUseId"},
        "conflict_index": {"type": "integer", "minimum": 0, "maximum": 31},
        "source_region_ids": {"$ref": "#/$defs/regionIds"}
      }
    }
  }
}
