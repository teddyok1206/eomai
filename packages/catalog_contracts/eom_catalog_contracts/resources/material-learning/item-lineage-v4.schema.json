{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/material-learning/item-lineage/4.0",
  "title": "EOM exact-score Item successor lineage with pinned Native reanalysis evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "material-learning-item-lineage/4.0"
    },
    "material_id": {
      "type": "string",
      "pattern": "^material_[0-9a-f]{32}$"
    },
    "material_revision_id": {
      "type": "string",
      "pattern": "^materialrev_[0-9a-f]{32}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^materialtask_[0-9a-f]{32}$"
    },
    "unit_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "selection": {
      "$ref": "eom://schemas/material-learning/authorization-request/1.0"
    },
    "work_input": {
      "allOf": [
        {
          "$ref": "eom://schemas/material-learning/types/1.0#/$defs/artifactMember"
        },
        {
          "properties": {
            "schema_ref": {
              "const": "eom://schemas/material-learning/extraction-work/1.0"
            },
            "member_path": {
              "const": "material/work.json"
            },
            "media_type": {
              "const": "application/json"
            }
          }
        }
      ]
    },
    "role_result": {
      "allOf": [
        {
          "$ref": "eom://schemas/external-item/creative-source-lineage/1.0#/$defs/member"
        },
        {
          "properties": {
            "schema_ref": {
              "const": "material-learning-result@3.0"
            },
            "member_path": {
              "const": "result.json"
            },
            "media_type": {
              "const": "application/json"
            }
          }
        }
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "proposed_content_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registered_content_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_answer_mode": {
      "enum": [
        "EDITORIAL_SOURCE",
        "MODEL_PROPOSAL_UNVERIFIED",
        "NOT_APPLICABLE"
      ]
    },
    "warning_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "maxItems": 64
    },
    "registration_policy": {
      "const": "PRESERVE_SOURCE_WITH_REVIEW_WARNINGS_V1"
    },
    "requested_by": {
      "type": "string",
      "pattern": "^operator_[0-9a-f]{32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "lineage_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "native_score_reanalysis": {
      "allOf": [
        {
          "$ref": "eom://schemas/material-learning/types/1.0#/$defs/artifactMember"
        },
        {
          "properties": {
            "schema_ref": {
              "const": "eom://schemas/material-learning/native-score-reanalysis/1.0"
            },
            "member_path": {
              "const": "score-reanalysis.json"
            },
            "media_type": {
              "const": "application/json"
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "material_id",
    "material_revision_id",
    "task_id",
    "unit_key",
    "selection",
    "work_input",
    "role_result",
    "input_sha256",
    "result_sha256",
    "proposed_content_sha256",
    "registered_content_sha256",
    "source_answer_mode",
    "warning_codes",
    "registration_policy",
    "requested_by",
    "created_at",
    "lineage_sha256",
    "native_score_reanalysis"
  ]
}
