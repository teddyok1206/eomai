{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/material-learning/create/2.0",
  "title": "Native material learning submission",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "material-learning-create/2.0"
    },
    "operation": {
      "const": "CREATE_MATERIAL_LEARNING"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^operator_[0-9a-f]{32}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[!-~]{16,128}$"
    },
    "upload": {
      "$ref": "eom://schemas/material-learning/upload/1.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "eom://schemas/material-learning/intake-types/1.0#/$defs/selectedSource"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "native_bundle": {
      "$ref": "eom://schemas/material-learning/types/1.0#/$defs/artifactMember"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "actor_id",
    "idempotency_key",
    "upload",
    "sources",
    "native_bundle"
  ]
}
