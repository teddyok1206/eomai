{
  "$id": "eom://schemas/assessment-assembly/mock-exam-assembly-cohort/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "mock-exam-assembly-cohort/1.0"},
    "cohort_id": {"pattern": "^assemblycohort_[0-9a-f]{32}$", "type": "string"},
    "members": {
      "items": {"$ref": "#/$defs/member"},
      "maxItems": 25,
      "minItems": 25,
      "type": "array"
    },
    "cohort_sha256": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["schema_version", "cohort_id", "members", "cohort_sha256"],
  "$defs": {
    "member": {
      "additionalProperties": false,
      "properties": {
        "position": {"maximum": 25, "minimum": 1, "type": "integer"},
        "item_revision_id": {"pattern": "^itemrev_[0-9a-f]{32}$", "type": "string"}
      },
      "required": ["position", "item_revision_id"],
      "type": "object"
    }
  },
  "title": "Mock Exam Assembly Cohort V1",
  "type": "object"
}
