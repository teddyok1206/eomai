{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {"pattern": "^[A-Z][A-Z0-9_]{2,63}$", "type": "string"},
        "message": {"maxLength": 2000, "minLength": 1, "type": "string"},
        "severity": {
          "enum": ["info", "warning", "blocking"],
          "type": "string"
        }
      },
      "required": ["code", "severity", "message"],
      "type": "object"
    },
    "FindingCounts": {
      "additionalProperties": false,
      "properties": {
        "blocking": {"maximum": 20, "minimum": 0, "type": "integer"},
        "info": {"maximum": 20, "minimum": 0, "type": "integer"},
        "warning": {"maximum": 20, "minimum": 0, "type": "integer"}
      },
      "required": ["info", "warning", "blocking"],
      "type": "object"
    }
  },
  "$id": "https://eom.local/schemas/assessment-assembly/mock-exam-review-eligibility-result-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"approval_state": {"const": "PENDING"}},
        "required": ["approval_state"]
      },
      "then": {
        "properties": {
          "approved_at": {"type": "null"},
          "reviewer_operator_id": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"approval_state": {"const": "APPROVED"}},
        "required": ["approval_state"]
      },
      "then": {
        "properties": {
          "approved_at": {"format": "date-time", "type": "string"},
          "reviewer_operator_id": {
            "pattern": "^operator_[0-9a-f]{32}$",
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "approval_state": {
      "enum": ["PENDING", "APPROVED"],
      "type": "string"
    },
    "approval_lock_version": {"minimum": 1, "type": "integer"},
    "approval_request_id": {
      "pattern": "^approval_[0-9a-f]{32}$",
      "type": "string"
    },
    "decision": {"const": "ready_for_human", "type": "string"},
    "approved_at": {
      "oneOf": [
        {"format": "date-time", "type": "string"},
        {"type": "null"}
      ]
    },
    "eligible": {"type": "boolean"},
    "eligibility_reason": {
      "enum": ["ELIGIBLE", "REVIEW_BLOCKING_FINDINGS"],
      "type": "string"
    },
    "finding_counts": {"$ref": "#/$defs/FindingCounts"},
    "findings": {
      "items": {"$ref": "#/$defs/Finding"},
      "maxItems": 20,
      "type": "array"
    },
    "operation": {
      "const": "INSPECT_MOCK_EXAM_REVIEW_ELIGIBILITY",
      "type": "string"
    },
    "review_artifact_id": {
      "pattern": "^artifact_[0-9a-f]{32}$",
      "type": "string"
    },
    "review_artifact_revision_id": {
      "pattern": "^rev_[0-9a-f]{32}$",
      "type": "string"
    },
    "review_result_schema": {"const": "review-result@9.0", "type": "string"},
    "reviewer_operator_id": {
      "oneOf": [
        {"pattern": "^operator_[0-9a-f]{32}$", "type": "string"},
        {"type": "null"}
      ]
    },
    "review_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "review_step_run_id": {
      "pattern": "^steprun_[0-9a-f]{32}$",
      "type": "string"
    },
    "review_summary": {"maxLength": 4000, "minLength": 1, "type": "string"},
    "schema_version": {
      "const": "mock-exam-review-eligibility-result/2.0",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^workflow_[0-9a-f]{32}$",
      "type": "string"
    },
    "workflow_lock_version": {"minimum": 1, "type": "integer"}
  },
  "required": [
    "schema_version",
    "operation",
    "workflow_id",
    "workflow_lock_version",
    "approval_state",
    "approval_request_id",
    "approval_lock_version",
    "reviewer_operator_id",
    "approved_at",
    "review_step_run_id",
    "review_artifact_id",
    "review_artifact_revision_id",
    "review_sha256",
    "review_result_schema",
    "decision",
    "review_summary",
    "findings",
    "finding_counts",
    "eligible",
    "eligibility_reason"
  ],
  "title": "MockExamReviewEligibilityResultV2",
  "type": "object"
}
