{
  "$defs": {
    "MockExamAuthoringEvidenceUsageReceiptPointerV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "attempt": {
          "maximum": 10,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "job_id": {
          "pattern": "^job_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "result_schema": {
          "const": "authoring-result@10.0",
          "title": "Result Schema",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "step_key": {
          "const": "authoring",
          "title": "Step Key",
          "type": "string"
        },
        "step_run_id": {
          "pattern": "^steprun_[0-9a-f]{32}$",
          "title": "Step Run Id",
          "type": "string"
        },
        "workflow_id": {
          "pattern": "^workflow_[0-9a-f]{32}$",
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "step_run_id",
        "attempt",
        "job_id",
        "artifact_id",
        "artifact_revision_id",
        "sha256",
        "receipt_sha256",
        "step_key",
        "result_schema"
      ],
      "title": "MockExamAuthoringEvidenceUsageReceiptPointerV1",
      "type": "object"
    },
    "MockExamReviewEvidenceUsageReceiptPointerV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "attempt": {
          "maximum": 10,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "job_id": {
          "pattern": "^job_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "result_schema": {
          "const": "review-result@10.0",
          "title": "Result Schema",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "step_key": {
          "const": "review",
          "title": "Step Key",
          "type": "string"
        },
        "step_run_id": {
          "pattern": "^steprun_[0-9a-f]{32}$",
          "title": "Step Run Id",
          "type": "string"
        },
        "workflow_id": {
          "pattern": "^workflow_[0-9a-f]{32}$",
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "step_run_id",
        "attempt",
        "job_id",
        "artifact_id",
        "artifact_revision_id",
        "sha256",
        "receipt_sha256",
        "step_key",
        "result_schema"
      ],
      "title": "MockExamReviewEvidenceUsageReceiptPointerV1",
      "type": "object"
    },
    "MockExamReviewFindingCountsV3": {
      "additionalProperties": false,
      "description": "V3 wire form keeps the zero-blocking field explicit rather than defaulted.",
      "properties": {
        "blocking": {
          "const": 0,
          "title": "Blocking",
          "type": "integer"
        },
        "info": {
          "maximum": 20,
          "minimum": 0,
          "title": "Info",
          "type": "integer"
        },
        "warning": {
          "maximum": 20,
          "minimum": 0,
          "title": "Warning",
          "type": "integer"
        }
      },
      "required": [
        "info",
        "warning",
        "blocking"
      ],
      "title": "MockExamReviewFindingCountsV3",
      "type": "object"
    },
    "MockExamTrustedEvidenceUsageReceiptPairV1": {
      "additionalProperties": false,
      "description": "Resolvable authoring/review receipt identities for one trusted RAG Workflow.",
      "properties": {
        "authoring": {
          "$ref": "#/$defs/MockExamAuthoringEvidenceUsageReceiptPointerV1"
        },
        "receipt_schema_version": {
          "const": "evidence-usage-validation-receipt/1.0",
          "title": "Receipt Schema Version",
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/MockExamReviewEvidenceUsageReceiptPointerV1"
        },
        "role_protocol_version": {
          "const": "workflow-role/1.20.0",
          "title": "Role Protocol Version",
          "type": "string"
        },
        "schema_version": {
          "const": "mock-exam-trusted-evidence-usage-receipt-pair/1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "role_protocol_version",
        "receipt_schema_version",
        "authoring",
        "review"
      ],
      "title": "MockExamTrustedEvidenceUsageReceiptPairV1",
      "type": "object"
    }
  },
  "$id": "https://eom.local/schemas/assessment-assembly/mock-exam-item-review-publication-result-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Publication receipt preserving both decision Artifact and trusted source review.",
  "properties": {
    "created": {
      "title": "Created",
      "type": "boolean"
    },
    "decision": {
      "const": "APPROVE",
      "title": "Decision",
      "type": "string"
    },
    "decision_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Decision Sha256",
      "type": "string"
    },
    "final_rating": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Final Rating",
      "type": "string"
    },
    "finding_counts": {
      "$ref": "#/$defs/MockExamReviewFindingCountsV3"
    },
    "human_approval_request_id": {
      "pattern": "^approval_[0-9a-f]{32}$",
      "title": "Human Approval Request Id",
      "type": "string"
    },
    "item_review_record_id": {
      "pattern": "^itemreview_[0-9a-f]{32}$",
      "title": "Item Review Record Id",
      "type": "string"
    },
    "item_revision_id": {
      "pattern": "^itemrev_[0-9a-f]{32}$",
      "title": "Item Revision Id",
      "type": "string"
    },
    "operation": {
      "const": "PUBLISH_MOCK_EXAM_ITEM_REVIEW",
      "title": "Operation",
      "type": "string"
    },
    "rating_policy_revision_id": {
      "pattern": "^ratingpolicyrev_[0-9a-f]{32}$",
      "title": "Rating Policy Revision Id",
      "type": "string"
    },
    "rating_policy_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rating Policy Sha256",
      "type": "string"
    },
    "review_artifact_id": {
      "pattern": "^artifact_[0-9a-f]{32}$",
      "title": "Review Artifact Id",
      "type": "string"
    },
    "review_artifact_revision_id": {
      "pattern": "^rev_[0-9a-f]{32}$",
      "title": "Review Artifact Revision Id",
      "type": "string"
    },
    "review_result_schema": {
      "const": "review-result@10.0",
      "title": "Review Result Schema",
      "type": "string"
    },
    "review_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Review Sha256",
      "type": "string"
    },
    "review_step_run_id": {
      "pattern": "^steprun_[0-9a-f]{32}$",
      "title": "Review Step Run Id",
      "type": "string"
    },
    "reviewer_operator_id": {
      "pattern": "^operator_[0-9a-f]{32}$",
      "title": "Reviewer Operator Id",
      "type": "string"
    },
    "schema_version": {
      "const": "mock-exam-item-review-publication-result/3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_review_artifact_id": {
      "pattern": "^artifact_[0-9a-f]{32}$",
      "title": "Source Review Artifact Id",
      "type": "string"
    },
    "source_review_artifact_revision_id": {
      "pattern": "^rev_[0-9a-f]{32}$",
      "title": "Source Review Artifact Revision Id",
      "type": "string"
    },
    "source_review_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Review Sha256",
      "type": "string"
    },
    "trusted_evidence_usage_receipts": {
      "$ref": "#/$defs/MockExamTrustedEvidenceUsageReceiptPairV1"
    },
    "workflow_id": {
      "pattern": "^workflow_[0-9a-f]{32}$",
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "item_review_record_id",
    "item_revision_id",
    "workflow_id",
    "review_step_run_id",
    "human_approval_request_id",
    "review_artifact_id",
    "review_artifact_revision_id",
    "review_sha256",
    "decision_sha256",
    "review_result_schema",
    "decision",
    "final_rating",
    "finding_counts",
    "reviewer_operator_id",
    "rating_policy_revision_id",
    "rating_policy_sha256",
    "created",
    "source_review_artifact_id",
    "source_review_artifact_revision_id",
    "source_review_sha256",
    "trusted_evidence_usage_receipts"
  ],
  "title": "MockExamItemReviewPublicationResultV3",
  "type": "object"
}
