{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/assessment-assembly/mock-exam-assembly-manifest/1.0",
  "title": "Mock Exam Assembly Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "assessment_assembly_revision_id", "assessment_assembly_id",
    "assessment_form_id", "assessment_form_revision_id", "deliverable_id",
    "deliverable_revision_id", "policy_revision_id", "policy_sha256", "outline_key",
    "outline_revision", "outline_sha256", "graph_snapshot_revision_id", "graph_snapshot_sha256",
    "placements", "validation", "revision_state", "manifest_sha256", "created_at", "created_by"
  ],
  "properties": {
    "schema_version": {"const": "mock-exam-assembly-manifest/1.0"},
    "assessment_assembly_revision_id": {"type": "string", "pattern": "^assemblyrev_[0-9a-f]{32}$"},
    "assessment_assembly_id": {"type": "string", "pattern": "^assembly_[0-9a-f]{32}$"},
    "assessment_form_id": {"type": "string", "pattern": "^form_[0-9a-f]{32}$"},
    "assessment_form_revision_id": {"type": "string", "pattern": "^formrev_[0-9a-f]{32}$"},
    "deliverable_id": {"type": "string", "pattern": "^deliverable_[0-9a-f]{32}$"},
    "deliverable_revision_id": {"type": "string", "pattern": "^delivrev_[0-9a-f]{32}$"},
    "policy_revision_id": {"type": "string", "pattern": "^assemblypolicyrev_[0-9a-f]{32}$"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "outline_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "outline_revision": {"type": "string", "minLength": 1, "maxLength": 32},
    "outline_sha256": {"$ref": "#/$defs/sha256"},
    "graph_snapshot_revision_id": {"type": "string", "pattern": "^graphrev_[0-9a-f]{32}$"},
    "graph_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "placements": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {"$ref": "#/$defs/placement"}
    },
    "validation": {"$ref": "#/$defs/validation"},
    "revision_state": {"const": "RELEASED"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": [
        "placement_id", "position", "display_number", "item_id", "item_revision_id",
        "item_manifest_sha256", "graph_placement_node_id", "curriculum_unit_keys",
        "points_milli", "coverage_role", "coverage_requirement_id", "is_inquiry",
        "item_type_key", "difficulty_band", "material_type", "review_annotation_sha256"
      ],
      "properties": {
        "placement_id": {"type": "string", "pattern": "^placement_[0-9a-f]{32}$"},
        "position": {"type": "integer", "minimum": 1, "maximum": 200},
        "display_number": {"type": "string", "minLength": 1, "maxLength": 32},
        "item_id": {"type": "string", "pattern": "^item_[0-9a-f]{32}$"},
        "item_revision_id": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
        "item_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "graph_placement_node_id": {"type": "string", "pattern": "^knode_[0-9a-f]{32}$"},
        "curriculum_unit_keys": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,191}$"},
          "uniqueItems": true
        },
        "points_milli": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "coverage_role": {"enum": ["REQUIRED", "BALANCE"]},
        "coverage_requirement_id": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
            {"type": "null"}
          ]
        },
        "is_inquiry": {"type": "boolean"},
        "item_type_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "difficulty_band": {"oneOf": [{"type": "string", "maxLength": 64}, {"type": "null"}]},
        "material_type": {"type": "string", "minLength": 1, "maxLength": 64},
        "review_annotation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "item_count", "total_points_milli", "score_distribution", "required_slot_count",
        "balance_slot_count", "inquiry_count", "coverage_requirement_ids", "major_unit_counts"
      ],
      "properties": {
        "item_count": {"type": "integer", "minimum": 1, "maximum": 200},
        "total_points_milli": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "score_distribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "required_slot_count": {"type": "integer", "minimum": 0},
        "balance_slot_count": {"type": "integer", "minimum": 0},
        "inquiry_count": {"type": "integer", "minimum": 0},
        "coverage_requirement_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "major_unit_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    }
  }
}
