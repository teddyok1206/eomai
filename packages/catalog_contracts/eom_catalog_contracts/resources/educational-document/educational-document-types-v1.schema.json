{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/educational-document/types/1.0",
  "title": "EOM Educational Document Types V1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "actorId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "documentId": {"type": "string", "pattern": "^edudoc_[0-9a-f]{32}$"},
    "documentRevisionId": {"type": "string", "pattern": "^edudocrev_[0-9a-f]{32}$"},
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer_type", "artifact_id", "artifact_revision_id", "member_path", "schema_ref", "media_type", "sha256"],
      "properties": {
        "pointer_type": {"const": "ARTIFACT_MEMBER"},
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "member_path": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^(?!/)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+/[^\\u0000-\\u001f\\u007f]+$"},
        "schema_ref": {"type": "string", "pattern": "^eom://schemas/[A-Za-z0-9._/-]{1,220}$"},
        "media_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_key", "document_kind", "publisher_key", "publisher_label", "title", "curriculum_volume", "edition_label", "language"],
      "properties": {
        "document_key": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9-]{2,127}$"},
        "document_kind": {"enum": ["TEXTBOOK", "REFERENCE_BOOK", "CURRICULUM", "GUIDANCE"]},
        "publisher_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "publisher_label": {"type": "string", "minLength": 1, "maxLength": 100},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "curriculum_volume": {"type": ["string", "null"], "enum": ["I", "II", null]},
        "edition_label": {"type": "string", "minLength": 1, "maxLength": 100},
        "language": {"const": "ko-KR"}
      },
      "allOf": [{
        "if": {"properties": {"document_kind": {"const": "TEXTBOOK"}}, "required": ["document_kind"]},
        "then": {"properties": {"curriculum_volume": {"enum": ["I", "II"]}}}
      }]
    },
    "rightsAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "rights_attestation_id", "source_sha256", "source_media_type", "rights_state", "basis", "permitted_uses", "allowed_roles", "answer_bearing", "attribution_required", "retention_policy_key", "withdrawal_behavior", "confirmation_reference", "reviewed_at", "reviewed_by", "rights_attestation_sha256"],
      "properties": {
        "schema_version": {"const": "educational-document-rights-attestation/1.0"},
        "rights_attestation_id": {"type": "string", "pattern": "^edurights_[0-9a-f]{32}$"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_media_type": {"const": "application/pdf"},
        "rights_state": {"const": "CLEARED_LICENSED"},
        "basis": {"const": "PURCHASED_AND_NEGOTIATED"},
        "permitted_uses": {
          "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
          "items": {"enum": ["INTERNAL_ARCHIVAL", "TEXT_EXTRACTION", "KNOWLEDGE_ANALYSIS", "GRAPH_INDEXING", "ITEM_AUTHORING_GROUNDING", "INTERNAL_REVIEW"]}
        },
        "allowed_roles": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": {"enum": ["ADMIN", "RIGHTS_REVIEWER", "DATA_ANALYST_WORKER", "ITEM_AUTHORING_WORKER", "HUMAN_EDITOR"]}
        },
        "answer_bearing": {"type": "boolean"},
        "attribution_required": {"type": "boolean"},
        "retention_policy_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
        "withdrawal_behavior": {"const": "RETIRE_FROM_NEW_RETRIEVAL"},
        "confirmation_reference": {"type": "string", "minLength": 8, "maxLength": 200},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "reviewed_by": {"$ref": "#/$defs/actorId"},
        "rights_attestation_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
