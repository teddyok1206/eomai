{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/content-planning/edition-composition/1.0",
  "title": "Edition composition: exact Form revisions and ordered section tree",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deliverable_id",
    "edition_id",
    "deliverable_revision_id",
    "revision_number",
    "previous_revision_id",
    "content_title",
    "content_type",
    "edition_label",
    "academic_year",
    "sections",
    "created_by",
    "created_at",
    "composition_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "content-edition-composition/1.0"
    },
    "deliverable_id": {
      "type": "string",
      "pattern": "^deliverable_[0-9a-f]{32}$"
    },
    "edition_id": {
      "type": "string",
      "pattern": "^edition_[0-9a-f]{32}$"
    },
    "deliverable_revision_id": {
      "type": "string",
      "pattern": "^delivrev_[0-9a-f]{32}$"
    },
    "revision_number": {
      "type": "integer",
      "minimum": 1
    },
    "previous_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^delivrev_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "content_type": {
      "enum": [
        "MOCK_EXAM",
        "TEXTBOOK",
        "WEEKLY",
        "OTHER"
      ]
    },
    "edition_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "academic_year": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1900,
          "maximum": 3000
        },
        {
          "type": "null"
        }
      ]
    },
    "sections": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "eom://schemas/content-planning/edition-composition/1.0#/$defs/section"
      }
    },
    "created_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "composition_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "form_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_id",
        "form_revision_id",
        "form_sha256",
        "assembly_id",
        "assembly_revision_id",
        "manifest_sha256",
        "placement_count"
      ],
      "properties": {
        "form_id": {
          "type": "string",
          "pattern": "^form_[0-9a-f]{32}$"
        },
        "form_revision_id": {
          "type": "string",
          "pattern": "^formrev_[0-9a-f]{32}$"
        },
        "form_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "assembly_id": {
          "type": "string",
          "pattern": "^assembly_[0-9a-f]{32}$"
        },
        "assembly_revision_id": {
          "type": "string",
          "pattern": "^assemblyrev_[0-9a-f]{32}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "placement_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "parent_id",
        "kind",
        "ordinal",
        "label",
        "numbering",
        "form"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^section_[0-9a-f]{32}$"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^section_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "GROUP",
            "FORM"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "numbering": {
          "enum": [
            "RESET_PER_SECTION",
            "CONTINUE_WITHIN_GROUP"
          ]
        },
        "form": {
          "anyOf": [
            {
              "$ref": "eom://schemas/content-planning/edition-composition/1.0#/$defs/form_pointer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "GROUP"
              }
            }
          },
          "then": {
            "properties": {
              "form": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "form": {
                "$ref": "eom://schemas/content-planning/edition-composition/1.0#/$defs/form_pointer"
              }
            }
          }
        }
      ]
    }
  }
}
