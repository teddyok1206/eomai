{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/content-intake/uncertainties-v1",
  "title": "EOM Content Intake Uncertainties V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch_id": {"type": "string", "pattern": "^intake_[0-9a-f]{32}$"},
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "description", "blocking"],
        "properties": {
          "key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "blocking": {"type": "boolean"}
        }
      }
    }
  }
}
