{
  "$defs": {
    "memberPointer": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "type": "string"
        },
        "content_length": {
          "maximum": 268435456,
          "minimum": 1,
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "application/vnd.hancom.hwp",
            "application/vnd.hancom.hwpx",
            "image/png",
            "application/json"
          ]
        },
        "member_path": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "schema_ref": {
          "pattern": "^eom://schemas/document-review/[a-z0-9-]+/[12]\\.0$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "sha256",
        "content_length",
        "media_type",
        "schema_ref"
      ],
      "type": "object"
    }
  },
  "$id": "eom://schemas/catalog/document-review-hwpx-correction-request/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "base_hwpx": {
      "$ref": "#/$defs/memberPointer"
    },
    "finding_ids": {
      "items": {
        "pattern": "^reviewfinding_[0-9a-f]{32}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 16,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,255}$",
      "type": "string"
    },
    "operation": {
      "const": "APPLY_DOCUMENT_REVIEW_HWPX_CORRECTIONS"
    },
    "review_result": {
      "$ref": "#/$defs/memberPointer"
    },
    "schema_version": {
      "const": "document-review-hwpx-correction-request/1.0"
    },
    "workflow_id": {
      "pattern": "^workflow_[0-9a-f]{32}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "actor_id",
    "idempotency_key",
    "workflow_id",
    "review_result",
    "base_hwpx",
    "finding_ids"
  ],
  "title": "EOM Document Review HWPX Correction Request V1",
  "type": "object"
}
