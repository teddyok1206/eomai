{
  "$id": "eom://schemas/catalog-application/catalog-item-component-media-request/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "component_type": {"const": "IMAGE"},
    "item_revision_id": {"pattern": "^itemrev_[a-z0-9]{8,55}$", "type": "string"},
    "operation": {"const": "GET_ITEM_COMPONENT_MEDIA"},
    "ordinal": {"maximum": 1, "minimum": 0, "type": "integer"}
  },
  "required": ["operation", "item_revision_id", "component_type", "ordinal"],
  "title": "Catalog Item Component Media Request V1",
  "type": "object"
}
