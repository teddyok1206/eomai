{
  "$id": "eom://schemas/catalog-application/catalog-item-media-request/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "block_id": {"pattern": "^block_[a-z][a-z0-9_]{0,63}$", "type": "string"},
    "item_revision_id": {"pattern": "^itemrev_[a-z0-9]{8,55}$", "type": "string"},
    "operation": {"const": "GET_ITEM_MEDIA"}
  },
  "required": ["operation", "item_revision_id", "block_id"],
  "title": "Catalog Item Media Request V1",
  "type": "object"
}
