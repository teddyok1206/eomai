      "description": "Immutable source/archive identity used by every renderer attempt.",
      "properties": {
        "archive_file": {
          "const": "input/handoff.zip",
          "title": "Archive File",
          "type": "string"
        },
        "archive_sha256": {
          "const": "sha256:dc1c9e254a31fc235824eddbb366a5fac52a4d03e3b334bd5e325fb52391ea91",
          "title": "Archive Sha256",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^artifact_[a-f0-9]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[a-f0-9]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "entry_count": {
          "const": 606,
          "title": "Entry Count",
          "type": "integer"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/V2ContentTeamHandoffMember"
          },
          "maxItems": 10,
          "minItems": 10,
          "title": "Members",
          "type": "array"
        },
        "profile_sha256": {
          "const": "sha256:ce08671ad433026ec51e68ddfc6a4d7ffe33ae8a792c1791dfa26b9b62e78863",
          "title": "Profile Sha256",
          "type": "string"
        },
        "uncompressed_bytes": {
          "const": 49280719,
          "title": "Uncompressed Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "archive_sha256",
        "archive_file",
        "entry_count",
        "uncompressed_bytes",
        "profile_sha256",
        "members"
      ],
      "title": "ContentTeamHandoffSnapshot",
      "type": "object"
    },
    "V2ContentTeamHandoffMember": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "automation-template",
            "equation-prototypes",
            "visual-slots-left-right",
            "visual-slots-two-tables",
            "labeled-data-condition",
            "table-2-column",
            "table-3-column",
            "table-3-column-long-equation",
            "table-4-column",
            "inquiry-experiment-box"
