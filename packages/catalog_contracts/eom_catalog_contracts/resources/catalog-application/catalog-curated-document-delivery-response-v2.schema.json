          "title": "Purpose",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 26214400,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "purpose",
        "sha256",
        "size"
      ],
      "title": "ContentTeamHandoffMember",
      "type": "object"
    },
    "CuratedHwpxBuildInputV2": {
      "title": "Pinned curated HWPX build inputs",
      "description": "Metadata-only input snapshot. No content bodies, image bytes, worker authority or filesystem paths.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "assembly_id",
        "assembly_revision_id",
        "assembly_manifest_sha256",
        "profile",
        "renderer_version",
        "handoff",
        "converter",
        "placements"
      ],
      "properties": {
        "schema_version": {
          "const": "curated-hwpx-build-input/2.0"
        },
        "assembly_id": {
          "type": "string",
          "pattern": "^assembly_[0-9a-f]{32}$"
        },
        "assembly_revision_id": {
          "type": "string",
          "pattern": "^assemblyrev_[0-9a-f]{32}$"
        },
        "assembly_manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "profile": {
          "const": "CURATED_EDITABLE_OCCURRENCES_V2"
        },
        "renderer_version": {
          "const": "2.0.0"
        },
        "handoff": {
          "anyOf": [
            {
              "$ref": "#/$defs/V2ContentTeamHandoffSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "converter": {
          "anyOf": [
            {
              "$ref": "#/$defs/V2ConverterSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/V2NativeDocument"
              },
              {
                "$ref": "#/$defs/V2RegisteredItem"
              }
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "properties": {
    "operation": {
