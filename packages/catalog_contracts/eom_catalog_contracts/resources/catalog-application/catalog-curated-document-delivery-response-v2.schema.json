        "placements": {
          "items": {
            "$ref": "#/$defs/CuratedBuildPlacement"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Placements",
          "type": "array"
        }
      },
      "required": [
        "assembly_id",
        "assembly_revision_id",
        "assembly_manifest_sha256",
        "handoff",
        "converter",
        "placements"
      ],
      "title": "CuratedHwpxBuildInput",
      "type": "object"
    },
