{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/catalog-application/catalog-application-request-v15",
  "title": "EOM Catalog Mock Exam Assembly Request V15",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cohort": {
      "$ref": "eom://schemas/assessment-assembly/mock-exam-assembly-cohort/1.0"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "item_id",
        "item_revision_id",
        "item_manifest_sha256",
        "graph_placement_node_id",
        "curriculum_unit_keys",
        "points_milli",
        "coverage_role",
        "coverage_requirement_id",
        "is_inquiry",
        "material_type"
      ],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 200},
        "item_id": {"type": "string", "pattern": "^item_[0-9a-f]{32}$"},
        "item_revision_id": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
        "item_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "graph_placement_node_id": {
          "type": "string",
          "pattern": "^knode_[0-9a-f]{32}$"
        },
        "curriculum_unit_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 191}
        },
        "points_milli": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "coverage_role": {"enum": ["REQUIRED", "BALANCE"]},
        "coverage_requirement_id": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
            }
          ]
        },
        "is_inquiry": {"type": "boolean"},
        "material_type": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "policy_revision_id",
        "policy_sha256",
        "graph_snapshot_revision_id",
        "graph_snapshot_sha256"
      ],
      "properties": {
        "operation": {"const": "PREVIEW_MOCK_EXAM_ASSEMBLY_PLAN"},
        "policy_revision_id": {
          "type": "string",
          "pattern": "^assemblypolicyrev_[0-9a-f]{32}$"
        },
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "graph_snapshot_revision_id": {
          "type": "string",
          "pattern": "^graphrev_[0-9a-f]{32}$"
        },
        "graph_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "cohort": {"$ref": "#/$defs/cohort"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "deliverable_id",
        "deliverable_revision_id",
        "form_key",
        "display_label",
        "policy_revision_id",
        "policy_sha256",
        "graph_snapshot_revision_id",
        "graph_snapshot_sha256",
        "placements",
        "actor_id"
      ],
      "properties": {
        "operation": {"const": "CREATE_MOCK_EXAM_ASSEMBLY"},
        "deliverable_id": {
          "type": "string",
          "pattern": "^deliverable_[0-9a-f]{32}$"
        },
        "deliverable_revision_id": {
          "type": "string",
          "pattern": "^delivrev_[0-9a-f]{32}$"
        },
        "form_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "display_label": {"type": "string", "minLength": 1, "maxLength": 128},
        "policy_revision_id": {
          "type": "string",
          "pattern": "^assemblypolicyrev_[0-9a-f]{32}$"
        },
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "graph_snapshot_revision_id": {
          "type": "string",
          "pattern": "^graphrev_[0-9a-f]{32}$"
        },
        "graph_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "placements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {"$ref": "#/$defs/selection"}
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "deliverable_id",
        "deliverable_revision_id",
        "form_key",
        "display_label",
        "policy_revision_id",
        "policy_sha256",
        "graph_snapshot_revision_id",
        "graph_snapshot_sha256",
        "expected_plan_sha256",
        "planned_at",
        "actor_id"
      ],
      "properties": {
        "operation": {"const": "CREATE_PLANNED_MOCK_EXAM_ASSEMBLY"},
        "deliverable_id": {
          "type": "string",
          "pattern": "^deliverable_[0-9a-f]{32}$"
        },
        "deliverable_revision_id": {
          "type": "string",
          "pattern": "^delivrev_[0-9a-f]{32}$"
        },
        "form_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "display_label": {"type": "string", "minLength": 1, "maxLength": 128},
        "policy_revision_id": {
          "type": "string",
          "pattern": "^assemblypolicyrev_[0-9a-f]{32}$"
        },
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "graph_snapshot_revision_id": {
          "type": "string",
          "pattern": "^graphrev_[0-9a-f]{32}$"
        },
        "graph_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "cohort": {"$ref": "#/$defs/cohort"},
        "expected_plan_sha256": {"$ref": "#/$defs/sha256"},
        "planned_at": {"type": "string", "format": "date-time"},
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "assessment_assembly_revision_id"],
      "properties": {
        "operation": {"const": "INSPECT_MOCK_EXAM_ASSEMBLY"},
        "assessment_assembly_revision_id": {
          "type": "string",
          "pattern": "^assemblyrev_[0-9a-f]{32}$"
        }
      }
    }
  ]
}
