{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/catalog-application/catalog-application-request-v4",
  "title": "EOM Catalog Application Request V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation", "requirement", "evidence_budget", "access_policy_revision_id",
    "access_policy_sha256", "requester_role", "requester_permission_keys",
    "requested_by", "idempotency_key", "submission_sha256"
  ],
  "properties": {
    "operation": {"const": "CREATE_ITEM_PRODUCTION_EVIDENCE"},
    "requirement": {"$ref": "eom://schemas/knowledge/educational-retrieval-requirement/1.0"},
    "evidence_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_documents", "max_item_revisions", "max_graph_nodes", "max_claims", "max_context_tokens"],
      "properties": {
        "max_documents": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_item_revisions": {"type": "integer", "minimum": 0, "maximum": 64},
        "max_graph_nodes": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_claims": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_context_tokens": {"type": "integer", "minimum": 1000, "maximum": 32000}
      }
    },
    "access_policy_revision_id": {"type": "string", "pattern": "^accessrev_[0-9a-f]{32}$"},
    "access_policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requester_role": {"enum": ["ADMIN", "EDITOR", "REVIEWER"]},
    "requester_permission_keys": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$", "maxLength": 128}
    },
    "requested_by": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[!-~]+$"},
    "submission_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
