{
  "$defs": {
    "outputPointer": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "type": "string"
        },
        "content_length": {
          "maximum": 536870912,
          "minimum": 1,
          "type": "integer"
        },
        "document_role": {
          "enum": [
            "DOCUMENT",
            "QUESTION",
            "SOLUTION"
          ]
        },
        "media_type": {
          "const": "application/pdf"
        },
        "member_path": {
          "enum": [
            "annotated/document.pdf",
            "annotated/question.pdf",
            "annotated/solution.pdf"
          ]
        },
        "schema_ref": {
          "const": "eom://schemas/document-review/annotated-pdf/1.0"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "document_role",
        "member_path",
        "sha256",
        "content_length",
        "media_type",
        "schema_ref"
      ],
      "type": "object"
    }
  },
  "$id": "eom://schemas/catalog/document-review-pdf-annotation-media-request/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_id": {
      "pattern": "^docannotation_[0-9a-f]{32}$",
      "type": "string"
    },
    "document_role": {
      "enum": [
        "DOCUMENT",
        "QUESTION",
        "SOLUTION"
      ]
    },
    "operation": {
      "const": "GET_DOCUMENT_REVIEW_ANNOTATED_PDF"
    },
    "output": {
      "$ref": "#/$defs/outputPointer"
    },
    "schema_version": {
      "const": "document-review-pdf-annotation-media-request/1.0"
    },
    "workflow_id": {
      "pattern": "^workflow_[0-9a-f]{32}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "workflow_id",
    "annotation_id",
    "document_role",
    "output"
  ],
  "title": "EOM Document Review PDF Annotation Media Request V1",
  "type": "object"
}
