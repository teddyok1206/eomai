{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/room-snapshot/1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "kakao-room-snapshot/1.0"
    },
    "source_binding_id": {
      "type": "string",
      "pattern": "^kakaobinding_[0-9a-f]{32}$"
    },
    "room_id": {
      "type": "string",
      "pattern": "^kakaoroom_[0-9a-f]{32}$"
    },
    "snapshot_revision_id": {
      "type": "string",
      "pattern": "^kakaosnapshotrev_[0-9a-f]{32}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "csv_scope": {
      "enum": [
        "full_accessible_history",
        "loaded_window",
        "explicit_range",
        "unknown"
      ]
    }
  },
  "required": [
    "schema_version",
    "source_binding_id",
    "room_id",
    "snapshot_revision_id",
    "source_sha256",
    "source_bytes",
    "observed_at_utc",
    "csv_scope"
  ]
}
