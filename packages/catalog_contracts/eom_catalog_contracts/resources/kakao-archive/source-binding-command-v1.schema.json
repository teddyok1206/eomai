{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/source-binding-command-v1/1.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "action",
        "parent_policy_revision_id",
        "expected_resource_version",
        "policy"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-binding-command/1.0"
        },
        "action": {
          "const": "UPDATE_COLLECTION_POLICY"
        },
        "parent_policy_revision_id": {
          "type": "string",
          "pattern": "^kakaopolicyrev_[0-9a-f]{32}$"
        },
        "expected_resource_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interval_minutes",
            "include_images",
            "source_timezone",
            "question_rule_version"
          ],
          "properties": {
            "interval_minutes": {
              "type": "integer",
              "minimum": 60,
              "maximum": 10080
            },
            "include_images": {
              "const": true
            },
            "source_timezone": {
              "enum": [
                "unknown",
                "Asia/Seoul"
              ]
            },
            "question_rule_version": {
              "const": "turn_v1"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "action",
        "parent_policy_revision_id",
        "expected_resource_version"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-binding-command/1.0"
        },
        "action": {
          "const": "RETIRE"
        },
        "parent_policy_revision_id": {
          "type": "string",
          "pattern": "^kakaopolicyrev_[0-9a-f]{32}$"
        },
        "expected_resource_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    }
  ]
}
