{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/catalog-kakao-question-v1/1.0",
  "title": "Private question API owner messages and exact read projections",
  "$defs": {
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "block_id",
        "role",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "TEXT"
        },
        "block_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "enum": [
            "student",
            "staff"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "Image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "block_id",
        "role",
        "attachment_id",
        "attachment_revision_id",
        "availability",
        "source_quality"
      ],
      "properties": {
        "kind": {
          "const": "IMAGE"
        },
        "block_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "enum": [
            "student",
            "staff"
          ]
        },
        "attachment_id": {
          "type": "string",
          "pattern": "^kakaoattachment_[0-9a-f]{32}$"
        },
        "attachment_revision_id": {
          "type": "string",
          "pattern": "^kakaoattachmentrev_[0-9a-f]{32}$"
        },
        "availability": {
          "enum": [
            "available",
            "expired",
            "denied",
            "not_found",
            "pending",
            "failed"
          ]
        },
        "source_quality": {
          "enum": [
            "ORIGINAL",
            "BEST_AVAILABLE",
            "UNKNOWN"
          ]
        }
      }
    },
    "View": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "question",
        "ordered_blocks",
        "review_reasons",
        "boundary_uncertain"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-question-view/1.0"
        },
        "question": {
          "$ref": "eom://schemas/kakao-archive/question-store-v1/1.0#/$defs/Stored"
        },
        "ordered_blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 230,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Text"
              },
              {
                "$ref": "#/$defs/Image"
              }
            ]
          }
        },
        "review_reasons": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,79}$"
          }
        },
        "boundary_uncertain": {
          "type": "boolean"
        }
      }
    },
    "Media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_binding_id",
        "room_id",
        "question_id",
        "question_revision_id",
        "attachment_id",
        "media_type",
        "content_length",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-question-image/1.0"
        },
        "source_binding_id": {
          "type": "string",
          "pattern": "^kakaobinding_[0-9a-f]{32}$"
        },
        "room_id": {
          "type": "string",
          "pattern": "^kakaoroom_[0-9a-f]{32}$"
        },
        "question_id": {
          "type": "string",
          "pattern": "^kakaoquestion_[0-9a-f]{32}$"
        },
        "question_revision_id": {
          "type": "string",
          "pattern": "^kakaoquestionrev_[0-9a-f]{32}$"
        },
        "attachment_id": {
          "type": "string",
          "pattern": "^kakaoattachment_[0-9a-f]{32}$"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "content_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "actor_id",
        "session_id",
        "request_id",
        "authentication_time",
        "command",
        "idempotency_key"
      ],
      "properties": {
        "operation": {
          "const": "CREATE_KAKAO_QUESTION"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^operator_[0-9a-f]{32}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^apisession_[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "authentication_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "command": {
          "$ref": "eom://schemas/kakao-archive/question-store-v1/1.0#/$defs/Create"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[!-~]{16,128}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "actor_id",
        "session_id",
        "request_id",
        "authentication_time",
        "command",
        "idempotency_key"
      ],
      "properties": {
        "operation": {
          "const": "CHANGE_KAKAO_QUESTION"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^operator_[0-9a-f]{32}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^apisession_[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "authentication_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "command": {
          "$ref": "eom://schemas/kakao-archive/question-store-v1/1.0#/$defs/Change"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[!-~]{16,128}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "actor_id",
        "session_id",
        "request_id",
        "authentication_time",
        "source_binding_id",
        "room_id",
        "question_id",
        "question_revision_id"
      ],
      "properties": {
        "operation": {
          "const": "READ_KAKAO_QUESTION"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^operator_[0-9a-f]{32}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^apisession_[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "authentication_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "source_binding_id": {
          "type": "string",
          "pattern": "^kakaobinding_[0-9a-f]{32}$"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^kakaoroom_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_id": {
          "type": "string",
          "pattern": "^kakaoquestion_[0-9a-f]{32}$"
        },
        "question_revision_id": {
          "type": "string",
          "pattern": "^kakaoquestionrev_[0-9a-f]{32}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "actor_id",
        "session_id",
        "request_id",
        "authentication_time",
        "source_binding_id",
        "room_id",
        "limit",
        "cursor"
      ],
      "properties": {
        "operation": {
          "const": "LIST_KAKAO_QUESTIONS"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^operator_[0-9a-f]{32}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^apisession_[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "authentication_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "source_binding_id": {
          "type": "string",
          "pattern": "^kakaobinding_[0-9a-f]{32}$"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^kakaoroom_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^kakaoquestion_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "actor_id",
        "session_id",
        "request_id",
        "authentication_time",
        "source_binding_id",
        "room_id",
        "question_id",
        "question_revision_id",
        "attachment_id"
      ],
      "properties": {
        "operation": {
          "const": "READ_KAKAO_QUESTION_IMAGE"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^operator_[0-9a-f]{32}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^apisession_[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "authentication_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "source_binding_id": {
          "type": "string",
          "pattern": "^kakaobinding_[0-9a-f]{32}$"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^kakaoroom_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_id": {
          "type": "string",
          "pattern": "^kakaoquestion_[0-9a-f]{32}$"
        },
        "question_revision_id": {
          "type": "string",
          "pattern": "^kakaoquestionrev_[0-9a-f]{32}$"
        },
        "attachment_id": {
          "type": "string",
          "pattern": "^kakaoattachment_[0-9a-f]{32}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "request_id",
        "status",
        "result",
        "error_code"
      ],
      "properties": {
        "operation": {
          "const": "CREATE_KAKAO_QUESTION"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "status": {
          "const": "OK"
        },
        "result": {
          "$ref": "eom://schemas/kakao-archive/question-store-v1/1.0#/$defs/Mutation"
        },
        "error_code": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "request_id",
        "status",
        "result",
        "error_code"
      ],
      "properties": {
        "operation": {
          "const": "CHANGE_KAKAO_QUESTION"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "status": {
          "const": "OK"
        },
        "result": {
          "$ref": "eom://schemas/kakao-archive/question-store-v1/1.0#/$defs/Mutation"
        },
        "error_code": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "request_id",
        "status",
        "result",
        "error_code"
      ],
      "properties": {
        "operation": {
          "const": "READ_KAKAO_QUESTION"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "status": {
          "const": "OK"
        },
        "result": {
          "$ref": "#/$defs/View"
        },
        "error_code": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "request_id",
        "status",
        "result",
        "error_code"
      ],
      "properties": {
        "operation": {
          "const": "LIST_KAKAO_QUESTIONS"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "status": {
          "const": "OK"
        },
        "result": {
          "$ref": "eom://schemas/kakao-archive/question-store-v1/1.0#/$defs/Page"
        },
        "error_code": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "request_id",
        "status",
        "result",
        "error_code"
      ],
      "properties": {
        "operation": {
          "const": "READ_KAKAO_QUESTION_IMAGE"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "status": {
          "const": "OK"
        },
        "result": {
          "$ref": "#/$defs/Media"
        },
        "error_code": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "request_id",
        "status",
        "result",
        "error_code"
      ],
      "properties": {
        "operation": {
          "enum": [
            "CREATE_KAKAO_QUESTION",
            "CHANGE_KAKAO_QUESTION",
            "READ_KAKAO_QUESTION",
            "LIST_KAKAO_QUESTIONS",
            "READ_KAKAO_QUESTION_IMAGE"
          ]
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "status": {
          "const": "ERROR"
        },
        "result": {
          "type": "null"
        },
        "error_code": {
          "enum": [
            "KAKAO_ARCHIVE_REQUEST_INVALID",
            "KAKAO_ARCHIVE_PERMISSION_DENIED",
            "KAKAO_ARCHIVE_RESOURCE_NOT_FOUND",
            "KAKAO_ARCHIVE_PRECONDITION_FAILED",
            "KAKAO_ARCHIVE_IDEMPOTENCY_CONFLICT",
            "KAKAO_ARCHIVE_BINDING_RETIRED",
            "KAKAO_ARCHIVE_ROOM_RETIRED",
            "KAKAO_ARCHIVE_STUDENT_RETIRED",
            "KAKAO_ARCHIVE_CANDIDATE_NOT_FOUND",
            "KAKAO_ARCHIVE_CANDIDATE_ALREADY_REGISTERED",
            "KAKAO_ARCHIVE_QUESTION_SELECTION_INVALID",
            "KAKAO_ARCHIVE_STORED_QUESTION_INVALID",
            "KAKAO_ARCHIVE_STORED_SOURCE_INVALID",
            "KAKAO_ARCHIVE_ADMISSION_EVIDENCE_INVALID",
            "KAKAO_ARCHIVE_IMAGE_UNAVAILABLE",
            "KAKAO_ARCHIVE_SOURCE_BYTES_LIMIT",
            "KAKAO_ARCHIVE_RESULT_INVALID",
            "KAKAO_ARCHIVE_RESULT_TOO_LARGE",
            "CATALOG_APPLICATION_UNAVAILABLE",
            "CATALOG_APPLICATION_INTERNAL_ERROR"
          ]
        }
      }
    },
    {
      "$ref": "#/$defs/View"
    },
    {
      "$ref": "#/$defs/Media"
    }
  ]
}
