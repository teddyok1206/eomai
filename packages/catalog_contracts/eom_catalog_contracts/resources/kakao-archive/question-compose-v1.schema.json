{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/question-compose-v1/1.0",
  "title": "Exact private question split and merge selections, without client-supplied content or authority",
  "$defs": {
    "Input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question_revision_id", "resource_version"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^kakaoquestion_[0-9a-f]{32}$"},
        "question_revision_id": {"type": "string", "pattern": "^kakaoquestionrev_[0-9a-f]{32}$"},
        "resource_version": {"type": "integer", "minimum": 1, "maximum": 2147483646}
      }
    },
    "Block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "block_id"],
      "properties": {
        "kind": {"const": "BLOCK"},
        "block_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"}
      }
    },
    "TextSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "block_id", "start_codepoint", "end_codepoint"],
      "properties": {
        "kind": {"const": "TEXT_SPAN"},
        "block_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
        "start_codepoint": {"type": "integer", "minimum": 0, "maximum": 65535},
        "end_codepoint": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "Partition": {
      "type": "array",
      "minItems": 1,
      "maxItems": 230,
      "items": {"oneOf": [{"$ref": "#/$defs/Block"}, {"$ref": "#/$defs/TextSpan"}]}
    },
    "Split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "source_binding_id", "room_id", "input", "partitions"],
      "properties": {
        "schema_version": {"const": "kakao-question-compose/1.0"},
        "operation": {"const": "SPLIT"},
        "source_binding_id": {"type": "string", "pattern": "^kakaobinding_[0-9a-f]{32}$"},
        "room_id": {"type": "string", "pattern": "^kakaoroom_[0-9a-f]{32}$"},
        "input": {"$ref": "#/$defs/Input"},
        "partitions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/Partition"}
        }
      }
    },
    "Merge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "source_binding_id", "room_id", "inputs"],
      "properties": {
        "schema_version": {"const": "kakao-question-compose/1.0"},
        "operation": {"const": "MERGE"},
        "source_binding_id": {"type": "string", "pattern": "^kakaobinding_[0-9a-f]{32}$"},
        "room_id": {"type": "string", "pattern": "^kakaoroom_[0-9a-f]{32}$"},
        "inputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/Input"}
        }
      }
    }
  },
  "oneOf": [{"$ref": "#/$defs/Split"}, {"$ref": "#/$defs/Merge"}]
}
