{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/study-store-v1/1.0",
  "oneOf": [
    {
      "$ref": "#/$defs/create"
    },
    {
      "$ref": "#/$defs/revise"
    },
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/stored"
    },
    {
      "$ref": "#/$defs/mutation"
    },
    {
      "$ref": "#/$defs/page"
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "binding": {
      "type": "string",
      "pattern": "^kakaobinding_[0-9a-f]{32}$"
    },
    "packet": {
      "type": "string",
      "pattern": "^kakaopacket_[0-9a-f]{32}$"
    },
    "packet_revision": {
      "type": "string",
      "pattern": "^kakaopacketrev_[0-9a-f]{32}$"
    },
    "student": {
      "type": "string",
      "pattern": "^kakaostudent_[0-9a-f]{32}$"
    },
    "study": {
      "type": "string",
      "pattern": "^kakaostudy_[0-9a-f]{32}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^kakaostudyrev_[0-9a-f]{32}$"
    },
    "question_revision": {
      "type": "string",
      "pattern": "^kakaoquestionrev_[0-9a-f]{32}$"
    },
    "task": {
      "type": "string",
      "pattern": "^kakaoconcepttask_[0-9a-f]{32}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "pointer": {
      "$ref": "eom://schemas/kakao-archive/question-manifest-v1/1.0#/$defs/pointer"
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_index",
        "title",
        "relevance",
        "explanation",
        "capture_indices"
      ],
      "properties": {
        "block_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "relevance": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            {
              "type": "null"
            }
          ]
        },
        "capture_indices": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 0,
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "text"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_revision_id",
        "concept_task_id",
        "blocks",
        "notes"
      ],
      "properties": {
        "question_revision_id": {
          "$ref": "#/$defs/question_revision"
        },
        "concept_task_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/task"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "notes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/note"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "concept_task_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "blocks": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edit",
        "result"
      ],
      "properties": {
        "edit": {
          "$ref": "#/$defs/edit"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "eom://schemas/kakao-archive/concept-knowledge/1.0#/$defs/result_pin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "edit": {
                "properties": {
                  "concept_task_id": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "result": {
                "$ref": "eom://schemas/kakao-archive/concept-knowledge/1.0#/$defs/result_pin"
              }
            }
          }
        }
      ]
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_binding_id",
        "packet_id",
        "packet_revision_id",
        "student_id",
        "title",
        "questions"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-study-create/1.0"
        },
        "source_binding_id": {
          "$ref": "#/$defs/binding"
        },
        "packet_id": {
          "$ref": "#/$defs/packet"
        },
        "packet_revision_id": {
          "$ref": "#/$defs/packet_revision"
        },
        "student_id": {
          "$ref": "#/$defs/student"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/edit"
          }
        }
      }
    },
    "revise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_binding_id",
        "packet_id",
        "packet_revision_id",
        "student_id",
        "title",
        "questions",
        "study_id",
        "parent_revision_id",
        "expected_resource_version"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-study-revise/1.0"
        },
        "source_binding_id": {
          "$ref": "#/$defs/binding"
        },
        "packet_id": {
          "$ref": "#/$defs/packet"
        },
        "packet_revision_id": {
          "$ref": "#/$defs/packet_revision"
        },
        "student_id": {
          "$ref": "#/$defs/student"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/edit"
          }
        },
        "study_id": {
          "$ref": "#/$defs/study"
        },
        "parent_revision_id": {
          "$ref": "#/$defs/revision"
        },
        "expected_resource_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "study_id",
        "study_revision_id",
        "previous_revision_id",
        "resource_version",
        "source_binding_id",
        "packet_id",
        "packet_revision_id",
        "student_id",
        "title",
        "packet_manifest",
        "subset_sha256",
        "questions",
        "created_at",
        "created_by"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-study-manifest/1.0"
        },
        "study_id": {
          "$ref": "#/$defs/study"
        },
        "study_revision_id": {
          "$ref": "#/$defs/revision"
        },
        "previous_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "source_binding_id": {
          "$ref": "#/$defs/binding"
        },
        "packet_id": {
          "$ref": "#/$defs/packet"
        },
        "packet_revision_id": {
          "$ref": "#/$defs/packet_revision"
        },
        "student_id": {
          "$ref": "#/$defs/student"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "packet_manifest": {
          "allOf": [
            {
              "$ref": "#/$defs/pointer"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/kakao-archive/question-packet-v1/1.0"
                },
                "media_type": {
                  "const": "application/json"
                },
                "member_path": {
                  "const": "packet.json"
                }
              }
            }
          ]
        },
        "subset_sha256": {
          "$ref": "#/$defs/hash"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "created_by": {
          "type": "string",
          "pattern": "^operator_[0-9a-f]{32}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resource_version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "previous_revision_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "previous_revision_id": {
                "$ref": "#/$defs/revision"
              }
            }
          }
        }
      ]
    },
    "stored": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "study_id",
        "study_revision_id",
        "previous_revision_id",
        "resource_version",
        "source_binding_id",
        "packet_id",
        "packet_revision_id",
        "student_id",
        "title",
        "question_count",
        "manifest",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-stored-study/1.0"
        },
        "study_id": {
          "$ref": "#/$defs/study"
        },
        "study_revision_id": {
          "$ref": "#/$defs/revision"
        },
        "previous_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "source_binding_id": {
          "$ref": "#/$defs/binding"
        },
        "packet_id": {
          "$ref": "#/$defs/packet"
        },
        "packet_revision_id": {
          "$ref": "#/$defs/packet_revision"
        },
        "student_id": {
          "$ref": "#/$defs/student"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "question_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "manifest": {
          "allOf": [
            {
              "$ref": "#/$defs/pointer"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/kakao-archive/study-store-v1/1.0"
                },
                "media_type": {
                  "const": "application/json"
                },
                "member_path": {
                  "const": "study.json"
                }
              }
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resource_version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "previous_revision_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "previous_revision_id": {
                "$ref": "#/$defs/revision"
              }
            }
          }
        }
      ]
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "study",
        "replayed"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-study-mutation/1.0"
        },
        "study": {
          "$ref": "#/$defs/stored"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "items",
        "next_cursor"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-study-page/1.0"
        },
        "items": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/stored"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/study"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
