{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/collection-intent-v1/1.0",
  "oneOf": [{"$ref": "#/$defs/create"}, {"$ref": "#/$defs/accepted"}, {"$ref": "#/$defs/status"}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding": {"type": "string", "pattern": "^kakaobinding_[0-9a-f]{32}$"},
    "room": {"type": "string", "pattern": "^kakaoroom_[0-9a-f]{32}$"},
    "run": {"type": "string", "pattern": "^kakaorun_[0-9a-f]{32}$"},
    "task": {"type": "string", "pattern": "^kakaotask_[0-9a-f]{32}$"},
    "capability": {"type": "string", "pattern": "^kakaocapabilityrev_[0-9a-f]{32}$"},
    "policy": {"type": "string", "pattern": "^kakaopolicyrev_[0-9a-f]{32}$"},
    "version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "utc": {"type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"},
    "create": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_binding_id", "room_id", "capability_revision_id", "expected_binding_version", "expected_policy_revision_id"],
      "properties": {
        "schema_version": {"const": "kakao-room-collection-create/1.0"},
        "source_binding_id": {"$ref": "#/$defs/binding"},
        "room_id": {"$ref": "#/$defs/room"},
        "capability_revision_id": {"$ref": "#/$defs/capability"},
        "expected_binding_version": {"$ref": "#/$defs/version"},
        "expected_policy_revision_id": {"$ref": "#/$defs/policy"}
      }
    },
    "accepted": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request", "run_id", "task_id", "request_sha256", "policy_sha256", "adapter_release_sha256", "created_at", "replayed"],
      "properties": {
        "schema_version": {"const": "kakao-room-collection-accepted/1.0"},
        "request": {"$ref": "#/$defs/create"},
        "run_id": {"$ref": "#/$defs/run"},
        "task_id": {"$ref": "#/$defs/task"},
        "request_sha256": {"$ref": "#/$defs/hash"},
        "policy_sha256": {"$ref": "#/$defs/hash"},
        "adapter_release_sha256": {"$ref": "#/$defs/hash"},
        "created_at": {"$ref": "#/$defs/utc"},
        "replayed": {"type": "boolean"}
      }
    },
    "status": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "source_binding_id", "state", "resource_version", "created_at", "updated_at"],
      "properties": {
        "schema_version": {"const": "kakao-collection-status/1.0"},
        "run_id": {"$ref": "#/$defs/run"},
        "source_binding_id": {"$ref": "#/$defs/binding"},
        "state": {"enum": ["QUEUED", "INVENTORY", "COLLECTING", "RECONCILING", "PAUSING", "PAUSED", "AUTH_REQUIRED", "COMPLETED", "PARTIAL", "FAILED", "CANCELLED"]},
        "resource_version": {"$ref": "#/$defs/version"},
        "created_at": {"$ref": "#/$defs/utc"},
        "updated_at": {"$ref": "#/$defs/utc"}
      }
    }
  }
}
