{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/capability-verification-v1/1.0",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/verification"}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pointer": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_revision_id", "member_path", "schema_ref", "media_type", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "member_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "schema_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "media_type": {"const": "application/json"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_binding_id", "room_id", "expected_binding_version"],
      "properties": {
        "schema_version": {"const": "kakao-capability-confirmation/1.0"},
        "source_binding_id": {"type": "string", "pattern": "^kakaobinding_[0-9a-f]{32}$"},
        "room_id": {"type": "string", "pattern": "^kakaoroom_[0-9a-f]{32}$"},
        "expected_binding_version": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request", "request_sha256", "created_by", "capability_revision_id", "adapter_release_sha256", "room_observation", "manual_proof", "capability_sha256"],
      "properties": {
        "schema_version": {"const": "kakao-capability-verification/1.0"},
        "request": {"$ref": "#/$defs/request"},
        "request_sha256": {"$ref": "#/$defs/hash"},
        "created_by": {"type": "string", "pattern": "^operator_[0-9a-f]{32}$"},
        "capability_revision_id": {"type": "string", "pattern": "^kakaocapabilityrev_[0-9a-f]{32}$"},
        "adapter_release_sha256": {"$ref": "#/$defs/hash"},
        "room_observation": {"$ref": "#/$defs/pointer"},
        "manual_proof": {"$ref": "#/$defs/pointer"},
        "capability_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
