{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-composite-request/1.0",
  "title": "EOM local image composite request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation", "overlay", "final_output_member", "composite_request_sha256"],
  "properties": {
    "schema_version": {"const": "local-image-composite-request/1.0"},
    "generation": {"$ref": "eom://schemas/image-provider/local-image-generation-request/1.0"},
    "overlay": {"$ref": "#/$defs/overlay"},
    "final_output_member": {"const": "generated-stimulus.png"},
    "composite_request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_path", "media_type", "width_px", "height_px", "mode", "size_bytes", "sha256"],
      "properties": {
        "member_path": {"const": "generated-overlay.png"},
        "media_type": {"const": "image/png"},
        "width_px": {"const": 800},
        "height_px": {"const": 500},
        "mode": {"const": "RGBA"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
