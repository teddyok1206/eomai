{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-sdxl-training-target-result/1.1",
  "title": "CPU-only SDXL target candidates; not publication or training approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "command_sha256",
    "source_snapshot_sha256",
    "state",
    "activation_policy",
    "status",
    "error_code",
    "pillow_version",
    "prepared_targets",
    "deferred_sample_ids",
    "started_at",
    "completed_at",
    "duration_ms",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-sdxl-training-target-result/1.1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^imgsdxltargetpreprun_[0-9a-f]{32}$"
    },
    "command_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state": {
      "const": "UNREVIEWED_TRAIN_TARGET_CANDIDATES"
    },
    "activation_policy": {
      "const": "FORBIDDEN"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "SDXL_TARGET_INPUT_INVALID",
            "SDXL_TARGET_SOURCE_INVALID",
            "SDXL_TARGET_RUNTIME_MISMATCH",
            "SDXL_TARGET_PREPARATION_FAILED",
            "SDXL_TARGET_OUTPUT_INVALID"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "pillow_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "prepared_targets": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/PreparedTarget"
      }
    },
    "deferred_sample_ids": {
      "type": "array",
      "maxItems": 511,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^imgsourcecrop_[0-9a-f]{32}$"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "Placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_pixel_box",
        "resized_width_px",
        "resized_height_px",
        "offset_x_px",
        "offset_y_px"
      ],
      "properties": {
        "source_pixel_box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          }
        },
        "resized_width_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 704
        },
        "resized_height_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 448
        },
        "offset_x_px": {
          "type": "integer",
          "minimum": 32,
          "maximum": 383
        },
        "offset_y_px": {
          "type": "integer",
          "minimum": 32,
          "maximum": 255
        }
      }
    },
    "PreparedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "target_id",
        "target_revision_id",
        "source_crop_sha256",
        "member_path",
        "sha256",
        "size_bytes",
        "width_px",
        "height_px",
        "mode",
        "training_caption_en",
        "training_caption_sha256",
        "placement"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "pattern": "^imgsourcecrop_[0-9a-f]{32}$"
        },
        "target_id": {
          "type": "string",
          "pattern": "^imgsdxltarget_[0-9a-f]{32}$"
        },
        "target_revision_id": {
          "type": "string",
          "pattern": "^imgsdxltargetrev_[0-9a-f]{32}$"
        },
        "source_crop_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "member_path": {
          "type": "string",
          "pattern": "^targets/imgsdxltarget_[0-9a-f]{32}\\.png$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "width_px": {
          "const": 768
        },
        "height_px": {
          "const": 512
        },
        "mode": {
          "const": "RGB"
        },
        "training_caption_en": {
          "type": "string",
          "minLength": 10,
          "maxLength": 512,
          "pattern": "^[ -~]+$"
        },
        "training_caption_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        }
      }
    }
  }
}
