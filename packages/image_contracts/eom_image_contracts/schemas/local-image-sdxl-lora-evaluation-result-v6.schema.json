{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.5",
  "title": "Native geometry diagnostic with explicitly style-balanced training1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "command_sha256",
    "evaluation",
    "baseline_command_sha256",
    "model",
    "case_relation",
    "conditioning_policy",
    "numerics",
    "status",
    "error_code",
    "runtime",
    "generation_calls",
    "outputs",
    "started_at",
    "completed_at",
    "duration_ms",
    "result_sha256"
  ],
  "properties": {
    "baseline_command_sha256": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/baseline_command_sha256"
    },
    "case_relation": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/case_relation"
    },
    "command_sha256": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/command_sha256"
    },
    "completed_at": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/completed_at"
    },
    "conditioning_policy": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/conditioning_policy"
    },
    "duration_ms": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/duration_ms"
    },
    "error_code": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/error_code"
    },
    "evaluation": {
      "$ref": "#/$defs/BalancedEvaluationPin"
    },
    "generation_calls": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/generation_calls"
    },
    "model": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/model"
    },
    "numerics": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/numerics"
    },
    "outputs": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/outputs"
    },
    "result_sha256": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/result_sha256"
    },
    "run_id": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/run_id"
    },
    "runtime": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/runtime"
    },
    "schema_version": {
      "const": "local-image-sdxl-lora-evaluation-result/1.5"
    },
    "started_at": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/started_at"
    },
    "status": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/properties/status"
    }
  },
  "$defs": {
    "BalancedEvaluationPin": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^imgadapter_[0-9a-f]{32}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_manifest": {
          "allOf": [
            {
              "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-native-lora-adapter-manifest/1.0"
                },
                "member_path": {
                  "const": "manifests/sdxl-native-lora-adapter-manifest.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        },
        "adapter_manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Adapter Manifest Sha256",
          "type": "string"
        },
        "adapter_revision_id": {
          "pattern": "^imgadapterrev_[0-9a-f]{32}$",
          "title": "Adapter Revision Id",
          "type": "string"
        },
        "adapter_strength": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Adapter Strength",
          "type": "number"
        },
        "baseline_command": {
          "allOf": [
            {
              "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-lineart-probe-command/1.0"
                },
                "member_path": {
                  "const": "manifests/sdxl-lineart-probe-command.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        },
        "training_command": {
          "allOf": [
            {
              "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-native-lora-command/1.2"
                },
                "member_path": {
                  "const": "manifests/sdxl-native-lora-command.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        },
        "training_result": {
          "allOf": [
            {
              "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-native-lora-result/1.0"
                },
                "member_path": {
                  "const": "manifests/sdxl-native-lora-result.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        }
      },
      "required": [
        "baseline_command",
        "training_command",
        "training_result",
        "adapter_manifest",
        "adapter_id",
        "adapter_revision_id",
        "adapter_manifest_sha256",
        "adapter_strength"
      ],
      "title": "SdxlNativeLoraEvaluationPinV2",
      "type": "object"
    }
  }
}
