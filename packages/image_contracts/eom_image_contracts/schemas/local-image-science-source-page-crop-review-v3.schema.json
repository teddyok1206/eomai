{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.2",
  "title": "Reviewed literal original-page regions independent of detector candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "created_at",
    "created_by",
    "source_commit",
    "basis_crop_set",
    "training_authorization",
    "policy",
    "pillow_version",
    "activation_policy",
    "review_sha256",
    "selections",
    "supplemental_pilots"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-science-source-page-crop-review/1.2"
    },
    "review_id": {
      "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/properties/review_id"
    },
    "created_at": {
      "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/properties/created_at"
    },
    "created_by": {
      "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/properties/created_by"
    },
    "source_commit": {
      "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/properties/source_commit"
    },
    "basis_crop_set": {
      "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/properties/basis_crop_set"
    },
    "training_authorization": {
      "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/properties/training_authorization"
    },
    "policy": {
      "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/properties/policy"
    },
    "pillow_version": {
      "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/properties/pillow_version"
    },
    "activation_policy": {
      "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/properties/activation_policy"
    },
    "review_sha256": {
      "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/properties/review_sha256"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_anchor",
          "selection_id",
          "document_id",
          "physical_page",
          "source_document",
          "source_page",
          "page_width_px",
          "page_height_px",
          "page_render_dpi",
          "pixel_box",
          "exam_group_sha256",
          "partition",
          "depiction_key",
          "caption_en",
          "caption_sha256",
          "expression"
        ],
        "properties": {
          "source_anchor": {
            "const": "REVIEWED_ORIGINAL_PAGE"
          },
          "selection_id": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/selection_id"
          },
          "document_id": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/document_id"
          },
          "physical_page": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/physical_page"
          },
          "source_document": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/source_document"
          },
          "source_page": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/source_page"
          },
          "page_width_px": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/page_width_px"
          },
          "page_height_px": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/page_height_px"
          },
          "page_render_dpi": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/page_render_dpi"
          },
          "pixel_box": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/pixel_box"
          },
          "exam_group_sha256": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/exam_group_sha256"
          },
          "partition": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/partition"
          },
          "depiction_key": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/depiction_key"
          },
          "caption_en": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/caption_en"
          },
          "caption_sha256": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/caption_sha256"
          },
          "expression": {
            "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0#/$defs/Selection/properties/expression"
          }
        }
      }
    },
    "supplemental_pilots": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "anyOf": [
        {
          "maxItems": 0
        },
        {
          "minItems": 2
        }
      ],
      "items": {
        "$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.1#/properties/supplemental_pilots/items"
      }
    }
  }
}
