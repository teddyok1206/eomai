{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-sdxl-photo-style-command/1.3",
  "title": "Licensed photo command with an explicit bounded spatial-control window, not visual acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_commit",
    "created_at",
    "purpose",
    "activation_policy",
    "plan",
    "plan_id",
    "plan_sha256",
    "command_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-sdxl-photo-style-command/1.3"
    },
    "run_id": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-command/1.0#/properties/run_id"
    },
    "source_commit": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-command/1.0#/properties/source_commit"
    },
    "created_at": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-command/1.0#/properties/created_at"
    },
    "purpose": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-command/1.0#/properties/purpose"
    },
    "activation_policy": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-command/1.0#/properties/activation_policy"
    },
    "plan": {
      "allOf": [
        {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-lineart-probe-command/1.0#/$defs/pointer"
        },
        {
          "properties": {
            "schema_ref": {
              "const": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.3"
            },
            "member_path": {
              "const": "manifests/sdxl-photo-style-plan.json"
            },
            "media_type": {
              "const": "application/json"
            }
          }
        }
      ]
    },
    "plan_id": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-command/1.0#/properties/plan_id"
    },
    "plan_sha256": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-command/1.0#/properties/plan_sha256"
    },
    "command_sha256": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-command/1.0#/properties/command_sha256"
    }
  }
}
