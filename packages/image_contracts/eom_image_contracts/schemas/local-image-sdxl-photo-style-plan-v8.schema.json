{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.7",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "activation_policy": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/activation_policy"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automatic_retry": {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/$defs/PhotoObjectSupportBudget/properties/automatic_retry"
        },
        "maximum_dispatches": {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/$defs/PhotoObjectSupportBudget/properties/maximum_dispatches"
        },
        "maximum_duration_ms": {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/$defs/PhotoObjectSupportBudget/properties/maximum_duration_ms"
        },
        "maximum_outputs": {
          "const": 1
        },
        "maximum_peak_gpu_memory_bytes": {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/$defs/PhotoObjectSupportBudget/properties/maximum_peak_gpu_memory_bytes"
        }
      },
      "required": [
        "maximum_duration_ms",
        "maximum_peak_gpu_memory_bytes"
      ]
    },
    "cases": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/cases"
    },
    "comparison_policy": {
      "const": "CHANGE_NATIVE_ADAPTER_ONLY_REUSE_OBJECT_SUPPORTED_BASE"
    },
    "configuration_anchor": {
      "allOf": [
        {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/$defs/ImageEvaluationArtifactMember"
        },
        {
          "properties": {
            "schema_ref": {
              "const": "eom://schemas/image-provider/local-image-sdxl-canny-reference-command/1.4"
            },
            "member_path": {
              "const": "manifests/sdxl-canny-reference-command.json"
            },
            "media_type": {
              "const": "application/json"
            }
          }
        }
      ]
    },
    "control": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/control"
    },
    "created_at": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/created_at"
    },
    "dispatch_policy": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/dispatch_policy"
    },
    "initialization": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/initialization"
    },
    "plan_id": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/plan_id"
    },
    "plan_sha256": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/plan_sha256"
    },
    "purpose": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/purpose"
    },
    "schema_version": {
      "const": "local-image-sdxl-photo-style-plan/1.7"
    },
    "seed": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/seed"
    },
    "source_commit": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/source_commit"
    },
    "source_population": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/source_population"
    },
    "support_parents": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/properties/support_parents"
    },
    "baseline_reuse": {
      "$ref": "#/$defs/PhotoBaselineReuse"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "source_commit",
    "created_at",
    "purpose",
    "dispatch_policy",
    "activation_policy",
    "source_population",
    "configuration_anchor",
    "cases",
    "seed",
    "initialization",
    "budget",
    "plan_sha256",
    "control",
    "support_parents",
    "comparison_policy",
    "baseline_reuse"
  ],
  "$defs": {
    "PhotoBaselineReuse": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "prior_plan": {
          "allOf": [
            {
              "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6"
                },
                "member_path": {
                  "const": "manifests/sdxl-photo-style-plan.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        },
        "prior_result": {
          "allOf": [
            {
              "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-photo-style-result/1.6"
                },
                "member_path": {
                  "const": "manifests/sdxl-photo-style-result.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        },
        "prior_configuration": {
          "allOf": [
            {
              "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-canny-reference-command/1.3"
                },
                "member_path": {
                  "const": "manifests/sdxl-canny-reference-command.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        }
      },
      "required": [
        "prior_plan",
        "prior_result",
        "prior_configuration"
      ]
    }
  }
}
