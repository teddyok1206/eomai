{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "training_run_id", "created_at", "created_by", "source_commit", "base_model", "source_crop_set", "training_authorization", "experiment_authorization", "target_batches", "training_samples", "review_scope", "caption_policy", "preprocessing_policy", "dependencies", "hyperparameters", "budget", "seed", "purpose", "activation_policy", "command_sha256"],
  "$defs": {
    "Pointer": {"$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/ImageEvaluationArtifactMember"},
    "Sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "TargetBatch": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "result"],
      "properties": {"command": {"$ref": "#/$defs/Pointer"}, "result": {"$ref": "#/$defs/Pointer"}}
    },
    "PreparedSample": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_id", "target_id", "target_revision_id", "source_image", "training_caption_en", "training_caption_sha256"],
      "properties": {
        "sample_id": {"type": "string", "pattern": "^imgsourcecrop_[0-9a-f]{32}$"},
        "target_id": {"type": "string", "pattern": "^imgsdxltarget_[0-9a-f]{32}$"},
        "target_revision_id": {"type": "string", "pattern": "^imgsdxltargetrev_[0-9a-f]{32}$"},
        "source_image": {"$ref": "#/$defs/Pointer"},
        "training_caption_en": {"type": "string", "minLength": 10, "maxLength": 640, "pattern": "^[ -~]+$"},
        "training_caption_sha256": {"$ref": "#/$defs/Sha256"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "local-image-sdxl-lora-micro-command/1.1"},
    "training_run_id": {"type": "string", "pattern": "^imgsdxlmicrotrainrun_[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:@-]+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_model": {"$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/SdxlLineartStackPointer"},
    "source_crop_set": {"$ref": "#/$defs/Pointer"},
    "training_authorization": {"$ref": "#/$defs/Pointer"},
    "experiment_authorization": {"$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/SdxlExperimentAuthorization"},
    "target_batches": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/TargetBatch"}},
    "training_samples": {"type": "array", "minItems": 1, "maxItems": 96, "items": {"$ref": "#/$defs/PreparedSample"}},
    "review_scope": {"const": "OWN_TRAIN_TARGET_SCREENING_NOT_INDEPENDENT"},
    "caption_policy": {"const": "EXACT_REVIEWED_TARGET_CAPTION/1.0"},
    "preprocessing_policy": {"const": "EXACT_PREPARED_RGB_768X512/1.0"},
    "dependencies": {"$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/LocalImageTrainerDependencies"},
    "hyperparameters": {"$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/LocalImageLoraMicroHyperparameters"},
    "budget": {"$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/SdxlLoraMicroBudget"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "purpose": {"const": "EVALUATION_ONLY_SDXL_REVIEWED_LITERAL_TARGET_MICRO"},
    "activation_policy": {"const": "FORBIDDEN"},
    "command_sha256": {"$ref": "#/$defs/Sha256"}
  }
}
