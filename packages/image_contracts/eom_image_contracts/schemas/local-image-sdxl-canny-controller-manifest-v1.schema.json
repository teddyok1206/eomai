{
  "$defs": {
    "ModelFile": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 8589934592,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "size_bytes",
        "sha256"
      ],
      "title": "ModelFile",
      "type": "object"
    },
    "SdxlCannyControllerLicense": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "HUB_DECLARATION_WITH_HUB_LINKED_STANDARD_TEXT",
          "default": "HUB_DECLARATION_WITH_HUB_LINKED_STANDARD_TEXT",
          "title": "Basis",
          "type": "string"
        },
        "card_revision": {
          "const": "eb115a19a10d14909256db740ed109532ab1483c",
          "default": "eb115a19a10d14909256db740ed109532ab1483c",
          "title": "Card Revision",
          "type": "string"
        },
        "controller_own_license_file": {
          "const": false,
          "default": false,
          "title": "Controller Own License File",
          "type": "boolean"
        },
        "declared_identifier": {
          "const": "openrail++",
          "default": "openrail++",
          "title": "Declared Identifier",
          "type": "string"
        },
        "identifier_mapping_revision": {
          "const": "fd6cf1f56e1514af08c5a7262d9f79b3becb810d",
          "default": "fd6cf1f56e1514af08c5a7262d9f79b3becb810d",
          "title": "Identifier Mapping Revision",
          "type": "string"
        },
        "license_id": {
          "const": "CreativeML-Open-RAIL++-M",
          "default": "CreativeML-Open-RAIL++-M",
          "title": "License Id",
          "type": "string"
        },
        "standard_text_member": {
          "const": "LICENSE.md",
          "default": "LICENSE.md",
          "title": "Standard Text Member",
          "type": "string"
        },
        "standard_text_repo": {
          "const": "stabilityai/stable-diffusion-xl-base-1.0",
          "default": "stabilityai/stable-diffusion-xl-base-1.0",
          "title": "Standard Text Repo",
          "type": "string"
        },
        "standard_text_revision": {
          "const": "462165984030d82259a11f4367a4eed129e94a7b",
          "default": "462165984030d82259a11f4367a4eed129e94a7b",
          "title": "Standard Text Revision",
          "type": "string"
        }
      },
      "title": "SdxlCannyControllerLicense",
      "type": "object"
    }
  },
  "$id": "eom://schemas/image-provider/local-image-sdxl-canny-controller-manifest/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_policy": {
      "const": "FORBIDDEN",
      "title": "Activation Policy",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:@-]+$",
      "title": "Created By",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ModelFile"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Files",
      "type": "array"
    },
    "license": {
      "$ref": "#/$defs/SdxlCannyControllerLicense"
    },
    "manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "model_id": {
      "pattern": "^imgmodel_[0-9a-f]{32}$",
      "title": "Model Id",
      "type": "string"
    },
    "model_revision_id": {
      "pattern": "^imgmodelrev_[0-9a-f]{32}$",
      "title": "Model Revision Id",
      "type": "string"
    },
    "provider_family": {
      "const": "diffusers-sdxl-controlnet-canny",
      "default": "diffusers-sdxl-controlnet-canny",
      "title": "Provider Family",
      "type": "string"
    },
    "runtime_contract_version": {
      "const": "eom-local-image-sdxl-canny-runner/1.0",
      "default": "eom-local-image-sdxl-canny-runner/1.0",
      "title": "Runtime Contract Version",
      "type": "string"
    },
    "schema_version": {
      "const": "local-image-sdxl-canny-controller-manifest/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_url": {
      "const": "https://huggingface.co/diffusers/controlnet-canny-sdxl-1.0",
      "title": "Source Url",
      "type": "string"
    },
    "state": {
      "const": "EVALUATION_ONLY",
      "title": "State",
      "type": "string"
    },
    "supported_base_repo": {
      "const": "stabilityai/stable-diffusion-xl-base-1.0",
      "title": "Supported Base Repo",
      "type": "string"
    },
    "upstream_repo": {
      "const": "diffusers/controlnet-canny-sdxl-1.0",
      "title": "Upstream Repo",
      "type": "string"
    },
    "upstream_revision": {
      "const": "eb115a19a10d14909256db740ed109532ab1483c",
      "title": "Upstream Revision",
      "type": "string"
    }
  },
  "required": [
    "model_id",
    "model_revision_id",
    "manifest_sha256",
    "schema_version",
    "state",
    "activation_policy",
    "upstream_repo",
    "upstream_revision",
    "source_url",
    "supported_base_repo",
    "license",
    "files",
    "created_at",
    "created_by"
  ],
  "title": "LocalImageSdxlCannyControllerManifest",
  "type": "object"
}
