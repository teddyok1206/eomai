{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-style-dataset-split/1.0",
  "title": "Document grouped local image style dataset split",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "split_id",
    "split_revision_id",
    "created_at",
    "style_track",
    "reviewed_inventory",
    "authorization",
    "seed",
    "minimum_counts",
    "pinned_holdout_sample_ids",
    "members",
    "readiness",
    "split_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-style-dataset-split/1.0"
    },
    "split_id": {
      "type": "string",
      "pattern": "^imgstylesplit_[0-9a-f]{32}$"
    },
    "split_revision_id": {
      "type": "string",
      "pattern": "^imgstylesplitrev_[0-9a-f]{32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "style_track": {
      "enum": [
        "OBJECT_LINE_ART",
        "RASTER_TEXTURE_SCENE"
      ]
    },
    "reviewed_inventory": {
      "$ref": "#/$defs/pointer"
    },
    "authorization": {
      "$ref": "#/$defs/pointer"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "minimum_counts": {
      "$ref": "#/$defs/counts"
    },
    "pinned_holdout_sample_ids": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^imgstylesample_[0-9a-f]{32}$"
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/member"
      }
    },
    "readiness": {
      "enum": [
        "READY",
        "INSUFFICIENT"
      ]
    },
    "split_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "artifact_revision_id": {
          "type": "string",
          "pattern": "^rev_[0-9a-f]{32}$"
        },
        "member_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*/$).+$"
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train",
        "validation",
        "holdout"
      ],
      "properties": {
        "train": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "validation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "holdout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "crop",
        "source_document",
        "exam_group_sha256",
        "near_duplicate_group_sha256",
        "depiction_key"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "pattern": "^imgstylesample_[0-9a-f]{32}$"
        },
        "crop": {
          "$ref": "#/$defs/pointer"
        },
        "source_document": {
          "$ref": "#/$defs/pointer"
        },
        "exam_group_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "near_duplicate_group_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "depiction_key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample",
        "partition"
      ],
      "properties": {
        "sample": {
          "$ref": "#/$defs/sample"
        },
        "partition": {
          "enum": [
            "TRAIN",
            "VALIDATION",
            "HOLDOUT"
          ]
        }
      }
    }
  }
}
