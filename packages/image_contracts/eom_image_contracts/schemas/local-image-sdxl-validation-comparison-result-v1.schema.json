{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-sdxl-validation-comparison-result/1.0",
  "title": "Reserved VALIDATION matched spatial comparison result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "command_sha256",
    "configuration_command_sha256",
    "case_relation",
    "native_fit_policy",
    "quality_acceptance",
    "activation_policy",
    "training_steps",
    "holdout_binary_reads",
    "status",
    "error_code",
    "runtime",
    "inputs",
    "outputs",
    "started_at",
    "completed_at",
    "duration_ms",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-sdxl-validation-comparison-result/1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^imgsdxlvalcmprun_[0-9a-f]{32}$"
    },
    "command_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "configuration_command_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "case_relation": {
      "const": "RESERVED_VALIDATION_NOT_TRAIN_OR_HOLDOUT"
    },
    "native_fit_policy": {
      "const": "NATIVE_FIT_800X500_CENTER_832X512_OPENCV_CANNY/1.0"
    },
    "quality_acceptance": {
      "const": "NOT_REVIEWED"
    },
    "activation_policy": {
      "const": "FORBIDDEN"
    },
    "training_steps": {
      "const": 0
    },
    "holdout_binary_reads": {
      "const": 0
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "error_code": {
      "enum": [
        null,
        "SDXL_PROBE_INPUT_INVALID",
        "SDXL_PROBE_MODEL_INVALID",
        "SDXL_PROBE_HASH_MISMATCH",
        "SDXL_PROBE_GPU_UNAVAILABLE",
        "SDXL_PROBE_OOM",
        "SDXL_PROBE_EXEC_FAILED",
        "SDXL_PROBE_OUTPUT_INVALID",
        "SDXL_PROBE_BUDGET_EXCEEDED",
        "SDXL_PROBE_PROMPT_TRUNCATED"
      ]
    },
    "runtime": {
      "anyOf": [
        {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-canny-reference-result/1.0#/$defs/LocalImageRuntime"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 12,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "eom://schemas/image-provider/local-image-sdxl-canny-reference-result/1.0#/$defs/SdxlCannyReferenceTrace"
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "eom://schemas/image-provider/local-image-sdxl-canny-reference-result/1.0#/$defs/SdxlLearnedComparisonOutput"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
