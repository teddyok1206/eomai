{
  "$defs": {
    "ImageEvaluationArtifactMember": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Member Path",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "title": "ImageEvaluationArtifactMember",
      "type": "object"
    },
    "LocalImageRuntime": {
      "additionalProperties": false,
      "properties": {
        "compute_capability": {
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Compute Capability",
          "type": "string"
        },
        "cuda_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Cuda Version",
          "type": "string"
        },
        "diffusers_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Diffusers Version",
          "type": "string"
        },
        "gpu_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Gpu Name",
          "type": "string"
        },
        "peak_gpu_memory_bytes": {
          "minimum": 1,
          "title": "Peak Gpu Memory Bytes",
          "type": "integer"
        },
        "provider_version": {
          "const": "eom-local-image-provider/1.0",
          "default": "eom-local-image-provider/1.0",
          "title": "Provider Version",
          "type": "string"
        },
        "python_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "torch_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Torch Version",
          "type": "string"
        },
        "transformers_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Transformers Version",
          "type": "string"
        }
      },
      "required": [
        "python_version",
        "torch_version",
        "diffusers_version",
        "transformers_version",
        "cuda_version",
        "gpu_name",
        "compute_capability",
        "peak_gpu_memory_bytes"
      ],
      "title": "LocalImageRuntime",
      "type": "object"
    },
    "SdxlLineartStackPointer": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "model_id": {
          "pattern": "^imgmodel_[0-9a-f]{32}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_revision_id": {
          "pattern": "^imgmodelrev_[0-9a-f]{32}$",
          "title": "Model Revision Id",
          "type": "string"
        },
        "provider_family": {
          "const": "diffusers-sdxl-t2i-lineart",
          "title": "Provider Family",
          "type": "string"
        },
        "runtime_contract_version": {
          "const": "eom-local-image-sdxl-lineart-runner/1.0",
          "title": "Runtime Contract Version",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "model_revision_id",
        "manifest_sha256",
        "provider_family",
        "runtime_contract_version"
      ],
      "title": "SdxlLineartStackPointer",
      "type": "object"
    },
    "SdxlNativeGeometryNumerics": {
      "additionalProperties": false,
      "properties": {
        "adapter_conditioning_scale": {
          "default": 0,
          "maximum": 0,
          "minimum": 0,
          "title": "Adapter Conditioning Scale",
          "type": "number"
        },
        "guidance_scale": {
          "default": 7,
          "maximum": 7,
          "minimum": 7,
          "title": "Guidance Scale",
          "type": "number"
        },
        "inference_steps": {
          "const": 30,
          "default": 30,
          "title": "Inference Steps",
          "type": "integer"
        },
        "seed": {
          "const": 104729,
          "default": 104729,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "SdxlNativeGeometryNumerics",
      "type": "object"
    },
    "SdxlNativeGeometryOutput": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "enum": [
            "BASE",
            "LORA"
          ],
          "title": "Arm",
          "type": "string"
        },
        "canvas": {
          "enum": [
            "LEGACY_832X512",
            "SQUARE_1024",
            "PORTRAIT_768X1024",
            "LANDSCAPE_1024X768"
          ],
          "title": "Canvas",
          "type": "string"
        },
        "duration_ms": {
          "maximum": 600000,
          "minimum": 1,
          "title": "Duration Ms",
          "type": "integer"
        },
        "height_px": {
          "maximum": 1024,
          "minimum": 512,
          "title": "Height Px",
          "type": "integer"
        },
        "member_path": {
          "title": "Member Path",
          "type": "string"
        },
        "negative_prompt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Negative Prompt Sha256",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^imgsourcecrop_[0-9a-f]{32}$",
          "title": "Sample Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "width_px": {
          "maximum": 1024,
          "minimum": 512,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "sample_id",
        "arm",
        "canvas",
        "width_px",
        "height_px",
        "prompt_sha256",
        "negative_prompt_sha256",
        "member_path",
        "sha256",
        "size_bytes",
        "duration_ms"
      ],
      "title": "SdxlNativeGeometryOutput",
      "type": "object"
    },
    "SdxlNativeLoraEvaluationPinV2": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^imgadapter_[0-9a-f]{32}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_manifest": {
          "allOf": [
            {
              "$ref": "#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-native-lora-adapter-manifest/1.0"
                },
                "member_path": {
                  "const": "manifests/sdxl-native-lora-adapter-manifest.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        },
        "adapter_manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Adapter Manifest Sha256",
          "type": "string"
        },
        "adapter_revision_id": {
          "pattern": "^imgadapterrev_[0-9a-f]{32}$",
          "title": "Adapter Revision Id",
          "type": "string"
        },
        "adapter_strength": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Adapter Strength",
          "type": "number"
        },
        "baseline_command": {
          "allOf": [
            {
              "$ref": "#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-lineart-probe-command/1.0"
                },
                "member_path": {
                  "const": "manifests/sdxl-lineart-probe-command.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        },
        "training_command": {
          "allOf": [
            {
              "$ref": "#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-native-lora-command/1.1"
                },
                "member_path": {
                  "const": "manifests/sdxl-native-lora-command.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        },
        "training_result": {
          "allOf": [
            {
              "$ref": "#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-native-lora-result/1.0"
                },
                "member_path": {
                  "const": "manifests/sdxl-native-lora-result.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        }
      },
      "required": [
        "baseline_command",
        "training_command",
        "training_result",
        "adapter_manifest",
        "adapter_id",
        "adapter_revision_id",
        "adapter_manifest_sha256",
        "adapter_strength"
      ],
      "title": "SdxlNativeLoraEvaluationPinV2",
      "type": "object"
    }
  },
  "$id": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-result/1.4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Baseline Command Sha256",
      "type": "string"
    },
    "case_relation": {
      "const": "ADMITTED_NATIVE_TRAIN_GEOMETRY_DIAGNOSTIC_NOT_HOLDOUT",
      "title": "Case Relation",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "conditioning_policy": {
      "const": "SYNTHETIC_BLACK_T2I_ZERO_NO_INITIALIZER/1.0",
      "title": "Conditioning Policy",
      "type": "string"
    },
    "duration_ms": {
      "maximum": 3600000,
      "minimum": 1,
      "title": "Duration Ms",
      "type": "integer"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "SDXL_PROBE_INPUT_INVALID",
            "SDXL_PROBE_MODEL_INVALID",
            "SDXL_PROBE_HASH_MISMATCH",
            "SDXL_PROBE_GPU_UNAVAILABLE",
            "SDXL_PROBE_OOM",
            "SDXL_PROBE_EXEC_FAILED",
            "SDXL_PROBE_OUTPUT_INVALID",
            "SDXL_PROBE_BUDGET_EXCEEDED",
            "SDXL_PROBE_PROMPT_TRUNCATED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "evaluation": {
      "$ref": "#/$defs/SdxlNativeLoraEvaluationPinV2"
    },
    "generation_calls": {
      "maximum": 8,
      "minimum": 0,
      "title": "Generation Calls",
      "type": "integer"
    },
    "model": {
      "$ref": "#/$defs/SdxlLineartStackPointer"
    },
    "numerics": {
      "$ref": "#/$defs/SdxlNativeGeometryNumerics"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/SdxlNativeGeometryOutput"
      },
      "maxItems": 8,
      "title": "Outputs",
      "type": "array"
    },
    "result_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^imgsdxlloraevalrun_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalImageRuntime"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "local-image-sdxl-lora-evaluation-result/1.4",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "command_sha256",
    "evaluation",
    "baseline_command_sha256",
    "model",
    "case_relation",
    "conditioning_policy",
    "numerics",
    "status",
    "error_code",
    "runtime",
    "generation_calls",
    "outputs",
    "started_at",
    "completed_at",
    "duration_ms",
    "result_sha256"
  ],
  "title": "LocalImageSdxlNativeGeometryResultV2",
  "type": "object"
}
