{
  "$defs": {
    "ImageEvaluationArtifactMember": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Member Path",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "title": "ImageEvaluationArtifactMember",
      "type": "object"
    },
    "SdxlNativeGeometryBudget": {
      "additionalProperties": false,
      "properties": {
        "maximum_duration_ms": {
          "maximum": 600000,
          "minimum": 1000,
          "title": "Maximum Duration Ms",
          "type": "integer"
        },
        "maximum_generations": {
          "maximum": 8,
          "minimum": 4,
          "multipleOf": 4,
          "title": "Maximum Generations",
          "type": "integer"
        },
        "maximum_peak_gpu_memory_bytes": {
          "maximum": 17179869184,
          "minimum": 1,
          "title": "Maximum Peak Gpu Memory Bytes",
          "type": "integer"
        }
      },
      "required": [
        "maximum_generations",
        "maximum_duration_ms",
        "maximum_peak_gpu_memory_bytes"
      ],
      "title": "SdxlNativeGeometryBudget",
      "type": "object"
    },
    "SdxlNativeGeometryCase": {
      "additionalProperties": false,
      "properties": {
        "native_canvas": {
          "enum": [
            "SQUARE_1024",
            "PORTRAIT_768X1024",
            "LANDSCAPE_1024X768"
          ],
          "title": "Native Canvas",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^imgsourcecrop_[0-9a-f]{32}$",
          "title": "Sample Id",
          "type": "string"
        },
        "training_caption_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Training Caption Sha256",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "native_canvas",
        "training_caption_sha256"
      ],
      "title": "SdxlNativeGeometryCase",
      "type": "object"
    },
    "SdxlNativeGeometryNumerics": {
      "additionalProperties": false,
      "properties": {
        "adapter_conditioning_scale": {
          "default": 0.0,
          "maximum": 0.0,
          "minimum": 0.0,
          "title": "Adapter Conditioning Scale",
          "type": "number"
        },
        "guidance_scale": {
          "default": 7.0,
          "maximum": 7.0,
          "minimum": 7.0,
          "title": "Guidance Scale",
          "type": "number"
        },
        "inference_steps": {
          "const": 30,
          "default": 30,
          "title": "Inference Steps",
          "type": "integer"
        },
        "seed": {
          "const": 104729,
          "default": 104729,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "SdxlNativeGeometryNumerics",
      "type": "object"
    },
    "SdxlNativeLoraEvaluationPin": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^imgadapter_[0-9a-f]{32}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_manifest": {
          "$ref": "#/$defs/ImageEvaluationArtifactMember"
        },
        "adapter_manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Adapter Manifest Sha256",
          "type": "string"
        },
        "adapter_revision_id": {
          "pattern": "^imgadapterrev_[0-9a-f]{32}$",
          "title": "Adapter Revision Id",
          "type": "string"
        },
        "adapter_strength": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Adapter Strength",
          "type": "number"
        },
        "baseline_command": {
          "$ref": "#/$defs/ImageEvaluationArtifactMember"
        },
        "training_command": {
          "$ref": "#/$defs/ImageEvaluationArtifactMember"
        },
        "training_result": {
          "$ref": "#/$defs/ImageEvaluationArtifactMember"
        }
      },
      "required": [
        "baseline_command",
        "training_command",
        "training_result",
        "adapter_manifest",
        "adapter_id",
        "adapter_revision_id",
        "adapter_manifest_sha256",
        "adapter_strength"
      ],
      "title": "SdxlNativeLoraEvaluationPin",
      "type": "object"
    }
  },
  "$id": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-command/1.3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_policy": {
      "const": "FORBIDDEN",
      "title": "Activation Policy",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/SdxlNativeGeometryBudget"
    },
    "case_relation": {
      "const": "ADMITTED_NATIVE_TRAIN_GEOMETRY_DIAGNOSTIC_NOT_HOLDOUT",
      "title": "Case Relation",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/SdxlNativeGeometryCase"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "conditioning_policy": {
      "const": "SYNTHETIC_BLACK_T2I_ZERO_NO_INITIALIZER/1.0",
      "title": "Conditioning Policy",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evaluation": {
      "$ref": "#/$defs/SdxlNativeLoraEvaluationPin"
    },
    "negative_prompt_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Negative Prompt Sha256",
      "type": "string"
    },
    "numerics": {
      "$ref": "#/$defs/SdxlNativeGeometryNumerics"
    },
    "purpose": {
      "const": "EVALUATION_ONLY_MATCHED_SDXL_LORA",
      "title": "Purpose",
      "type": "string"
    },
    "run_id": {
      "pattern": "^imgsdxlloraevalrun_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "local-image-sdxl-lora-evaluation-command/1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Commit",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "source_commit",
    "evaluation",
    "purpose",
    "activation_policy",
    "command_sha256",
    "case_relation",
    "conditioning_policy",
    "cases",
    "negative_prompt_sha256",
    "numerics",
    "budget"
  ],
  "title": "LocalImageSdxlNativeGeometryCommand",
  "type": "object"
}
