{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-quality-evaluation-plan/1.0",
  "title": "EOM local image quality evaluation plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "created_at",
    "source_snapshot",
    "provider_binding",
    "selection_method",
    "population_pattern_count",
    "variants",
    "samples",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": "local-image-quality-evaluation-plan/1.0"},
    "evaluation_id": {"type": "string", "pattern": "^imageeval_[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_snapshot": {"$ref": "#/$defs/sourceSnapshot"},
    "provider_binding": {"$ref": "eom://schemas/image-provider/local-image-provider-binding/1.0"},
    "selection_method": {"const": "STRATIFIED_DETERMINISTIC_V1"},
    "population_pattern_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "variants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/variant"}
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/sample"}
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifactMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "member_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9._()가-힣/-]+$"
        },
        "schema_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "boundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": {"type": "integer", "minimum": 0, "maximum": 9999},
        "top": {"type": "integer", "minimum": 0, "maximum": 9999},
        "right": {"type": "integer", "minimum": 1, "maximum": 10000},
        "bottom": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_revision_id",
        "graph_snapshot_sha256",
        "graph_manifest_sha256",
        "target_count",
        "target_set_sha256"
      ],
      "properties": {
        "graph_revision_id": {"type": "string", "pattern": "^graphrev_[0-9a-f]{32}$"},
        "graph_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "graph_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "target_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "target_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "label", "policy_revision"],
      "properties": {
        "variant_id": {
          "enum": ["ASSESSMENT_STYLE_EN", "CURRENT_KO", "ENGLISH_SUBJECT"]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "policy_revision": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "visualPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "representation_kind",
        "rendering_mode",
        "color_mode",
        "background",
        "panel_layout",
        "features",
        "pedagogical_function",
        "composition_summary_sha256",
        "reconstruction_guidance_sha256"
      ],
      "properties": {
        "pattern_id": {"type": "string", "pattern": "^visualpattern_[0-9a-f]{32}$"},
        "representation_kind": {
          "enum": ["APPARATUS", "COMPOSITE", "DIAGRAM", "PHOTOGRAPH"]
        },
        "rendering_mode": {"enum": ["MIXED", "RASTER", "VECTOR_LIKE"]},
        "color_mode": {"enum": ["GRAYSCALE", "LIMITED_COLOR", "MONOCHROME"]},
        "background": {"enum": ["OTHER_OBSERVED", "TRANSPARENT", "WHITE"]},
        "panel_layout": {"enum": ["GRID", "HORIZONTAL", "OVERLAID", "SINGLE", "VERTICAL"]},
        "features": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "enum": [
              "ARROWS",
              "BOUNDARY",
              "CALLOUT",
              "DATA_POINTS",
              "GRID",
              "LABELS",
              "LEADER_LINES",
              "LEGEND",
              "MULTIPLE_PANELS",
              "NUMBERED_STEPS",
              "PATTERN_FILL",
              "SCALE",
              "SYMBOL_KEY",
              "TRAJECTORY"
            ]
          }
        },
        "pedagogical_function": {
          "enum": ["CLASSIFICATION", "COMPARISON", "CONTEXT", "PRIMARY_DATA", "PROCESS", "SPATIAL_RELATION"]
        },
        "composition_summary_sha256": {"$ref": "#/$defs/sha256"},
        "reconstruction_guidance_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "positive_prompt",
        "positive_prompt_sha256",
        "negative_prompt",
        "negative_prompt_sha256"
      ],
      "properties": {
        "variant_id": {
          "enum": ["ASSESSMENT_STYLE_EN", "CURRENT_KO", "ENGLISH_SUBJECT"]
        },
        "positive_prompt": {"type": "string", "minLength": 1, "maxLength": 4000},
        "positive_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "negative_prompt": {"type": "string", "minLength": 1, "maxLength": 2000},
        "negative_prompt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "item_revision_id",
        "extraction_result",
        "visual_pattern",
        "source_anchor_id",
        "source_page_image",
        "physical_page",
        "bounding_box",
        "seed",
        "prompts"
      ],
      "properties": {
        "sample_id": {"type": "string", "pattern": "^imgsample_[0-9a-f]{32}$"},
        "item_revision_id": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
        "extraction_result": {"$ref": "#/$defs/artifactMember"},
        "visual_pattern": {"$ref": "#/$defs/visualPattern"},
        "source_anchor_id": {"type": "string", "pattern": "^assessmentanchor_[0-9a-f]{32}$"},
        "source_page_image": {"$ref": "#/$defs/artifactMember"},
        "physical_page": {"type": "integer", "minimum": 1, "maximum": 100000},
        "bounding_box": {
          "oneOf": [
            {"$ref": "#/$defs/boundingBox"},
            {"type": "null"}
          ]
        },
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "prompts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/prompt"}
        }
      }
    }
  }
}
