{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-sdxl-lora-micro-result/1.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "training_run_id", "command_sha256", "status", "error_code", "adapter_manifest", "realized_samples", "sample_set_sha256", "runtime", "completed_steps", "final_loss", "started_at", "completed_at", "duration_ms", "result_sha256"],
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "RealizedSample": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_id", "source_crop_sha256", "realized_crop_sha256", "training_caption_sha256"],
      "properties": {
        "sample_id": {"type": "string", "pattern": "^imgsourcecrop_[0-9a-f]{32}$"},
        "source_crop_sha256": {"$ref": "#/$defs/Sha256"},
        "realized_crop_sha256": {"$ref": "#/$defs/Sha256"},
        "training_caption_sha256": {"$ref": "#/$defs/Sha256"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "local-image-sdxl-lora-micro-result/1.1"},
    "training_run_id": {"type": "string", "pattern": "^imgsdxlmicrotrainrun_[0-9a-f]{32}$"},
    "command_sha256": {"$ref": "#/$defs/Sha256"},
    "status": {"enum": ["SUCCEEDED", "FAILED", "CANCELLED"]},
    "error_code": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^IMAGE_TRAINING_[A-Z0-9_]{3,96}$"}]},
    "adapter_manifest": {"anyOf": [{"type": "null"}, {"$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-adapter-manifest/1.0"}]},
    "realized_samples": {"type": "array", "maxItems": 96, "items": {"$ref": "#/$defs/RealizedSample"}},
    "sample_set_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/Sha256"}]},
    "runtime": {"anyOf": [{"type": "null"}, {"$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-result/1.0#/$defs/LocalImageLoraTrainingRuntime"}]},
    "completed_steps": {"type": "integer", "minimum": 0, "maximum": 200},
    "final_loss": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1000000}]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 1, "maximum": 3660000},
    "result_sha256": {"$ref": "#/$defs/Sha256"}
  }
}
