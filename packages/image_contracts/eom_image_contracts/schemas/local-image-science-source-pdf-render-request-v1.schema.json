{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-science-source-pdf-render-request/1.0",
  "title": "One bounded TRAIN PDF native-render handoff value",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "command_sha256", "source", "regions", "render_dpi", "renderer", "pillow_version", "request_sha256"],
  "properties": {
    "schema_version": {"const": "local-image-science-source-pdf-render-request/1.0"},
    "command_id": {"type": "string", "pattern": "^imgpdfcropcommand_[0-9a-f]{32}$"},
    "command_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {"$ref": "eom://schemas/image-provider/local-image-science-corpus-visual-pilot-plan/1.0#/$defs/pdfSource"},
    "regions": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/region"}},
    "render_dpi": {"const": 576},
    "renderer": {"$ref": "eom://schemas/image-provider/local-image-science-source-pdf-crop-command/1.0#/properties/renderer"},
    "pillow_version": {"$ref": "eom://schemas/image-provider/local-image-science-source-pdf-crop-command/1.0#/properties/pillow_version"},
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["selection_id", "physical_page", "source_page", "page_width_px", "page_height_px", "page_render_dpi", "pixel_box"],
      "properties": {
        "selection_id": {"type": "string", "pattern": "^imgsourcecrop_[0-9a-f]{32}$"},
        "physical_page": {"type": "integer", "minimum": 1, "maximum": 512},
        "source_page": {"$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/ImageEvaluationArtifactMember"},
        "page_width_px": {"type": "integer", "minimum": 100, "maximum": 10000},
        "page_height_px": {"type": "integer", "minimum": 100, "maximum": 10000},
        "page_render_dpi": {"const": 144},
        "pixel_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 10000}}
      }
    }
  }
}
