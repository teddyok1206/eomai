{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.4",
  "title": "Reviewed retained photo region under fixed full spatial control, not quality acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "source_commit",
    "created_at",
    "purpose",
    "dispatch_policy",
    "activation_policy",
    "source_population",
    "configuration_anchor",
    "cases",
    "seed",
    "initialization",
    "budget",
    "plan_sha256",
    "control",
    "region_reviews",
    "region_review_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-sdxl-photo-style-plan/1.4"
    },
    "plan_id": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/plan_id"
    },
    "source_commit": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/source_commit"
    },
    "created_at": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/created_at"
    },
    "purpose": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/purpose"
    },
    "dispatch_policy": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/dispatch_policy"
    },
    "activation_policy": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/activation_policy"
    },
    "source_population": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/source_population"
    },
    "configuration_anchor": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/configuration_anchor"
    },
    "cases": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/cases"
    },
    "seed": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/seed"
    },
    "initialization": {
      "$ref": "#/$defs/initialization"
    },
    "budget": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/budget"
    },
    "plan_sha256": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/properties/plan_sha256"
    },
    "control": {
      "allOf": [
        {"$ref": "eom://schemas/image-provider/local-image-sdxl-canny-comparison-command/1.0#/properties/control"},
        {"required": ["conditioning_scale", "guidance_start", "guidance_end", "resource_profile"]}
      ]
    },
    "region_reviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/regionReview"
      }
    },
    "region_review_evidence": {
      "allOf": [
        {"$ref": "eom://schemas/image-provider/local-image-sdxl-lineart-probe-command/1.0#/$defs/pointer"},
        {"properties": {
          "schema_ref": {"const": "eom://schemas/operations/plain-text-log/1.0"},
          "member_path": {"const": "reports/own-review.md"},
          "media_type": {"const": "text/plain"}
        }}
      ]
    }
  },
  "$defs": {
    "initialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "denoising_strength",
        "scheduler_steps",
        "effective_denoising_steps",
        "pillow_version"
      ],
      "properties": {
        "policy": {
          "const": "CONSTANT_WHITE_RGB_832X512_FULL_DENOISE/1.0"
        },
        "denoising_strength": {
          "type": "number",
          "const": 1
        },
        "scheduler_steps": {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/$defs/initialization/properties/scheduler_steps"
        },
        "effective_denoising_steps": {
          "const": 30
        },
        "pillow_version": {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0#/$defs/initialization/properties/pillow_version"
        }
      }
    },
    "sourceBox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 799
        },
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 503
        },
        "right": {
          "type": "integer",
          "minimum": 1,
          "maximum": 800
        },
        "bottom": {
          "type": "integer",
          "minimum": 1,
          "maximum": 504
        }
      }
    },
    "regionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "reference_sha256",
        "coordinate_system",
        "source_width_px",
        "source_height_px",
        "retained_box",
        "protected_boxes",
        "context_policy",
        "reviewed_at",
        "reviewed_by",
        "observation"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^imgsdxlcase_[0-9a-f]{32}$"
        },
        "reference_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "coordinate_system": {
          "const": "NORMALIZED_PHOTO_SOURCE_PIXELS_800X504/1.0"
        },
        "source_width_px": {
          "const": 800
        },
        "source_height_px": {
          "const": 504
        },
        "retained_box": {
          "$ref": "#/$defs/sourceBox"
        },
        "protected_boxes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceBox"
          }
        },
        "context_policy": {
          "const": "SUBJECT_MORPHOLOGY_ONLY_IRRELEVANT_BACKDROP"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@-]+$"
        },
        "observation": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000,
          "pattern": "^[ -~]+$"
        }
      }
    }
  }
}
