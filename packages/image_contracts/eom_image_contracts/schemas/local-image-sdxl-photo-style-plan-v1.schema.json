{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.0",
  "title": "Licensed photograph style comparison preparation, not dispatch authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "source_commit",
    "created_at",
    "purpose",
    "dispatch_policy",
    "activation_policy",
    "source_population",
    "configuration_anchor",
    "cases",
    "seed",
    "initialization",
    "budget",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-sdxl-photo-style-plan/1.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^imgsdxlphotoplan_[0-9a-f]{32}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "const": "EVALUATION_ONLY_PHOTO_TO_EXAM_STYLE"
    },
    "dispatch_policy": {
      "const": "PREPARATION_ONLY_NOT_A_WORKER_COMMAND"
    },
    "activation_policy": {
      "const": "FORBIDDEN"
    },
    "source_population": {
      "const": "LICENSED_MORPHOLOGY_REFERENCES_NOT_CORPUS_HOLDOUT"
    },
    "configuration_anchor": {
      "allOf": [
        {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-lineart-probe-command/1.0#/$defs/pointer"
        },
        {
          "properties": {
            "schema_ref": {
              "const": "eom://schemas/image-provider/local-image-sdxl-canny-reference-command/1.2"
            },
            "member_path": {
              "const": "manifests/sdxl-canny-reference-command.json"
            },
            "media_type": {
              "const": "application/json"
            }
          }
        }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/photo_case"
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "initialization": {
      "$ref": "#/$defs/initialization"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_duration_ms",
        "maximum_peak_gpu_memory_bytes"
      ],
      "properties": {
        "maximum_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "maximum_peak_gpu_memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "maximum_outputs": {
          "const": 12,
          "default": 12
        },
        "maximum_dispatches": {
          "const": 1,
          "default": 1
        },
        "automatic_retry": {
          "const": false,
          "default": false
        }
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "photo_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_reference",
        "source_review",
        "case"
      ],
      "properties": {
        "visual_reference": {
          "$ref": "eom://schemas/image-provider/local-image-reference-conditioned-composite-request/1.0#/$defs/reference_pointer"
        },
        "source_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_kind",
            "reviewed_at",
            "reviewed_by",
            "reference_sha256",
            "observation"
          ],
          "properties": {
            "source_kind": {
              "const": "PHOTOGRAPH"
            },
            "reviewed_at": {
              "type": "string",
              "format": "date-time"
            },
            "reviewed_by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:@-]+$"
            },
            "reference_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "observation": {
              "type": "string",
              "minLength": 10,
              "maxLength": 1000,
              "pattern": "^[ -~]+$"
            }
          }
        },
        "case": {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-lineart-probe-command/1.0#/$defs/case"
        }
      }
    },
    "initialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "denoising_strength",
        "scheduler_steps",
        "effective_denoising_steps",
        "pillow_version"
      ],
      "properties": {
        "policy": {
          "const": "FIT_GRAYSCALE_WHITE_RGB_832X512/1.0"
        },
        "denoising_strength": {
          "const": 0.7
        },
        "scheduler_steps": {
          "const": 30
        },
        "effective_denoising_steps": {
          "const": 21
        },
        "pillow_version": {
          "const": "11.3.0"
        }
      }
    }
  }
}
