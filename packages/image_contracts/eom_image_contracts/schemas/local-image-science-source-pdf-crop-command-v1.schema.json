{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-science-source-pdf-crop-command/1.0",
  "title": "TRAIN-only native PDF crops from pinned reviewed source regions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "created_at", "created_by", "source_commit", "source_review", "selection_ids", "render_dpi", "renderer", "pillow_version", "policy", "activation_policy", "command_sha256"],
  "properties": {
    "schema_version": {"const": "local-image-science-source-pdf-crop-command/1.0"},
    "command_id": {"type": "string", "pattern": "^imgpdfcropcommand_[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:@-]+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_review": {"$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/ImageEvaluationArtifactMember"},
    "selection_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^imgsourcecrop_[0-9a-f]{32}$"}},
    "render_dpi": {"const": 576},
    "renderer": {
      "type": "object", "additionalProperties": false, "required": ["path", "version", "sha256"],
      "properties": {
        "path": {"const": "/usr/bin/pdftoppm"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "pillow_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policy": {"const": "PINNED_TRAIN_REVIEW_144_DPI_FRAME_RENDERED_AT_576_DPI/1.0"},
    "activation_policy": {"const": "FORBIDDEN"},
    "command_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
