{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-institutional-style-review-packet/1.0",
  "title": "EOM local image institutional style blinded review packet v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "blindMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_path",
        "schema_ref",
        "media_type",
        "width_px",
        "height_px",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "member_path": {
          "type": "string",
          "pattern": "^presentation/[0-9a-f]{64}\\.png$"
        },
        "schema_ref": {
          "const": "eom://schemas/image-provider/local-image-institutional-style-blind-presentation-png/1.0"
        },
        "media_type": {
          "const": "image/png"
        },
        "width_px": {
          "const": 800
        },
        "height_px": {
          "const": 500
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8388608
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "subject_family",
        "depiction_key",
        "presentation_token",
        "left_image",
        "right_image"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^imgstylecase_[0-9a-f]{32}$"
        },
        "subject_family": {
          "enum": [
            "EARTH_SPACE",
            "LAB_APPARATUS",
            "LIVING_ORGANISM",
            "NATURAL_OBJECT",
            "PHYSICAL_OBJECT",
            "REAL_WORLD_SCENE"
          ]
        },
        "depiction_key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "presentation_token": {
          "type": "string",
          "pattern": "^blind_[0-9a-f]{32}$"
        },
        "left_image": {
          "$ref": "#/$defs/blindMember"
        },
        "right_image": {
          "$ref": "#/$defs/blindMember"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "evaluation_id",
    "plan_sha256",
    "presentation_policy",
    "cases",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-institutional-style-review-packet/1.0"
    },
    "evaluation_id": {
      "type": "string",
      "pattern": "^imgstyleeval_[0-9a-f]{32}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "presentation_policy": {
      "const": "FOREGROUND_BBOX_FIT_800X500_V1"
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
