{
  "$defs": {
    "LocalImageRuntime": {
      "additionalProperties": false,
      "properties": {
        "compute_capability": {
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Compute Capability",
          "type": "string"
        },
        "cuda_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Cuda Version",
          "type": "string"
        },
        "diffusers_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Diffusers Version",
          "type": "string"
        },
        "gpu_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Gpu Name",
          "type": "string"
        },
        "peak_gpu_memory_bytes": {
          "minimum": 1,
          "title": "Peak Gpu Memory Bytes",
          "type": "integer"
        },
        "provider_version": {
          "const": "eom-local-image-provider/1.0",
          "default": "eom-local-image-provider/1.0",
          "title": "Provider Version",
          "type": "string"
        },
        "python_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "torch_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Torch Version",
          "type": "string"
        },
        "transformers_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Transformers Version",
          "type": "string"
        }
      },
      "required": [
        "python_version",
        "torch_version",
        "diffusers_version",
        "transformers_version",
        "cuda_version",
        "gpu_name",
        "compute_capability",
        "peak_gpu_memory_bytes"
      ],
      "title": "LocalImageRuntime",
      "type": "object"
    },
    "SdxlCannyReferenceInitialization": {
      "additionalProperties": false,
      "properties": {
        "denoising_strength": {
          "default": 0.35,
          "maximum": 0.35,
          "minimum": 0.35,
          "title": "Denoising Strength",
          "type": "number"
        },
        "effective_denoising_steps": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Effective Denoising Steps",
          "type": "integer"
        },
        "pillow_version": {
          "const": "11.3.0",
          "default": "11.3.0",
          "title": "Pillow Version",
          "type": "string"
        },
        "policy": {
          "const": "FIT_GRAYSCALE_WHITE_RGB_832X512/1.0",
          "default": "FIT_GRAYSCALE_WHITE_RGB_832X512/1.0",
          "title": "Policy",
          "type": "string"
        },
        "scheduler_steps": {
          "default": 30,
          "maximum": 100,
          "minimum": 3,
          "title": "Scheduler Steps",
          "type": "integer"
        }
      },
      "title": "SdxlCannyReferenceInitialization",
      "type": "object"
    },
    "SdxlCannyReferenceTrace": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^imgsdxlcase_[0-9a-f]{32}$",
          "title": "Case Id",
          "type": "string"
        },
        "conditioning_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Conditioning Sha256",
          "type": "string"
        },
        "height_px": {
          "const": 512,
          "default": 512,
          "title": "Height Px",
          "type": "integer"
        },
        "initialization_rgb_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Initialization Rgb Sha256",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "width_px": {
          "const": 832,
          "default": 832,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "source_sha256",
        "conditioning_sha256",
        "initialization_rgb_sha256"
      ],
      "title": "SdxlCannyReferenceTrace",
      "type": "object"
    },
    "SdxlLearnedComparisonOutput": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "enum": [
            "BASE",
            "LORA"
          ],
          "title": "Arm",
          "type": "string"
        },
        "case_id": {
          "pattern": "^imgsdxlcase_[0-9a-f]{32}$",
          "title": "Case Id",
          "type": "string"
        },
        "conditioning_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Conditioning Sha256",
          "type": "string"
        },
        "duration_ms": {
          "maximum": 1800000,
          "minimum": 1,
          "title": "Duration Ms",
          "type": "integer"
        },
        "height_px": {
          "const": 500,
          "title": "Height Px",
          "type": "integer"
        },
        "member_path": {
          "pattern": "^outputs/(?:base|lora)/final/imgsdxlcase_[0-9a-f]{32}-[0-9]{10}\\.png$",
          "title": "Member Path",
          "type": "string"
        },
        "peak_gpu_memory_bytes": {
          "maximum": 17179869184,
          "minimum": 1,
          "title": "Peak Gpu Memory Bytes",
          "type": "integer"
        },
        "raw_member_path": {
          "pattern": "^outputs/(?:base|lora)/raw/imgsdxlcase_[0-9a-f]{32}-[0-9]{10}\\.png$",
          "title": "Raw Member Path",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "raw_size_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Raw Size Bytes",
          "type": "integer"
        },
        "reference_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Reference Sha256",
          "type": "string"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "width_px": {
          "const": 800,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "arm",
        "case_id",
        "seed",
        "reference_sha256",
        "conditioning_sha256",
        "member_path",
        "sha256",
        "size_bytes",
        "raw_member_path",
        "raw_sha256",
        "raw_size_bytes",
        "width_px",
        "height_px",
        "duration_ms",
        "peak_gpu_memory_bytes"
      ],
      "title": "SdxlLearnedComparisonOutput",
      "type": "object"
    }
  },
  "$id": "eom://schemas/image-provider/local-image-sdxl-canny-reference-result/1.2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_policy": {
      "const": "FORBIDDEN",
      "title": "Activation Policy",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "duration_ms": {
      "maximum": 3600000,
      "minimum": 1,
      "title": "Duration Ms",
      "type": "integer"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "SDXL_PROBE_INPUT_INVALID",
            "SDXL_PROBE_MODEL_INVALID",
            "SDXL_PROBE_HASH_MISMATCH",
            "SDXL_PROBE_GPU_UNAVAILABLE",
            "SDXL_PROBE_OOM",
            "SDXL_PROBE_EXEC_FAILED",
            "SDXL_PROBE_OUTPUT_INVALID",
            "SDXL_PROBE_BUDGET_EXCEEDED",
            "SDXL_PROBE_PROMPT_TRUNCATED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "initialization": {
      "$ref": "#/$defs/SdxlCannyReferenceInitialization"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/SdxlCannyReferenceTrace"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/SdxlLearnedComparisonOutput"
      },
      "maxItems": 6,
      "title": "Outputs",
      "type": "array"
    },
    "quality_acceptance": {
      "const": "NOT_REVIEWED",
      "title": "Quality Acceptance",
      "type": "string"
    },
    "result_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^imgsdxlcannyrefrun_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalImageRuntime"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "local-image-sdxl-canny-reference-result/1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "spatial_command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Spatial Command Sha256",
      "type": "string"
    },
    "spatial_result_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Spatial Result Sha256",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "case_relation": {
      "const": "REVIEWED_TRAIN_REFERENCE_NOT_HOLDOUT",
      "type": "string"
    },
    "native_evaluation_command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "native_adapter_manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "command_sha256",
    "spatial_command_sha256",
    "spatial_result_sha256",
    "initialization",
    "inputs",
    "quality_acceptance",
    "activation_policy",
    "status",
    "error_code",
    "runtime",
    "outputs",
    "started_at",
    "completed_at",
    "duration_ms",
    "result_sha256",
    "case_relation",
    "native_evaluation_command_sha256",
    "native_adapter_manifest_sha256"
  ],
  "title": "LocalImageSdxlNativeCannyReferenceResultV2",
  "type": "object"
}
