{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-reference-conditioned-composite-receipt/1.0",
  "title": "EOM local image reference-conditioned composite receipt v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "reference_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_revision_id",
        "bundle_manifest",
        "primary_reference_id",
        "reference_member"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^imgrefbundle_[0-9a-f]{32}$"
        },
        "bundle_revision_id": {
          "type": "string",
          "pattern": "^imgrefbundlerev_[0-9a-f]{32}$"
        },
        "bundle_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "artifact_revision_id",
            "member_path",
            "schema_ref",
            "media_type",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^artifact_[0-9a-f]{32}$"
            },
            "artifact_revision_id": {
              "type": "string",
              "pattern": "^rev_[0-9a-f]{32}$"
            },
            "member_path": {
              "type": "string",
              "pattern": "^manifests/visual-reference-bundle\\.json$"
            },
            "schema_ref": {
              "const": "eom://schemas/image-provider/local-image-visual-reference-bundle/1.0"
            },
            "media_type": {
              "const": "application/json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        },
        "primary_reference_id": {
          "type": "string",
          "pattern": "^imgref_[0-9a-f]{32}$"
        },
        "reference_member": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "artifact_revision_id",
            "member_path",
            "schema_ref",
            "media_type",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^artifact_[0-9a-f]{32}$"
            },
            "artifact_revision_id": {
              "type": "string",
              "pattern": "^rev_[0-9a-f]{32}$"
            },
            "member_path": {
              "type": "string",
              "pattern": "^references/primary\\.png$"
            },
            "schema_ref": {
              "const": "eom://schemas/image-provider/normalized-visual-reference/1.0"
            },
            "media_type": {
              "const": "image/png"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        }
      }
    },
    "conditioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "strength",
        "fit_policy"
      ],
      "properties": {
        "contract": {
          "const": "sdxl-img2img/1.0"
        },
        "strength": {
          "const": 0.35
        },
        "fit_policy": {
          "const": "CONTAIN_WHITE_NO_UPSCALE"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "request_sha256",
    "composite_receipt",
    "visual_reference",
    "conditioning",
    "completed_at",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-reference-conditioned-composite-receipt/1.0"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "composite_receipt": {
      "$ref": "eom://schemas/image-provider/local-image-composite-receipt/1.0"
    },
    "visual_reference": {
      "$ref": "#/$defs/reference_pointer"
    },
    "conditioning": {
      "$ref": "#/$defs/conditioning"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
