{
  "$defs": {
    "ImageEvaluationArtifactMember": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Member Path",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "title": "ImageEvaluationArtifactMember",
      "type": "object"
    },
    "SdxlLearnedComparisonBudget": {
      "additionalProperties": false,
      "properties": {
        "maximum_duration_ms": {
          "maximum": 1800000,
          "minimum": 1,
          "title": "Maximum Duration Ms",
          "type": "integer"
        },
        "maximum_peak_gpu_memory_bytes": {
          "maximum": 17179869184,
          "minimum": 1,
          "title": "Maximum Peak Gpu Memory Bytes",
          "type": "integer"
        }
      },
      "required": [
        "maximum_duration_ms",
        "maximum_peak_gpu_memory_bytes"
      ],
      "title": "SdxlLearnedComparisonBudget",
      "type": "object"
    }
  },
  "$id": "eom://schemas/image-provider/local-image-sdxl-learned-comparison-command/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_policy": {
      "const": "FORBIDDEN",
      "title": "Activation Policy",
      "type": "string"
    },
    "baseline_command": {
      "$ref": "#/$defs/ImageEvaluationArtifactMember"
    },
    "budget": {
      "$ref": "#/$defs/SdxlLearnedComparisonBudget"
    },
    "case_ids": {
      "items": {
        "pattern": "^imgsdxlcase_[0-9a-f]{32}$",
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Case Ids",
      "type": "array"
    },
    "command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "conditioning_policy": {
      "const": "PINNED_LEARNED_FINE_INVERTED/1.0",
      "title": "Conditioning Policy",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "extraction_command": {
      "$ref": "#/$defs/ImageEvaluationArtifactMember"
    },
    "extraction_result": {
      "$ref": "#/$defs/ImageEvaluationArtifactMember"
    },
    "lora_evaluation_command": {
      "$ref": "#/$defs/ImageEvaluationArtifactMember"
    },
    "purpose": {
      "const": "EVALUATION_ONLY_MATCHED_LEARNED_CONDITIONING",
      "title": "Purpose",
      "type": "string"
    },
    "run_id": {
      "pattern": "^imgsdxllearnedrun_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "local-image-sdxl-learned-comparison-command/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Commit",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_commit",
    "created_at",
    "purpose",
    "activation_policy",
    "baseline_command",
    "extraction_command",
    "extraction_result",
    "lora_evaluation_command",
    "conditioning_policy",
    "case_ids",
    "seed",
    "budget",
    "command_sha256"
  ],
  "title": "LocalImageSdxlLearnedComparisonCommand",
  "type": "object"
}
