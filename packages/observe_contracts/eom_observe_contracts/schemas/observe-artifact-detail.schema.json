{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eom.local/schemas/observe/observe-artifact-detail.schema.json",
  "title": "EOM Observe Artifact Detail",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "artifact_type", "approved", "job_id", "created_at", "revisions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "maxLength": 64},
    "artifact_type": {"type": "string", "maxLength": 80},
    "approved": {"type": "boolean"},
    "job_id": {"type": "string", "maxLength": 64},
    "created_at": {"type": "string", "format": "date-time"},
    "revisions": {"type": "array", "items": {"type": "object"}, "maxItems": 100}
  }
}
