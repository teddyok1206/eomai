/* One purpose-specific worker grant; keep frozen embedding policies byte-identical. */
polkit.addRule(function(action, subject) {
    var unit = action.lookup("unit");
    var match = typeof unit === "string"
        ? /^eom-worker-analysis-03@job_[0-9a-f]{32}\.service$/.exec(unit) : null;
    if (action.id === "org.freedesktop.systemd1.manage-units"
        && subject.user === "eom-workflow-runner"
        && action.lookup("verb") === "start"
        && match !== null && match[0] === unit) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
