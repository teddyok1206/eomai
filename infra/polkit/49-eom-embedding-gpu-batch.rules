// Trusted application owner may start one fixed root controller, not a native worker/socket.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    if (typeof unit === "string" &&
        /^eom-embedding-native-gpu-batch-owner@[0-9a-f]{32}\.service$/.test(unit)) {
        if (subject.user === "eom-workflow-runner" && action.lookup("verb") === "start") {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }
    if (typeof unit === "string" &&
        /^eom-embedding-native-gpu-batch@[0-9a-f]{32}\.(?:service|socket)$/.test(unit)) {
        return polkit.Result.NO;
    }
    return polkit.Result.NOT_HANDLED;
});
