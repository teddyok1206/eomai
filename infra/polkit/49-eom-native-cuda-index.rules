// A trusted owner may start the fixed root controller, never the CUDA main unit.
// Source/claim/policy authorization remains with the original application use case.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    if (typeof unit === "string" &&
        /^eom-embedding-native-cuda-index-owner@[0-9a-f]{32}\.service$/.test(unit)) {
        if (subject.user === "eom-workflow-runner" && action.lookup("verb") === "start") {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }
    if (typeof unit === "string" &&
        /^eom-embedding-native-cuda-index@[0-9a-f]{32}\.service$/.test(unit)) {
        return polkit.Result.NO;
    }
    return polkit.Result.NOT_HANDLED;
});
