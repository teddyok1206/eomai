/* EOM fixed worker and HWPX StartUnit boundary. Installed root-owned; no transient units. */
polkit.addRule(function(action, subject) {
    var workerUnit = /^eom-worker-(01|02|03|04|05)@job_[0-9a-f]{32}\.service$/;
    var probeUnit = /^eom-worker-probe-(01|02|03|04|05)@probe_[0-9a-f]{32}\.service$/;
    var hwpxUnit = /^eom-hwpx-kordoc@hwpxbuild_[0-9a-f]{32}\.service$/;

    if (
        action.id !== "org.freedesktop.systemd1.manage-units"
        || subject.user !== "eom"
    ) {
        return polkit.Result.NOT_HANDLED;
    }

    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (verb === "start" && (workerUnit.test(unit) || probeUnit.test(unit) || hwpxUnit.test(unit))) {
        return polkit.Result.YES;
    }

    return polkit.Result.NO;
});
