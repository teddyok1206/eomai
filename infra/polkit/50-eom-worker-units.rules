/* EOM fixed worker and HWPX StartUnit boundary. Installed root-owned; no transient units. */
polkit.addRule(function(action, subject) {
    var workerUnit = /^eom-worker-(01|02|03|04|05|06)@job_[0-9a-f]{32}\.service$/;
    var probeUnit = /^eom-worker-probe-(01|02|03|04|05|06)@probe_[0-9a-f]{32}\.service$/;
    var authUnit = /^eom-worker-auth-(01|02|03|04|05|06)\.service$/;
    var loginUnit = /^eom-worker-login-(01|02|03|04|05|06)@authflow_[0-9a-f]{32}\.service$/;
    var kordocUnit = /^eom-hwpx-kordoc@hwpxbuild_[0-9a-f]{32}\.service$/;
    var questionTemplateUnit = /^eom-hwpx-builder@hwpxbuild_[0-9a-f]{32}\.service$/;
    var localImageUnit = /^eom-image-provider@imgreq_[0-9a-f]{32}\.service$/;

    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }

    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (verb === "start" && subject.user === "eom-workflow-runner"
        && (workerUnit.test(unit) || probeUnit.test(unit) || authUnit.test(unit)
            || loginUnit.test(unit) || localImageUnit.test(unit))) {
        return polkit.Result.YES;
    }
    if (verb === "start" && subject.user === "eom-hwpx-manager"
        && (kordocUnit.test(unit) || questionTemplateUnit.test(unit))) {
        return polkit.Result.YES;
    }
    if (verb === "start" && subject.user === "eom"
        && (probeUnit.test(unit) || authUnit.test(unit))) {
        return polkit.Result.YES;
    }
    if (["eom", "eom-workflow-runner", "eom-hwpx-manager"].indexOf(subject.user) !== -1) {
        return polkit.Result.NO;
    }
    return polkit.Result.NOT_HANDLED;
});
