[Unit]
Description=EOM fixed Codex worker slot 01 (contract v1), job %i

[Service]
Type=oneshot
User=eom-cdx-01
Group=eom-cdx-01
WorkingDirectory=/srv/eom/workspaces/eom-cdx-01/%i
Environment=HOME=/srv/eom/worker-homes/eom-cdx-01
Environment=CODEX_HOME=/srv/eom/worker-homes/eom-cdx-01/.codex
Environment=LANG=C.UTF-8
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/libexec/eom-worker-exec --slot 01 --job-id %i

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
# Codex's nested Bubblewrap mounts a private /proc. The outer systemd
# ProtectKernelTunables mount namespace blocks that operation; the worker has
# no capabilities and the nested sandbox owns the proc/sys boundary instead.
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
# Bubblewrap needs AF_NETLINK only to configure loopback inside its private
# network namespace; packet sockets and capabilities remain unavailable.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

InaccessiblePaths=/mnt/nas
InaccessiblePaths=/var/run/docker.sock
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/etc/eom
InaccessiblePaths=/srv/eom/staging
InaccessiblePaths=/srv/eom/workspaces/eom-cdx-02
InaccessiblePaths=/srv/eom/workspaces/eom-cdx-03
InaccessiblePaths=/srv/eom/workspaces/eom-cdx-04
InaccessiblePaths=/srv/eom/workspaces/eom-cdx-05
InaccessiblePaths=/srv/eom/workspaces/eom-cdx-06
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-02
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-03
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-04
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-05
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-06
ReadWritePaths=/srv/eom/workspaces/eom-cdx-01/%i
ReadWritePaths=/srv/eom/worker-homes/eom-cdx-01

UMask=0007
MemoryMax=6G
CPUQuota=200%
TasksMax=256
TimeoutStartSec=1800
TimeoutStopSec=15
KillMode=control-group
SendSIGKILL=true

StandardOutput=journal
StandardError=journal
