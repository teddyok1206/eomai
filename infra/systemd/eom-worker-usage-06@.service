[Unit]
Description=EOM fixed Codex usage observation slot 06, command %i

[Service]
Type=oneshot
User=eom-cdx-06
Group=eom-cdx-06
Environment=HOME=/srv/eom/worker-homes/eom-cdx-06
Environment=CODEX_HOME=/srv/eom/worker-homes/eom-cdx-06/.codex
Environment=LANG=C.UTF-8
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RuntimeDirectory=eom-codex-usage-06
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/libexec/eom-worker-codex-usage --slot 06 --instance %i
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
InaccessiblePaths=/mnt/nas
InaccessiblePaths=/var/run/docker.sock
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/etc/eom
InaccessiblePaths=/srv/eom/staging
InaccessiblePaths=/srv/eom/workspaces
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-01
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-02
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-03
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-04
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-05
ReadOnlyPaths=/srv/eom/conda/envs/eom-api
ReadWritePaths=/srv/eom/worker-homes/eom-cdx-06
ReadWritePaths=/run/eom-codex-usage-06
UMask=0027
MemoryMax=512M
TasksMax=64
TimeoutStartSec=75
TimeoutStopSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal
