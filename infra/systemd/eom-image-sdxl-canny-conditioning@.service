[Unit]
Description=EOM isolated CPU-only pinned SDXL Canny input preparation %i
After=local-fs.target
ConditionPathIsDirectory=/srv/eom/image-training-workspaces/%i
ConditionPathIsReadWrite=/srv/eom/image-training-workspaces/%i

[Service]
Type=oneshot
User=eom-image
Group=eom-image
WorkingDirectory=/srv/eom/image-training-workspaces/%i
Environment=HOME=/var/lib/eom-image
Environment=TZ=UTC
Environment=PYTHONNOUSERSITE=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/srv/eom/conda/envs/eom-image-trainer/bin/eom-local-image sdxl-canny-conditioning --command /srv/eom/image-training-workspaces/%i/command.json --workspace /srv/eom/image-training-workspaces/%i

NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/srv/eom/conda/envs/eom-image-trainer
ReadWritePaths=/srv/eom/image-training-workspaces/%i
InaccessiblePaths=/mnt/nas
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/etc/eom
InaccessiblePaths=/srv/eom/models/image
InaccessiblePaths=/srv/eom/image-workspaces
InaccessiblePaths=/srv/eom/workspaces
InaccessiblePaths=/srv/eom/worker-homes
InaccessiblePaths=/root/.codex
InaccessiblePaths=/var/run/docker.sock
UMask=0077
MemoryMax=2G
TasksMax=64
CPUQuota=200%
TimeoutStartSec=120
TimeoutStopSec=15
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
Restart=no
