[Unit]
Description=EOM isolated Office document converter workspace %i
After=local-fs.target

[Service]
Type=oneshot
User=eom-catalog-manager
Group=eom-api
WorkingDirectory=/var/lib/eom-catalog-api/staging/office-conversion/%i
Environment=HOME=/var/lib/eom-catalog-api/staging/office-conversion/%i/home
ExecStart=/srv/eom/conda/envs/eom-api/bin/python -I -m eom_catalog_service.office_converter_worker %i

NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
UMask=0077

InaccessiblePaths=/mnt/nas
InaccessiblePaths=/root/.codex
InaccessiblePaths=/srv/eom/worker-homes
InaccessiblePaths=/var/run/docker.sock
InaccessiblePaths=/etc/eom
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/usr/local/bin/codex
ReadWritePaths=/var/lib/eom-catalog-api/staging/office-conversion/%i
ReadOnlyPaths=/srv/eom/vendor/h2orestart/0.7.14-eom.1/H2Orestart.oxt

RestrictAddressFamilies=AF_UNIX
MemoryMax=2G
CPUQuota=200%
TasksMax=128
TimeoutStartSec=180
