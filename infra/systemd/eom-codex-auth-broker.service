[Unit]
Description=EOM private Codex device-auth challenge broker
After=local-fs.target

[Service]
Type=simple
User=eom-codex-auth-broker
Group=eom-codex-auth
SupplementaryGroups=eom-cdx-01 eom-cdx-02 eom-cdx-03 eom-cdx-04 eom-cdx-05
RuntimeDirectory=eom-codex-auth-broker
RuntimeDirectoryMode=0750
WorkingDirectory=/run/eom-codex-auth-broker
Environment=HOME=/var/lib/eom-codex-auth-broker
Environment=TZ=UTC
ExecStart=/srv/eom/conda/envs/eom-api/bin/python -I -m eom_orchestrator.codex_auth_broker_server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
ReadOnlyPaths=/srv/eom/conda/envs/eom-api
ReadOnlyPaths=-/run/eom-codex-login-01
ReadOnlyPaths=-/run/eom-codex-login-02
ReadOnlyPaths=-/run/eom-codex-login-03
ReadOnlyPaths=-/run/eom-codex-login-04
ReadOnlyPaths=-/run/eom-codex-login-05
InaccessiblePaths=/mnt/nas
InaccessiblePaths=/var/run/docker.sock
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/etc/eom
InaccessiblePaths=/srv/eom/staging
InaccessiblePaths=/srv/eom/workspaces
InaccessiblePaths=/srv/eom/worker-homes
StateDirectory=eom-codex-auth-broker
StateDirectoryMode=0700
UMask=0007
MemoryMax=256M
TasksMax=64
TimeoutStartSec=30
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
