[Unit]
Description=EOM Workflow Command Runner
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=eom-workflow-runner
Group=eom
SupplementaryGroups=eom-artifact-committers eom-cdx-01 eom-cdx-02 eom-cdx-03 eom-cdx-04 eom-cdx-05
StateDirectory=eom-workflow-runner
StateDirectoryMode=0700
WorkingDirectory=/var/lib/eom-workflow-runner
Environment=HOME=/var/lib/eom-workflow-runner
Environment=TZ=UTC
Environment=EOM_POSTGRES_ENV=/etc/eom/secrets/postgres.env
Environment=EOM_WORKER_CONFIG=/etc/eom/worker-slots.yaml
Environment=EOM_WORKFLOW_DEFINITION=/etc/eom/workflows/generic-item-development.yaml
Environment=EOM_HUMAN_ACTOR_CONFIG=/etc/eom/human-actors.yaml
Environment=EOM_WORKFLOW_RUNNER_CONFIG=/etc/eom/workflow-runner.yaml
Environment=EOM_WORKFLOW_PROMPT_ROOT=/etc/eom/workflow-prompts
ExecStart=/srv/eom/conda/envs/eom-api/bin/eom-workflow-runner serve
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# The runner must create reviewed 02770 worker job directories. The fixed worker
# templates retain the SUID/SGID restriction; only this producer boundary may set SGID.
RestrictSUIDSGID=false
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

ReadOnlyPaths=/etc/eom/secrets/postgres.env
ReadOnlyPaths=/etc/eom/worker-slots.yaml
ReadOnlyPaths=/etc/eom/human-actors.yaml
ReadOnlyPaths=/etc/eom/workflow-runner.yaml
ReadOnlyPaths=/etc/eom/workflows
ReadOnlyPaths=/etc/eom/workflow-prompts
ReadOnlyPaths=/srv/eom/conda/envs/eom-api
ReadOnlyPaths=/srv/eom/worker-homes
ReadWritePaths=/srv/eom/staging
ReadWritePaths=/srv/eom/workspaces
ReadWritePaths=/mnt/nas/eom/artifacts
ReadWritePaths=/var/lib/eom-workflow-runner

InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/root/.codex
InaccessiblePaths=/var/run/docker.sock
InaccessiblePaths=-/var/lib/lxd
InaccessiblePaths=-/var/snap/lxd
InaccessiblePaths=-/run/lxd
InaccessiblePaths=-/run/snapd.socket
InaccessiblePaths=/etc/eom/secrets/api.env
InaccessiblePaths=/etc/eom/secrets/catalog-manager.env
InaccessiblePaths=/etc/eom/secrets/hwpx-manager.env
InaccessiblePaths=/etc/eom/secrets/observe.env
InaccessiblePaths=/etc/eom/secrets/web-gui.env
InaccessiblePaths=-/etc/eom/secrets/dev-slack.env
InaccessiblePaths=/etc/eom-api
InaccessiblePaths=-/srv/eom/worker-homes/eom-cdx-01/.codex
InaccessiblePaths=-/srv/eom/worker-homes/eom-cdx-02/.codex
InaccessiblePaths=-/srv/eom/worker-homes/eom-cdx-03/.codex
InaccessiblePaths=-/srv/eom/worker-homes/eom-cdx-04/.codex
InaccessiblePaths=-/srv/eom/worker-homes/eom-cdx-05/.codex

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0007
MemoryMax=2G
TasksMax=128
TimeoutStartSec=30
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
