[Unit]
Description=EOM private Kakao remote gateway (bounded owner lease)
After=local-fs.target eom-kakao-browser.service
BindsTo=eom-kakao-browser.service

[Service]
Type=notify
NotifyAccess=main
User=eom-kakao-remote
Group=eom-kakao-proxy
SupplementaryGroups=eom-kakao-vnc eom-kakao-grant
RuntimeDirectory=eom-kakao-remote
RuntimeDirectoryMode=2750
WorkingDirectory=/run/eom-kakao-remote
ExecStart=/opt/eom/conda/envs/eom-kakao-remote/bin/python -I -B -m eom_kakao_archive_gateway.supervisor
Restart=no
KillMode=control-group
TimeoutStartSec=15
TimeoutStopSec=3
SendSIGKILL=yes
UMask=0007
StandardInput=null
StandardOutput=null
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M
CPUQuota=100%
TasksMax=32
LimitNOFILE=256
LimitCORE=0
ReadOnlyPaths=/var/lib/eom-kakao-runtime/remote
ReadOnlyPaths=/opt/eom/kakao-remote/releases/novnc-1.6.0/noVNC
ReadOnlyPaths=/run/eom-kakao-vnc
ReadWritePaths=/run/eom-kakao-remote
InaccessiblePaths=/mnt/nas /home/eom/EOM -/home/eom/EOMIS /root /srv/eom/worker-homes
InaccessiblePaths=-/var/lib/eom-kakao -/run/eom-kakao-private -/var/lib/eom-catalog-api
InaccessiblePaths=-/run/postgresql -/run/eom-catalog-api -/var/run/docker.sock
InaccessiblePaths=-/run/dbus -/run/systemd/private -/usr/local/bin/codex
