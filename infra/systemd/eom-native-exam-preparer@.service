[Unit]
Description=EOM bounded native exam file preparation %i
After=local-fs.target

[Service]
Type=oneshot
User=eom-image
Group=eom-api
RuntimeDirectory=eom-native-exam/%i
RuntimeDirectoryMode=0700
WorkingDirectory=/run/eom-native-exam/%i
BindPaths=/var/lib/eom-catalog-api/staging/native-exam/%i:/run/eom-native-exam/%i
ExecStart=/srv/eom/conda/envs/eom-api/bin/python -I -B -m eom_catalog_service.native_exam_preparer_worker %i
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
UMask=0077
InaccessiblePaths=/mnt/nas
InaccessiblePaths=/root
InaccessiblePaths=/etc/eom
InaccessiblePaths=/var/lib/eom-catalog-api
InaccessiblePaths=/srv/eom/worker-homes
InaccessiblePaths=-/run/postgresql
InaccessiblePaths=-/run/eom
InaccessiblePaths=-/run/eom-catalog-api
InaccessiblePaths=-/var/run/docker.sock
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=-/home/eom/EOMIS
InaccessiblePaths=-/usr/local/bin/codex
ReadWritePaths=/run/eom-native-exam/%i
RestrictAddressFamilies=AF_UNIX
MemoryMax=2G
CPUQuota=200%
TasksMax=128
LimitFSIZE=536870912
TimeoutStartSec=115
KillMode=control-group
SendSIGKILL=true
