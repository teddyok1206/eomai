[Unit]
Description=EOM bounded visual reference discoverer %i
After=network-online.target local-fs.target
Wants=network-online.target
ConditionPathIsDirectory=/srv/eom/image-reference-workspaces/%i
ConditionPathIsReadWrite=/srv/eom/image-reference-workspaces/%i

[Service]
Type=oneshot
User=eom-image-reference
Group=eom-image-reference
WorkingDirectory=/srv/eom/image-reference-workspaces/%i
Environment=HOME=/var/lib/eom-image-reference
Environment=TZ=UTC
Environment=PYTHONNOUSERSITE=1
ExecStart=/srv/eom/conda/envs/eom-image/bin/eom-local-image discover-reference --command /srv/eom/image-reference-workspaces/%i/command.json --workspace /srv/eom/image-reference-workspaces/%i

StateDirectory=eom-image-reference
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=false
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

ReadOnlyPaths=/srv/eom/conda/envs/eom-image
ReadWritePaths=/srv/eom/image-reference-workspaces/%i
InaccessiblePaths=/mnt/nas
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/etc/eom
InaccessiblePaths=/srv/eom/models
InaccessiblePaths=/srv/eom/image-workspaces
InaccessiblePaths=/srv/eom/image-training-workspaces
InaccessiblePaths=/srv/eom/workspaces
InaccessiblePaths=/srv/eom/worker-homes
InaccessiblePaths=/root/.codex
InaccessiblePaths=/var/run/docker.sock

UMask=0077
MemoryMax=2G
TasksMax=64
TimeoutStartSec=240
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
Restart=no
