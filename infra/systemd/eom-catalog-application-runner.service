[Unit]
Description=EOM Catalog Application Manager
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=eom-catalog-manager
Group=eom-api
SupplementaryGroups=eom
RuntimeDirectory=eom-catalog-api
RuntimeDirectoryMode=0750
StateDirectory=eom-catalog-api
StateDirectoryMode=0700
WorkingDirectory=/var/lib/eom-catalog-api
Environment=HOME=/var/lib/eom-catalog-api
Environment=TZ=UTC
Environment=EOM_CATALOG_STAGING_ROOT=/var/lib/eom-catalog-api/staging
EnvironmentFile=/etc/eom/secrets/catalog-manager.env
ExecStartPre=/usr/bin/install -d -m 0750 /var/lib/eom-catalog-api/staging
ExecStartPre=/usr/bin/install -d -m 0750 /var/lib/eom-catalog-api/staging/content-packs
ExecStartPre=/usr/bin/install -d -m 0750 /var/lib/eom-catalog-api/staging/registry
ExecStartPre=/usr/bin/install -d -m 0750 /var/lib/eom-catalog-api/staging/workflow-prompts
ExecStart=/srv/eom/conda/envs/eom-api/bin/eom-catalog-application-runner serve
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=

ReadOnlyPaths=/etc/eom/secrets/catalog-manager.env
ReadOnlyPaths=/srv/eom/conda/envs/eom-api
ReadWritePaths=/mnt/nas/eom/artifacts
ReadWritePaths=/run/eom-catalog-api
ReadWritePaths=/var/lib/eom-catalog-api

InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/srv/eom/staging/catalog
InaccessiblePaths=/root/.codex
InaccessiblePaths=/srv/eom/worker-homes
InaccessiblePaths=/var/run/docker.sock
InaccessiblePaths=-/var/lib/lxd
InaccessiblePaths=-/var/snap/lxd
InaccessiblePaths=-/run/lxd
InaccessiblePaths=-/run/snapd.socket
InaccessiblePaths=/etc/eom/secrets/api.env
InaccessiblePaths=/etc/eom/secrets/hwpx-manager.env
InaccessiblePaths=/etc/eom/secrets/observe.env
InaccessiblePaths=/etc/eom/secrets/web-gui.env
InaccessiblePaths=/etc/eom-api

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
MemoryMax=1G
TasksMax=128
TimeoutStartSec=30
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
