[Unit]
Description=EOM isolated original-case learned lineart extraction %i
After=local-fs.target
StartLimitIntervalSec=infinity
StartLimitBurst=1
CollectMode=inactive
ConditionPathIsDirectory=/srv/eom/image-training-workspaces/%i
ConditionPathIsReadWrite=/srv/eom/image-training-workspaces/%i

[Service]
Type=oneshot
RemainAfterExit=yes
NotifyAccess=main
FileDescriptorStoreMax=1
FileDescriptorStorePreserve=yes
SupplementaryGroups=eom-gpu-lease
KillMode=control-group
ReadOnlyPaths=/run/eom-gpu-lease
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE
User=eom-image
Group=eom-image
WorkingDirectory=/srv/eom/image-training-workspaces/%i
Environment=HOME=/var/lib/eom-image
Environment=TZ=UTC
Environment=PYTHONNOUSERSITE=1
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=CUBLAS_WORKSPACE_CONFIG=:4096:8
ExecStartPre=+/opt/eom/conda/envs/eom-embedding-experiment/bin/python3.12 -I -B /usr/local/libexec/eom-image-runtime/start_gpu_guard.py %n
ExecStart=/srv/eom/conda/envs/eom-image-trainer/bin/python3.11 -I -B /usr/local/libexec/eom-image-runtime/run_gpu_unit.py PROVIDER_IN_TRAINER informative-lineart-extraction --command /srv/eom/image-training-workspaces/%i/command.json --model-store-root /srv/eom/models/image --workspace /srv/eom/image-training-workspaces/%i --gpu-lock /run/eom-gpu-lease/gpu0.lock

StateDirectory=eom-image
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw

ReadOnlyPaths=/srv/eom/conda/envs/eom-image-trainer
ReadOnlyPaths=/srv/eom/models/image
ReadWritePaths=/srv/eom/image-training-workspaces/%i
ReadWritePaths=/var/lib/eom-image
InaccessiblePaths=/mnt/nas
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/etc/eom
InaccessiblePaths=/srv/eom/image-workspaces
InaccessiblePaths=/srv/eom/workspaces
InaccessiblePaths=/srv/eom/worker-homes
InaccessiblePaths=/root/.codex
InaccessiblePaths=/var/run/docker.sock

UMask=0077
MemoryMax=24G
TasksMax=512
TimeoutStartSec=630
TimeoutStopSec=60
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
Restart=no
