[Unit]
Description=EOM fixed root CPU experiment staging %i
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/
Environment=TZ=UTC
Environment=LANG=C.UTF-8
Environment=PATH=/usr/bin:/bin
Environment=PYTHONNOUSERSITE=1
ExecStart=/srv/eom/conda/envs/eom-api/bin/python -I -m eom_orchestrator.inference_transfer_cpu_handoff --execution-id %i

NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
# Root may only traverse the fixed private input and assign the reviewed output group.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadOnlyPaths=/srv/eom/conda/envs/eom-api
ReadOnlyPaths=/var/lib/eom-workflow-runner/inference-transfer-experiments
ReadWritePaths=/run/eom-embedding-experiments
InaccessiblePaths=/mnt/nas /home/eom/EOM /home/eom/EOMIS /etc/eom
InaccessiblePaths=/root/.codex /srv/eom/worker-homes /srv/eom/models
InaccessiblePaths=-/var/run/docker.sock -/run/postgresql -/var/run/postgresql
InaccessiblePaths=-/run/dbus -/run/systemd/private

UMask=0077
MemoryMax=512M
TasksMax=16
TimeoutStartSec=30
TimeoutStopSec=5
KillMode=control-group
Restart=no
LimitFSIZE=64M
LimitCORE=0
StandardInput=null
StandardOutput=null
StandardError=null
