[Unit]
Description=EOM fixed Codex worker slot 04 (contract v1), job %i

[Service]
Type=oneshot
User=eom-cdx-04
Group=eom-cdx-04
WorkingDirectory=/srv/eom/workspaces/eom-cdx-04/%i
Environment=HOME=/srv/eom/worker-homes/eom-cdx-04
Environment=CODEX_HOME=/srv/eom/worker-homes/eom-cdx-04/.codex
Environment=LANG=C.UTF-8
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/libexec/eom-worker-exec --slot 04 --job-id %i

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

InaccessiblePaths=/mnt/nas
InaccessiblePaths=/var/run/docker.sock
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/etc/eom
InaccessiblePaths=/srv/eom/staging
InaccessiblePaths=/srv/eom/workspaces/eom-cdx-01
InaccessiblePaths=/srv/eom/workspaces/eom-cdx-02
InaccessiblePaths=/srv/eom/workspaces/eom-cdx-03
InaccessiblePaths=/srv/eom/workspaces/eom-cdx-05
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-01
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-02
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-03
InaccessiblePaths=/srv/eom/worker-homes/eom-cdx-05
ReadWritePaths=/srv/eom/workspaces/eom-cdx-04/%i
ReadWritePaths=/srv/eom/worker-homes/eom-cdx-04

UMask=0007
MemoryMax=6G
CPUQuota=200%
TasksMax=256
TimeoutStartSec=600
TimeoutStopSec=15
KillMode=control-group
SendSIGKILL=true

StandardOutput=journal
StandardError=journal
