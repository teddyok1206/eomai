[Unit]
Description=EOM isolated science-corpus visual pilot %i
After=local-fs.target
ConditionPathIsDirectory=/srv/eom/image-training-workspaces/%i
ConditionPathIsReadWrite=/srv/eom/image-training-workspaces/%i

[Service]
Type=oneshot
User=eom-image
Group=eom-image
WorkingDirectory=/srv/eom/image-training-workspaces/%i
Environment=HOME=/var/lib/eom-image
Environment=TZ=UTC
Environment=PYTHONNOUSERSITE=1
ExecStart=/srv/eom/conda/envs/eom-image-trainer/bin/eom-local-image-trainer science-corpus-visual-pilot --command /srv/eom/image-training-workspaces/%i/command.json --workspace /srv/eom/image-training-workspaces/%i

StateDirectory=eom-image
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX

ReadOnlyPaths=/srv/eom/conda/envs/eom-image-trainer
ReadWritePaths=/srv/eom/image-training-workspaces/%i
ReadWritePaths=/var/lib/eom-image
InaccessiblePaths=/mnt/nas
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/etc/eom
InaccessiblePaths=/srv/eom/image-workspaces
InaccessiblePaths=/srv/eom/workspaces
InaccessiblePaths=/srv/eom/worker-homes
InaccessiblePaths=/root/.codex
InaccessiblePaths=/var/run/docker.sock

UMask=0077
MemoryMax=8G
TasksMax=256
TimeoutStartSec=14400
TimeoutStopSec=60
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
Restart=no
