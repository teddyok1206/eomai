[Unit]
Description=EOM isolated content-team HWPX renderer workspace %i
After=local-fs.target

[Service]
Type=oneshot
User=eom-hwpx
Group=eom-hwpx
WorkingDirectory=/srv/eom/hwpx-workspaces/%i
Environment=HOME=/var/lib/eom-hwpx
ExecStart=/srv/eom/conda/envs/eom-hwpx/bin/eom-hwpx render-content-team --request request.json --result result.json

NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
UMask=0077

InaccessiblePaths=/mnt/nas
InaccessiblePaths=/root/.codex
InaccessiblePaths=/srv/eom/worker-homes
InaccessiblePaths=/var/run/docker.sock
InaccessiblePaths=/etc/eom
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/usr/local/bin/codex
ReadWritePaths=/srv/eom/hwpx-workspaces/%i

MemoryMax=2G
CPUQuota=200%
TasksMax=64
TimeoutStartSec=300
