[Unit]
Description=EOM Versioned Application API
After=network-online.target docker.service eom-catalog-application-runner.service
Wants=network-online.target eom-catalog-application-runner.service

[Service]
Type=simple
User=eom-api
Group=eom-api
WorkingDirectory=/var/lib/eom-api

EnvironmentFile=/etc/eom/secrets/api.env
Environment=EOM_API_CONFIG=/etc/eom-api/api.yaml

ExecStart=/srv/eom/conda/envs/eom-api/bin/eom-api serve

Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=

ReadOnlyPaths=/etc/eom-api/api.yaml
ReadOnlyPaths=/etc/eom/secrets/api.env
ReadWritePaths=/var/lib/eom-api

InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/root/.codex
InaccessiblePaths=/srv/eom/worker-homes
InaccessiblePaths=/mnt/nas
InaccessiblePaths=/var/run/docker.sock
InaccessiblePaths=/etc/eom/secrets/postgres.env
InaccessiblePaths=/etc/eom/secrets/dev-slack.env
InaccessiblePaths=/etc/eom/secrets/catalog-manager.env
InaccessiblePaths=/etc/eom/secrets/observe.env

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

UMask=0077
MemoryMax=1G
TasksMax=256
TimeoutStartSec=30
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
