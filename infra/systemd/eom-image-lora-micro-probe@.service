[Unit]
Description=EOM isolated evaluation-only local image LoRA micro probe %i
After=local-fs.target
ConditionPathIsDirectory=/srv/eom/image-training-workspaces/%i
ConditionPathIsReadWrite=/srv/eom/image-training-workspaces/%i

[Service]
Type=oneshot
User=eom-image
Group=eom-image
WorkingDirectory=/srv/eom/image-training-workspaces/%i
Environment=HOME=/var/lib/eom-image
Environment=TZ=UTC
Environment=PYTHONNOUSERSITE=1
Environment=CUBLAS_WORKSPACE_CONFIG=:4096:8
ExecStart=/srv/eom/conda/envs/eom-image-trainer/bin/eom-local-image-trainer micro-probe --command /srv/eom/image-training-workspaces/%i/command.json --model-store-root /srv/eom/models/image --workspace /srv/eom/image-training-workspaces/%i --gpu-lock /var/lib/eom-image/gpu0.lock

StateDirectory=eom-image
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw

ReadOnlyPaths=/srv/eom/conda/envs/eom-image-trainer
ReadOnlyPaths=/srv/eom/models/image
ReadWritePaths=/srv/eom/image-training-workspaces/%i
ReadWritePaths=/var/lib/eom-image
InaccessiblePaths=/mnt/nas
InaccessiblePaths=/home/eom/EOM
InaccessiblePaths=/home/eom/EOMIS
InaccessiblePaths=/etc/eom
InaccessiblePaths=/srv/eom/image-workspaces
InaccessiblePaths=/srv/eom/workspaces
InaccessiblePaths=/srv/eom/worker-homes
InaccessiblePaths=/root/.codex
InaccessiblePaths=/var/run/docker.sock

UMask=0077
MemoryMax=32G
TasksMax=512
TimeoutStartSec=14400
TimeoutStopSec=120
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
Restart=no
