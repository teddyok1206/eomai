{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/development/code-context-index/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "reviewed_source_commit", "topics"],
  "properties": {
    "schema_version": {"const": "code-context-index/1.0"},
    "purpose": {"const": "DEVELOPER_NAVIGATION_NOT_RUNTIME_AUTHORITY"},
    "reviewed_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "topics": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "note", "keywords", "source_paths", "test_paths", "reference_paths"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "note": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.md$"},
          "keywords": {
            "type": "array", "minItems": 2, "maxItems": 32, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 80}
          },
          "source_paths": {"$ref": "#/$defs/Paths"},
          "test_paths": {"$ref": "#/$defs/Paths"},
          "reference_paths": {"$ref": "#/$defs/Paths"}
        }
      }
    }
  },
  "$defs": {
    "Paths": {
      "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  }
}
