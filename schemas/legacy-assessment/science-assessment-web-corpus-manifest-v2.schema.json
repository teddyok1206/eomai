{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/legacy-assessment/science-assessment-web-corpus-manifest/2.0",
  "title": "EOM Science Assessment Web Corpus Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "plan_id",
    "plan_sha256",
    "acquisition_sha256",
    "resolution_sha256",
    "resolution_policy_id",
    "resolution_policy_sha256",
    "observed_at",
    "pdf_validator",
    "documents",
    "failures",
    "intake_shards",
    "summary",
    "manifest_sha256"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uri": {"type": "string", "format": "uri", "minLength": 8, "maxLength": 4096},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "intakePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake_batch_id",
        "source_file_id",
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "sha256"
      ],
      "properties": {
        "intake_batch_id": {"type": "string", "pattern": "^intake_[0-9a-f]{32}$"},
        "source_file_id": {"type": "string", "pattern": "^sourcefile_[0-9a-f]{32}$"},
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "member_path": {
          "type": "string",
          "pattern": "^source/(?!.*(?:^|/)\\.\\.?/)[^\\u0000-\\u001f\\u007f\\\\]+\\.pdf$",
          "maxLength": 512
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["post_url", "download_url", "resolved_url", "link_text"],
      "properties": {
        "post_url": {"$ref": "#/$defs/uri"},
        "download_url": {"$ref": "#/$defs/uri"},
        "resolved_url": {"$ref": "#/$defs/uri"},
        "link_text": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "science-assessment-web-corpus-manifest/2.0"},
    "corpus_id": {"type": "string", "pattern": "^sciencecorpus_[0-9a-f]{32}$"},
    "plan_id": {"type": "string", "pattern": "^sciencecorpusplan_[0-9a-f]{32}$"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "acquisition_sha256": {"$ref": "#/$defs/sha256"},
    "resolution_sha256": {"$ref": "#/$defs/sha256"},
    "resolution_policy_id": {
      "type": "string",
      "pattern": "^sciencecorpuspolicy_[0-9a-f]{32}$"
    },
    "resolution_policy_sha256": {"$ref": "#/$defs/sha256"},
    "observed_at": {"$ref": "#/$defs/utc"},
    "pdf_validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qpdf_path", "qpdf_sha256", "pdfinfo_path", "pdfinfo_sha256"],
      "properties": {
        "qpdf_path": {"const": "/usr/bin/qpdf"},
        "qpdf_sha256": {"$ref": "#/$defs/sha256"},
        "pdfinfo_path": {"const": "/usr/bin/pdfinfo"},
        "pdfinfo_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "sha256",
          "bytes",
          "page_count",
          "original_filename",
          "media_type",
          "document_role",
          "subject_family",
          "subject_label",
          "issuer_type",
          "administration_year",
          "grade",
          "session_label",
          "publication_disposition",
          "origins",
          "source"
        ],
        "properties": {
          "document_id": {"type": "string", "pattern": "^sciencedoc_[0-9a-f]{32}$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 1024, "maximum": 104857600},
          "page_count": {"type": "integer", "minimum": 1, "maximum": 512},
          "original_filename": {"type": "string", "minLength": 1, "maxLength": 255},
          "media_type": {"const": "application/pdf"},
          "document_role": {"const": "PROBLEM_DOCUMENT"},
          "subject_family": {
            "enum": [
              "CHEMISTRY",
              "EARTH_SCIENCE",
              "GENERAL_SCIENCE",
              "INTEGRATED_SCIENCE",
              "LIFE_SCIENCE",
              "PHYSICS"
            ]
          },
          "subject_label": {"type": "string", "minLength": 1, "maxLength": 128},
          "issuer_type": {"enum": ["EDUCATION_AUTHORITY", "KICE"]},
          "administration_year": {"type": "integer", "minimum": 1994, "maximum": 2200},
          "grade": {"type": "integer", "minimum": 1, "maximum": 3},
          "session_label": {"type": "string", "minLength": 1, "maxLength": 128},
          "publication_disposition": {"enum": ["NEW_INTAKE", "REUSED_EXISTING"]},
          "origins": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/origin"}
          },
          "source": {"$ref": "#/$defs/intakePointer"}
        }
      }
    },
    "failures": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["post_url", "download_url", "error_code"],
        "properties": {
          "post_url": {"$ref": "#/$defs/uri"},
          "download_url": {"$ref": "#/$defs/uri"},
          "error_code": {
            "type": "string",
            "pattern": "^SCIENCE_CORPUS_[A-Z0-9_]{1,96}$"
          }
        }
      }
    },
    "intake_shards": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "intake_batch_id",
          "artifact_id",
          "artifact_revision_id",
          "source_fingerprint",
          "document_count"
        ],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 64},
          "intake_batch_id": {"type": "string", "pattern": "^intake_[0-9a-f]{32}$"},
          "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
          "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
          "source_fingerprint": {"$ref": "#/$defs/sha256"},
          "document_count": {"type": "integer", "minimum": 1, "maximum": 499}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unique_document_count",
        "scanned_post_count",
        "candidate_count",
        "acquisition_failure_count",
        "duplicate_observation_count",
        "reused_existing_count",
        "new_intake_count",
        "total_bytes"
      ],
      "properties": {
        "unique_document_count": {"type": "integer", "minimum": 1, "maximum": 5000},
        "scanned_post_count": {"type": "integer", "minimum": 1, "maximum": 5000},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 5000},
        "acquisition_failure_count": {"type": "integer", "minimum": 0, "maximum": 5000},
        "duplicate_observation_count": {"type": "integer", "minimum": 0},
        "reused_existing_count": {"type": "integer", "minimum": 0},
        "new_intake_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 1024}
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  }
}
