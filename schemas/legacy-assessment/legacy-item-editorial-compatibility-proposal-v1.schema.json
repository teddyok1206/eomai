{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/legacy-assessment/legacy-item-editorial-compatibility-proposal/1.0",
  "title": "EOM Legacy Item Editorial Compatibility Worker Proposal V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compatibility_request_id",
    "request_sha256",
    "source",
    "authorities",
    "renderer_profile",
    "status",
    "issues",
    "completed_at",
    "proposal_sha256"
  ],
  "properties": {
    "schema_version": {"const": "legacy-item-editorial-compatibility-proposal/1.0"},
    "compatibility_request_id": {
      "type": "string",
      "pattern": "^editorialcompatreq_[0-9a-f]{32}$"
    },
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "source": {"$ref": "#/$defs/learnedItem"},
    "authorities": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/contentTeamPrompt"},
        {"$ref": "#/$defs/hwpxProfile"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "renderer_profile": {"$ref": "#/$defs/rendererProfile"},
    "status": {"enum": ["COMPATIBLE", "NEEDS_ADAPTATION", "BLOCKED"]},
    "issues": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/issue"}
    },
    "completed_at": {"type": "string", "format": "date-time"},
    "proposal_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "COMPATIBLE"}}, "required": ["status"]},
      "then": {"properties": {"issues": {"maxItems": 0}}},
      "else": {"properties": {"issues": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "issues": {
            "contains": {"properties": {"severity": {"const": "BLOCKING"}}},
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rendererProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer_profile",
        "artifact_id",
        "artifact_revision_id",
        "archive_member_path",
        "archive_schema_ref",
        "archive_media_type",
        "archive_sha256",
        "profile_sha256"
      ],
      "properties": {
        "renderer_profile": {"const": "content-team-hwp-question-editor-v1"},
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "archive_member_path": {"const": "handoff-source.zip"},
        "archive_schema_ref": {
          "const": "eom://schemas/hwpx/content-team-handoff-archive/1.0"
        },
        "archive_media_type": {"const": "application/zip"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "member_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "schema_ref": {
          "type": "string",
          "pattern": "^eom://schemas/[A-Za-z0-9._/-]{1,220}$"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "learnedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "item_revision_id",
        "item_manifest_sha256",
        "item_content",
        "extraction_acceptance_id",
        "extraction_acceptance_sha256",
        "item_origin_profile_id",
        "item_origin_profile_sha256",
        "lifecycle_state"
      ],
      "properties": {
        "item_id": {"type": "string", "pattern": "^item_[0-9a-f]{32}$"},
        "item_revision_id": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
        "item_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "item_content": {
          "allOf": [
            {"$ref": "#/$defs/artifactMember"},
            {
              "properties": {
                "schema_ref": {
                  "enum": [
                    "eom://schemas/item-registry/assessment-item-content-v1",
                    "eom://schemas/item-registry/assessment-item-content-v2"
                  ]
                },
                "media_type": {"const": "application/json"}
              }
            }
          ]
        },
        "extraction_acceptance_id": {
          "type": "string",
          "pattern": "^itemacceptance_[0-9a-f]{32}$"
        },
        "extraction_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "item_origin_profile_id": {
          "type": "string",
          "pattern": "^originprofile_[0-9a-f]{32}$"
        },
        "item_origin_profile_sha256": {"$ref": "#/$defs/sha256"},
        "lifecycle_state": {"const": "APPROVED"}
      }
    },
    "authorityBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_kind",
        "reference_key",
        "reference_revision",
        "artifact_member"
      ],
      "properties": {
        "authority_kind": {
          "enum": ["CONTENT_TEAM_PROMPT", "HWP_QUESTION_EDITOR_PROFILE"]
        },
        "reference_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,127}$"
        },
        "reference_revision": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"
        },
        "artifact_member": {
          "allOf": [
            {"$ref": "#/$defs/artifactMember"},
            {"properties": {"media_type": {"const": "text/markdown"}}}
          ]
        }
      }
    },
    "contentTeamPrompt": {
      "allOf": [
        {"$ref": "#/$defs/authorityBase"},
        {"properties": {"authority_kind": {"const": "CONTENT_TEAM_PROMPT"}}}
      ]
    },
    "hwpxProfile": {
      "allOf": [
        {"$ref": "#/$defs/authorityBase"},
        {"properties": {"authority_kind": {"const": "HWP_QUESTION_EDITOR_PROFILE"}}}
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "authority_kind",
        "authority_artifact_revision_id",
        "authority_sha256",
        "rule_locator",
        "category",
        "severity",
        "item_content_paths",
        "observation",
        "required_adaptation"
      ],
      "properties": {
        "issue_id": {"type": "string", "pattern": "^editorialissue_[0-9a-f]{32}$"},
        "authority_kind": {
          "enum": ["CONTENT_TEAM_PROMPT", "HWP_QUESTION_EDITOR_PROFILE"]
        },
        "authority_artifact_revision_id": {
          "type": "string",
          "pattern": "^rev_[0-9a-f]{32}$"
        },
        "authority_sha256": {"$ref": "#/$defs/sha256"},
        "rule_locator": {"type": "string", "minLength": 1, "maxLength": 256},
        "category": {
          "enum": [
            "CONTENT_CONTRACT",
            "MARKDOWN_STRUCTURE",
            "VISUAL_LAYOUT",
            "EQUATION_NOTATION",
            "HWPX_RENDERING",
            "LOSSY_TRANSFORMATION",
            "OTHER_AUTHORITY_RULE"
          ]
        },
        "severity": {"enum": ["ADAPTATION_REQUIRED", "BLOCKING"]},
        "item_content_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^./\\u0000-\\u001f]+(?:\\.[^./\\u0000-\\u001f]+)*$"
          }
        },
        "observation": {"type": "string", "minLength": 1, "maxLength": 2000},
        "required_adaptation": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
