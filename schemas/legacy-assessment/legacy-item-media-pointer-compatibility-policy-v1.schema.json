{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/legacy-assessment/legacy-item-media-pointer-compatibility-policy/1.0",
  "title": "EOM Legacy Item Media Pointer Compatibility Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_revision_id",
    "entries",
    "policy_sha256"
  ],
  "properties": {
    "schema_version": {"const": "legacy-item-media-pointer-compatibility-policy/1.0"},
    "policy_id": {
      "type": "string",
      "pattern": "^legacyitemmediapolicy_[0-9a-f]{32}$"
    },
    "policy_revision_id": {
      "type": "string",
      "pattern": "^legacyitemmediapolicyrev_[0-9a-f]{32}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "policy_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mediaPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "artifact_member",
        "sha256",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "artifact_revision_id": {
          "type": "string",
          "pattern": "^rev_[0-9a-f]{32}$"
        },
        "artifact_member": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"enum": ["image/png", "image/jpeg"]}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_id",
        "acceptance_sha256",
        "extraction_result_id",
        "result_sha256",
        "extraction_request_id",
        "request_sha256",
        "bundle_revision_id",
        "bundle_manifest_sha256",
        "item_proposal_id",
        "item_number",
        "content_path",
        "block_id",
        "target_page_input_id",
        "target_source_role",
        "target_physical_page",
        "target_schema_ref",
        "source_anchor_id",
        "source",
        "target",
        "reason_code"
      ],
      "properties": {
        "acceptance_id": {
          "type": "string",
          "pattern": "^itemacceptance_[0-9a-f]{32}$"
        },
        "acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "extraction_result_id": {
          "type": "string",
          "pattern": "^itemextractresult_[0-9a-f]{32}$"
        },
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "extraction_request_id": {
          "type": "string",
          "pattern": "^itemextractreq_[0-9a-f]{32}$"
        },
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_revision_id": {
          "type": "string",
          "pattern": "^assessbundlerev_[0-9a-f]{32}$"
        },
        "bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "item_proposal_id": {
          "type": "string",
          "pattern": "^itemproposal_[0-9a-f]{32}$"
        },
        "item_number": {"type": "integer", "minimum": 1, "maximum": 10000},
        "content_path": {
          "type": "string",
          "pattern": "^body\\[[0-9]+\\]$"
        },
        "block_id": {
          "type": "string",
          "pattern": "^block_[a-z][a-z0-9_]{0,63}$"
        },
        "target_page_input_id": {
          "type": "string",
          "pattern": "^assessmentpage_[0-9a-f]{32}$"
        },
        "target_source_role": {"const": "PROBLEM_DOCUMENT"},
        "target_physical_page": {"type": "integer", "minimum": 1},
        "target_schema_ref": {
          "const": "eom://schemas/legacy-assessment/page-image/1.0"
        },
        "source_anchor_id": {
          "type": "string",
          "pattern": "^assessmentanchor_[0-9a-f]{32}$"
        },
        "source": {"$ref": "#/$defs/mediaPointer"},
        "target": {"$ref": "#/$defs/mediaPointer"},
        "reason_code": {
          "const": "WORKER_LOGICAL_ARTIFACT_ID_TRANSCRIPTION"
        }
      }
    }
  }
}
