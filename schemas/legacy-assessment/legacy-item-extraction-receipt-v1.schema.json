{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/legacy-assessment/legacy-item-extraction-receipt/1.0",
  "title": "EOM Legacy Item Extraction Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_result_id",
    "extraction_request_id",
    "request_sha256",
    "result_artifact",
    "result_sha256",
    "observed_page_input_ids",
    "item_numbers",
    "completed_at",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "legacy-item-extraction-receipt/1.0"
    },
    "extraction_result_id": {
      "type": "string",
      "pattern": "^itemextractresult_[0-9a-f]{32}$"
    },
    "extraction_request_id": {
      "type": "string",
      "pattern": "^itemextractreq_[0-9a-f]{32}$"
    },
    "request_sha256": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
    },
    "result_artifact": {
      "allOf": [
        {
          "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/artifactMemberPointer"
        },
        {
          "properties": {
            "member_path": {
              "const": "result.json"
            },
            "schema_ref": {
              "const": "eom://schemas/legacy-assessment/legacy-item-extraction-result/1.0"
            },
            "media_type": {
              "const": "application/json"
            }
          }
        }
      ]
    },
    "result_sha256": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
    },
    "observed_page_input_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^assessmentpage_[0-9a-f]{32}$"
      }
    },
    "item_numbers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      }
    },
    "completed_at": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/utcTimestamp"
    },
    "receipt_sha256": {
      "$ref": "eom://schemas/legacy-assessment/legacy-assessment-types/1.0#/$defs/sha256"
    }
  }
}
