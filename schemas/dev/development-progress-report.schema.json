{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eom.local/schemas/dev/development-progress-report.schema.json",
  "title": "EOM Development Progress Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "report_id",
    "project",
    "repository",
    "branch",
    "head_commit",
    "working_tree_clean",
    "status",
    "phase",
    "summary",
    "completed",
    "in_progress",
    "next",
    "blockers",
    "tests",
    "changed_file_count",
    "diff_stat",
    "timestamp_utc"
  ],
  "properties": {
    "report_version": {"type": "string", "const": "1.0"},
    "report_id": {"type": "string", "pattern": "^devreport_[0-9a-f]{32}$"},
    "project": {"type": "string", "const": "EOM"},
    "repository": {"type": "string", "minLength": 1, "maxLength": 256},
    "branch": {"type": "string", "minLength": 1, "maxLength": 128},
    "head_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|unknown)$"},
    "working_tree_clean": {"type": "boolean"},
    "status": {
      "type": "string",
      "enum": ["STARTED", "IN_PROGRESS", "BLOCKED", "RECOVERED", "TESTING", "COMPLETED", "FAILED"]
    },
    "phase": {"type": "string", "minLength": 1, "maxLength": 128},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "completed": {"$ref": "#/$defs/items"},
    "in_progress": {"$ref": "#/$defs/items"},
    "next": {"$ref": "#/$defs/items"},
    "blockers": {"$ref": "#/$defs/items"},
    "tests": {"$ref": "#/$defs/items"},
    "changed_file_count": {"type": "integer", "minimum": 0},
    "diff_stat": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "timestamp_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}
