{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/material-learning/preparation-recovery/1.0",
  "title": "EOM material preparation recovery 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "material-learning-preparation-recovery/1.0"
    },
    "operation": {
      "const": "RECOVER_MATERIAL_PREPARATION"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^operator_[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^materialrun_[0-9a-f]{32}$"
    },
    "expected_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expected_input_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target_profile_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "error_code": {
      "enum": [
        "CREATIVE_PAGE_RENDERER_FAILED",
        "MATERIAL_LEARNING_SOURCE_FILE_INVALID"
      ]
    }
  },
  "required": [
    "schema_version",
    "operation",
    "actor_id",
    "run_id",
    "expected_updated_at",
    "expected_input_sha256",
    "target_profile_sha256",
    "error_code"
  ]
}
