{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/material-learning/authorization-reply/1.0",
  "title": "EOM material learning authorization-reply 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "material-learning-authorization-reply/1.0"
    },
    "operation": {
      "const": "AUTHORIZE_MATERIAL_LEARNING_INPUT"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "FAILED"
      ]
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "MATERIAL_LEARNING_AUTHORIZATION_FAILED",
            "MATERIAL_LEARNING_AUTHORIZATION_UNAVAILABLE"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "operation",
    "status",
    "request_sha256",
    "input_sha256",
    "error_code"
  ]
}
