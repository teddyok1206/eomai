{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/material-learning/retry/1.0",
  "title": "EOM material learning retry 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "material-learning-retry/1.0"
    },
    "operation": {
      "const": "RETRY_MATERIAL_LEARNING_RUN"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^operator_[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^materialrun_[0-9a-f]{32}$"
    },
    "expected_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "actor_id",
    "run_id",
    "expected_updated_at"
  ]
}
