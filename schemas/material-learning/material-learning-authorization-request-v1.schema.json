{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/material-learning/authorization-request/1.0",
  "title": "EOM material learning authorization-request 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "material-learning-authorization-request/1.0"
    },
    "operation": {
      "const": "AUTHORIZE_MATERIAL_LEARNING_INPUT"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^workflow_[0-9a-f]{32}$"
    },
    "step_run_id": {
      "type": "string",
      "pattern": "^steprun_[0-9a-f]{32}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^execplan_[0-9a-f]{32}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "workflow_id",
    "step_run_id",
    "plan_id",
    "plan_sha256",
    "input_sha256"
  ]
}
