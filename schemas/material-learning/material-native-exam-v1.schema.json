{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/material-learning/native-exam/1.0",
  "title": "Native exam source inventory and lossless workbook observations",
  "oneOf": [{"$ref": "#/$defs/archive"}, {"$ref": "#/$defs/workbook"}],
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text": {"type": "string", "maxLength": 32767},
    "nullableText": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "attribute": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 200}, "value": {"$ref": "#/$defs/text"}}
    },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["zip_member", "member_path", "source_format", "sha256", "bytes"],
      "properties": {
        "zip_member": {"type": "string", "minLength": 1, "maxLength": 2048},
        "member_path": {"type": "string", "minLength": 1, "maxLength": 2048},
        "source_format": {"enum": ["HWP", "HWPX", "XLSX"]},
        "sha256": {"$ref": "#/$defs/sha"},
        "bytes": {"type": "integer", "minimum": 8, "maximum": 134217728}
      }
    },
    "folder": {
      "type": "object", "additionalProperties": false,
      "required": ["folder_path", "question", "solutions", "workbook"],
      "properties": {
        "folder_path": {"type": "string", "minLength": 1, "maxLength": 2048},
        "question": {"$ref": "#/$defs/member"},
        "solutions": {"$ref": "#/$defs/member"},
        "workbook": {"oneOf": [{"$ref": "#/$defs/member"}, {"type": "null"}]}
      }
    },
    "archive": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "sha256", "bytes", "folders", "ignored_metadata_count"],
      "properties": {
        "schema_version": {"const": "material-native-exam-archive/1.0"},
        "sha256": {"$ref": "#/$defs/sha"},
        "bytes": {"type": "integer", "minimum": 8, "maximum": 536870912},
        "folders": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/folder"}},
        "ignored_metadata_count": {"type": "integer", "minimum": 0, "maximum": 2000}
      }
    },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "value", "raw_value", "storage_type", "formula", "formula_attributes"],
      "properties": {
        "reference": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"},
        "value": {"$ref": "#/$defs/nullableText"},
        "raw_value": {"$ref": "#/$defs/nullableText"},
        "storage_type": {"enum": ["n", "s", "inlineStr", "str", "b", "e", "d"]},
        "formula": {"$ref": "#/$defs/nullableText"},
        "formula_attributes": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/attribute"}}
      }
    },
    "column": {
      "type": "object", "additionalProperties": false,
      "required": ["column", "header", "semantic"],
      "properties": {
        "column": {"type": "string", "pattern": "^[A-Z]{1,3}$"},
        "header": {"$ref": "#/$defs/text"},
        "semantic": {"enum": ["QUESTION_NUMBER", "UNIT", "SOURCE_LABEL", "AUTHOR", "POINTS", "DIFFICULTY", "INQUIRY", "CLASSIFICATION", "GRADE", "SUBJECT", "EXTERNAL_NUMBER", "UNMAPPED"]}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["row_number", "question_number", "external_number", "unit_raw", "unit_normalized", "source_label"],
      "properties": {
        "row_number": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "question_number": {"type": "integer", "minimum": 1, "maximum": 10000},
        "external_number": {"oneOf": [{"type": "string", "pattern": "^[0-9]{5}$"}, {"type": "null"}]},
        "unit_raw": {"$ref": "#/$defs/text"},
        "unit_normalized": {"$ref": "#/$defs/text"},
        "source_label": {"$ref": "#/$defs/text"}
      }
    },
    "worksheet": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "member_path", "header_row", "external_number_basis", "columns", "cells", "rows"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "member_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "header_row": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 100}, {"type": "null"}]},
        "external_number_basis": {"enum": ["EXPLICIT_HEADER", "RIGHTMOST_UNTITLED_FIVE_DIGIT", "ABSENT"]},
        "columns": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/column"}},
        "cells": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/cell"}},
        "rows": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/row"}}
      }
    },
    "workbook": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "sha256", "bytes", "worksheets"],
      "properties": {
        "schema_version": {"const": "material-native-exam-workbook/1.0"},
        "sha256": {"$ref": "#/$defs/sha"},
        "bytes": {"type": "integer", "minimum": 8, "maximum": 8388608},
        "worksheets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/worksheet"}}
      }
    }
  }
}
