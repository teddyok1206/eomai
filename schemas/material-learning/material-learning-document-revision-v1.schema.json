{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/material-learning/document-revision/1.0",
  "title": "EOM material learning document-revision 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "material-learning-document-revision/1.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^edudoc_[0-9a-f]{32}$"
    },
    "document_revision_id": {
      "type": "string",
      "pattern": "^edudocrev_[0-9a-f]{32}$"
    },
    "document_key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]{2,127}$"
    },
    "revision_number": {
      "const": 1
    },
    "previous_revision_id": {
      "type": "null"
    },
    "material_id": {
      "type": "string",
      "pattern": "^material_[0-9a-f]{32}$"
    },
    "material_revision_id": {
      "type": "string",
      "pattern": "^materialrev_[0-9a-f]{32}$"
    },
    "source_role": {
      "enum": [
        "MAIN",
        "SOLUTIONS"
      ]
    },
    "document_kind": {
      "enum": [
        "TEXTBOOK",
        "REFERENCE_BOOK",
        "GUIDANCE"
      ]
    },
    "source_class": {
      "enum": [
        "TEXTBOOK",
        "INTERNAL_GUIDE"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "publisher_key": {
      "type": "null"
    },
    "curriculum_volume": {
      "type": "null"
    },
    "edition_label": {
      "type": "null"
    },
    "original": {
      "$ref": "eom://schemas/material-learning/types/1.0#/$defs/artifactMember"
    },
    "source": {
      "$ref": "eom://schemas/material-learning/types/1.0#/$defs/artifactMember"
    },
    "source_page_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "analysis_bundle_manifest": {
      "$ref": "eom://schemas/material-learning/types/1.0#/$defs/artifactMember"
    },
    "rights_attestation": {
      "$ref": "eom://schemas/material-learning/types/1.0#/$defs/artifactMember"
    },
    "registered_by": {
      "type": "string",
      "pattern": "^operator_[0-9a-f]{32}$"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "registration_request_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "document_revision_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "document_revision_id",
    "document_key",
    "revision_number",
    "previous_revision_id",
    "material_id",
    "material_revision_id",
    "source_role",
    "document_kind",
    "source_class",
    "title",
    "source_description",
    "publisher_key",
    "curriculum_volume",
    "edition_label",
    "original",
    "source",
    "source_page_count",
    "analysis_bundle_manifest",
    "rights_attestation",
    "registered_by",
    "registered_at",
    "registration_request_sha256",
    "document_revision_sha256"
  ]
}
