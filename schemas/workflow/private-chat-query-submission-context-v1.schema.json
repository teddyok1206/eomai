{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/private-chat-query-submission-context/1.0",
  "title": "Original private Chat QUERY submission context",
  "description": "Text-free immutable Workflow metadata, not a live Chat grant, native admission or result-read permission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "workflow_request_sha256", "origin", "artifact_pointers", "context_sha256"],
  "properties": {
    "schema_version": {"const": "private-chat-query-submission-context/1.0"},
    "purpose": {"const": "PRIVATE_CHAT_QUERY"},
    "workflow_request_sha256": {"$ref": "#/$defs/hash"},
    "origin": {"$ref": "eom://schemas/knowledge/general-chat-private-query-read/1.0#/$defs/origin"},
    "artifact_pointers": {"type": "array", "const": []},
    "context_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
