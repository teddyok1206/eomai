{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/embedding-batch-execution-receipt/1.0",
  "title": "Canonical CUDA batch execution metadata; not publication of child results or a source grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "device",
    "parent_plan_job_id",
    "scope",
    "allocation",
    "ready",
    "bound",
    "completed",
    "children",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "embedding-batch-execution-receipt/1.0"
    },
    "purpose": {
      "enum": [
        "INDEX",
        "REFERENCE_QUERY"
      ]
    },
    "device": {
      "const": "CUDA"
    },
    "parent_plan_job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{32}$"
    },
    "scope": {
      "$ref": "eom://schemas/knowledge/embedding-work-batch-input/1.0#/$defs/scope"
    },
    "allocation": {
      "$ref": "eom://schemas/knowledge/embedding-gpu-allocation-control/1.0#/$defs/request"
    },
    "ready": {
      "$ref": "eom://schemas/workflow/embedding-batch-owner-control/1.0#/$defs/ready"
    },
    "bound": {
      "$ref": "eom://schemas/workflow/embedding-batch-owner-control/1.0#/$defs/bound"
    },
    "completed": {
      "$ref": "eom://schemas/workflow/embedding-batch-owner-control/1.0#/$defs/completed"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/child"
      }
    },
    "receipt_sha256": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "native_job_id",
        "input_sha256",
        "result_sha256",
        "shard_sha256",
        "binary_sha256",
        "vector_offset",
        "vector_byte_count",
        "row_count",
        "dimension"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "native_job_id": {
          "type": "string",
          "pattern": "^job_[0-9a-f]{32}$"
        },
        "input_sha256": {
          "$ref": "#/$defs/hash"
        },
        "result_sha256": {
          "$ref": "#/$defs/hash"
        },
        "shard_sha256": {
          "$ref": "#/$defs/hash"
        },
        "binary_sha256": {
          "$ref": "#/$defs/hash"
        },
        "vector_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777212
        },
        "vector_byte_count": {
          "type": "integer",
          "minimum": 4,
          "maximum": 16777216
        },
        "row_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "dimension": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      }
    }
  }
}
