{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/embedding-batch-execution-receipt/1.1",
  "title": "Owned private Chat finite CUDA execution receipt",
  "description": "One actual private QUERY2 child in numerical envelope3. Metadata and original physical completion pointers are not a source grant, CPU observation or permission to retry. Released receipt1.0 is unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "device",
    "parent_plan_job_id",
    "scope",
    "allocation",
    "ready",
    "bound",
    "completed",
    "children",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "embedding-batch-execution-receipt/1.1"
    },
    "purpose": {
      "const": "PRIVATE_CHAT_QUERY"
    },
    "device": {
      "const": "CUDA"
    },
    "parent_plan_job_id": {
      "$ref": "eom://schemas/workflow/embedding-batch-execution-receipt/1.0#/properties/parent_plan_job_id"
    },
    "scope": {
      "allOf": [
        {
          "$ref": "eom://schemas/workflow/embedding-batch-execution-receipt/1.0#/properties/scope"
        },
        {
          "type": "object",
          "properties": {
            "actor_kind": {
              "const": "OPERATOR"
            },
            "storage_partition": {
              "const": "public-solution"
            }
          }
        }
      ]
    },
    "allocation": {
      "$ref": "eom://schemas/workflow/embedding-batch-execution-receipt/1.0#/properties/allocation"
    },
    "ready": {
      "$ref": "eom://schemas/workflow/embedding-batch-execution-receipt/1.0#/properties/ready"
    },
    "bound": {
      "$ref": "eom://schemas/workflow/embedding-batch-execution-receipt/1.0#/properties/bound"
    },
    "completed": {
      "$ref": "eom://schemas/workflow/embedding-batch-execution-receipt/1.0#/properties/completed"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "eom://schemas/workflow/embedding-batch-execution-receipt/1.0#/$defs/child"
          },
          {
            "type": "object",
            "properties": {
              "ordinal": {
                "const": 0
              },
              "row_count": {
                "const": 1
              }
            }
          }
        ]
      }
    },
    "receipt_sha256": {
      "$ref": "eom://schemas/workflow/embedding-batch-execution-receipt/1.0#/$defs/hash"
    }
  }
}
