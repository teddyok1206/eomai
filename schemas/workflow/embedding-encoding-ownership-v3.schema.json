{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/embedding-encoding-ownership/3.0",
  "$defs": {
    "ArtifactMemberPointer": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Member Path",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "title": "ArtifactMemberPointer",
      "type": "object"
    },
    "EmbeddingEncodingAttachedEventV3": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "embedding-encoding-ownership/3.0",
          "default": "embedding-encoding-ownership/3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "record_type": {
          "const": "ATTACHED",
          "default": "ATTACHED",
          "title": "Record Type",
          "type": "string"
        },
        "owned_job": {
          "$ref": "#/$defs/LocalEmbeddingOwnedJob"
        },
        "intent": {
          "$ref": "#/$defs/LocalEmbeddingLaunchIntentV3"
        },
        "event_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Event Sha256",
          "type": "string"
        }
      },
      "required": [
        "owned_job",
        "intent",
        "event_sha256"
      ],
      "title": "EmbeddingEncodingAttachedEventV3",
      "type": "object"
    },
    "EmbeddingEncodingCompletedEventV3": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "embedding-encoding-ownership/3.0",
          "default": "embedding-encoding-ownership/3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "record_type": {
          "const": "COMPLETED",
          "default": "COMPLETED",
          "title": "Record Type",
          "type": "string"
        },
        "owned_job": {
          "$ref": "#/$defs/LocalEmbeddingOwnedJob"
        },
        "intent": {
          "$ref": "#/$defs/LocalEmbeddingLaunchIntentV3"
        },
        "launch_association_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Launch Association Sha256",
          "type": "string"
        },
        "receipt": {
          "$ref": "#/$defs/EmbeddingSharedRowReceipt"
        },
        "event_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Event Sha256",
          "type": "string"
        }
      },
      "required": [
        "owned_job",
        "intent",
        "launch_association_sha256",
        "receipt",
        "event_sha256"
      ],
      "title": "EmbeddingEncodingCompletedEventV3",
      "type": "object"
    },
    "EmbeddingEncodingIdentity": {
      "additionalProperties": false,
      "properties": {
        "storage_partition": {
          "$ref": "#/$defs/StoragePartition"
        },
        "space_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Space Sha256",
          "type": "string"
        },
        "input_text_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Text Sha256",
          "type": "string"
        },
        "encoding_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Encoding Sha256",
          "type": "string"
        }
      },
      "required": [
        "storage_partition",
        "space_sha256",
        "input_text_sha256",
        "encoding_sha256"
      ],
      "title": "EmbeddingEncodingIdentity",
      "type": "object"
    },
    "EmbeddingEncodingJobReference": {
      "additionalProperties": false,
      "description": "Original existing Job allocations remain immutable and unused by shared output.",
      "properties": {
        "job_id": {
          "pattern": "^job_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "allocated_artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Allocated Artifact Id",
          "type": "string"
        },
        "allocated_artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Allocated Artifact Revision Id",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "request_sha256",
        "allocated_artifact_id",
        "allocated_artifact_revision_id"
      ],
      "title": "EmbeddingEncodingJobReference",
      "type": "object"
    },
    "EmbeddingEncodingJobRequest": {
      "additionalProperties": false,
      "description": "Computational key excludes actor, source, Graph, batch, launch and timestamps.",
      "properties": {
        "schema_version": {
          "const": "embedding-encoding-job/1.0",
          "default": "embedding-encoding-job/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "record_type": {
          "const": "REQUEST",
          "default": "REQUEST",
          "title": "Record Type",
          "type": "string"
        },
        "purpose": {
          "const": "LOCAL_EMBEDDING",
          "default": "LOCAL_EMBEDDING",
          "title": "Purpose",
          "type": "string"
        },
        "space": {
          "$ref": "#/$defs/EmbeddingSpace"
        },
        "encoding": {
          "$ref": "#/$defs/EmbeddingEncodingIdentity"
        },
        "request_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        }
      },
      "required": [
        "space",
        "encoding",
        "request_sha256"
      ],
      "title": "EmbeddingEncodingJobRequest",
      "type": "object"
    },
    "EmbeddingEncodingReadResultV3": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "embedding-encoding-ownership/3.0",
          "default": "embedding-encoding-ownership/3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "record_type": {
          "const": "READ_RESULT",
          "default": "READ_RESULT",
          "title": "Record Type",
          "type": "string"
        },
        "owned_job": {
          "$ref": "#/$defs/LocalEmbeddingOwnedJob"
        },
        "owner_intent": {
          "$ref": "#/$defs/LocalEmbeddingLaunchIntentV3"
        },
        "status": {
          "enum": [
            "OWNED",
            "BORROWED",
            "COMPLETED",
            "FAILED",
            "CANCELLED",
            "UNCERTAIN"
          ],
          "title": "Status",
          "type": "string"
        },
        "completion": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmbeddingEncodingCompletedEventV3"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Read Sha256",
          "type": "string"
        }
      },
      "required": [
        "owned_job",
        "owner_intent",
        "status",
        "completion",
        "read_sha256"
      ],
      "title": "EmbeddingEncodingReadResultV3",
      "type": "object"
    },
    "EmbeddingExecutionRuntime": {
      "additionalProperties": false,
      "description": "Actual installed execution fingerprint is verified by the owner, not this pure DTO.",
      "properties": {
        "device": {
          "enum": [
            "CPU",
            "CUDA"
          ],
          "title": "Device",
          "type": "string"
        },
        "precision": {
          "const": "FLOAT32",
          "default": "FLOAT32",
          "title": "Precision",
          "type": "string"
        },
        "tf32_enabled": {
          "const": false,
          "default": false,
          "title": "Tf32 Enabled",
          "type": "boolean"
        },
        "execution_runtime_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Execution Runtime Sha256",
          "type": "string"
        }
      },
      "required": [
        "device",
        "execution_runtime_sha256"
      ],
      "title": "EmbeddingExecutionRuntime",
      "type": "object"
    },
    "EmbeddingSharedRowReceipt": {
      "additionalProperties": false,
      "description": "One canonical result/shard/binary file set and row; never vector bytes.",
      "properties": {
        "native_launch_job_id": {
          "pattern": "^job_[0-9a-f]{32}$",
          "title": "Native Launch Job Id",
          "type": "string"
        },
        "result_manifest": {
          "$ref": "#/$defs/ArtifactMemberPointer"
        },
        "result_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "shard_manifest": {
          "$ref": "#/$defs/ArtifactMemberPointer"
        },
        "shard_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Shard Sha256",
          "type": "string"
        },
        "binary_member": {
          "$ref": "#/$defs/ArtifactMemberPointer"
        },
        "row_ref": {
          "$ref": "#/$defs/EmbeddingVectorRowRef"
        },
        "receipt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        }
      },
      "required": [
        "native_launch_job_id",
        "result_manifest",
        "result_sha256",
        "shard_manifest",
        "shard_sha256",
        "binary_member",
        "row_ref",
        "receipt_sha256"
      ],
      "title": "EmbeddingSharedRowReceipt",
      "type": "object"
    },
    "EmbeddingSpace": {
      "additionalProperties": false,
      "properties": {
        "model_spec": {
          "$ref": "#/$defs/LocalEmbeddingModelSpec"
        },
        "purpose": {
          "enum": [
            "QUERY",
            "DOCUMENT"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/EmbeddingExecutionRuntime"
        },
        "space_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Space Sha256",
          "type": "string"
        }
      },
      "required": [
        "model_spec",
        "purpose",
        "runtime",
        "space_sha256"
      ],
      "title": "EmbeddingSpace",
      "type": "object"
    },
    "EmbeddingVectorRowRef": {
      "additionalProperties": false,
      "properties": {
        "shard_manifest": {
          "$ref": "#/$defs/ArtifactMemberPointer"
        },
        "row_index": {
          "maximum": 1023,
          "minimum": 0,
          "title": "Row Index",
          "type": "integer"
        },
        "encoding_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Encoding Sha256",
          "type": "string"
        }
      },
      "required": [
        "shard_manifest",
        "row_index",
        "encoding_sha256"
      ],
      "title": "EmbeddingVectorRowRef",
      "type": "object"
    },
    "LocalEmbeddingFile": {
      "additionalProperties": false,
      "properties": {
        "member_path": {
          "enum": [
            "config.json",
            "model.safetensors",
            "tokenizer.json",
            "tokenizer_config.json",
            "special_tokens_map.json",
            "sentencepiece.bpe.model",
            "README.md",
            "LICENSE",
            "1_Pooling/config.json"
          ],
          "title": "Member Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 8589934592,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "member_path",
        "sha256",
        "size_bytes"
      ],
      "title": "LocalEmbeddingFile",
      "type": "object"
    },
    "LocalEmbeddingLaunchAssociationV3": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "embedding-encoding-ownership/3.0",
          "default": "embedding-encoding-ownership/3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "record_type": {
          "const": "LAUNCH_ASSOCIATION",
          "default": "LAUNCH_ASSOCIATION",
          "title": "Record Type",
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/LocalEmbeddingLaunchIntentV3"
        },
        "owned_jobs": {
          "items": {
            "$ref": "#/$defs/LocalEmbeddingOwnedJob"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Owned Jobs",
          "type": "array"
        },
        "owned_input": {
          "$ref": "#/$defs/ArtifactMemberPointer"
        },
        "owned_input_request_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Owned Input Request Sha256",
          "type": "string"
        },
        "owned_input_set_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Owned Input Set Sha256",
          "type": "string"
        },
        "association_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Association Sha256",
          "type": "string"
        }
      },
      "required": [
        "intent",
        "owned_jobs",
        "owned_input",
        "owned_input_request_sha256",
        "owned_input_set_sha256",
        "association_sha256"
      ],
      "title": "LocalEmbeddingLaunchAssociationV3",
      "type": "object"
    },
    "LocalEmbeddingLaunchIntentV3": {
      "additionalProperties": false,
      "properties": {
        "workflow_id": {
          "pattern": "^workflow_[0-9a-f]{32}$",
          "title": "Workflow Id",
          "type": "string"
        },
        "step_run_id": {
          "pattern": "^steprun_[0-9a-f]{32}$",
          "title": "Step Run Id",
          "type": "string"
        },
        "step_key": {
          "const": "encode_batch",
          "default": "encode_batch",
          "title": "Step Key",
          "type": "string"
        },
        "attempt": {
          "maximum": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "native_launch_job_id": {
          "pattern": "^job_[0-9a-f]{32}$",
          "title": "Native Launch Job Id",
          "type": "string"
        },
        "workflow_request_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Workflow Request Sha256",
          "type": "string"
        },
        "source_plan": {
          "$ref": "#/$defs/ArtifactMemberPointer"
        },
        "source_plan_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Plan Sha256",
          "type": "string"
        },
        "resource_profile_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Resource Profile Sha256",
          "type": "string"
        },
        "command_id": {
          "pattern": "^wfcmd_[0-9a-f]{32}$",
          "title": "Command Id",
          "type": "string"
        },
        "runner_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Runner Id",
          "type": "string"
        },
        "lease_generation": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Lease Generation",
          "type": "integer"
        },
        "intent_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Intent Sha256",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "step_run_id",
        "attempt",
        "native_launch_job_id",
        "workflow_request_sha256",
        "source_plan",
        "source_plan_sha256",
        "resource_profile_sha256",
        "command_id",
        "runner_id",
        "lease_generation",
        "intent_sha256"
      ],
      "title": "LocalEmbeddingLaunchIntentV3",
      "type": "object"
    },
    "LocalEmbeddingModelSpec": {
      "additionalProperties": false,
      "description": "Pinned offline recipe; owning a manifest does not activate or approve its files.",
      "properties": {
        "schema_version": {
          "const": "item-local-embedding-model-spec/1.0",
          "default": "item-local-embedding-model-spec/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "pattern": "^embeddingmodel_[0-9a-f]{32}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_revision_id": {
          "pattern": "^embeddingmodelrev_[0-9a-f]{32}$",
          "title": "Model Revision Id",
          "type": "string"
        },
        "provider_family": {
          "const": "transformers-local-dense/1.0",
          "default": "transformers-local-dense/1.0",
          "title": "Provider Family",
          "type": "string"
        },
        "upstream_repo": {
          "enum": [
            "BAAI/bge-m3",
            "intfloat/multilingual-e5-small",
            "intfloat/multilingual-e5-base"
          ],
          "title": "Upstream Repo",
          "type": "string"
        },
        "upstream_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Upstream Revision",
          "type": "string"
        },
        "license_id": {
          "const": "MIT",
          "default": "MIT",
          "title": "License Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            384,
            768,
            1024
          ],
          "title": "Dimension",
          "type": "integer"
        },
        "maximum_tokens": {
          "maximum": 8192,
          "minimum": 2,
          "title": "Maximum Tokens",
          "type": "integer"
        },
        "pooling": {
          "enum": [
            "CLS",
            "MEAN"
          ],
          "title": "Pooling",
          "type": "string"
        },
        "normalization": {
          "const": "L2",
          "default": "L2",
          "title": "Normalization",
          "type": "string"
        },
        "dtype": {
          "const": "float32",
          "default": "float32",
          "title": "Dtype",
          "type": "string"
        },
        "query_prefix": {
          "enum": [
            "",
            "query: "
          ],
          "title": "Query Prefix",
          "type": "string"
        },
        "document_prefix": {
          "enum": [
            "",
            "query: "
          ],
          "title": "Document Prefix",
          "type": "string"
        },
        "truncation": {
          "const": "REJECT_OVERFLOW",
          "default": "REJECT_OVERFLOW",
          "title": "Truncation",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/LocalEmbeddingFile"
          },
          "maxItems": 9,
          "minItems": 5,
          "title": "Files",
          "type": "array"
        },
        "runtime_versions": {
          "items": {
            "$ref": "#/$defs/LocalEmbeddingRuntimeVersion"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Runtime Versions",
          "type": "array"
        },
        "manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "model_revision_id",
        "upstream_repo",
        "upstream_revision",
        "dimension",
        "maximum_tokens",
        "pooling",
        "query_prefix",
        "document_prefix",
        "files",
        "runtime_versions",
        "manifest_sha256"
      ],
      "title": "LocalEmbeddingModelSpec",
      "type": "object"
    },
    "LocalEmbeddingOwnedJob": {
      "additionalProperties": false,
      "properties": {
        "job_reference": {
          "$ref": "#/$defs/EmbeddingEncodingJobReference"
        },
        "request": {
          "$ref": "#/$defs/EmbeddingEncodingJobRequest"
        }
      },
      "required": [
        "job_reference",
        "request"
      ],
      "title": "LocalEmbeddingOwnedJob",
      "type": "object"
    },
    "LocalEmbeddingRuntimeVersion": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "torch",
            "transformers",
            "safetensors",
            "tokenizers"
          ],
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9][A-Za-z0-9.+_-]{0,95}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "LocalEmbeddingRuntimeVersion",
      "type": "object"
    },
    "StoragePartition": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "ATTACHED": "#/$defs/EmbeddingEncodingAttachedEventV3",
      "COMPLETED": "#/$defs/EmbeddingEncodingCompletedEventV3",
      "LAUNCH_ASSOCIATION": "#/$defs/LocalEmbeddingLaunchAssociationV3",
      "READ_RESULT": "#/$defs/EmbeddingEncodingReadResultV3"
    },
    "propertyName": "record_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/LocalEmbeddingLaunchAssociationV3"
    },
    {
      "$ref": "#/$defs/EmbeddingEncodingAttachedEventV3"
    },
    {
      "$ref": "#/$defs/EmbeddingEncodingCompletedEventV3"
    },
    {
      "$ref": "#/$defs/EmbeddingEncodingReadResultV3"
    }
  ]
}
