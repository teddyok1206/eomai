{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/content-team-material-requirement/1.0",
  "title": "Content-team student-visible material requirement V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "form",
    "panel_count"
  ],
  "properties": {
    "schema_version": {
      "const": "content-team-material-requirement/1.0"
    },
    "form": {
      "enum": [
        "AUTO",
        "TEXT",
        "DATA",
        "TABLE",
        "IMAGE",
        "MIXED",
        "INQUIRY"
      ]
    },
    "panel_count": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "form": {
            "enum": [
              "AUTO",
              "TEXT",
              "DATA",
              "INQUIRY"
            ]
          }
        },
        "required": [
          "form"
        ]
      },
      "then": {
        "properties": {
          "panel_count": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "enum": [
              "TABLE",
              "IMAGE"
            ]
          }
        },
        "required": [
          "form"
        ]
      },
      "then": {
        "properties": {
          "panel_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "MIXED"
          }
        },
        "required": [
          "form"
        ]
      },
      "then": {
        "properties": {
          "panel_count": {
            "const": 2
          }
        }
      }
    }
  ]
}
