{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/local-indexing-owner-configuration/6.0",
  "title": "Public-solution GPU-preferred INDEX owner; not authority or activation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cpu_configuration", "cuda_runtime_profile", "cuda_backend", "cuda_grants", "routing_policy", "routing_policy_sha256", "controller_release", "legacy_configuration"],
  "properties": {
    "schema_version": {"const": "local-indexing-owner-configuration/6.0"},
    "cpu_configuration": {"$ref": "#/$defs/publicCpuSelection"},
    "cuda_runtime_profile": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/5.0#/properties/cuda_runtime_profile"},
    "cuda_backend": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/5.0#/properties/cuda_backend"},
    "cuda_grants": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/5.0#/$defs/cudaGrant"}},
    "routing_policy": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/5.0#/properties/routing_policy"},
    "routing_policy_sha256": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/service_policy_sha256"},
    "controller_release": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "legacy_configuration": {"anyOf": [{"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/5.0"}, {"type": "null"}]}
  },
  "$defs": {
    "publicCpuSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "namespace", "recipe", "source_classes", "service_policy_revision_id", "service_policy_sha256", "native_execution_policy", "native_execution_policy_sha256", "runtime_profile", "database_owner", "runtime_verifier", "cpu_environment_raw_sha256", "owner_environment_raw_sha256", "poll_interval_seconds", "maximum_targets", "maximum_sources"],
      "properties": {
        "corpus_id": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/corpus_id"},
        "namespace": {"$ref": "eom://schemas/knowledge/public-solution-embedding-index/3.0#/$defs/PublicSolutionIndexNamespace"},
        "recipe": {"$ref": "eom://schemas/knowledge/public-solution-embedding-entry/1.0#/$defs/recipe"},
        "source_classes": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/source_classes"},
        "service_policy_revision_id": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/service_policy_revision_id"},
        "service_policy_sha256": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/service_policy_sha256"},
        "native_execution_policy": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/native_execution_policy"},
        "native_execution_policy_sha256": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/native_execution_policy_sha256"},
        "runtime_profile": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/runtime_profile"},
        "database_owner": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/database_owner"},
        "runtime_verifier": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/runtime_verifier"},
        "cpu_environment_raw_sha256": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/cpu_environment_raw_sha256"},
        "owner_environment_raw_sha256": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/owner_environment_raw_sha256"},
        "poll_interval_seconds": {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/poll_interval_seconds"},
        "maximum_targets": {"type": "integer", "minimum": 1, "maximum": 1024},
        "maximum_sources": {"type": "integer", "minimum": 1, "maximum": 16384}
      }
    }
  }
}
