{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/local-indexing-owner-configuration/4.0",
  "title": "CPU-only mixed INDEX owner selection; not runtime or source authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "additional_namespaces",
    "runtime_profile",
    "corpus_id",
    "recipe",
    "source_classes",
    "service_policy_revision_id",
    "service_policy_sha256",
    "native_execution_policy",
    "native_execution_policy_sha256",
    "database_owner",
    "runtime_verifier",
    "cpu_environment_raw_sha256",
    "owner_environment_raw_sha256",
    "poll_interval_seconds",
    "maximum_targets",
    "maximum_sources"
  ],
  "properties": {
    "legacy_configuration": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0"},
        {"$ref": "eom://schemas/workflow/local-indexing-owner-configuration/2.0"}
      ]
    },
    "schema_version": {
      "const": "local-indexing-owner-configuration/4.0"
    },
    "namespace": {
      "$ref": "eom://schemas/knowledge/embedding-registry/2.0#/$defs/namespace"
    },
    "additional_namespaces": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "eom://schemas/knowledge/embedding-registry/2.0#/$defs/namespace"
      }
    },
    "runtime_profile": {
      "allOf": [
        {
          "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/runtime_profile"
        },
        {
          "properties": {
            "resource_profile": {
              "properties": {
                "device": {
                  "const": "CPU"
                }
              }
            }
          }
        }
      ]
    },
    "corpus_id": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/corpus_id"
    },
    "recipe": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/recipe"
    },
    "source_classes": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/source_classes"
    },
    "service_policy_revision_id": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/service_policy_revision_id"
    },
    "service_policy_sha256": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/service_policy_sha256"
    },
    "native_execution_policy": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/native_execution_policy"
    },
    "native_execution_policy_sha256": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/native_execution_policy_sha256"
    },
    "database_owner": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/database_owner"
    },
    "runtime_verifier": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/runtime_verifier"
    },
    "cpu_environment_raw_sha256": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/cpu_environment_raw_sha256"
    },
    "owner_environment_raw_sha256": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/owner_environment_raw_sha256"
    },
    "poll_interval_seconds": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/poll_interval_seconds"
    },
    "maximum_targets": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/maximum_targets"
    },
    "maximum_sources": {
      "$ref": "eom://schemas/workflow/local-indexing-owner-configuration/1.0#/properties/maximum_sources"
    }
  }
}
