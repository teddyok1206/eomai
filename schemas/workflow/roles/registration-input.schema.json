{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eom.local/schemas/workflow/roles/registration-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "job_id", "workflow_id", "step_run_id", "attempt", "role", "request", "upstream_artifacts", "artifact"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "protocol_version": {"type": "string", "const": "workflow-role/1.0.1"},
    "job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
    "workflow_id": {"type": "string", "pattern": "^workflow_[0-9a-f]{32}$"},
    "step_run_id": {"type": "string", "pattern": "^steprun_[0-9a-f]{32}$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 10},
    "role": {"type": "string", "const": "item_management"},
    "request": {"$ref": "#/$defs/request"},
    "upstream_artifacts": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/pointer"}},
    "artifact": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {
    "request": {"type": "object", "additionalProperties": false, "required": ["request_name", "image_mode"], "properties": {"request_name": {"type": "string", "const": "PLACEHOLDER_REQUEST"}, "image_mode": {"type": "string", "enum": ["skip", "required"]}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["logical_artifact_id", "revision_id", "file_name", "media_type"], "properties": {"logical_artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"}, "revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"}, "file_name": {"type": "string", "const": "result.json"}, "media_type": {"type": "string", "const": "application/json"}}},
    "pointer": {"type": "object", "additionalProperties": false, "required": ["step_key", "attempt", "job_id", "logical_artifact_id", "revision_id", "content_hash", "result_schema"], "properties": {"step_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}, "attempt": {"type": "integer", "minimum": 1}, "job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"}, "logical_artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"}, "revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"}, "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "result_schema": {"type": "string", "minLength": 1, "maxLength": 128}}}
  }
}
