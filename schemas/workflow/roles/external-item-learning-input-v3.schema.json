{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "file_name": {
          "const": "result.json"
        },
        "logical_artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "type": "string"
        },
        "media_type": {
          "const": "application/json"
        },
        "revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "required": [
        "logical_artifact_id",
        "revision_id",
        "file_name",
        "media_type"
      ],
      "type": "object"
    }
  },
  "$id": "https://eom.local/schemas/workflow/roles/external-item-learning-input-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "attempt": {
      "maximum": 10,
      "minimum": 1,
      "type": "integer"
    },
    "job_id": {
      "pattern": "^job_[0-9a-f]{32}$",
      "type": "string"
    },
    "protocol_version": {
      "const": "workflow-role/1.36.0"
    },
    "request": {
      "additionalProperties": false,
      "properties": {
        "request_name": {
          "const": "EXTERNAL_ITEM_LEARNING_REQUEST"
        },
        "work_input": {
          "$ref": "eom://schemas/external-item/learning-work-input/2.0"
        }
      },
      "required": [
        "request_name",
        "work_input"
      ],
      "type": "object"
    },
    "role": {
      "const": "support"
    },
    "schema_version": {
      "const": "1.0"
    },
    "step_run_id": {
      "pattern": "^steprun_[0-9a-f]{32}$",
      "type": "string"
    },
    "upstream_artifacts": {
      "maxItems": 0,
      "type": "array"
    },
    "workflow_id": {
      "pattern": "^workflow_[0-9a-f]{32}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "job_id",
    "workflow_id",
    "step_run_id",
    "attempt",
    "role",
    "request",
    "upstream_artifacts",
    "artifact"
  ],
  "type": "object"
}
