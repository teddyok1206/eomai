{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "file_name": {
          "const": "result.json"
        },
        "logical_artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "type": "string"
        },
        "media_type": {
          "const": "application/json"
        },
        "revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "required": [
        "logical_artifact_id",
        "revision_id",
        "file_name",
        "media_type"
      ],
      "type": "object"
    }
  },
  "$id": "https://eom.local/schemas/workflow/roles/material-learning-input-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "attempt": {
      "maximum": 10,
      "minimum": 1,
      "type": "integer"
    },
    "job_id": {
      "pattern": "^job_[0-9a-f]{32}$",
      "type": "string"
    },
    "protocol_version": {
      "const": "workflow-role/1.40.0"
    },
    "request": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "work_input": {
                "properties": {
                  "task_kind": {
                    "const": "DISCOVER"
                  }
                },
                "required": [
                  "task_kind"
                ]
              }
            },
            "required": [
              "work_input"
            ]
          },
          "then": {
            "properties": {
              "native_visual_scope": {
                "type": "null"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "native_printed_score": {
                "$ref": "eom://schemas/external-item/source-score/2.0#/oneOf/0"
              }
            }
          },
          "if": {
            "properties": {
              "native_visual_scope": {
                "type": "null"
              }
            },
            "required": [
              "native_visual_scope"
            ]
          },
          "then": {
            "properties": {
              "native_printed_score": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "native_printed_score": {
          "oneOf": [
            {
              "$ref": "eom://schemas/external-item/source-score/2.0#/oneOf/0"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_visual_scope": {
          "anyOf": [
            {
              "$ref": "eom://schemas/material-learning/prepared/3.0#/$defs/questionScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_name": {
          "const": "MATERIAL_LEARNING_REQUEST"
        },
        "work_input": {
          "oneOf": [
            {
              "$ref": "eom://schemas/material-learning/discovery-work/1.0"
            },
            {
              "$ref": "eom://schemas/material-learning/extraction-work/1.0"
            }
          ]
        }
      },
      "required": [
        "request_name",
        "work_input",
        "native_visual_scope",
        "native_printed_score"
      ],
      "type": "object"
    },
    "role": {
      "const": "support"
    },
    "schema_version": {
      "const": "1.0"
    },
    "step_run_id": {
      "pattern": "^steprun_[0-9a-f]{32}$",
      "type": "string"
    },
    "upstream_artifacts": {
      "maxItems": 0,
      "type": "array"
    },
    "workflow_id": {
      "pattern": "^workflow_[0-9a-f]{32}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "job_id",
    "workflow_id",
    "step_run_id",
    "attempt",
    "role",
    "request",
    "upstream_artifacts",
    "artifact"
  ],
  "type": "object"
}
