{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/embedding-batch-plan/1.4",
  "title": "Public-solution QUERY exact device indexes over unchanged allocation and numeric frames",
  "oneOf": [
    {
      "$ref": "#/$defs/selection"
    },
    {
      "$ref": "#/$defs/request"
    }
  ],
  "$defs": {
    "queryOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_purpose",
        "maximum_sources",
        "top_k"
      ],
      "properties": {
        "consumer_purpose": {
          "$ref": "eom://schemas/knowledge/public-solution-similarity/3.0#/$defs/request/properties/consumer_purpose"
        },
        "maximum_sources": {
          "$ref": "eom://schemas/knowledge/public-solution-similarity/3.0#/$defs/request/properties/maximum_sources"
        },
        "top_k": {
          "$ref": "eom://schemas/knowledge/public-solution-similarity/3.0#/$defs/request/properties/top_k"
        }
      }
    },
    "indexPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "cuda"
      ],
      "properties": {
        "cpu": {
          "$ref": "eom://schemas/knowledge/public-solution-similarity/3.0#/$defs/view"
        },
        "cuda": {
          "$ref": "eom://schemas/knowledge/public-solution-similarity/3.0#/$defs/view"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "purpose",
        "scope",
        "corpus_id",
        "graph_snapshot",
        "access_policy_revision_id",
        "anchors",
        "recipe",
        "views",
        "query",
        "source_classes",
        "index_pairs",
        "selection_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "embedding-batch-plan/1.4"
        },
        "message_type": {
          "const": "SELECTION"
        },
        "purpose": {
          "const": "REFERENCE_QUERY"
        },
        "scope": {
          "allOf": [
            {
              "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/scope"
            },
            {
              "properties": {
                "actor_kind": {
                  "const": "OPERATOR"
                }
              }
            }
          ]
        },
        "corpus_id": {
          "type": "string",
          "pattern": "^corpus_[0-9a-f]{32}$"
        },
        "graph_snapshot": {
          "$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/graphSnapshotPointer"
        },
        "access_policy_revision_id": {
          "type": "string",
          "pattern": "^accessrev_[0-9a-f]{32}$"
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "eom://schemas/knowledge/public-solution-similarity/3.0#/$defs/anchor"
          }
        },
        "recipe": {
          "$ref": "eom://schemas/knowledge/public-solution-embedding-entry/1.0#/$defs/recipe"
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "CONCRETE_FACETS"
          }
        },
        "query": {
          "$ref": "#/$defs/queryOptions"
        },
        "source_classes": {
          "$ref": "eom://schemas/knowledge/public-solution-similarity/3.0#/$defs/request/properties/source_classes"
        },
        "index_pairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/indexPair"
          }
        },
        "selection_sha256": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "purpose",
        "scope",
        "batch_id",
        "parent_request_sha256",
        "selection_manifest",
        "selection_sha256",
        "routing_policy",
        "routing_policy_sha256",
        "child_selection_sha256s",
        "request_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "embedding-batch-plan/1.4"
        },
        "message_type": {
          "const": "REQUEST"
        },
        "purpose": {
          "const": "REFERENCE_QUERY"
        },
        "scope": {
          "allOf": [
            {
              "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/scope"
            },
            {
              "properties": {
                "actor_kind": {
                  "const": "OPERATOR"
                }
              }
            }
          ]
        },
        "batch_id": {
          "type": "string",
          "pattern": "^embeddingbatch_[0-9a-f]{32}$"
        },
        "parent_request_sha256": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
        },
        "selection_manifest": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/member"
        },
        "selection_sha256": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
        },
        "routing_policy": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/member"
        },
        "routing_policy_sha256": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
        },
        "child_selection_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
          }
        },
        "request_sha256": {
          "$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"
        }
      }
    }
  }
}
