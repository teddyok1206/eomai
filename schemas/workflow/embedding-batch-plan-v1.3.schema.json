{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/embedding-batch-plan/1.3",
  "title": "Public-solution INDEX pointers over unchanged allocation and numeric frames",
  "oneOf": [
    {"$ref": "#/$defs/selection"},
    {"$ref": "#/$defs/request"}
  ],
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "source", "base_analysis_run_id", "profile", "evidence"],
      "properties": {
        "basis": {"const": "VERIFIABLE_PUBLIC_SOLUTION"},
        "source": {"$ref": "eom://schemas/knowledge/public-solution-embedding-entry/1.0#/properties/source"},
        "base_analysis_run_id": {"type": "string", "pattern": "^analysisrun_[0-9a-f]{32}$"},
        "profile": {"$ref": "eom://schemas/knowledge/public-solution-embedding-index/3.0#/$defs/PublicSolutionProfilePointer"},
        "evidence": {"$ref": "eom://schemas/knowledge/public-solution-embedding-entry/1.0#/properties/evidence"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "purpose", "scope", "corpus_id", "graph_snapshot", "access_policy_revision_id", "anchors", "recipe", "views", "query", "selection_sha256"],
      "properties": {
        "schema_version": {"const": "embedding-batch-plan/1.3"},
        "message_type": {"const": "SELECTION"},
        "purpose": {"const": "INDEX"},
        "scope": {"$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/scope"},
        "corpus_id": {"type": "string", "pattern": "^corpus_[0-9a-f]{32}$"},
        "graph_snapshot": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/graphSnapshotPointer"},
        "access_policy_revision_id": {"type": "string", "pattern": "^accessrev_[0-9a-f]{32}$"},
        "anchors": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/anchor"}},
        "recipe": {"$ref": "eom://schemas/knowledge/public-solution-embedding-entry/1.0#/$defs/recipe"},
        "views": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "CONCRETE_FACETS"}},
        "query": {"type": "null"},
        "selection_sha256": {"$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "batch_id", "parent_request_sha256", "purpose", "scope", "selection_manifest", "selection_sha256", "routing_policy", "routing_policy_sha256", "child_selection_sha256s", "request_sha256"],
      "properties": {
        "schema_version": {"const": "embedding-batch-plan/1.3"},
        "message_type": {"const": "REQUEST"},
        "batch_id": {"type": "string", "pattern": "^embeddingbatch_[0-9a-f]{32}$"},
        "parent_request_sha256": {"$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"},
        "purpose": {"const": "INDEX"},
        "scope": {"$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/scope"},
        "selection_manifest": {"$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/member"},
        "selection_sha256": {"$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"},
        "routing_policy": {"$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/member"},
        "routing_policy_sha256": {"$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"},
        "child_selection_sha256s": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"}},
        "request_sha256": {"$ref": "eom://schemas/workflow/embedding-batch-plan/1.0#/$defs/hash"}
      }
    }
  }
}
