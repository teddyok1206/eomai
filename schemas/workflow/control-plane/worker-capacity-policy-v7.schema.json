{
  "$id": "eom://schemas/workflow/worker-capacity-policy/1.6",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capacity_policy_id": {
      "pattern": "^capacity_[0-9a-f]{32}$",
      "type": "string"
    },
    "capacity_policy_revision_id": {
      "pattern": "^capacityrev_[0-9a-f]{32}$",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "delegated_slot_roles": {
      "const": [
        {
          "execution_role": "support",
          "native_role": "image",
          "pool_key": "support",
          "slot_key": "slot03"
        },
        {
          "execution_role": "support",
          "native_role": "item_management",
          "pool_key": "support",
          "slot_key": "slot04"
        }
      ]
    },
    "max_active_codex": {
      "const": 4
    },
    "max_active_gpu": {
      "const": 1
    },
    "max_active_knowledge_analysis": {
      "const": 4
    },
    "max_active_per_slot": {
      "const": 1
    },
    "max_configured_slots": {
      "const": 6
    },
    "pools": {
      "const": [
        {
          "max_active": 4,
          "pool_key": "support",
          "roles": [
            "support"
          ],
          "slot_keys": [
            "slot03",
            "slot04",
            "slot05",
            "slot06"
          ]
        }
      ]
    },
    "purpose": {
      "const": "UPLOADED_MATERIAL_LEARNING"
    },
    "revision_number": {
      "const": 1
    },
    "schema_version": {
      "const": "worker-capacity-policy/1.6"
    },
    "state": {
      "enum": [
        "DRAFT",
        "RELEASED",
        "DEPRECATED"
      ]
    }
  },
  "required": [
    "schema_version",
    "capacity_policy_id",
    "capacity_policy_revision_id",
    "revision_number",
    "state",
    "purpose",
    "max_configured_slots",
    "max_active_codex",
    "max_active_per_slot",
    "max_active_gpu",
    "max_active_knowledge_analysis",
    "pools",
    "delegated_slot_roles",
    "content_sha256",
    "created_at"
  ],
  "title": "EOM mixed-material learning capacity in the shared four-process host",
  "type": "object"
}
