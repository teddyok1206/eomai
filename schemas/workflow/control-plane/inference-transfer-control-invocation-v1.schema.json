{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/inference-transfer-control-invocation/1.0",
  "title": "EOM initial inference-transfer control preparation and release values",
  "description": "Small exact output/input values. A receipt or hash is not authentication, permission, model availability, activation or educational approval.",
  "$defs": {
    "sha256": {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"},
    "bootstrapArtifact": {
      "allOf": [
        {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/artifactPointer"},
        {"properties": {
          "schema_ref": {"const": "eom://schemas/workflow/inference-transfer-control-bootstrap/1.0"},
          "media_type": {"const": "application/json"},
          "logical_name": {"const": "inference-transfer-bootstrap.json"}
        }}
      ]
    },
    "instructionBundle": {
      "allOf": [
        {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/bundleRevisionPointer"},
        {"properties": {
          "bundle_id": {"pattern": "^instrbundle_[0-9a-f]{32}$"},
          "bundle_revision_id": {"pattern": "^instrrev_[0-9a-f]{32}$"},
          "manifest_artifact": {"properties": {
            "schema_ref": {"const": "eom://schemas/workflow/instruction-bundle-manifest/1.0"},
            "media_type": {"const": "application/json"},
            "logical_name": {"const": "instruction-bundle.json"}
          }}
        }}
      ]
    },
    "dedicatedPreset": {
      "allOf": [
        {"$ref": "eom://schemas/workflow/execution-preset-revision/1.0"},
        {"properties": {
          "general_knowledge_policy": {"const": "DENY"},
          "compatible_workflow_protocols": {"const": ["workflow-role/1.29.0"]},
          "role_policies": {
            "minItems": 1, "maxItems": 1,
            "items": {"properties": {
              "role": {"const": "support"},
              "model_candidates": {"minItems": 1, "maxItems": 1},
              "reference_bundle": {"type": "null"},
              "worker_pool_key": {"const": "customer-support"},
              "timeout_seconds": {"maximum": 900}
            }}
          }
        }}
      ]
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "inference-transfer-prepared-receipt/1.0"},
        "manifest": {"$ref": "eom://schemas/workflow/inference-transfer-control-bootstrap/1.0"},
        "bootstrap_artifact": {"$ref": "#/$defs/bootstrapArtifact"},
        "instruction_bundle": {"$ref": "#/$defs/instructionBundle"},
        "draft": {"allOf": [
          {"$ref": "#/$defs/dedicatedPreset"},
          {"properties": {"state": {"const": "DRAFT"}, "revision_number": {"const": 1}}}
        ]},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["schema_version", "manifest", "bootstrap_artifact", "instruction_bundle", "draft", "receipt_sha256"]
    },
    "releaseRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "inference-transfer-control-release-request/1.0"},
        "receipt": {"$ref": "#/$defs/receipt"},
        "request_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["schema_version", "receipt", "request_sha256"]
    },
    "releaseResult": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "inference-transfer-control-release-result/1.0"},
        "prepared_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "preset": {"allOf": [
          {"$ref": "#/$defs/dedicatedPreset"},
          {"properties": {"state": {"const": "RELEASED"}, "revision_number": {"const": 2}}}
        ]},
        "evaluation_id": {"type": "string", "pattern": "^preseteval_[0-9a-f]{32}$"},
        "evaluation_artifact": {"allOf": [
          {"$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/artifactPointer"},
          {"properties": {
            "schema_ref": {"const": "eom://schemas/workflow/execution-preset-evaluation-report/1.0"},
            "media_type": {"const": "application/json"},
            "logical_name": {"const": "inference-transfer-preset-evaluation.json"}
          }}
        ]},
        "executed_cases": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:.-]{0,127}$"}
        },
        "quality_score_permille": {"type": "null"},
        "scientific_evaluation": {"const": "NOT_EVALUATED"},
        "human_transfer_evaluation": {"const": "NOT_EVALUATED"},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["schema_version", "prepared_receipt_sha256", "preset", "evaluation_id", "evaluation_artifact", "executed_cases", "quality_score_permille", "scientific_evaluation", "human_transfer_evaluation", "result_sha256"]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/receipt"},
    {"$ref": "#/$defs/releaseRequest"},
    {"$ref": "#/$defs/releaseResult"}
  ]
}
