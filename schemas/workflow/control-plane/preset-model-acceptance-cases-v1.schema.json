{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/preset-model-acceptance-cases/1.0",
  "title": "Pinned non-live preset adapter acceptance cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_id",
    "request_sha256",
    "preset_revision_id",
    "preset_content_sha256",
    "preset_policy_sha256",
    "base_revision_id",
    "base_content_sha256",
    "evaluator_source_commit",
    "case_keys",
    "completed_at",
    "cases_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "preset-model-acceptance-cases/1.0"
    },
    "validation_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{32}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "preset_revision_id": {
      "type": "string",
      "pattern": "^execpresetrev_[0-9a-f]{32}$"
    },
    "preset_content_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "preset_policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "base_revision_id": {
      "type": "string",
      "pattern": "^execpresetrev_[0-9a-f]{32}$"
    },
    "base_content_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evaluator_source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "case_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_:-]+$"
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "cases_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
