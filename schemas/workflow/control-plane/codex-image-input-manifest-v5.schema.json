{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/codex-image-input-manifest/5.0",
  "title": "EOM material source page image input manifest V5",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "codex-image-input-manifest/5.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^execplan_[0-9a-f]{32}$"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "source_role": {
            "enum": [
              "MAIN",
              "SOLUTIONS"
            ]
          },
          "physical_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^source/material/(?:main|solutions)/page-[0-9]{6}\\.png$"
          },
          "media_type": {
            "const": "image/png"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 24,
            "maximum": 16777216
          },
          "width_pixels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "height_pixels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "input_index",
          "source_role",
          "physical_page",
          "relative_path",
          "media_type",
          "sha256",
          "bytes",
          "width_pixels",
          "height_pixels"
        ]
      },
      "minItems": 1,
      "maxItems": 32
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "images",
    "manifest_sha256"
  ]
}
