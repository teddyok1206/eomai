{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/codex-usage-observation/1.0",
  "title": "Codex Usage Observation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "binding_id",
    "slot_key",
    "account_type",
    "plan_type",
    "windows",
    "observed_at",
    "observation_sha256"
  ],
  "properties": {
    "schema_version": {"const": "codex-usage-observation/1.0"},
    "command_id": {"type": "string", "pattern": "^codexcmd_[0-9a-f]{32}$"},
    "binding_id": {"type": "string", "pattern": "^authbinding_[0-9a-f]{32}$"},
    "slot_key": {"type": "string", "pattern": "^slot0[1-6]$"},
    "account_type": {"const": "chatgpt"},
    "plan_type": {
      "enum": ["free", "go", "plus", "pro", "prolite", "team", "self_serve_business_prolite", "self_serve_business_usage_based", "business", "ent26", "enterprise_cbp_automation", "enterprise_cbp_usage_based", "enterprise", "edu", "unknown"]
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "limit_id",
          "limit_name",
          "window_kind",
          "used_percent",
          "window_duration_minutes",
          "resets_at"
        ],
        "properties": {
          "limit_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "limit_name": {
            "oneOf": [
              {"type": "string", "minLength": 1, "maxLength": 128},
              {"type": "null"}
            ]
          },
          "window_kind": {"enum": ["PRIMARY", "SECONDARY"]},
          "used_percent": {"type": "integer", "minimum": 0, "maximum": 100},
          "window_duration_minutes": {
            "oneOf": [
              {"type": "integer", "minimum": 1, "maximum": 525600},
              {"type": "null"}
            ]
          },
          "resets_at": {
            "oneOf": [
              {"type": "string", "format": "date-time"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "observation_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
