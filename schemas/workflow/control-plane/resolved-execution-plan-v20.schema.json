{
  "$id": "eom://schemas/workflow/resolved-execution-plan/20.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capacity_policy_revision_id": {
      "pattern": "^capacityrev_[0-9a-f]{32}$",
      "type": "string"
    },
    "content_pack_release_id": {
      "pattern": "^packrel_[0-9a-f]{32}$",
      "type": "string"
    },
    "content_pack_sha256": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
    },
    "evidence_bundle_revision_id": {
      "type": "null"
    },
    "graph_snapshot_revision_id": {
      "type": "null"
    },
    "plan_id": {
      "pattern": "^execplan_[0-9a-f]{32}$",
      "type": "string"
    },
    "plan_sha256": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
    },
    "preset_id": {
      "pattern": "^execpreset_[0-9a-f]{32}$",
      "type": "string"
    },
    "preset_revision_id": {
      "pattern": "^execpresetrev_[0-9a-f]{32}$",
      "type": "string"
    },
    "preset_sha256": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
    },
    "resolved_at": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/utcTimestamp"
    },
    "resolver_version": {
      "const": "20.0.0"
    },
    "schema_version": {
      "const": "resolved-execution-plan/20.0"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "escalation_candidate": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string"
                  },
                  "reasoning_effort": {
                    "enum": [
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh"
                    ]
                  }
                },
                "required": [
                  "model",
                  "reasoning_effort"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_access": {
            "const": "NONE"
          },
          "general_knowledge_mode": {
            "enum": [
              "DENIED",
              "ALLOWED_WITH_PROVENANCE"
            ],
            "type": "string"
          },
          "instruction_bundle": {
            "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/bundleRevisionPointer"
          },
          "model": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "network": {
            "const": "disabled"
          },
          "reasoning_effort": {
            "enum": [
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh"
            ],
            "type": "string"
          },
          "reference_bundle": {
            "anyOf": [
              {
                "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/bundleRevisionPointer"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/role"
          },
          "sandbox": {
            "const": "read-only"
          },
          "step_key": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "timeout_seconds": {
            "maximum": 7200,
            "minimum": 30,
            "type": "integer"
          },
          "worker_pool_key": {
            "pattern": "^[a-z][a-z0-9_-]{1,63}$",
            "type": "string"
          }
        },
        "required": [
          "step_key",
          "role",
          "model",
          "reasoning_effort",
          "instruction_bundle",
          "reference_bundle",
          "worker_pool_key",
          "timeout_seconds",
          "sandbox",
          "network",
          "general_knowledge_mode",
          "evidence_access",
          "escalation_candidate"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "workflow_definition_key": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "workflow_definition_sha256": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
    },
    "workflow_definition_version": {
      "const": "1.16.0"
    },
    "workflow_id": {
      "pattern": "^workflow_[0-9a-f]{32}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "workflow_id",
    "preset_id",
    "preset_revision_id",
    "preset_sha256",
    "workflow_definition_key",
    "workflow_definition_version",
    "workflow_definition_sha256",
    "content_pack_release_id",
    "content_pack_sha256",
    "capacity_policy_revision_id",
    "steps",
    "resolver_version",
    "resolved_at",
    "plan_sha256",
    "graph_snapshot_revision_id",
    "evidence_bundle_revision_id"
  ],
  "title": "Resolved Execution Plan V20",
  "type": "object"
}
