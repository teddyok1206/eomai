{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/codex-compatibility-matrix/1.0",
  "title": "EOM Codex Compatibility Matrix V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selections"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "codex-compatibility-matrix/1.0"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "model", "reasoning_effort"],
        "properties": {
          "slot_id": {
            "type": "string",
            "enum": ["01", "02", "03", "04", "05", "06"]
          },
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "reasoning_effort": {
            "type": "string",
            "enum": ["minimal", "low", "medium", "high", "xhigh"]
          }
        }
      }
    }
  }
}
