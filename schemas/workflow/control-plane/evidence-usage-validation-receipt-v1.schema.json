{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/evidence-usage-validation-receipt/1.0",
  "$defs": {
    "knowledgeArtifactMemberPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "sha256",
        "schema_ref",
        "media_type",
        "logical_name"
      ],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "member_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
        },
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "schema_ref": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^eom(?:\\.assess(?:ment)?|://schemas/)[A-Za-z0-9._/@:-]{1,191}$"
        },
        "media_type": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9.+-]+/[A-Za-z0-9.+-]+$"
        },
        "logical_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        }
      }
    },
    "manifestArtifactMemberPointer": {
      "allOf": [
        {"$ref": "#/$defs/knowledgeArtifactMemberPointer"},
        {
          "properties": {
            "member_path": {"const": "evidence/manifest.json"},
            "media_type": {"const": "application/json"},
            "schema_ref": {
              "enum": [
                "eom://schemas/knowledge/evidence-bundle-manifest/2.0",
                "eom://schemas/knowledge/evidence-bundle-manifest/3.0",
                "eom://schemas/knowledge/evidence-bundle-manifest/4.0"
              ]
            }
          }
        }
      ]
    },
    "contextArtifactMemberPointer": {
      "allOf": [
        {"$ref": "#/$defs/knowledgeArtifactMemberPointer"},
        {
          "properties": {
            "member_path": {"const": "evidence/context.md"},
            "media_type": {"const": "text/markdown"},
            "schema_ref": {"const": "eom://schemas/knowledge/evidence-bundle-context/1.0"}
          }
        }
      ]
    },
    "resultArtifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_artifact_id", "revision_id", "content_hash", "result_schema"],
      "properties": {
        "logical_artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "result_schema": {
          "enum": ["authoring-result@10.0", "review-result@10.0"]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_sha256",
    "step_key",
    "evidence_bundle_id",
    "evidence_bundle_revision_id",
    "retrieval_request_id",
    "retrieval_request_sha256",
    "graph_snapshot_revision_id",
    "graph_snapshot_sha256",
    "evidence_manifest_artifact",
    "evidence_manifest_sha256",
    "evidence_context_artifact",
    "result_artifact",
    "authoring_citation_set_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evidence-usage-validation-receipt/1.0"},
    "plan_id": {"type": "string", "pattern": "^execplan_[0-9a-f]{32}$"},
    "plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "step_key": {"enum": ["authoring", "review"]},
    "evidence_bundle_id": {"type": "string", "pattern": "^evidence_[0-9a-f]{32}$"},
    "evidence_bundle_revision_id": {"type": "string", "pattern": "^evidencerev_[0-9a-f]{32}$"},
    "retrieval_request_id": {"type": "string", "pattern": "^retrieval_[0-9a-f]{32}$"},
    "retrieval_request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "graph_snapshot_revision_id": {"type": "string", "pattern": "^graphrev_[0-9a-f]{32}$"},
    "graph_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_manifest_artifact": {"$ref": "#/$defs/manifestArtifactMemberPointer"},
    "evidence_manifest_sha256": {
      "description": "Semantic manifest self-hash; distinct from evidence_manifest_artifact.sha256.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_context_artifact": {"$ref": "#/$defs/contextArtifactMemberPointer"},
    "result_artifact": {"$ref": "#/$defs/resultArtifactPointer"},
    "authoring_artifact": {"$ref": "#/$defs/resultArtifactPointer"},
    "authoring_citation_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review_citation_set_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "citation_sets_equal": {
      "anyOf": [{"const": true}, {"type": "null"}]
    },
    "receipt_sha256": {
      "description": "SHA-256 of RFC 8785-style canonical JSON for this receipt with receipt_sha256 omitted, using the repository content_sha256 implementation.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"step_key": {"const": "authoring"}}, "required": ["step_key"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["authoring_artifact"]},
            {"required": ["review_citation_set_sha256"]},
            {"required": ["citation_sets_equal"]}
          ]
        },
        "properties": {
          "result_artifact": {
            "properties": {"result_schema": {"const": "authoring-result@10.0"}}
          }
        }
      },
      "else": {
        "required": [
          "authoring_artifact",
          "review_citation_set_sha256",
          "citation_sets_equal"
        ],
        "properties": {
          "result_artifact": {
            "properties": {"result_schema": {"const": "review-result@10.0"}}
          },
          "authoring_artifact": {
            "properties": {"result_schema": {"const": "authoring-result@10.0"}}
          },
          "review_citation_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "citation_sets_equal": {"const": true}
        }
      }
    }
  ]
}
