{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/legacy-item-editorial-compatibility-control-bootstrap/2.0",
  "title": "Legacy item editorial compatibility control bootstrap manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preset_key",
    "display_name",
    "description",
    "created_at",
    "model",
    "reasoning_effort",
    "general_knowledge_policy",
    "compatible_workflow_protocols",
    "platform_instruction_path",
    "role_instruction_path",
    "slot_key",
    "worker_pool_key",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {"const": "legacy-item-editorial-compatibility-control-bootstrap/2.0"},
    "preset_key": {"const": "legacy-item-editorial-compatibility"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "created_at": {"type": "string", "format": "date-time"},
    "model": {"const": "gpt-5.6-terra"},
    "reasoning_effort": {"const": "high"},
    "general_knowledge_policy": {"const": "DENY"},
    "compatible_workflow_protocols": {
      "type": "array",
      "prefixItems": [{"const": "workflow-role/1.16.0"}],
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    },
    "platform_instruction_path": {"const": "instructions/platform.md"},
    "role_instruction_path": {"const": "instructions/legacy-item-editorial-compatibility.md"},
    "slot_key": {"const": "slot05"},
    "worker_pool_key": {"const": "support"},
    "timeout_seconds": {"const": 7200}
  }
}
