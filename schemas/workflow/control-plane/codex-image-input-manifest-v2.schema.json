{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/codex-image-input-manifest/2.0",
  "title": "EOM Codex Assessment Image Input Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "images", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "codex-image-input-manifest/2.0"},
    "plan_id": {"type": "string", "pattern": "^execplan_[0-9a-f]{32}$"},
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/image"}
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_input_id",
        "source_role",
        "physical_page",
        "relative_path",
        "media_type",
        "sha256",
        "bytes",
        "width_pixels",
        "height_pixels"
      ],
      "properties": {
        "page_input_id": {
          "type": "string",
          "pattern": "^assessmentpage_[0-9a-f]{32}$"
        },
        "source_role": {
          "enum": ["PROBLEM_DOCUMENT", "ANSWER_EXPLANATION_DOCUMENT"]
        },
        "physical_page": {"type": "integer", "minimum": 1, "maximum": 100000},
        "relative_path": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^source/pages/assessmentpage_[0-9a-f]{32}\\.png$"
        },
        "media_type": {"const": "image/png"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "width_pixels": {"type": "integer", "minimum": 1, "maximum": 20000},
        "height_pixels": {"type": "integer", "minimum": 1, "maximum": 20000}
      }
    }
  }
}
