{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/workflow/worker-capacity-policy/1.0",
  "title": "EOM Worker Capacity Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capacity_policy_id",
    "capacity_policy_revision_id",
    "revision_number",
    "state",
    "max_configured_slots",
    "max_active_codex",
    "max_active_per_slot",
    "max_active_gpu",
    "max_active_knowledge_analysis",
    "pools",
    "content_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "worker-capacity-policy/1.0"
    },
    "capacity_policy_id": {
      "type": "string",
      "pattern": "^capacity_[0-9a-f]{32}$"
    },
    "capacity_policy_revision_id": {
      "type": "string",
      "pattern": "^capacityrev_[0-9a-f]{32}$"
    },
    "revision_number": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": ["DRAFT", "RELEASED", "DEPRECATED"]
    },
    "max_configured_slots": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "max_active_codex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "max_active_per_slot": {
      "const": 1
    },
    "max_active_gpu": {
      "const": 1
    },
    "max_active_knowledge_analysis": {
      "const": 1
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pool_key", "roles", "slot_keys", "max_active"],
        "properties": {
          "pool_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/role"
            }
          },
          "slot_keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^slot[0-9]{2}$"
            }
          },
          "max_active": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    },
    "content_sha256": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/sha256"
    },
    "created_at": {
      "$ref": "eom://schemas/workflow/control-plane-types-v1#/$defs/utcTimestamp"
    }
  }
}
