{
  "$defs": {
    "MockExamAuthoringEvidenceUsageReceiptPointerV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "attempt": {
          "maximum": 10,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "job_id": {
          "pattern": "^job_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "result_schema": {
          "const": "authoring-result@10.0",
          "title": "Result Schema",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "step_key": {
          "const": "authoring",
          "title": "Step Key",
          "type": "string"
        },
        "step_run_id": {
          "pattern": "^steprun_[0-9a-f]{32}$",
          "title": "Step Run Id",
          "type": "string"
        },
        "workflow_id": {
          "pattern": "^workflow_[0-9a-f]{32}$",
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "step_run_id",
        "attempt",
        "job_id",
        "artifact_id",
        "artifact_revision_id",
        "sha256",
        "receipt_sha256",
        "step_key",
        "result_schema"
      ],
      "title": "MockExamAuthoringEvidenceUsageReceiptPointerV1",
      "type": "object"
    },
    "MockExamHumanApprovalPointer": {
      "additionalProperties": false,
      "properties": {
        "approval_request_id": {
          "pattern": "^approval_[0-9a-f]{32}$",
          "title": "Approval Request Id",
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "reviewer_operator_id": {
          "pattern": "^operator_[0-9a-f]{32}$",
          "title": "Reviewer Operator Id",
          "type": "string"
        }
      },
      "required": [
        "approval_request_id",
        "reviewer_operator_id",
        "approved_at"
      ],
      "title": "MockExamHumanApprovalPointer",
      "type": "object"
    },
    "MockExamReviewEvidenceUsageReceiptPointerV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "attempt": {
          "maximum": 10,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "job_id": {
          "pattern": "^job_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "result_schema": {
          "const": "review-result@10.0",
          "title": "Result Schema",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "step_key": {
          "const": "review",
          "title": "Step Key",
          "type": "string"
        },
        "step_run_id": {
          "pattern": "^steprun_[0-9a-f]{32}$",
          "title": "Step Run Id",
          "type": "string"
        },
        "workflow_id": {
          "pattern": "^workflow_[0-9a-f]{32}$",
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "step_run_id",
        "attempt",
        "job_id",
        "artifact_id",
        "artifact_revision_id",
        "sha256",
        "receipt_sha256",
        "step_key",
        "result_schema"
      ],
      "title": "MockExamReviewEvidenceUsageReceiptPointerV1",
      "type": "object"
    },
    "MockExamReviewFindingCountsV3": {
      "additionalProperties": false,
      "description": "V3 wire form keeps the zero-blocking field explicit rather than defaulted.",
      "properties": {
        "blocking": {
          "const": 0,
          "title": "Blocking",
          "type": "integer"
        },
        "info": {
          "maximum": 20,
          "minimum": 0,
          "title": "Info",
          "type": "integer"
        },
        "warning": {
          "maximum": 20,
          "minimum": 0,
          "title": "Warning",
          "type": "integer"
        }
      },
      "required": [
        "info",
        "warning",
        "blocking"
      ],
      "title": "MockExamReviewFindingCountsV3",
      "type": "object"
    },
    "MockExamSourceReviewPointerV3": {
      "additionalProperties": false,
      "description": "Exact @10 review result plus the trusted authoring/review receipt pair.",
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "finding_counts": {
          "$ref": "#/$defs/MockExamReviewFindingCountsV3"
        },
        "result_schema": {
          "const": "review-result@10.0",
          "title": "Result Schema",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "step_run_id": {
          "pattern": "^steprun_[0-9a-f]{32}$",
          "title": "Step Run Id",
          "type": "string"
        },
        "trusted_evidence_usage_receipts": {
          "$ref": "#/$defs/MockExamTrustedEvidenceUsageReceiptPairV1"
        },
        "worker_decision": {
          "const": "ready_for_human",
          "title": "Worker Decision",
          "type": "string"
        }
      },
      "required": [
        "step_run_id",
        "artifact_id",
        "artifact_revision_id",
        "sha256",
        "result_schema",
        "worker_decision",
        "finding_counts",
        "trusted_evidence_usage_receipts"
      ],
      "title": "MockExamSourceReviewPointerV3",
      "type": "object"
    },
    "MockExamTrustedEvidenceUsageReceiptPairV1": {
      "additionalProperties": false,
      "description": "Resolvable authoring/review receipt identities for one trusted RAG Workflow.",
      "properties": {
        "authoring": {
          "$ref": "#/$defs/MockExamAuthoringEvidenceUsageReceiptPointerV1"
        },
        "receipt_schema_version": {
          "const": "evidence-usage-validation-receipt/1.0",
          "title": "Receipt Schema Version",
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/MockExamReviewEvidenceUsageReceiptPointerV1"
        },
        "role_protocol_version": {
          "const": "workflow-role/1.20.0",
          "title": "Role Protocol Version",
          "type": "string"
        },
        "schema_version": {
          "const": "mock-exam-trusted-evidence-usage-receipt-pair/1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "role_protocol_version",
        "receipt_schema_version",
        "authoring",
        "review"
      ],
      "title": "MockExamTrustedEvidenceUsageReceiptPairV1",
      "type": "object"
    }
  },
  "$id": "https://eom.local/schemas/assessment-assembly/mock-exam-item-review-decision-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable operator decision closed over the exact trusted RAG evidence chain.",
  "properties": {
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "const": "APPROVE",
      "title": "Decision",
      "type": "string"
    },
    "decision_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Decision Sha256",
      "type": "string"
    },
    "final_rating": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Final Rating",
      "type": "string"
    },
    "human_approval": {
      "$ref": "#/$defs/MockExamHumanApprovalPointer"
    },
    "idempotency_key_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Idempotency Key Sha256",
      "type": "string"
    },
    "item_review_record_id": {
      "pattern": "^itemreview_[0-9a-f]{32}$",
      "title": "Item Review Record Id",
      "type": "string"
    },
    "item_revision_id": {
      "pattern": "^itemrev_[0-9a-f]{32}$",
      "title": "Item Revision Id",
      "type": "string"
    },
    "rating_policy_key": {
      "const": "integrated-science-item-rating",
      "title": "Rating Policy Key",
      "type": "string"
    },
    "rating_policy_revision_id": {
      "pattern": "^ratingpolicyrev_[0-9a-f]{32}$",
      "title": "Rating Policy Revision Id",
      "type": "string"
    },
    "rating_policy_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rating Policy Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "mock-exam-item-review-decision/3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_review": {
      "$ref": "#/$defs/MockExamSourceReviewPointerV3"
    },
    "workflow_id": {
      "pattern": "^workflow_[0-9a-f]{32}$",
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "item_review_record_id",
    "item_revision_id",
    "workflow_id",
    "source_review",
    "human_approval",
    "decision",
    "final_rating",
    "rating_policy_key",
    "rating_policy_revision_id",
    "rating_policy_sha256",
    "idempotency_key_sha256",
    "decided_at",
    "decision_sha256"
  ],
  "title": "MockExamItemReviewDecisionV3",
  "type": "object"
}
