{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/assessment-assembly/mock-exam-assembly-policy/1.0",
  "title": "Mock Exam Assembly Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_key", "policy_revision_id", "revision_number", "state",
    "subject_key", "item_count", "total_points_milli", "score_distribution",
    "required_slot_count", "balance_slot_count", "inquiry_min_count", "inquiry_max_count",
    "coverage_requirements", "eligible_item_revision_states", "outline_key",
    "outline_revision", "outline_sha256", "guidance_pointer"
  ],
  "properties": {
    "schema_version": {"const": "mock-exam-assembly-policy/1.0"},
    "policy_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
    "policy_revision_id": {"type": "string", "pattern": "^assemblypolicyrev_[0-9a-f]{32}$"},
    "revision_number": {"type": "integer", "minimum": 1},
    "state": {"const": "RELEASED"},
    "subject_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,159}$"},
    "item_count": {"type": "integer", "minimum": 1, "maximum": 200},
    "total_points_milli": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "score_distribution": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {"$ref": "#/$defs/score_bucket"}
    },
    "required_slot_count": {"type": "integer", "minimum": 0, "maximum": 200},
    "balance_slot_count": {"type": "integer", "minimum": 0, "maximum": 200},
    "inquiry_min_count": {"type": "integer", "minimum": 0, "maximum": 200},
    "inquiry_max_count": {"type": "integer", "minimum": 0, "maximum": 200},
    "coverage_requirements": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {"$ref": "#/$defs/coverage_requirement"}
    },
    "eligible_item_revision_states": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {"enum": ["APPROVED", "SUPERSEDED"]},
      "uniqueItems": true
    },
    "outline_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "outline_revision": {"type": "string", "minLength": 1, "maxLength": 32},
    "outline_sha256": {"$ref": "#/$defs/sha256"},
    "guidance_pointer": {"$ref": "#/$defs/guidance_pointer"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "score_bucket": {
      "type": "object", "additionalProperties": false,
      "required": ["points_milli", "count"],
      "properties": {
        "points_milli": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "count": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    },
    "coverage_requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "selection_count", "distinct_units", "allowed_unit_keys"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
        "selection_count": {"type": "integer", "minimum": 1, "maximum": 20},
        "distinct_units": {"type": "boolean"},
        "allowed_unit_keys": {
          "type": "array", "minItems": 1, "maxItems": 40,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,191}$"},
          "uniqueItems": true
        }
      }
    },
    "guidance_pointer": {
      "type": "object", "additionalProperties": false,
      "required": ["guidance_key", "revision", "reviewed_document_sha256", "original_sha256"],
      "properties": {
        "guidance_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
        "revision": {"type": "integer", "minimum": 1},
        "reviewed_document_sha256": {"$ref": "#/$defs/sha256"},
        "original_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
