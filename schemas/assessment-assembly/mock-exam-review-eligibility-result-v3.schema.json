{
  "$defs": {
    "MockExamAuthoringEvidenceUsageReceiptPointerV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "attempt": {
          "maximum": 10,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "job_id": {
          "pattern": "^job_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "result_schema": {
          "const": "authoring-result@10.0",
          "title": "Result Schema",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "step_key": {
          "const": "authoring",
          "title": "Step Key",
          "type": "string"
        },
        "step_run_id": {
          "pattern": "^steprun_[0-9a-f]{32}$",
          "title": "Step Run Id",
          "type": "string"
        },
        "workflow_id": {
          "pattern": "^workflow_[0-9a-f]{32}$",
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "step_run_id",
        "attempt",
        "job_id",
        "artifact_id",
        "artifact_revision_id",
        "sha256",
        "receipt_sha256",
        "step_key",
        "result_schema"
      ],
      "title": "MockExamAuthoringEvidenceUsageReceiptPointerV1",
      "type": "object"
    },
    "MockExamEligibilityFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "MockExamEligibilityFinding",
      "type": "object"
    },
    "MockExamEligibilityFindingCounts": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "maximum": 20,
          "minimum": 0,
          "title": "Blocking",
          "type": "integer"
        },
        "info": {
          "maximum": 20,
          "minimum": 0,
          "title": "Info",
          "type": "integer"
        },
        "warning": {
          "maximum": 20,
          "minimum": 0,
          "title": "Warning",
          "type": "integer"
        }
      },
      "required": [
        "info",
        "warning",
        "blocking"
      ],
      "title": "MockExamEligibilityFindingCounts",
      "type": "object"
    },
    "MockExamReviewEvidenceUsageReceiptPointerV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "attempt": {
          "maximum": 10,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "job_id": {
          "pattern": "^job_[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "result_schema": {
          "const": "review-result@10.0",
          "title": "Result Schema",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "step_key": {
          "const": "review",
          "title": "Step Key",
          "type": "string"
        },
        "step_run_id": {
          "pattern": "^steprun_[0-9a-f]{32}$",
          "title": "Step Run Id",
          "type": "string"
        },
        "workflow_id": {
          "pattern": "^workflow_[0-9a-f]{32}$",
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "step_run_id",
        "attempt",
        "job_id",
        "artifact_id",
        "artifact_revision_id",
        "sha256",
        "receipt_sha256",
        "step_key",
        "result_schema"
      ],
      "title": "MockExamReviewEvidenceUsageReceiptPointerV1",
      "type": "object"
    },
    "MockExamTrustedEvidenceUsageReceiptPairV1": {
      "additionalProperties": false,
      "description": "Resolvable authoring/review receipt identities for one trusted RAG Workflow.",
      "properties": {
        "authoring": {
          "$ref": "#/$defs/MockExamAuthoringEvidenceUsageReceiptPointerV1"
        },
        "receipt_schema_version": {
          "const": "evidence-usage-validation-receipt/1.0",
          "title": "Receipt Schema Version",
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/MockExamReviewEvidenceUsageReceiptPointerV1"
        },
        "role_protocol_version": {
          "const": "workflow-role/1.20.0",
          "title": "Role Protocol Version",
          "type": "string"
        },
        "schema_version": {
          "const": "mock-exam-trusted-evidence-usage-receipt-pair/1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "role_protocol_version",
        "receipt_schema_version",
        "authoring",
        "review"
      ],
      "title": "MockExamTrustedEvidenceUsageReceiptPairV1",
      "type": "object"
    }
  },
  "$id": "https://eom.local/schemas/assessment-assembly/mock-exam-review-eligibility-result-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_state": {
            "const": "PENDING"
          }
        },
        "required": [
          "approval_state"
        ]
      },
      "then": {
        "properties": {
          "approved_at": {
            "type": "null"
          },
          "reviewer_operator_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_state": {
            "const": "APPROVED"
          }
        },
        "required": [
          "approval_state"
        ]
      },
      "then": {
        "properties": {
          "approved_at": {
            "format": "date-time",
            "type": "string"
          },
          "reviewer_operator_id": {
            "pattern": "^operator_[0-9a-f]{32}$",
            "type": "string"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "eligibility_reason": {
            "const": "REVIEW_BLOCKING_FINDINGS"
          },
          "eligible": {
            "const": false
          }
        }
      },
      "if": {
        "properties": {
          "finding_counts": {
            "properties": {
              "blocking": {
                "const": 0
              }
            },
            "required": [
              "blocking"
            ]
          }
        },
        "required": [
          "finding_counts"
        ]
      },
      "then": {
        "properties": {
          "eligibility_reason": {
            "const": "ELIGIBLE"
          },
          "eligible": {
            "const": true
          }
        }
      }
    }
  ],
  "description": "Eligibility projection whose @10 review is backed by trusted RAG receipts.",
  "properties": {
    "approval_lock_version": {
      "minimum": 1,
      "title": "Approval Lock Version",
      "type": "integer"
    },
    "approval_request_id": {
      "pattern": "^approval_[0-9a-f]{32}$",
      "title": "Approval Request Id",
      "type": "string"
    },
    "approval_state": {
      "enum": [
        "PENDING",
        "APPROVED"
      ],
      "title": "Approval State",
      "type": "string"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approved At"
    },
    "decision": {
      "const": "ready_for_human",
      "title": "Decision",
      "type": "string"
    },
    "eligibility_reason": {
      "enum": [
        "ELIGIBLE",
        "REVIEW_BLOCKING_FINDINGS"
      ],
      "title": "Eligibility Reason",
      "type": "string"
    },
    "eligible": {
      "title": "Eligible",
      "type": "boolean"
    },
    "finding_counts": {
      "$ref": "#/$defs/MockExamEligibilityFindingCounts"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/MockExamEligibilityFinding"
      },
      "maxItems": 20,
      "title": "Findings",
      "type": "array"
    },
    "operation": {
      "const": "INSPECT_MOCK_EXAM_REVIEW_ELIGIBILITY",
      "title": "Operation",
      "type": "string"
    },
    "review_artifact_id": {
      "pattern": "^artifact_[0-9a-f]{32}$",
      "title": "Review Artifact Id",
      "type": "string"
    },
    "review_artifact_revision_id": {
      "pattern": "^rev_[0-9a-f]{32}$",
      "title": "Review Artifact Revision Id",
      "type": "string"
    },
    "review_result_schema": {
      "const": "review-result@10.0",
      "title": "Review Result Schema",
      "type": "string"
    },
    "review_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Review Sha256",
      "type": "string"
    },
    "review_step_run_id": {
      "pattern": "^steprun_[0-9a-f]{32}$",
      "title": "Review Step Run Id",
      "type": "string"
    },
    "review_summary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Review Summary",
      "type": "string"
    },
    "reviewer_operator_id": {
      "anyOf": [
        {
          "pattern": "^operator_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reviewer Operator Id"
    },
    "schema_version": {
      "const": "mock-exam-review-eligibility-result/3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trusted_evidence_usage_receipts": {
      "$ref": "#/$defs/MockExamTrustedEvidenceUsageReceiptPairV1"
    },
    "workflow_id": {
      "pattern": "^workflow_[0-9a-f]{32}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "workflow_lock_version": {
      "minimum": 1,
      "title": "Workflow Lock Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "workflow_id",
    "workflow_lock_version",
    "approval_state",
    "approval_request_id",
    "approval_lock_version",
    "reviewer_operator_id",
    "approved_at",
    "review_step_run_id",
    "review_artifact_id",
    "review_artifact_revision_id",
    "review_sha256",
    "review_result_schema",
    "decision",
    "review_summary",
    "findings",
    "finding_counts",
    "eligible",
    "eligibility_reason",
    "trusted_evidence_usage_receipts"
  ],
  "title": "MockExamReviewEligibilityResultV3",
  "type": "object"
}
