    {
      "additionalProperties": false,
      "properties": {
        "error_code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
          "type": "string"
        },
        "operation": {
          "const": "CREATE_DOCUMENT_REVIEW_ANNOTATED_PDFS_V2"
        },
        "schema_version": {
          "const": "document-review-pdf-annotation-response/2.0"
        },
        "status": {
          "const": "ERROR"
        }
      },
      "required": [
