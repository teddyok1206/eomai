{
  "$defs": {
    "memberPointer": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "type": "string"
        },
        "content_length": {
          "maximum": 536870912,
          "minimum": 1,
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "application/json",
            "image/png"
          ]
        },
        "member_path": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^(?:eom://|https://eom\\.local/)[A-Za-z0-9._:/-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "sha256",
        "content_length",
        "media_type",
        "schema_ref"
      ],
      "type": "object"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "content_length": {
          "maximum": 536870912,
          "minimum": 1,
          "type": "integer"
        },
        "document_role": {
          "enum": [
            "DOCUMENT",
            "QUESTION",
            "SOLUTION"
          ]
        },
        "media_type": {
          "const": "application/pdf"
        },
        "member_path": {
          "enum": [
            "annotated/document.pdf",
            "annotated/question.pdf",
            "annotated/solution.pdf"
          ]
        },
        "schema_ref": {
          "const": "eom://schemas/document-review/annotated-pdf/1.0"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "document_role",
        "member_path",
        "sha256",
        "content_length",
        "media_type",
        "schema_ref"
      ],
      "type": "object"
    },
    "outputPointer": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "type": "string"
        },
        "content_length": {
          "maximum": 536870912,
          "minimum": 1,
          "type": "integer"
        },
        "document_role": {
          "enum": [
            "DOCUMENT",
            "QUESTION",
            "SOLUTION"
          ]
        },
        "media_type": {
          "const": "application/pdf"
        },
        "member_path": {
          "enum": [
            "annotated/document.pdf",
            "annotated/question.pdf",
            "annotated/solution.pdf"
          ]
        },
        "schema_ref": {
          "const": "eom://schemas/document-review/annotated-pdf/1.0"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "document_role",
        "member_path",
        "sha256",
        "content_length",
        "media_type",
        "schema_ref"
      ],
      "type": "object"
    }
  },
  "$id": "eom://schemas/catalog/document-review-pdf-annotation-response/2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
