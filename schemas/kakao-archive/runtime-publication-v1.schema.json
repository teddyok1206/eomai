{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/runtime-publication-v1/1.0",
  "title": "Initial fixed Kakao runtime publication, independently reviewed operator input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "install_manifest_sha256", "source_uid", "dependency_lock"],
  "properties": {
    "schema_version": {"const": "kakao-runtime-publication/1.0"},
    "install_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71},
    "source_uid": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "dependency_lock": {
      "type": "object", "additionalProperties": false,
      "required": ["browser", "remote", "pdf"],
      "properties": {
        "browser": {"$ref": "#/$defs/distributions"},
        "remote": {"$ref": "#/$defs/distributions"},
        "pdf": {"$ref": "#/$defs/distributions"}
      }
    }
  },
  "$defs": {
    "distributions": {
      "type": "object", "minProperties": 1, "maxProperties": 128,
      "propertyNames": {"type": "string", "maxLength": 100, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9.+!-]*$"}
    }
  }
}
