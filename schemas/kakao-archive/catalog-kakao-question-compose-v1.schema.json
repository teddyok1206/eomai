{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/catalog-kakao-question-compose-v1/1.0",
  "title": "API-peer atomic private question composition",
  "$defs": {
    "Request": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "actor_id", "session_id", "request_id", "authentication_time", "command", "idempotency_key"],
      "properties": {
        "operation": {"const": "COMPOSE_KAKAO_QUESTIONS"},
        "actor_id": {"type": "string", "pattern": "^operator_[0-9a-f]{32}$"},
        "session_id": {"type": "string", "pattern": "^apisession_[0-9a-f]{32}$"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$"},
        "authentication_time": {"type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"},
        "command": {"$ref": "eom://schemas/kakao-archive/question-compose-v1/1.0"},
        "idempotency_key": {"type": "string", "pattern": "^[!-~]{16,128}$"}
      }
    },
    "Success": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "status", "error_code", "result"],
      "properties": {
        "operation": {"const": "COMPOSE_KAKAO_QUESTIONS"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$"},
        "status": {"const": "OK"}, "error_code": {"type": "null"},
        "result": {"$ref": "eom://schemas/kakao-archive/question-composition-result-v1/1.0"}
      }
    },
    "Failure": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "status", "error_code", "result"],
      "properties": {
        "operation": {"const": "COMPOSE_KAKAO_QUESTIONS"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$"},
        "status": {"const": "ERROR"}, "result": {"type": "null"},
        "error_code": {"enum": [
          "KAKAO_ARCHIVE_REQUEST_INVALID", "KAKAO_ARCHIVE_PERMISSION_DENIED",
          "KAKAO_ARCHIVE_RESOURCE_NOT_FOUND", "KAKAO_ARCHIVE_PRECONDITION_FAILED",
          "KAKAO_ARCHIVE_IDEMPOTENCY_CONFLICT", "KAKAO_ARCHIVE_BINDING_RETIRED",
          "KAKAO_ARCHIVE_ROOM_RETIRED", "KAKAO_ARCHIVE_STUDENT_RETIRED",
          "KAKAO_ARCHIVE_COMPOSITION_SCOPE_INVALID", "KAKAO_ARCHIVE_QUESTION_EDIT_INVALID",
          "KAKAO_ARCHIVE_QUESTION_SELECTION_INVALID", "KAKAO_ARCHIVE_STORED_QUESTION_INVALID",
          "KAKAO_ARCHIVE_STORED_SOURCE_INVALID", "KAKAO_ARCHIVE_ADMISSION_EVIDENCE_INVALID",
          "KAKAO_ARCHIVE_SOURCE_BYTES_LIMIT", "KAKAO_ARCHIVE_RESULT_INVALID",
          "KAKAO_ARCHIVE_RESULT_TOO_LARGE", "CATALOG_APPLICATION_UNAVAILABLE",
          "CATALOG_APPLICATION_INTERNAL_ERROR"
        ]}
      }
    }
  },
  "oneOf": [{"$ref": "#/$defs/Request"}, {"$ref": "#/$defs/Success"}, {"$ref": "#/$defs/Failure"}]
}
