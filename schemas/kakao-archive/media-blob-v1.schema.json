{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/media-blob/1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "kakao-media-blob/1.0"
    },
    "source_binding_id": {
      "type": "string",
      "pattern": "^kakaobinding_[0-9a-f]{32}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    },
    "media_type": {
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ]
    },
    "width_px": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "height_px": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "pixel_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50000000
    },
    "original_bytes_preserved": {
      "const": true
    }
  },
  "required": [
    "schema_version",
    "source_binding_id",
    "source_sha256",
    "source_bytes",
    "media_type",
    "width_px",
    "height_px",
    "pixel_count",
    "original_bytes_preserved"
  ]
}
