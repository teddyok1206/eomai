      "required": [
        "operation",
        "request_id",
        "status",
        "result",
        "error_code"
      ],
      "properties": {
        "operation": {
          "enum": [
            "SAVE_KAKAO_PACKET",
            "READ_KAKAO_PACKET",
            "LIST_KAKAO_PACKETS",
            "CREATE_KAKAO_EXPORT",
            "READ_KAKAO_EXPORT",
            "LIST_KAKAO_EXPORTS",
