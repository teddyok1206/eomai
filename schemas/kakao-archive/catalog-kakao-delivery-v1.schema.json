{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/catalog-kakao-delivery-v1/1.0",
  "title": "Private packet and student PDF API messages",
  "$defs": {
    "Student": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "student_id",
        "student_display_revision_id",
        "display_name",
        "question_count"
      ],
      "properties": {
        "student_id": {
          "type": "string",
          "pattern": "^kakaostudent_[0-9a-f]{32}$"
        },
        "student_display_revision_id": {
          "type": "string",
          "pattern": "^kakaostudentrev_[0-9a-f]{32}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "question_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "PacketView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "packet",
        "questions",
        "students"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-packet-view/1.0"
        },
        "packet": {
          "$ref": "eom://schemas/kakao-archive/packet-store-v1/1.0#/$defs/Stored"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "eom://schemas/kakao-archive/question-manifest-v1/1.0#/$defs/provenance"
          }
        },
        "students": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/Student"
          }
        }
      }
    },
    "Pdf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_binding_id",
        "export_id",
        "export_revision_id",
        "media_type",
        "content_length",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "kakao-export-pdf/1.0"
        },
        "source_binding_id": {
          "type": "string",
          "pattern": "^kakaobinding_[0-9a-f]{32}$"
        },
        "export_id": {
          "type": "string",
          "pattern": "^kakaoexport_[0-9a-f]{32}$"
        },
        "export_revision_id": {
          "type": "string",
          "pattern": "^kakaoexportrev_[0-9a-f]{32}$"
        },
        "media_type": {
          "const": "application/pdf"
        },
        "content_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "actor_id",
        "session_id",
        "request_id",
        "authentication_time",
        "command",
        "idempotency_key"
      ],
      "properties": {
        "operation": {
          "const": "SAVE_KAKAO_PACKET"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^operator_[0-9a-f]{32}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^apisession_[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "authentication_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "command": {
          "oneOf": [
            {
              "$ref": "eom://schemas/kakao-archive/packet-store-v1/1.0#/$defs/Create"
            },
            {
              "$ref": "eom://schemas/kakao-archive/packet-store-v1/1.0#/$defs/Revise"
            }
          ]
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[!-~]{16,128}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "request_id",
        "status",
        "result",
        "error_code"
      ],
      "properties": {
        "operation": {
          "const": "SAVE_KAKAO_PACKET"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$",
          "minLength": 3,
          "maxLength": 128
        },
        "status": {
          "const": "OK"
        },
        "result": {
          "$ref": "eom://schemas/kakao-archive/packet-store-v1/1.0#/$defs/Mutation"
        },
        "error_code": {
          "type": "null"
        }
      }
    },
