{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/concept-authorization/1.0",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/reply"}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "kakao-concept-authorization-request/1.0"},
        "operation": {"const": "AUTHORIZE_KAKAO_CONCEPT_INPUT"},
        "workflow_id": {"type": "string", "pattern": "^workflow_[0-9a-f]{32}$"},
        "step_run_id": {"type": "string", "pattern": "^steprun_[0-9a-f]{32}$"},
        "plan_id": {"type": "string", "pattern": "^execplan_[0-9a-f]{32}$"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "work_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["schema_version", "operation", "workflow_id", "step_run_id", "plan_id", "plan_sha256", "work_sha256"]
    },
    "reply": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "kakao-concept-authorization-reply/1.0"},
        "operation": {"const": "AUTHORIZE_KAKAO_CONCEPT_INPUT"},
        "status": {"enum": ["SUCCESS", "FAILED"]},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "work_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "error_code": {"enum": [null, "KAKAO_CONCEPT_AUTHORIZATION_FAILED", "KAKAO_CONCEPT_AUTHORIZATION_UNAVAILABLE"]}
      },
      "required": ["schema_version", "operation", "status", "request_sha256", "work_sha256", "error_code"],
      "allOf": [{"if": {"properties": {"status": {"const": "SUCCESS"}}},
        "then": {"properties": {"work_sha256": {"$ref": "#/$defs/sha256"}, "error_code": {"type": "null"}}},
        "else": {"properties": {"work_sha256": {"type": "null"}, "error_code": {"type": "string"}}}
      }]
    }
  }
}
