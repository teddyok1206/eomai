{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/catalog-kakao-room-request-v1/1.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "session_id",
        "request_id",
        "authentication_time",
        "operation",
        "room_id",
        "idempotency_key",
        "command",
        "source_binding_id"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^operator_[0-9a-f]{32}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^apisession_[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$"
        },
        "authentication_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        },
        "operation": {
          "const": "COMMAND_KAKAO_ROOM"
        },
        "room_id": {
          "$ref": "eom://schemas/kakao-archive/room-directory-v1/1.0#/$defs/RoomId"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[!-~]{16,128}$"
        },
        "command": {
          "oneOf": [
            {
              "$ref": "eom://schemas/kakao-archive/room-directory-v1/1.0#/$defs/MapStudent"
            },
            {
              "$ref": "eom://schemas/kakao-archive/room-directory-v1/1.0#/$defs/UnmapStudent"
            }
          ]
        },
        "source_binding_id": {
          "type": "string",
          "pattern": "^kakaobinding_[0-9a-f]{32}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "session_id",
        "request_id",
        "authentication_time",
        "operation",
        "room_id",
        "mapping_revision_id",
        "source_binding_id"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^operator_[0-9a-f]{32}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^apisession_[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$"
        },
        "authentication_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        },
        "operation": {
          "const": "READ_KAKAO_ROOM"
        },
        "room_id": {
          "$ref": "eom://schemas/kakao-archive/room-directory-v1/1.0#/$defs/RoomId"
        },
        "mapping_revision_id": {
          "oneOf": [
            {
              "$ref": "eom://schemas/kakao-archive/room-directory-v1/1.0#/$defs/MappingRevisionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_binding_id": {
          "type": "string",
          "pattern": "^kakaobinding_[0-9a-f]{32}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "session_id",
        "request_id",
        "authentication_time",
        "operation",
        "limit",
        "cursor",
        "source_binding_id"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^operator_[0-9a-f]{32}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^apisession_[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$"
        },
        "authentication_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        },
        "operation": {
          "const": "LIST_KAKAO_ROOMS"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "oneOf": [
            {
              "$ref": "eom://schemas/kakao-archive/room-directory-v1/1.0#/$defs/RoomId"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_binding_id": {
          "type": "string",
          "pattern": "^kakaobinding_[0-9a-f]{32}$"
        }
      }
    }
  ]
}
