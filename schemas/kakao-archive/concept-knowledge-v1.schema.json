{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/kakao-archive/concept-knowledge/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "request_sha256", "plan_result", "scope", "materials", "pages"],
  "properties": {
    "schema_version": {"const": "kakao-concept-knowledge/1.0"},
    "task_id": {"$ref": "eom://schemas/kakao-archive/concept-task-store-v1/1.0#/$defs/task"},
    "request_sha256": {"$ref": "#/$defs/hash"},
    "plan_result": {"$ref": "#/$defs/result_pin"},
    "scope": {"$ref": "eom://schemas/kakao-archive/concept-task-store-v1/1.0#/$defs/scope"},
    "materials": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/material"}},
    "pages": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pointer": {"$ref": "eom://schemas/kakao-archive/question-manifest-v1/1.0#/$defs/pointer"},
    "result_pin": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_id", "step_run_id", "job_id", "artifact_id", "artifact_revision_id", "sha256"],
      "properties": {
        "workflow_id": {"type": "string", "pattern": "^workflow_[0-9a-f]{32}$"},
        "step_run_id": {"type": "string", "pattern": "^steprun_[0-9a-f]{32}$"},
        "job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "material": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "analysis_run_id", "source", "node_ids", "anchor_ids", "accepted_result", "normalized_markdown", "analysis_text_sha256"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "analysis_run_id": {"type": "string", "pattern": "^analysisrun_[0-9a-f]{32}$"},
        "source": {
          "allOf": [
            {"anyOf": [
              {"$ref": "eom://schemas/knowledge/knowledge-analysis-types/2.0#/$defs/contentIntakeSource"},
              {"$ref": "eom://schemas/knowledge/knowledge-analysis-types/3.0#/$defs/documentRevisionSource"},
              {"$ref": "eom://schemas/knowledge/knowledge-analysis-types/4.0#/$defs/documentRevisionSource"},
              {"$ref": "eom://schemas/knowledge/educational-document-source/5.0"}
            ]},
            {"properties": {"source_class": {"const": "TEXTBOOK"}}}
          ]
        },
        "node_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "anchor_ids": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "accepted_result": {
          "allOf": [
            {"$ref": "#/$defs/pointer"},
            {"properties": {"media_type": {"const": "application/json"}}}
          ]
        },
        "normalized_markdown": {
          "allOf": [
            {"$ref": "#/$defs/pointer"},
            {"properties": {"media_type": {"const": "text/markdown"}}}
          ]
        },
        "analysis_text_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_key", "physical_page", "original"],
      "properties": {
        "evidence_key": {"enum": ["E1", "E2", "E3"]},
        "physical_page": {"type": "integer", "minimum": 1, "maximum": 100000},
        "original": {
          "allOf": [
            {"$ref": "#/$defs/pointer"},
            {"properties": {
              "schema_ref": {"const": "eom://schemas/educational-document/page-image/1.0"},
              "media_type": {"const": "image/png"}
            }}
          ]
        }
      }
    }
  }
}
