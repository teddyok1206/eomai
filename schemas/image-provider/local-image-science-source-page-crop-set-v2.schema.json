{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-science-source-page-crop-set/1.1",
  "title": "Reviewed literal supplemental original-page crop set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "crop_set_id",
    "crop_set_revision_id",
