{
  "$defs": {
    "artifact_member": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "media_type",
        "schema_ref",
        "sha256"
      ],
      "type": "object"
    },
    "bounding_box": {
      "additionalProperties": false,
      "properties": {
        "bottom": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "left": {
          "maximum": 9999,
          "minimum": 0,
          "type": "integer"
        },
        "right": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "top": {
          "maximum": 9999,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bottom",
        "left",
        "right",
        "top"
      ],
      "type": "object"
    },
    "member": {
      "additionalProperties": false,
      "properties": {
        "caption_en": {
          "maxLength": 240,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ,.'()/_:-]{2,239}$",
          "type": "string"
        },
        "caption_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "crop_bounding_box": {
          "$ref": "#/$defs/bounding_box"
        },
        "document_id": {
          "pattern": "^sciencedoc_[0-9a-f]{32}$",
          "type": "string"
        },
        "exam_group_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "height_px": {
          "maximum": 10000,
          "minimum": 32,
          "type": "integer"
        },
        "media_type": {
          "const": "image/png"
        },
        "member_path": {
          "pattern": "^crops/imgscivislineartcrop_[0-9a-f]{32}\\.png$",
          "type": "string"
        },
        "object_family": {
          "enum": [
            "ANIMAL",
            "HUMAN",
            "LAB_EQUIPMENT",
            "NATURAL_SPECIMEN",
            "PLANT",
            "SAFETY_EQUIPMENT",
            "VEHICLE",
            "OTHER_OBJECT"
          ]
        },
        "parent_candidate_id": {
          "pattern": "^imgsciviscandidate_[0-9a-f]{32}$",
          "type": "string"
        },
        "parent_candidate_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "partition": {
          "enum": [
            "HOLDOUT",
            "TRAIN",
            "VALIDATION"
          ]
        },
        "perceptual_hash": {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "physical_page": {
          "maximum": 512,
          "minimum": 1,
          "type": "integer"
        },
        "sample_id": {
          "pattern": "^imgscivislineartcrop_[0-9a-f]{32}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 67108864,
          "minimum": 64,
          "type": "integer"
        },
        "width_px": {
          "maximum": 10000,
          "minimum": 32,
          "type": "integer"
        }
      },
      "required": [
        "caption_en",
        "caption_sha256",
        "crop_bounding_box",
        "document_id",
        "exam_group_sha256",
        "height_px",
        "media_type",
        "member_path",
        "object_family",
        "parent_candidate_id",
        "parent_candidate_sha256",
        "partition",
        "perceptual_hash",
        "physical_page",
        "sample_id",
        "sha256",
        "size_bytes",
        "width_px"
      ],
      "type": "object"
    }
  },
  "$id": "eom://schemas/image-provider/local-image-science-object-line-art-crop-set/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "pattern": "^imgsciviscampaign_[0-9a-f]{32}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$",
      "type": "string"
    },
    "created_by": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:@-]+$",
      "type": "string"
    },
    "crop_set_id": {
      "pattern": "^imgscivislineartcropset_[0-9a-f]{32}$",
      "type": "string"
    },
    "crop_set_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "line_art_suitability_review": {
      "$ref": "#/$defs/artifact_member"
    },
    "line_art_suitability_review_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "member_policy": {
      "additionalProperties": false,
      "properties": {
        "max_members_per_document": {
          "const": 3
        },
        "max_members_per_exam_group": {
          "const": 4
        },
        "partition_policy": {
          "const": "PINNED_SOURCE_GROUP_V1"
        }
      },
      "required": [
        "max_members_per_document",
        "max_members_per_exam_group",
        "partition_policy"
      ],
      "type": "object"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/member"
      },
      "maxItems": 96,
      "minItems": 24,
      "type": "array"
    },
    "pattern_inventory": {
      "$ref": "#/$defs/artifact_member"
    },
    "pattern_inventory_semantic_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "local-image-science-object-line-art-crop-set/1.0"
    },
    "training_authorization": {
      "$ref": "#/$defs/artifact_member"
    }
  },
  "required": [
    "campaign_id",
    "created_at",
    "created_by",
    "crop_set_id",
    "crop_set_sha256",
    "line_art_suitability_review",
    "line_art_suitability_review_sha256",
    "member_policy",
    "members",
    "pattern_inventory",
    "pattern_inventory_semantic_sha256",
    "schema_version",
    "training_authorization"
  ],
  "title": "LocalImageScienceObjectLineArtCropSet",
  "type": "object"
}
