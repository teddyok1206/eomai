  "$defs": {
    "PhotoBaselineReuse": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "prior_plan": {
          "allOf": [
            {
              "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6"
                },
                "member_path": {
                  "const": "manifests/sdxl-photo-style-plan.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        },
        "prior_result": {
          "allOf": [
            {
              "$ref": "eom://schemas/image-provider/local-image-sdxl-photo-style-plan/1.6#/$defs/ImageEvaluationArtifactMember"
            },
            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-photo-style-result/1.6"
                },
                "member_path": {
                  "const": "manifests/sdxl-photo-style-result.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        },
