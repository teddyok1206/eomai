            {
              "properties": {
                "schema_ref": {
                  "const": "eom://schemas/image-provider/local-image-sdxl-canny-reference-command/1.3"
                },
                "member_path": {
                  "const": "manifests/sdxl-canny-reference-command.json"
                },
                "media_type": {
                  "const": "application/json"
                }
              }
            }
          ]
        }
      },
      "required": [
        "prior_plan",
        "prior_result",
        "prior_configuration"
      ]
    }
