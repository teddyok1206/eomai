{
  "$defs": {
    "ImageEvaluationArtifactMember": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Member Path",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "title": "ImageEvaluationArtifactMember",
      "type": "object"
    },
    "LocalImageAssessmentLineArtPostprocessV2": {
      "additionalProperties": false,
      "description": "Successor cleanup with a pinned final microdetail-suppression pass.",
      "properties": {
        "border_foreground_ratio_max": {
          "default": 0.01,
          "maximum": 0.01,
          "minimum": 0.01,
          "title": "Border Foreground Ratio Max",
          "type": "number"
        },
        "cleanup_component_max_pixels": {
          "const": 48,
          "default": 48,
          "title": "Cleanup Component Max Pixels",
          "type": "integer"
        },
        "component_count_max": {
          "const": 256,
          "default": 256,
          "title": "Component Count Max",
          "type": "integer"
        },
        "contract": {
          "const": "local-image-assessment-line-art-postprocess/2.0",
          "default": "local-image-assessment-line-art-postprocess/2.0",
          "title": "Contract",
          "type": "string"
        },
        "edge_dark_threshold": {
          "const": 92,
          "default": 92,
          "title": "Edge Dark Threshold",
          "type": "integer"
        },
        "edge_density_max": {
          "default": 0.3,
          "maximum": 0.3,
          "minimum": 0.3,
          "title": "Edge Density Max",
          "type": "number"
        },
        "edge_density_min": {
          "default": 0.01,
          "maximum": 0.01,
          "minimum": 0.01,
          "title": "Edge Density Min",
          "type": "number"
        },
        "edge_mid_threshold": {
          "const": 48,
          "default": 48,
          "title": "Edge Mid Threshold",
          "type": "integer"
        },
        "final_dark_threshold": {
          "const": 80,
          "default": 80,
          "title": "Final Dark Threshold",
          "type": "integer"
        },
        "final_median_filter_size": {
          "const": 5,
          "default": 5,
          "title": "Final Median Filter Size",
          "type": "integer"
        },
        "final_mid_threshold": {
          "const": 235,
          "default": 235,
          "title": "Final Mid Threshold",
          "type": "integer"
        },
        "final_output_tones": {
          "default": [
            32,
            96,
            255
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": 32,
              "type": "integer"
            },
            {
              "const": 96,
              "type": "integer"
            },
            {
              "const": 255,
              "type": "integer"
            }
          ],
          "title": "Final Output Tones",
          "type": "array"
        },
        "fine_detail_fraction_max": {
          "default": 0.1,
          "maximum": 0.1,
          "minimum": 0.1,
          "title": "Fine Detail Fraction Max",
          "type": "number"
        },
        "foreground_luma_threshold": {
          "const": 245,
          "default": 245,
          "title": "Foreground Luma Threshold",
          "type": "integer"
        },
        "foreground_ratio_max": {
          "default": 0.25,
          "maximum": 0.25,
          "minimum": 0.25,
          "title": "Foreground Ratio Max",
          "type": "number"
        },
        "foreground_ratio_min": {
          "default": 0.01,
          "maximum": 0.01,
          "minimum": 0.01,
          "title": "Foreground Ratio Min",
          "type": "number"
        },
        "horizontal_border_px": {
          "const": 40,
          "default": 40,
          "title": "Horizontal Border Px",
          "type": "integer"
        },
        "mask_blur_radius": {
          "const": 12,
          "default": 12,
          "title": "Mask Blur Radius",
          "type": "integer"
        },
        "mask_contract_size": {
          "const": 17,
          "default": 17,
          "title": "Mask Contract Size",
          "type": "integer"
        },
        "mask_expand_size": {
          "const": 25,
          "default": 25,
          "title": "Mask Expand Size",
          "type": "integer"
        },
        "mask_luma_threshold": {
          "const": 224,
          "default": 224,
          "title": "Mask Luma Threshold",
          "type": "integer"
        },
        "median_filter_size": {
          "const": 3,
          "default": 3,
          "title": "Median Filter Size",
          "type": "integer"
        },
        "microdetail_blur_radius": {
          "default": 0.85,
          "maximum": 0.85,
          "minimum": 0.85,
          "title": "Microdetail Blur Radius",
          "type": "number"
        },
        "output_tones": {
          "default": [
            48,
            160,
            255
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": 48,
              "type": "integer"
            },
            {
              "const": 160,
              "type": "integer"
            },
            {
              "const": 255,
              "type": "integer"
            }
          ],
          "title": "Output Tones",
          "type": "array"
        },
        "raw_member": {
          "const": "generated-background-raw.png",
          "default": "generated-background-raw.png",
          "title": "Raw Member",
          "type": "string"
        },
        "tiny_component_fraction_max": {
          "default": 0.05,
          "maximum": 0.05,
          "minimum": 0.05,
          "title": "Tiny Component Fraction Max",
          "type": "number"
        },
        "vertical_border_px": {
          "const": 24,
          "default": 24,
          "title": "Vertical Border Px",
          "type": "integer"
        }
      },
      "title": "LocalImageAssessmentLineArtPostprocessV2",
      "type": "object"
    },
    "SdxlPublicationBudget": {
      "additionalProperties": false,
      "properties": {
        "maximum_duration_ms": {
          "maximum": 90000,
          "minimum": 1000,
          "title": "Maximum Duration Ms",
          "type": "integer"
        },
        "maximum_input_png_bytes": {
          "const": 16777216,
          "default": 16777216,
          "title": "Maximum Input Png Bytes",
          "type": "integer"
        },
        "maximum_outputs": {
          "const": 6,
          "default": 6,
          "title": "Maximum Outputs",
          "type": "integer"
        }
      },
      "required": [
        "maximum_duration_ms"
      ],
      "title": "SdxlPublicationBudget",
      "type": "object"
    }
  },
  "$id": "eom://schemas/image-provider/local-image-sdxl-publication-comparison-command/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_policy": {
      "const": "FORBIDDEN",
      "title": "Activation Policy",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/SdxlPublicationBudget"
    },
    "case_relation": {
      "const": "REVIEWED_TRAIN_TARGET_NOT_HOLDOUT",
      "title": "Case Relation",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "pillow_version": {
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Pillow Version",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "postprocess": {
      "$ref": "#/$defs/LocalImageAssessmentLineArtPostprocessV2"
    },
    "purpose": {
      "const": "EVALUATION_ONLY_PINNED_CPU_PUBLICATION",
      "title": "Purpose",
      "type": "string"
    },
    "run_id": {
      "pattern": "^imgsdxlpublicationrun_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "local-image-sdxl-publication-comparison-command/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_command": {
      "$ref": "#/$defs/ImageEvaluationArtifactMember"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "source_result": {
      "$ref": "#/$defs/ImageEvaluationArtifactMember"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_commit",
    "created_at",
    "purpose",
    "activation_policy",
    "case_relation",
    "source_command",
    "source_result",
    "postprocess",
    "policy_sha256",
    "pillow_version",
    "budget",
    "command_sha256"
  ],
  "title": "LocalImageSdxlPublicationComparisonCommand",
  "type": "object"
}
