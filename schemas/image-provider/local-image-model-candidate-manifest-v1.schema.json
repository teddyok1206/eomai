{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-model-candidate-manifest/1.0",
  "title": "EOM evaluation-only local image model candidate manifest v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 68719476736},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["relative_path", "size_bytes", "sha256"]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo_id": {"const": "black-forest-labs/FLUX.2-klein-base-4B"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_url": {"const": "https://huggingface.co/black-forest-labs/FLUX.2-klein-base-4B"},
        "license_id": {"const": "Apache-2.0"}
      },
      "required": ["repo_id", "revision", "source_url", "license_id"]
    }
  },
  "properties": {
    "schema_version": {"const": "local-image-model-candidate-manifest/1.0"},
    "model_id": {"type": "string", "pattern": "^imgmodel_[0-9a-f]{32}$"},
    "model_revision_id": {"type": "string", "pattern": "^imgmodelrev_[0-9a-f]{32}$"},
    "provider_family": {"const": "diffusers-flux2-klein-base-4b"},
    "runtime_contract_version": {"const": "eom-local-image-candidate-runner/1.0"},
    "state": {"const": "EVALUATION_ONLY"},
    "activation_policy": {"const": "FORBIDDEN"},
    "upstream": {"$ref": "#/$defs/upstream"},
    "files": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/file"}},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:@-]+$"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": ["schema_version", "model_id", "model_revision_id", "provider_family", "runtime_contract_version", "state", "activation_policy", "upstream", "files", "created_at", "created_by", "manifest_sha256"]
}
