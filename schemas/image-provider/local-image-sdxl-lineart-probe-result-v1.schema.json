{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-sdxl-lineart-probe-result/1.0",
  "title": "Measured SDXL lineart evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "command_sha256",
    "model",
    "status",
    "error_code",
    "runtime",
    "conditionings",
    "outputs",
    "started_at",
    "completed_at",
    "duration_ms",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-sdxl-lineart-probe-result/1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^imgsdxlproberun_[0-9a-f]{32}$"
    },
    "command_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "error_code": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "SDXL_PROBE_INPUT_INVALID",
            "SDXL_PROBE_MODEL_INVALID",
            "SDXL_PROBE_HASH_MISMATCH",
            "SDXL_PROBE_GPU_UNAVAILABLE",
            "SDXL_PROBE_OOM",
            "SDXL_PROBE_EXEC_FAILED",
            "SDXL_PROBE_OUTPUT_INVALID",
            "SDXL_PROBE_BUDGET_EXCEEDED",
            "SDXL_PROBE_PROMPT_TRUNCATED"
          ]
        }
      ]
    },
    "runtime": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "eom://schemas/image-provider/local-image-generation-receipt/1.0#/properties/runtime"
        }
      ]
    },
    "conditionings": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/conditioning"
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_revision_id",
        "manifest_sha256",
        "provider_family",
        "runtime_contract_version"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^imgmodel_[0-9a-f]{32}$"
        },
        "model_revision_id": {
          "type": "string",
          "pattern": "^imgmodelrev_[0-9a-f]{32}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider_family": {
          "const": "diffusers-sdxl-t2i-lineart"
        },
        "runtime_contract_version": {
          "const": "eom-local-image-sdxl-lineart-runner/1.0"
        }
      }
    },
    "conditioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "member_path",
        "sha256",
        "width_px",
        "height_px"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^imgsdxlcase_[0-9a-f]{32}$"
        },
        "member_path": {
          "type": "string",
          "pattern": "^outputs/conditioning/imgsdxlcase_[0-9a-f]{32}\\.png$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "width_px": {
          "const": 832
        },
        "height_px": {
          "const": 512
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "seed",
        "member_path",
        "sha256",
        "raw_member_path",
        "raw_sha256",
        "width_px",
        "height_px",
        "duration_ms",
        "peak_gpu_memory_bytes"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^imgsdxlcase_[0-9a-f]{32}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "member_path": {
          "type": "string",
          "pattern": "^outputs/final/imgsdxlcase_[0-9a-f]{32}-[0-9]{10}\\.png$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "raw_member_path": {
          "type": "string",
          "pattern": "^outputs/raw/imgsdxlcase_[0-9a-f]{32}-[0-9]{10}\\.png$"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "width_px": {
          "const": 800
        },
        "height_px": {
          "const": 500
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "peak_gpu_memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        }
      }
    }
  }
}
