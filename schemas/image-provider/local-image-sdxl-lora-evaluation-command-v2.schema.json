{
  "$defs": {
    "ImageEvaluationArtifactMember": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Member Path",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "title": "ImageEvaluationArtifactMember",
      "type": "object"
    },
    "SdxlLoraEvaluationPin": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^imgadapter_[0-9a-f]{32}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_manifest": {
          "$ref": "#/$defs/ImageEvaluationArtifactMember"
        },
        "adapter_manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Adapter Manifest Sha256",
          "type": "string"
        },
        "adapter_revision_id": {
          "pattern": "^imgadapterrev_[0-9a-f]{32}$",
          "title": "Adapter Revision Id",
          "type": "string"
        },
        "adapter_strength": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Adapter Strength",
          "type": "number"
        },
        "baseline_command": {
          "$ref": "#/$defs/ImageEvaluationArtifactMember"
        },
        "training_command": {
          "$ref": "#/$defs/ImageEvaluationArtifactMember"
        },
        "training_result": {
          "$ref": "#/$defs/ImageEvaluationArtifactMember"
        }
      },
      "required": [
        "baseline_command",
        "training_command",
        "training_result",
        "adapter_manifest",
        "adapter_id",
        "adapter_revision_id",
        "adapter_manifest_sha256",
        "adapter_strength"
      ],
      "title": "SdxlLoraEvaluationPin",
      "type": "object"
    }
  },
  "$id": "eom://schemas/image-provider/local-image-sdxl-lora-evaluation-command/1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_policy": {
      "const": "FORBIDDEN",
      "title": "Activation Policy",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evaluation": {
      "$ref": "#/$defs/SdxlLoraEvaluationPin"
    },
    "purpose": {
      "const": "EVALUATION_ONLY_MATCHED_SDXL_LORA",
      "title": "Purpose",
      "type": "string"
    },
    "run_id": {
      "pattern": "^imgsdxlloraevalrun_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "local-image-sdxl-lora-evaluation-command/1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "case_relation": {
      "const": "LEGACY_TRAIN_REFERENCE_DIAGNOSTIC_NOT_HOLDOUT",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "source_commit",
    "evaluation",
    "purpose",
    "activation_policy",
    "command_sha256",
    "case_relation"
  ],
  "title": "LocalImageSdxlLoraEvaluationCommand",
  "type": "object"
}
