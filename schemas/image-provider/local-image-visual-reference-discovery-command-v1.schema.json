{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-visual-reference-discovery-command/1.0",
  "title": "EOM local image visual reference discovery command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "workflow_id",
    "image_step_run_id",
    "image_job_id",
    "visual_ordinal",
    "drawing_sha256",
    "subject",
    "query_terms",
    "candidate_limit",
    "observed_at",
    "timeout_seconds",
    "command_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-visual-reference-discovery-command/1.0"
    },
    "command_id": {
      "type": "string",
      "pattern": "^imgrefdiscover_[0-9a-f]{32}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^workflow_[0-9a-f]{32}$"
    },
    "image_step_run_id": {
      "type": "string",
      "pattern": "^steprun_[0-9a-f]{32}$"
    },
    "image_job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{32}$"
    },
    "visual_ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "drawing_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ,.'()/_-]{2,179}$"
    },
    "query_terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9 .()/_-]{0,79}$"
      }
    },
    "candidate_limit": {
      "const": 5
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 180
    },
    "command_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
