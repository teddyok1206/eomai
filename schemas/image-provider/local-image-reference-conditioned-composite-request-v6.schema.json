{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-reference-conditioned-composite-request/6.0",
  "title": "EOM adaptive-reference assessment-line-art request v6",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "reference_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_revision_id",
        "bundle_manifest",
        "primary_reference_id",
        "reference_member"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^imgrefbundle_[0-9a-f]{32}$"
        },
        "bundle_revision_id": {
          "type": "string",
          "pattern": "^imgrefbundlerev_[0-9a-f]{32}$"
        },
        "bundle_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "artifact_revision_id",
            "member_path",
            "schema_ref",
            "media_type",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^artifact_[0-9a-f]{32}$"
            },
            "artifact_revision_id": {
              "type": "string",
              "pattern": "^rev_[0-9a-f]{32}$"
            },
            "member_path": {
              "type": "string",
              "pattern": "^manifests/visual-reference-bundle\\.json$"
            },
            "schema_ref": {
              "const": "eom://schemas/image-provider/local-image-visual-reference-bundle/1.0"
            },
            "media_type": {
              "const": "application/json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        },
        "primary_reference_id": {
          "type": "string",
          "pattern": "^imgref_[0-9a-f]{32}$"
        },
        "reference_member": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "artifact_revision_id",
            "member_path",
            "schema_ref",
            "media_type",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^artifact_[0-9a-f]{32}$"
            },
            "artifact_revision_id": {
              "type": "string",
              "pattern": "^rev_[0-9a-f]{32}$"
            },
            "member_path": {
              "type": "string",
              "pattern": "^references/primary\\.png$"
            },
            "schema_ref": {
              "const": "eom://schemas/image-provider/normalized-visual-reference/1.0"
            },
            "media_type": {
              "const": "image/png"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        }
      }
    },
    "conditioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "strength",
        "fit_policy",
        "simplification"
      ],
      "properties": {
        "contract": {
          "const": "sdxl-morphology-img2img/2.2"
        },
        "strength": {
          "const": 0.35
        },
        "fit_policy": {
          "const": "EXACT_NORMALIZED_CANVAS"
        },
        "simplification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "output_member",
            "color_policy",
            "denoise_policy",
            "tone_policy",
            "foreground_luma_threshold",
            "border_width_px",
            "foreground_ratio_min",
            "foreground_ratio_max",
            "border_foreground_ratio_max",
            "line_art_channel_spread_max",
            "line_art_near_monochrome_ratio_min",
            "line_art_white_background_ratio_min",
            "line_art_dark_luma_threshold",
            "line_art_dark_foreground_fraction_min"
          ],
          "properties": {
            "contract": {
              "const": "local-image-reference-simplification/1.2"
            },
            "output_member": {
              "const": "reference-conditioning.png"
            },
            "color_policy": {
              "const": "GRAYSCALE_WHITE_BACKGROUND"
            },
            "denoise_policy": {
              "const": "ADAPTIVE_PRESERVE_LINE_ART_OR_REDUCE_PHOTO"
            },
            "tone_policy": {
              "const": "SIX_LEVEL_LIGHT_TONE_CONTOUR"
            },
            "foreground_luma_threshold": {
              "const": 245
            },
            "border_width_px": {
              "const": 24
            },
            "foreground_ratio_min": {
              "const": 0.005
            },
            "foreground_ratio_max": {
              "const": 0.8
            },
            "border_foreground_ratio_max": {
              "const": 0.12
            },
            "line_art_channel_spread_max": {
              "const": 8
            },
            "line_art_near_monochrome_ratio_min": {
              "const": 0.98
            },
            "line_art_white_background_ratio_min": {
              "const": 0.7
            },
            "line_art_dark_luma_threshold": {
              "const": 96
            },
            "line_art_dark_foreground_fraction_min": {
              "const": 0.5
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "composite_request",
    "visual_reference",
    "conditioning",
    "postprocess",
    "morphology_retention_ratio_min",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-reference-conditioned-composite-request/6.0"
    },
    "composite_request": {
      "$ref": "eom://schemas/image-provider/local-image-composite-request/1.0"
    },
    "visual_reference": {
      "$ref": "#/$defs/reference_pointer"
    },
    "conditioning": {
      "$ref": "#/$defs/conditioning"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "postprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "raw_member",
        "median_filter_size",
        "mask_blur_radius",
        "mask_luma_threshold",
        "mask_expand_size",
        "mask_contract_size",
        "edge_mid_threshold",
        "edge_dark_threshold",
        "output_tones",
        "horizontal_border_px",
        "vertical_border_px",
        "foreground_luma_threshold",
        "foreground_ratio_min",
        "foreground_ratio_max",
        "border_foreground_ratio_max",
        "edge_density_min",
        "edge_density_max"
      ],
      "properties": {
        "contract": {
          "const": "local-image-assessment-line-art-postprocess/1.0"
        },
        "raw_member": {
          "const": "generated-background-raw.png"
        },
        "median_filter_size": {
          "const": 3
        },
        "mask_blur_radius": {
          "const": 12
        },
        "mask_luma_threshold": {
          "const": 224
        },
        "mask_expand_size": {
          "const": 25
        },
        "mask_contract_size": {
          "const": 17
        },
        "edge_mid_threshold": {
          "const": 48
        },
        "edge_dark_threshold": {
          "const": 92
        },
        "output_tones": {
          "type": "array",
          "prefixItems": [
            {
              "const": 48
            },
            {
              "const": 160
            },
            {
              "const": 255
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "horizontal_border_px": {
          "const": 40
        },
        "vertical_border_px": {
          "const": 8
        },
        "foreground_luma_threshold": {
          "const": 245
        },
        "foreground_ratio_min": {
          "const": 0.01
        },
        "foreground_ratio_max": {
          "const": 0.25
        },
        "border_foreground_ratio_max": {
          "const": 0.01
        },
        "edge_density_min": {
          "const": 0.01
        },
        "edge_density_max": {
          "const": 0.3
        }
      }
    },
    "morphology_retention_ratio_min": {
      "const": 0.25
    }
  }
}
