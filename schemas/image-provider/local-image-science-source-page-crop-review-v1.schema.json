{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-science-source-page-crop-review/1.0",
  "title": "Reviewed literal original-page illustration selections",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "created_at",
    "created_by",
    "source_commit",
    "basis_crop_set",
    "training_authorization",
    "selections",
    "policy",
    "pillow_version",
    "activation_policy",
    "review_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-science-source-page-crop-review/1.0"
    },
    "review_id": {
      "type": "string",
      "pattern": "^imgsourcecropreview_[0-9a-f]{32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:@-]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "basis_crop_set": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/ImageEvaluationArtifactMember"
    },
    "training_authorization": {
      "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/ImageEvaluationArtifactMember"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/Selection"
      }
    },
    "policy": {
      "const": "REVIEWED_LITERAL_ORIGINAL_PAGE_PIXELS/1.0"
    },
    "activation_policy": {
      "const": "FORBIDDEN"
    },
    "pillow_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "review_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_id",
        "candidate_id",
        "parent_candidate_sha256",
        "document_id",
        "physical_page",
        "source_document",
        "source_page",
        "page_width_px",
        "page_height_px",
        "page_render_dpi",
        "pixel_box",
        "exam_group_sha256",
        "partition",
        "depiction_key",
        "caption_en",
        "caption_sha256",
        "expression"
      ],
      "properties": {
        "selection_id": {
          "type": "string",
          "pattern": "^imgsourcecrop_[0-9a-f]{32}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^imgsciviscandidate_[0-9a-f]{32}$"
        },
        "parent_candidate_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^sciencedoc_[0-9a-f]{32}$"
        },
        "physical_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "source_document": {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/ImageEvaluationArtifactMember"
        },
        "source_page": {
          "$ref": "eom://schemas/image-provider/local-image-sdxl-lora-micro-command/1.0#/$defs/ImageEvaluationArtifactMember"
        },
        "page_width_px": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "page_height_px": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "page_render_dpi": {
          "const": 144
        },
        "pixel_box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "exam_group_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "partition": {
          "enum": [
            "TRAIN",
            "VALIDATION",
            "HOLDOUT"
          ]
        },
        "depiction_key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "caption_en": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ,.'()/_-]{2,179}$"
        },
        "caption_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "expression": {
          "enum": [
            "CLEAN_CONTOUR",
            "RESTRAINED_TONE",
            "FINE_HATCHING"
          ]
        }
      }
    }
  }
}
