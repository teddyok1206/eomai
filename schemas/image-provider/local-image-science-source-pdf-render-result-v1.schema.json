{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-science-source-pdf-render-result/1.0",
  "title": "Native PDF renderer output values bound to one exact request",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_sha256", "members", "activation_policy"],
  "properties": {
    "schema_version": {"const": "local-image-science-source-pdf-render-result/1.0"},
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "members": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "eom://schemas/image-provider/local-image-science-source-page-crop-set/1.0#/$defs/Member"}},
    "activation_policy": {"const": "FORBIDDEN"}
  }
}
