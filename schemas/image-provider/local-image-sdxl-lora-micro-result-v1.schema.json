{
  "$defs": {
    "LocalImageLoraAdapterFile": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "enum": [
            "adapter_config.json",
            "adapter_model.safetensors"
          ],
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "size_bytes",
        "sha256"
      ],
      "title": "LocalImageLoraAdapterFile",
      "type": "object"
    },
    "LocalImageLoraTrainingRuntime": {
      "additionalProperties": false,
      "properties": {
        "accelerate_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Accelerate Version",
          "type": "string"
        },
        "bitsandbytes_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Bitsandbytes Version",
          "type": "string"
        },
        "compute_capability": {
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Compute Capability",
          "type": "string"
        },
        "cuda_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Cuda Version",
          "type": "string"
        },
        "diffusers_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Diffusers Version",
          "type": "string"
        },
        "gpu_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Gpu Name",
          "type": "string"
        },
        "peak_gpu_memory_bytes": {
          "minimum": 1,
          "title": "Peak Gpu Memory Bytes",
          "type": "integer"
        },
        "peft_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Peft Version",
          "type": "string"
        },
        "python_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "torch_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Torch Version",
          "type": "string"
        },
        "transformers_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Transformers Version",
          "type": "string"
        }
      },
      "required": [
        "python_version",
        "torch_version",
        "diffusers_version",
        "transformers_version",
        "accelerate_version",
        "peft_version",
        "bitsandbytes_version",
        "cuda_version",
        "gpu_name",
        "compute_capability",
        "peak_gpu_memory_bytes"
      ],
      "title": "LocalImageLoraTrainingRuntime",
      "type": "object"
    },
    "LocalImageSdxlLoraMicroAdapterManifest": {
      "additionalProperties": false,
      "properties": {
        "activation_policy": {
          "const": "FORBIDDEN",
          "title": "Activation Policy",
          "type": "string"
        },
        "adapter_id": {
          "pattern": "^imgadapter_[0-9a-f]{32}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_revision_id": {
          "pattern": "^imgadapterrev_[0-9a-f]{32}$",
          "title": "Adapter Revision Id",
          "type": "string"
        },
        "base_model": {
          "$ref": "#/$defs/SdxlLineartStackPointer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/LocalImageLoraAdapterFile"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Files",
          "type": "array"
        },
        "manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "sample_set_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sample Set Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "local-image-sdxl-lora-micro-adapter-manifest/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "const": "EVALUATION_ONLY",
          "title": "State",
          "type": "string"
        },
        "training_command_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Training Command Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "adapter_id",
        "adapter_revision_id",
        "state",
        "activation_policy",
        "base_model",
        "training_command_sha256",
        "sample_set_sha256",
        "files",
        "created_at",
        "manifest_sha256"
      ],
      "title": "LocalImageSdxlLoraMicroAdapterManifest",
      "type": "object"
    },
    "SdxlLineartStackPointer": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "model_id": {
          "pattern": "^imgmodel_[0-9a-f]{32}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_revision_id": {
          "pattern": "^imgmodelrev_[0-9a-f]{32}$",
          "title": "Model Revision Id",
          "type": "string"
        },
        "provider_family": {
          "const": "diffusers-sdxl-t2i-lineart",
          "title": "Provider Family",
          "type": "string"
        },
        "runtime_contract_version": {
          "const": "eom-local-image-sdxl-lineart-runner/1.0",
          "title": "Runtime Contract Version",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "model_revision_id",
        "manifest_sha256",
        "provider_family",
        "runtime_contract_version"
      ],
      "title": "SdxlLineartStackPointer",
      "type": "object"
    },
    "SdxlLoraMicroRealizedSample": {
      "additionalProperties": false,
      "properties": {
        "realized_crop_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Realized Crop Sha256",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^imgscivislineartcrop_[0-9a-f]{32}$",
          "title": "Sample Id",
          "type": "string"
        },
        "source_crop_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Crop Sha256",
          "type": "string"
        },
        "training_caption_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Training Caption Sha256",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "source_crop_sha256",
        "realized_crop_sha256",
        "training_caption_sha256"
      ],
      "title": "SdxlLoraMicroRealizedSample",
      "type": "object"
    }
  },
  "$id": "eom://schemas/image-provider/local-image-sdxl-lora-micro-result/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalImageSdxlLoraMicroAdapterManifest"
        },
        {
          "type": "null"
        }
      ]
    },
    "command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "completed_steps": {
      "maximum": 200,
      "minimum": 0,
      "title": "Completed Steps",
      "type": "integer"
    },
    "duration_ms": {
      "maximum": 3660000,
      "minimum": 1,
      "title": "Duration Ms",
      "type": "integer"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^IMAGE_TRAINING_[A-Z0-9_]{3,96}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "final_loss": {
      "anyOf": [
        {
          "maximum": 1000000,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Final Loss"
    },
    "realized_samples": {
      "items": {
        "$ref": "#/$defs/SdxlLoraMicroRealizedSample"
      },
      "maxItems": 16,
      "title": "Realized Samples",
      "type": "array"
    },
    "result_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "runtime": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalImageLoraTrainingRuntime"
        },
        {
          "type": "null"
        }
      ]
    },
    "sample_set_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sample Set Sha256"
    },
    "schema_version": {
      "const": "local-image-sdxl-lora-micro-result/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "Status",
      "type": "string"
    },
    "training_run_id": {
      "pattern": "^imgsdxlmicrotrainrun_[0-9a-f]{32}$",
      "title": "Training Run Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "training_run_id",
    "command_sha256",
    "status",
    "error_code",
    "adapter_manifest",
    "realized_samples",
    "sample_set_sha256",
    "runtime",
    "completed_steps",
    "final_loss",
    "started_at",
    "completed_at",
    "duration_ms",
    "result_sha256"
  ],
  "title": "LocalImageSdxlLoraMicroResult",
  "type": "object"
}
