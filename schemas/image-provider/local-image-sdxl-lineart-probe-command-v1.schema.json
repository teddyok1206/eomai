{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-sdxl-lineart-probe-command/1.0",
  "title": "Bounded evaluation-only SDXL lineart command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "model",
    "prompt_policy",
    "style_track",
    "conditioning_policy",
    "inference_steps",
    "guidance_scale",
    "adapter_conditioning_scale",
    "budget",
    "cases",
    "command_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-sdxl-lineart-probe-command/1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^imgsdxlproberun_[0-9a-f]{32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "prompt_policy": {
      "$ref": "#/$defs/pointer"
    },
    "style_track": {
      "enum": [
        "OBJECT_LINE_ART",
        "RASTER_TEXTURE_SCENE"
      ]
    },
    "conditioning_policy": {
      "const": "FIT_GRAYSCALE_INVERT_832X512/1.0"
    },
    "inference_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "guidance_scale": {
      "type": "number",
      "minimum": 0,
      "maximum": 12
    },
    "adapter_conditioning_scale": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.5
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "command_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "artifact_revision_id": {
          "type": "string",
          "pattern": "^rev_[0-9a-f]{32}$"
        },
        "member_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*/$).+$"
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_revision_id",
        "manifest_sha256",
        "provider_family",
        "runtime_contract_version"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^imgmodel_[0-9a-f]{32}$"
        },
        "model_revision_id": {
          "type": "string",
          "pattern": "^imgmodelrev_[0-9a-f]{32}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider_family": {
          "const": "diffusers-sdxl-t2i-lineart"
        },
        "runtime_contract_version": {
          "const": "eom-local-image-sdxl-lineart-runner/1.0"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "depiction_key",
        "reference_image",
        "reference_width_px",
        "reference_height_px",
        "staged_member_path",
        "prompt_en",
        "prompt_sha256",
        "negative_prompt_en",
        "negative_prompt_sha256",
        "seeds"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^imgsdxlcase_[0-9a-f]{32}$"
        },
        "depiction_key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "reference_image": {
          "$ref": "#/$defs/pointer"
        },
        "reference_width_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "reference_height_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "staged_member_path": {
          "type": "string",
          "pattern": "^inputs/imgsdxlcase_[0-9a-f]{32}\\.png$"
        },
        "prompt_en": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1200,
          "pattern": "^[ -~]+$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "negative_prompt_en": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1200,
          "pattern": "^[ -~]+$"
        },
        "negative_prompt_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_duration_ms",
        "maximum_peak_gpu_memory_bytes"
      ],
      "properties": {
        "maximum_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800000
        },
        "maximum_peak_gpu_memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        }
      }
    }
  }
}
