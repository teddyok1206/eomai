{
  "$defs": {
    "LocalImageRuntime": {
      "additionalProperties": false,
      "properties": {
        "compute_capability": {
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Compute Capability",
          "type": "string"
        },
        "cuda_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Cuda Version",
          "type": "string"
        },
        "diffusers_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Diffusers Version",
          "type": "string"
        },
        "gpu_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Gpu Name",
          "type": "string"
        },
        "peak_gpu_memory_bytes": {
          "minimum": 1,
          "title": "Peak Gpu Memory Bytes",
          "type": "integer"
        },
        "provider_version": {
          "const": "eom-local-image-provider/1.0",
          "default": "eom-local-image-provider/1.0",
          "title": "Provider Version",
          "type": "string"
        },
        "python_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "torch_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Torch Version",
          "type": "string"
        },
        "transformers_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Transformers Version",
          "type": "string"
        }
      },
      "required": [
        "python_version",
        "torch_version",
        "diffusers_version",
        "transformers_version",
        "cuda_version",
        "gpu_name",
        "compute_capability",
        "peak_gpu_memory_bytes"
      ],
      "title": "LocalImageRuntime",
      "type": "object"
    },
    "SdxlLearnedComparisonOutput": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "enum": [
            "BASE",
            "LORA"
          ],
          "title": "Arm",
          "type": "string"
        },
        "case_id": {
          "pattern": "^imgsdxlcase_[0-9a-f]{32}$",
          "title": "Case Id",
          "type": "string"
        },
        "conditioning_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Conditioning Sha256",
          "type": "string"
        },
        "duration_ms": {
          "maximum": 1800000,
          "minimum": 1,
          "title": "Duration Ms",
          "type": "integer"
        },
        "height_px": {
          "const": 500,
          "title": "Height Px",
          "type": "integer"
        },
        "member_path": {
          "pattern": "^outputs/(?:base|lora)/final/imgsdxlcase_[0-9a-f]{32}-[0-9]{10}\\.png$",
          "title": "Member Path",
          "type": "string"
        },
        "peak_gpu_memory_bytes": {
          "maximum": 17179869184,
          "minimum": 1,
          "title": "Peak Gpu Memory Bytes",
          "type": "integer"
        },
        "raw_member_path": {
          "pattern": "^outputs/(?:base|lora)/raw/imgsdxlcase_[0-9a-f]{32}-[0-9]{10}\\.png$",
          "title": "Raw Member Path",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "raw_size_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Raw Size Bytes",
          "type": "integer"
        },
        "reference_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Reference Sha256",
          "type": "string"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "width_px": {
          "const": 800,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "arm",
        "case_id",
        "seed",
        "reference_sha256",
        "conditioning_sha256",
        "member_path",
        "sha256",
        "size_bytes",
        "raw_member_path",
        "raw_sha256",
        "raw_size_bytes",
        "width_px",
        "height_px",
        "duration_ms",
        "peak_gpu_memory_bytes"
      ],
      "title": "SdxlLearnedComparisonOutput",
      "type": "object"
    },
    "SdxlLineartStackPointer": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "model_id": {
          "pattern": "^imgmodel_[0-9a-f]{32}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_revision_id": {
          "pattern": "^imgmodelrev_[0-9a-f]{32}$",
          "title": "Model Revision Id",
          "type": "string"
        },
        "provider_family": {
          "const": "diffusers-sdxl-t2i-lineart",
          "title": "Provider Family",
          "type": "string"
        },
        "runtime_contract_version": {
          "const": "eom-local-image-sdxl-lineart-runner/1.0",
          "title": "Runtime Contract Version",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "model_revision_id",
        "manifest_sha256",
        "provider_family",
        "runtime_contract_version"
      ],
      "title": "SdxlLineartStackPointer",
      "type": "object"
    }
  },
  "$id": "eom://schemas/image-provider/local-image-sdxl-learned-comparison-result/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Baseline Command Sha256",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "conditioning_policy": {
      "const": "PINNED_LEARNED_FINE_INVERTED/1.0",
      "title": "Conditioning Policy",
      "type": "string"
    },
    "duration_ms": {
      "maximum": 3600000,
      "minimum": 1,
      "title": "Duration Ms",
      "type": "integer"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "SDXL_PROBE_INPUT_INVALID",
            "SDXL_PROBE_MODEL_INVALID",
            "SDXL_PROBE_HASH_MISMATCH",
            "SDXL_PROBE_GPU_UNAVAILABLE",
            "SDXL_PROBE_OOM",
            "SDXL_PROBE_EXEC_FAILED",
            "SDXL_PROBE_OUTPUT_INVALID",
            "SDXL_PROBE_BUDGET_EXCEEDED",
            "SDXL_PROBE_PROMPT_TRUNCATED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "extraction_result_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Extraction Result Sha256",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/SdxlLineartStackPointer"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/SdxlLearnedComparisonOutput"
      },
      "maxItems": 6,
      "title": "Outputs",
      "type": "array"
    },
    "result_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^imgsdxllearnedrun_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalImageRuntime"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "local-image-sdxl-learned-comparison-result/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "command_sha256",
    "baseline_command_sha256",
    "extraction_result_sha256",
    "model",
    "conditioning_policy",
    "status",
    "error_code",
    "runtime",
    "outputs",
    "started_at",
    "completed_at",
    "duration_ms",
    "result_sha256"
  ],
  "title": "LocalImageSdxlLearnedComparisonResult",
  "type": "object"
}
