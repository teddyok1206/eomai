{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/image-provider/local-image-visual-reference-publication-receipt/1.0",
  "title": "EOM visual reference publication receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "image_result_artifact",
    "entries",
    "published_at",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "local-image-visual-reference-publication-receipt/1.0"
    },
    "image_result_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_artifact_id",
        "revision_id",
        "content_hash",
        "result_schema"
      ],
      "properties": {
        "logical_artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^rev_[0-9a-f]{32}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "result_schema": {
          "const": "image-result@12.0"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "visual_ordinal",
          "drawing_sha256",
          "subject_sha256",
          "discovery_command_sha256",
          "discovery_result_sha256",
          "intent_sha256",
          "acquisition_command_sha256",
          "acquisition_result_sha256",
          "visual_reference"
        ],
        "properties": {
          "visual_ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "drawing_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "subject_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "discovery_command_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "discovery_result_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "intent_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "acquisition_command_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "acquisition_result_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "visual_reference": {
            "$ref": "eom://schemas/image-provider/local-image-reference-conditioned-composite-receipt/2.0#/$defs/reference_pointer"
          }
        }
      }
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

