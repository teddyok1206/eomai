{
  "$defs": {
    "ImageEvaluationArtifactMember": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Member Path",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "title": "ImageEvaluationArtifactMember",
      "type": "object"
    },
    "SdxlCannyComparisonBudget": {
      "additionalProperties": false,
      "properties": {
        "maximum_duration_ms": {
          "maximum": 1800000,
          "minimum": 1,
          "title": "Maximum Duration Ms",
          "type": "integer"
        },
        "maximum_outputs": {
          "const": 6,
          "default": 6,
          "title": "Maximum Outputs",
          "type": "integer"
        },
        "maximum_peak_gpu_memory_bytes": {
          "maximum": 17179869184,
          "minimum": 1,
          "title": "Maximum Peak Gpu Memory Bytes",
          "type": "integer"
        }
      },
      "required": [
        "maximum_duration_ms",
        "maximum_peak_gpu_memory_bytes"
      ],
      "title": "SdxlCannyComparisonBudget",
      "type": "object"
    },
    "SdxlCannyControlParameters": {
      "additionalProperties": false,
      "properties": {
        "conditioning_scale": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 1.0,
          "title": "Conditioning Scale",
          "type": "number"
        },
        "guidance_end": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 1.0,
          "title": "Guidance End",
          "type": "number"
        },
        "guidance_start": {
          "default": 0.0,
          "maximum": 0.0,
          "minimum": 0.0,
          "title": "Guidance Start",
          "type": "number"
        },
        "resource_profile": {
          "const": "ALL_GPU_FP16_NO_OFFLOAD",
          "default": "ALL_GPU_FP16_NO_OFFLOAD",
          "title": "Resource Profile",
          "type": "string"
        }
      },
      "title": "SdxlCannyControlParameters",
      "type": "object"
    },
    "SdxlCannyControllerPointer": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "model_id": {
          "pattern": "^imgmodel_[0-9a-f]{32}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_revision_id": {
          "pattern": "^imgmodelrev_[0-9a-f]{32}$",
          "title": "Model Revision Id",
          "type": "string"
        },
        "provider_family": {
          "const": "diffusers-sdxl-controlnet-canny",
          "default": "diffusers-sdxl-controlnet-canny",
          "title": "Provider Family",
          "type": "string"
        },
        "runtime_contract_version": {
          "const": "eom-local-image-sdxl-canny-runner/1.0",
          "default": "eom-local-image-sdxl-canny-runner/1.0",
          "title": "Runtime Contract Version",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "model_revision_id",
        "manifest_sha256"
      ],
      "title": "SdxlCannyControllerPointer",
      "type": "object"
    }
  },
  "$id": "eom://schemas/image-provider/local-image-sdxl-canny-comparison-command/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_policy": {
      "const": "FORBIDDEN",
      "title": "Activation Policy",
      "type": "string"
    },
    "baseline_result": {
      "$ref": "#/$defs/ImageEvaluationArtifactMember"
    },
    "budget": {
      "$ref": "#/$defs/SdxlCannyComparisonBudget"
    },
    "case_relation": {
      "const": "REVIEWED_TRAIN_TARGET_NOT_HOLDOUT",
      "title": "Case Relation",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "conditioning_command": {
      "$ref": "#/$defs/ImageEvaluationArtifactMember"
    },
    "conditioning_result": {
      "$ref": "#/$defs/ImageEvaluationArtifactMember"
    },
    "control": {
      "$ref": "#/$defs/SdxlCannyControlParameters"
    },
    "controller": {
      "$ref": "#/$defs/SdxlCannyControllerPointer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "detail_review": {
      "$ref": "#/$defs/ImageEvaluationArtifactMember"
    },
    "purpose": {
      "const": "EVALUATION_ONLY_MATCHED_CANNY_CONTROLNET",
      "title": "Purpose",
      "type": "string"
    },
    "run_id": {
      "pattern": "^imgsdxlcannycmprun_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "local-image-sdxl-canny-comparison-command/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Commit",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_commit",
    "created_at",
    "purpose",
    "activation_policy",
    "case_relation",
    "conditioning_command",
    "conditioning_result",
    "detail_review",
    "baseline_result",
    "controller",
    "control",
    "budget",
    "command_sha256"
  ],
  "title": "LocalImageSdxlCannyComparisonCommand",
  "type": "object"
}
