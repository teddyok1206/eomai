            "②",
            "③",
            "④",
            "⑤"
          ],
          "title": "Number",
          "type": "string"
        },
        "raw_line": {
          "maxLength": 2020,
          "minLength": 9,
          "pattern": "^정답 : [①②③④⑤] \\([^\\r\\n]+\\)$",
          "title": "Raw Line",
          "type": "string"
        },
        "statement_labels": {
          "items": {
            "enum": [
