{
  "$defs": {
    "ArtifactMemberPointer": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Member Path",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "title": "ArtifactMemberPointer",
      "type": "object"
    },
    "AssessmentItemContent": {
      "additionalProperties": false,
      "description": "Canonical small value artifact pinned by an Item Revision component.",
      "properties": {
        "body": {
          "items": {
            "discriminator": {
              "mapping": {
                "equation": "#/$defs/EquationBlock",
                "image": "#/$defs/ImageBlock",
                "paragraph": "#/$defs/ParagraphBlock",
                "statement_set": "#/$defs/StatementSetBlock",
                "table": "#/$defs/TableBlock"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ParagraphBlock"
              },
              {
                "$ref": "#/$defs/EquationBlock"
              },
              {
                "$ref": "#/$defs/TableBlock"
              },
              {
                "$ref": "#/$defs/ImageBlock"
              },
              {
                "$ref": "#/$defs/StatementSetBlock"
              }
            ]
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Body",
          "type": "array"
        },
        "interaction": {
          "discriminator": {
            "mapping": {
              "constructed_response": "#/$defs/ConstructedResponseInteraction",
              "single_choice": "#/$defs/SingleChoiceInteraction"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SingleChoiceInteraction"
            },
            {
              "$ref": "#/$defs/ConstructedResponseInteraction"
            }
          ],
          "title": "Interaction"
        },
        "locale": {
          "pattern": "^[a-z]{2}-[A-Z]{2}$",
          "title": "Locale",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "$ref": "#/$defs/ItemScore"
        },
        "solution": {
          "$ref": "#/$defs/ItemSolution"
        },
        "title": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "locale",
        "title",
        "body",
        "interaction",
        "solution",
        "score"
      ],
      "title": "AssessmentItemContent",
      "type": "object"
    },
    "AssessmentItemContentContract": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssessmentItemContent"
        },
        {
          "$ref": "#/$defs/AssessmentItemContentV2"
        },
        {
          "$ref": "#/$defs/AssessmentItemContentV3"
        }
      ]
    },
    "AssessmentItemContentV2": {
      "additionalProperties": false,
      "description": "Content-team-first canonical item; HWPX is one deterministic projection of it.",
      "properties": {
        "answer": {
          "$ref": "#/$defs/ContentTeamAnswer"
        },
        "authoring_prompt_sha256": {
          "const": "sha256:62f245320a4776a2ee3dcd273fb1180b6f3c431a45d2504d125816102f017435",
          "default": "sha256:62f245320a4776a2ee3dcd273fb1180b6f3c431a45d2504d125816102f017435",
          "title": "Authoring Prompt Sha256",
          "type": "string"
        },
        "bottom_stem": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Bottom Stem",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/ContentTeamChoice"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Choices",
          "type": "array"
        },
        "equation_sources": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Equation Sources",
          "type": "array"
        },
        "explanations": {
          "$ref": "#/$defs/ContentTeamExplanationSections"
        },
        "handoff_archive_sha256": {
          "const": "sha256:dc1c9e254a31fc235824eddbb366a5fac52a4d03e3b334bd5e325fb52391ea91",
          "default": "sha256:dc1c9e254a31fc235824eddbb366a5fac52a4d03e3b334bd5e325fb52391ea91",
          "title": "Handoff Archive Sha256",
          "type": "string"
        },
        "inquiry": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentTeamInquiry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "item_number": {
          "maximum": 999,
          "minimum": 1,
          "title": "Item Number",
          "type": "integer"
        },
        "labeled_blocks": {
          "items": {
            "$ref": "#/$defs/ContentTeamLabeledBlock"
          },
          "maxItems": 2,
          "title": "Labeled Blocks",
          "type": "array"
        },
        "renderer_profile": {
          "const": "content-team-hwp-question-editor-v1",
          "default": "content-team-hwp-question-editor-v1",
          "title": "Renderer Profile",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score_display": {
          "enum": [
            "2",
            "2.5",
            "3"
          ],
          "title": "Score Display",
          "type": "string"
        },
        "statements": {
          "anyOf": [
            {
              "maxItems": 0,
              "minItems": 0,
              "type": "array"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "$ref": "#/$defs/ContentTeamStatement"
                },
                {
                  "$ref": "#/$defs/ContentTeamStatement"
                },
                {
                  "$ref": "#/$defs/ContentTeamStatement"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Statements"
        },
        "stem": {
          "maxLength": 24000,
          "minLength": 1,
          "title": "Stem",
          "type": "string"
        },
        "visual_layout": {
          "enum": [
            "NONE",
            "IMAGE_ONLY",
            "TABLE_ONLY",
            "IMAGE_TABLE",
            "TABLE_IMAGE",
            "IMAGE_IMAGE",
            "TABLE_TABLE",
            "INQUIRY_BOX"
          ],
          "title": "Visual Layout",
          "type": "string"
        },
        "visuals": {
          "items": {
            "discriminator": {
              "mapping": {
                "IMAGE": "#/$defs/ContentTeamImageSlot",
                "TABLE": "#/$defs/ContentTeamTable"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ContentTeamTable"
              },
              {
                "$ref": "#/$defs/ContentTeamImageSlot"
              }
            ]
          },
          "maxItems": 2,
          "title": "Visuals",
          "type": "array"
        }
      },
      "required": [
        "item_number",
        "score_display",
        "stem",
        "bottom_stem",
        "labeled_blocks",
        "visuals",
        "visual_layout",
        "statements",
        "choices",
        "answer",
        "explanations",
        "equation_sources"
      ],
      "title": "AssessmentItemContentV2",
      "type": "object"
    },
