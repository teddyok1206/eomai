{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/legacy-usage/assessment-assembly-manifest/1.0",
  "title": "Assessment Assembly Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "assessment_assembly_revision_id", "assessment_assembly_id",
    "revision_number", "previous_revision_id", "assessment_form_id", "placements",
    "total_points_milli", "revision_state", "manifest_sha256", "created_at", "created_by"
  ],
  "properties": {
    "schema_version": {"const": "assessment-assembly-manifest/1.0"},
    "assessment_assembly_revision_id": {"type": "string", "pattern": "^assemblyrev_[0-9a-f]{32}$"},
    "assessment_assembly_id": {"type": "string", "pattern": "^assembly_[0-9a-f]{32}$"},
    "revision_number": {"type": "integer", "minimum": 1},
    "previous_revision_id": {
      "oneOf": [
        {"type": "string", "pattern": "^assemblyrev_[0-9a-f]{32}$"}, {"type": "null"}
      ]
    },
    "assessment_form_id": {"type": "string", "pattern": "^form_[0-9a-f]{32}$"},
    "placements": {
      "type": "array", "minItems": 1, "maxItems": 100000,
      "items": {"$ref": "#/$defs/placement"}
    },
    "total_points_milli": {"type": "integer", "minimum": 0},
    "revision_state": {"const": "RELEASED"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": [
        "placement_id", "section_key", "section_ordinal", "position", "display_number",
        "item_id", "item_revision_id", "item_manifest_sha256", "points_milli", "usage_role",
        "source_usage_plan_id"
      ],
      "properties": {
        "placement_id": {"type": "string", "pattern": "^placement_[0-9a-f]{32}$"},
        "section_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
        "section_ordinal": {"type": "integer", "minimum": 1, "maximum": 10000},
        "position": {"type": "integer", "minimum": 1, "maximum": 100000},
        "display_number": {"type": "string", "minLength": 1, "maxLength": 32},
        "item_id": {"type": "string", "pattern": "^item_[0-9a-f]{32}$"},
        "item_revision_id": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
        "item_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "points_milli": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "usage_role": {"enum": ["PRIMARY", "PRACTICE", "REVIEW", "EXAMPLE", "OTHER_REVIEWED"]},
        "source_usage_plan_id": {
          "oneOf": [
            {"type": "string", "pattern": "^usageplan_[0-9a-f]{32}$"}, {"type": "null"}
          ]
        }
      }
    }
  }
}
