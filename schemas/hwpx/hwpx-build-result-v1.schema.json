{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eom.local/schemas/hwpx/hwpx-build-result-v1.schema.json",
  "title": "EOM HWPX Build Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build_id", "template_id", "template_revision_id", "input_sha256", "renderer_version", "status", "output_file", "output_sha256", "package_manifest_file", "validation_report_file", "semantic_report_file", "warnings", "errors", "started_at", "completed_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "build_id": {"type": "string", "pattern": "^hwpxbuild_[a-f0-9]{32}$"},
    "template_id": {"type": "string", "pattern": "^hwpxtpl_[a-f0-9]{32}$"},
    "template_revision_id": {"type": "string", "pattern": "^hwpxrev_[a-f0-9]{32}$"},
    "input_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "renderer_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["SUCCEEDED", "FAILED", "PENDING_REFERENCE_TEMPLATE", "PENDING_MANUAL_HANCOM_VALIDATION"]},
    "output_file": {"type": ["string", "null"], "pattern": "^output/placeholder_item_combined\\.hwpx$"},
    "output_sha256": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "package_manifest_file": {"type": ["string", "null"], "pattern": "^output/package-manifest\\.json$"},
    "validation_report_file": {"type": ["string", "null"], "pattern": "^output/structural-validation\\.json$"},
    "semantic_report_file": {"type": ["string", "null"], "pattern": "^output/semantic-validation\\.json$"},
    "warnings": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 256}},
    "errors": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 256}},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
