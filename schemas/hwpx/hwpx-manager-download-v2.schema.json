{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/hwpx/manager-download/2.0",
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "operation", "build_id"],
      "properties": {
        "schema_version": {"const": "2.0"},
        "operation": {"const": "download-curated"},
        "build_id": {"type": "string", "pattern": "^hwpxbuild_[a-f0-9]{32}$"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status"],
      "properties": {
        "schema_version": {"const": "2.0"},
        "status": {"enum": ["OK", "ERROR"]},
        "filename": {"type": ["string", "null"], "minLength": 6, "maxLength": 150, "pattern": "^[A-Za-z0-9_.-]+\\.hwpx$"},
        "content_length": {"type": ["integer", "null"], "minimum": 1, "maximum": 268435456},
        "sha256": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "error_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,79}$"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "OK"}}},
        "then": {"required": ["filename", "content_length", "sha256"], "properties": {"filename": {"type": "string"}, "content_length": {"type": "integer"}, "sha256": {"type": "string"}, "error_code": {"type": "null"}}},
        "else": {"required": ["error_code"], "properties": {"filename": {"type": "null"}, "content_length": {"type": "null"}, "sha256": {"type": "null"}, "error_code": {"type": "string"}}}
      }]
    }
  }
}
