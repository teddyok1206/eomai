{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/hwpx/content-team-output-acceptance/1.0",
  "title": "ContentTeamOutputAcceptanceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "output_sha256", "package_entry_count", "uncompressed_bytes", "section_names", "items", "acceptance_sha256"],
  "properties": {
    "schema_version": {"const": "content-team-output-acceptance/1.0"},
    "output_sha256": {"$ref": "#/$defs/Sha256"},
    "package_entry_count": {"type": "integer", "minimum": 6, "maximum": 2000},
    "uncompressed_bytes": {"type": "integer", "minimum": 1, "maximum": 209715200},
    "section_names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^Contents/section(?:0|[1-9][0-9]{0,2})\\.xml$"}
    },
    "items": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/ItemAcceptance"}},
    "acceptance_sha256": {"$ref": "#/$defs/Sha256"}
  },
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "TableFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_ordinal", "label", "column_count", "row_count", "table_sha256"],
      "properties": {
        "visual_ordinal": {"type": "integer", "minimum": 0, "maximum": 1},
        "label": {"enum": ["", "(가)", "(나)"]},
        "column_count": {"type": "integer", "minimum": 2, "maximum": 5},
        "row_count": {"type": "integer", "minimum": 2, "maximum": 101},
        "table_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "ImageFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_ordinal", "label", "sha256"],
      "properties": {
        "visual_ordinal": {"type": "integer", "minimum": 0, "maximum": 1},
        "label": {"enum": ["", "(가)", "(나)"]},
        "sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "ItemAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "item_revision_id", "visual_layout", "tables", "images", "equation_count", "labeled_block_count", "semantic_text_sha256", "structure_sha256"],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 200},
        "item_revision_id": {"type": "string", "pattern": "^itemrev_[a-z0-9]{8,55}$"},
        "visual_layout": {"enum": ["NONE", "IMAGE_ONLY", "TABLE_ONLY", "IMAGE_TABLE", "TABLE_IMAGE", "IMAGE_IMAGE", "TABLE_TABLE", "INQUIRY_BOX"]},
        "tables": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/TableFingerprint"}},
        "images": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/ImageFingerprint"}},
        "equation_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "labeled_block_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "semantic_text_sha256": {"$ref": "#/$defs/Sha256"},
        "structure_sha256": {"$ref": "#/$defs/Sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"visual_layout": {"enum": ["NONE", "INQUIRY_BOX"]}}, "required": ["visual_layout"]},
          "then": {"properties": {"tables": {"maxItems": 0}, "images": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"visual_layout": {"const": "IMAGE_ONLY"}}, "required": ["visual_layout"]},
          "then": {
            "properties": {
              "tables": {"maxItems": 0},
              "images": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{"allOf": [{"$ref": "#/$defs/ImageFingerprint"}, {"properties": {"visual_ordinal": {"const": 0}, "label": {"const": ""}}}]}]
              }
            }
          }
        },
        {
          "if": {"properties": {"visual_layout": {"const": "TABLE_ONLY"}}, "required": ["visual_layout"]},
          "then": {
            "properties": {
              "tables": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{"allOf": [{"$ref": "#/$defs/TableFingerprint"}, {"properties": {"visual_ordinal": {"const": 0}, "label": {"const": ""}}}]}]
              },
              "images": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"visual_layout": {"const": "IMAGE_TABLE"}}, "required": ["visual_layout"]},
          "then": {
            "properties": {
              "tables": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{"allOf": [{"$ref": "#/$defs/TableFingerprint"}, {"properties": {"visual_ordinal": {"const": 1}, "label": {"const": ""}}}]}]
              },
              "images": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{"allOf": [{"$ref": "#/$defs/ImageFingerprint"}, {"properties": {"visual_ordinal": {"const": 0}, "label": {"const": ""}}}]}]
              }
            }
          }
        },
        {
          "if": {"properties": {"visual_layout": {"const": "TABLE_IMAGE"}}, "required": ["visual_layout"]},
          "then": {
            "properties": {
              "tables": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{"allOf": [{"$ref": "#/$defs/TableFingerprint"}, {"properties": {"visual_ordinal": {"const": 0}, "label": {"const": ""}}}]}]
              },
              "images": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{"allOf": [{"$ref": "#/$defs/ImageFingerprint"}, {"properties": {"visual_ordinal": {"const": 1}, "label": {"const": ""}}}]}]
              }
            }
          }
        },
        {
          "if": {"properties": {"visual_layout": {"const": "IMAGE_IMAGE"}}, "required": ["visual_layout"]},
          "then": {
            "properties": {
              "tables": {"maxItems": 0},
              "images": {
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {"allOf": [{"$ref": "#/$defs/ImageFingerprint"}, {"properties": {"visual_ordinal": {"const": 0}, "label": {"const": "(가)"}}}]},
                  {"allOf": [{"$ref": "#/$defs/ImageFingerprint"}, {"properties": {"visual_ordinal": {"const": 1}, "label": {"const": "(나)"}}}]}
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"visual_layout": {"const": "TABLE_TABLE"}}, "required": ["visual_layout"]},
          "then": {
            "properties": {
              "tables": {
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {"allOf": [{"$ref": "#/$defs/TableFingerprint"}, {"properties": {"visual_ordinal": {"const": 0}, "label": {"const": "(가)"}}}]},
                  {"allOf": [{"$ref": "#/$defs/TableFingerprint"}, {"properties": {"visual_ordinal": {"const": 1}, "label": {"const": "(나)"}}}]}
                ]
              },
              "images": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
