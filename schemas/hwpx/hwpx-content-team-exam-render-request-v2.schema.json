{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/hwpx/content-team-exam-render-request/2.0",
  "title": "Content-team mock-exam HWPX render request V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "renderer_profile", "build_id", "assembly", "handoff", "items", "output_directory"],
  "properties": {
    "schema_version": {"const": "content-team-exam-render-request/2.0"},
    "renderer_profile": {"const": "content-team-hwp-question-editor-exam-v1"},
    "build_id": {"type": "string", "pattern": "^hwpxbuild_[a-f0-9]{32}$"},
    "assembly": {"$ref": "#/$defs/assembly"},
    "handoff": {"$ref": "#/$defs/handoff"},
    "items": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/item"}},
    "output_directory": {"const": "output"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "handoffMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "sha256", "size"],
      "properties": {
        "purpose": {"enum": ["automation-template", "equation-prototypes", "visual-slots-left-right", "visual-slots-two-tables", "labeled-data-condition", "table-2-column", "table-3-column", "table-3-column-long-equation", "table-4-column", "inquiry-experiment-box"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 26214400}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_revision_id", "archive_sha256", "archive_file", "entry_count", "uncompressed_bytes", "profile_sha256", "members"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact_[a-f0-9]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[a-f0-9]{32}$"},
        "archive_sha256": {"const": "sha256:dc1c9e254a31fc235824eddbb366a5fac52a4d03e3b334bd5e325fb52391ea91"},
        "archive_file": {"const": "input/handoff.zip"},
        "entry_count": {"const": 606},
        "uncompressed_bytes": {"const": 49280719},
        "profile_sha256": {"const": "sha256:ce08671ad433026ec51e68ddfc6a4d7ffe33ae8a792c1791dfa26b9b62e78863"},
        "members": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/handoffMember"}}
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assembly_schema_version", "assessment_assembly_id", "assessment_assembly_revision_id", "manifest_sha256", "plan_sha256", "policy_revision_id", "policy_sha256", "graph_snapshot_revision_id", "graph_snapshot_sha256"],
      "properties": {
        "assembly_schema_version": {"const": "mock-exam-assembly-manifest/2.0"},
        "assessment_assembly_id": {"type": "string", "pattern": "^assembly_[a-f0-9]{32}$"},
        "assessment_assembly_revision_id": {"type": "string", "pattern": "^assemblyrev_[a-f0-9]{32}$"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "policy_revision_id": {"type": "string", "pattern": "^assemblypolicyrev_[a-f0-9]{32}$"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "graph_snapshot_revision_id": {"type": "string", "pattern": "^graphrev_[a-f0-9]{32}$"},
        "graph_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_ordinal", "label", "artifact_id", "artifact_revision_id", "artifact_member", "sha256", "schema_ref", "media_type", "width_px", "height_px", "alt_text", "file_name"],
      "properties": {
        "visual_ordinal": {"type": "integer", "minimum": 0, "maximum": 1},
        "label": {"enum": ["", "(가)", "(나)"]},
        "artifact_id": {"type": "string", "pattern": "^artifact_[a-f0-9]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[a-f0-9]{32}$"},
        "artifact_member": {"const": "generated-stimulus.png"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_ref": {"const": "eom://schemas/generated-item/stimulus-png/3.0"},
        "media_type": {"const": "image/png"},
        "width_px": {"const": 800},
        "height_px": {"const": 500},
        "alt_text": {"type": "string", "minLength": 1, "maxLength": 1000},
        "file_name": {"type": "string", "pattern": "^input/items/[0-9]{3}/visual-[01]\\.png$"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "display_number", "points_milli", "placement_id", "item_id", "item_revision_id", "item_manifest_sha256", "source_artifact_id", "source_artifact_revision_id", "source_json_sha256", "source_markdown_sha256", "json_file", "markdown_file", "images"],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 200},
        "display_number": {"type": "string", "pattern": "^[1-9][0-9]{0,2}$"},
        "points_milli": {"enum": [1500, 2000, 2500]},
        "placement_id": {"type": "string", "pattern": "^placement_[a-f0-9]{32}$"},
        "item_id": {"type": "string", "pattern": "^item_[a-f0-9]{32}$"},
        "item_revision_id": {"type": "string", "pattern": "^itemrev_[a-f0-9]{32}$"},
        "item_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_artifact_id": {"type": "string", "pattern": "^artifact_[a-f0-9]{32}$"},
        "source_artifact_revision_id": {"type": "string", "pattern": "^rev_[a-f0-9]{32}$"},
        "source_json_sha256": {"$ref": "#/$defs/sha256"},
        "source_markdown_sha256": {"$ref": "#/$defs/sha256"},
        "json_file": {"type": "string", "pattern": "^input/items/[0-9]{3}/item-content\\.json$"},
        "markdown_file": {"type": "string", "pattern": "^input/items/[0-9]{3}/content-team-item\\.md$"},
        "images": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/image"}}
      }
    }
  }
}
