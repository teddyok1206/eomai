{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/hwpx/curated-build-input/2.0",
  "title": "Pinned curated HWPX build inputs",
  "description": "Metadata-only input snapshot. No content bodies, image bytes, worker authority or filesystem paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assembly_id",
    "assembly_revision_id",
    "assembly_manifest_sha256",
    "profile",
    "renderer_version",
    "handoff",
    "converter",
    "placements"
  ],
  "properties": {
    "schema_version": {
      "const": "curated-hwpx-build-input/2.0"
    },
    "assembly_id": {
      "type": "string",
      "pattern": "^assembly_[0-9a-f]{32}$"
    },
    "assembly_revision_id": {
      "type": "string",
      "pattern": "^assemblyrev_[0-9a-f]{32}$"
    },
    "assembly_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile": {
      "const": "CURATED_EDITABLE_OCCURRENCES_V2"
    },
    "renderer_version": {
      "const": "2.0.0"
    },
    "handoff": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentTeamHandoffSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "converter": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConverterSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/NativeDocument"
          },
          {
            "$ref": "#/$defs/RegisteredItem"
          }
        ]
      }
    }
  },
  "$defs": {
    "ArtifactMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{32}$"
        },
        "artifact_revision_id": {
          "type": "string",
          "pattern": "^rev_[0-9a-f]{32}$"
        },
        "member_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\u0000]+$"
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "NativeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "position",
        "source_format",
        "document",
        "size_bytes",
        "placement_id"
      ],
      "properties": {
        "kind": {
          "const": "NATIVE_DOCUMENT"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "source_format": {
          "enum": [
            "HWP",
            "HWPX"
          ]
        },
        "document": {
          "$ref": "#/$defs/ArtifactMember"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "placement_id": {
          "type": "string",
          "pattern": "^placement_[0-9a-f]{32}$"
        }
      }
    },
    "RegisteredItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "position",
        "item_id",
        "item_revision_id",
        "item_manifest_sha256",
        "source_content",
        "display_content",
        "recovery_manifest",
        "editorial_markdown",
        "placement_id"
      ],
      "properties": {
        "kind": {
          "const": "REGISTERED_ITEM"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "item_id": {
          "type": "string",
          "pattern": "^item_[0-9a-f]{32}$"
        },
        "item_revision_id": {
          "type": "string",
          "pattern": "^itemrev_[0-9a-f]{32}$"
        },
        "item_manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_content": {
          "$ref": "#/$defs/ArtifactMember"
        },
        "display_content": {
          "$ref": "#/$defs/ArtifactMember"
        },
        "recovery_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactMember"
            },
            {
              "type": "null"
            }
          ]
        },
        "editorial_markdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactMember"
            },
            {
              "type": "null"
            }
          ]
        },
        "placement_id": {
          "type": "string",
          "pattern": "^placement_[0-9a-f]{32}$"
        }
      }
    },
    "ConverterSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "source_commit",
        "bundle_sha256"
      ],
      "properties": {
        "profile": {
          "const": "HWP2HWPX_NATIVE_V1"
        },
        "source_commit": {
          "const": "62d95b980a4e3a6766877dd3fb6f7f45f4afcf3d"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "ContentTeamHandoffSnapshot": {
      "additionalProperties": false,
      "description": "Immutable source/archive identity used by every renderer attempt.",
      "properties": {
        "archive_file": {
          "const": "input/handoff.zip",
          "title": "Archive File",
          "type": "string"
        },
        "archive_sha256": {
          "const": "sha256:dc1c9e254a31fc235824eddbb366a5fac52a4d03e3b334bd5e325fb52391ea91",
          "title": "Archive Sha256",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^artifact_[a-f0-9]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[a-f0-9]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "entry_count": {
          "const": 606,
          "title": "Entry Count",
          "type": "integer"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/ContentTeamHandoffMember"
          },
          "maxItems": 10,
          "minItems": 10,
          "title": "Members",
          "type": "array"
        },
        "profile_sha256": {
          "const": "sha256:ce08671ad433026ec51e68ddfc6a4d7ffe33ae8a792c1791dfa26b9b62e78863",
          "title": "Profile Sha256",
          "type": "string"
        },
        "uncompressed_bytes": {
          "const": 49280719,
          "title": "Uncompressed Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "archive_sha256",
        "archive_file",
        "entry_count",
        "uncompressed_bytes",
        "profile_sha256",
        "members"
      ],
      "title": "ContentTeamHandoffSnapshot",
      "type": "object"
    },
    "ContentTeamHandoffMember": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "automation-template",
            "equation-prototypes",
            "visual-slots-left-right",
            "visual-slots-two-tables",
            "labeled-data-condition",
            "table-2-column",
            "table-3-column",
            "table-3-column-long-equation",
            "table-4-column",
            "inquiry-experiment-box"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 26214400,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "purpose",
        "sha256",
        "size"
      ],
      "title": "ContentTeamHandoffMember",
      "type": "object"
    }
  }
}
