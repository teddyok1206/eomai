{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/hwpx/curated-render-result/4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build_id",
    "assembly_revision_id",
    "assembly_manifest_sha256",
    "request_sha256",
    "profile",
    "status",
    "source_sha256",
    "segment_sha256",
    "section_source_positions",
    "binary_count",
    "output_sha256",
    "output_size_bytes",
    "failure_code",
    "warnings",
    "converter_bundle_sha256",
    "input_plan_sha256",
    "native_equation_count",
    "native_table_count",
    "failure_position"
  ],
  "properties": {
    "schema_version": {
      "const": "curated-hwpx-render-result/4.0"
    },
    "build_id": {
      "type": "string",
      "pattern": "^hwpxbuild_[0-9a-f]{32}$"
    },
    "assembly_revision_id": {
      "type": "string",
      "pattern": "^assemblyrev_[0-9a-f]{32}$"
    },
    "assembly_manifest_sha256": {
      "$ref": "#/$defs/hash"
    },
    "request_sha256": {
      "$ref": "#/$defs/hash"
    },
    "profile": {
      "const": "CURATED_EDITABLE_OCCURRENCES_V2"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "source_sha256": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/hash"
      }
    },
    "segment_sha256": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/hash"
      }
    },
    "section_source_positions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      }
    },
    "binary_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "output_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "output_size_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        {
          "type": "null"
        }
      ]
    },
    "converter_bundle_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_code": {
      "anyOf": [
        {
          "enum": [
            "HWPX_CURATED_INPUT_INVALID",
            "HWPX_CURATED_INPUT_CHANGED",
            "HWPX_CURATED_FORMAT_UNSUPPORTED",
            "HWPX_CURATED_PRESERVATION_FAILED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "FIRST_DOCUMENT_PRINT_SETTINGS",
          "STYLE_NAMES_RELOCATED",
          "HWP_CONVERTED_NATIVE"
        ]
      }
    },
    "input_plan_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "native_equation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "native_table_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "failure_position": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "source_sha256": {
            "minItems": 1
          },
          "segment_sha256": {
            "minItems": 1
          },
          "section_source_positions": {
            "minItems": 1
          },
          "output_sha256": {
            "type": "string"
          },
          "output_size_bytes": {
            "type": "integer"
          },
          "failure_code": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "source_sha256": {
            "maxItems": 0
          },
          "segment_sha256": {
            "maxItems": 0
          },
          "section_source_positions": {
            "maxItems": 0
          },
          "binary_count": {
            "const": 0
          },
          "output_sha256": {
            "type": "null"
          },
          "output_size_bytes": {
            "type": "null"
          },
          "failure_code": {
            "type": "string"
          },
          "warnings": {
            "maxItems": 0
          },
          "converter_bundle_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "native_equation_count": {
            "const": 0
          },
          "native_table_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "failure_position": {
            "type": "null"
          }
        }
      }
    }
  ],
  "title": "Mixed editable curated assembly local render result V3"
}
