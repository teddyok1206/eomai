{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/external-item/source-item-draft/1.0",
  "title": "Creative source Item draft before owner-only crop materialization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locale", "title", "body", "interaction", "solution", "score", "solution_origin"],
  "properties": {
    "schema_version": {"const": "creative-source-item-draft/1.0"},
    "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
    "title": {"$ref": "eom://schemas/item-registry/assessment-item-content-v1#/$defs/text"},
    "body": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "oneOf": [
          {"$ref": "eom://schemas/item-registry/assessment-item-content-v1#/$defs/paragraphBlock"},
          {"$ref": "eom://schemas/item-registry/assessment-item-content-v1#/$defs/equationBlock"},
          {"$ref": "eom://schemas/item-registry/assessment-item-content-v1#/$defs/tableBlock"},
          {"$ref": "eom://schemas/item-registry/assessment-item-content-v1#/$defs/statementSetBlock"},
          {"$ref": "#/$defs/sourceImage"}
        ]
      }
    },
    "interaction": {
      "oneOf": [
        {"$ref": "eom://schemas/item-registry/assessment-item-content-v1#/$defs/singleChoice"},
        {"$ref": "eom://schemas/item-registry/assessment-item-content-v1#/$defs/constructedResponse"}
      ]
    },
    "solution": {"$ref": "eom://schemas/item-registry/assessment-item-content-v1#/$defs/solution"},
    "score": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["state", "points"],
          "properties": {"state": {"const": "PRINTED"}, "points": {"type": "integer", "minimum": 0, "maximum": 100}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["state", "points"],
          "properties": {"state": {"const": "UNPRINTED"}, "points": {"type": "null"}}
        }
      ]
    },
    "solution_origin": {"enum": ["EDITORIAL_SOURCE", "INDEPENDENT_PROPOSAL_UNVERIFIED"]}
  },
  "$defs": {
    "sourceImage": {
      "type": "object", "additionalProperties": false,
      "required": ["block_id", "type", "purpose", "source_region_id", "target_region_id", "alt_text"],
      "properties": {
        "block_id": {"type": "string", "pattern": "^block_[a-z][a-z0-9_]{0,63}$"},
        "type": {"const": "source_image"},
        "purpose": {"enum": ["stimulus", "reference"]},
        "source_region_id": {"type": "string", "pattern": "^extregion_[0-9a-f]{32}$"},
        "target_region_id": {"type": "string", "pattern": "^extregion_[0-9a-f]{32}$"},
        "alt_text": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
