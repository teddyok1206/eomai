{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/external-item/learning-result/1.0",
  "title": "External Item Learning Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "input_sha256", "source_id",
    "source_revision_id", "external_number", "status", "regions",
    "proposal", "conflicts", "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "external-item-learning-result/1.0"},
    "result_id": {"type": "string", "pattern": "^extlearnresult_[0-9a-f]{32}$"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "source_id": {"type": "string", "pattern": "^extitem_[0-9a-f]{32}$"},
    "source_revision_id": {"type": "string", "pattern": "^extitemrev_[0-9a-f]{32}$"},
    "external_number": {"type": "string", "pattern": "^[0-9]{5}$"},
    "status": {"enum": ["PROPOSED", "NEEDS_DECISION"]},
    "regions": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"$ref": "#/$defs/region"}
    },
    "proposal": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/proposal"}]
    },
    "conflicts": {
      "type": "array", "maxItems": 32,
      "items": {"$ref": "#/$defs/conflict"}
    },
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "regionId": {"type": "string", "pattern": "^extregion_[0-9a-f]{32}$"},
    "safeText": {
      "type": "string", "minLength": 1,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*$"
    },
    "box": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": {"type": "integer", "minimum": 0, "maximum": 9999},
        "top": {"type": "integer", "minimum": 0, "maximum": 9999},
        "right": {"type": "integer", "minimum": 1, "maximum": 10000},
        "bottom": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": [
        "region_id", "role", "physical_page", "bounding_box",
        "observed_text", "confidence_milli"
      ],
      "properties": {
        "region_id": {"$ref": "#/$defs/regionId"},
        "role": {"enum": ["TARGET_ITEM", "EDITORIAL_SOLUTION", "REFERENCE_ORIGINAL", "OTHER"]},
        "physical_page": {"type": "integer", "minimum": 1, "maximum": 32},
        "bounding_box": {"$ref": "#/$defs/box"},
        "observed_text": {"allOf": [{"$ref": "#/$defs/safeText"}, {"maxLength": 6000}]},
        "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "contentRegionMap": {
      "type": "object", "additionalProperties": false,
      "required": ["content_path", "region_ids"],
      "properties": {
        "content_path": {
          "type": "string",
          "pattern": "^(title|body\\[[0-9]+\\](?:\\.[A-Za-z0-9_\\[\\].-]+)?|interaction(?:\\.[A-Za-z0-9_\\[\\].-]+)?|solution(?:\\.[A-Za-z0-9_\\[\\].-]+)?|score(?:\\.[A-Za-z0-9_\\[\\].-]+)?)$"
        },
        "region_ids": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "uniqueItems": true, "items": {"$ref": "#/$defs/regionId"}
        }
      }
    },
    "solutionStep": {
      "type": "object", "additionalProperties": false,
      "required": ["step_number", "reasoning_summary", "source_region_ids"],
      "properties": {
        "step_number": {"type": "integer", "minimum": 1, "maximum": 32},
        "reasoning_summary": {"allOf": [{"$ref": "#/$defs/safeText"}, {"maxLength": 3000}]},
        "source_region_ids": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "uniqueItems": true, "items": {"$ref": "#/$defs/regionId"}
        }
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["conflict_code", "description", "source_region_ids", "blocking"],
      "properties": {
        "conflict_code": {"enum": [
          "UNREADABLE_CONTENT", "AMBIGUOUS_REGION", "MISSING_SOLUTION",
          "ANSWER_DISAGREEMENT", "UNRESOLVED_IMAGE", "UNSUPPORTED_STRUCTURE", "OTHER_OBSERVED"
        ]},
        "description": {"allOf": [{"$ref": "#/$defs/safeText"}, {"maxLength": 2000}]},
        "source_region_ids": {
          "type": "array", "maxItems": 16,
          "uniqueItems": true, "items": {"$ref": "#/$defs/regionId"}
        },
        "blocking": {"type": "boolean"}
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": [
        "item_number", "content", "content_region_map",
        "solution_steps", "answer_cross_check"
      ],
      "properties": {
        "item_number": {"type": "integer", "minimum": 1, "maximum": 10000},
        "content": {"$ref": "eom://schemas/item-registry/assessment-item-content-v1"},
        "content_region_map": {
          "type": "array", "minItems": 2, "maxItems": 128,
          "items": {"$ref": "#/$defs/contentRegionMap"}
        },
        "solution_steps": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "#/$defs/solutionStep"}
        },
        "answer_cross_check": {
          "enum": ["MATCHES_EDITORIAL_SOLUTION", "DISAGREES", "NO_EDITORIAL_SOLUTION"]
        }
      }
    }
  }
}
