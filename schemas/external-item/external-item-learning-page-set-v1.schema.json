{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/external-item/learning-page-set/1.0",
  "title": "External Item Learning Page Set V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_input_sha256", "preview_artifact_id",
    "preview_artifact_revision_id", "preview_pdf_sha256", "renderer",
    "pages", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "external-item-learning-page-set/1.0"},
    "source_input_sha256": {"$ref": "#/$defs/sha256"},
    "preview_artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
    "preview_artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
    "preview_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "renderer": {"$ref": "#/$defs/renderer"},
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"$ref": "#/$defs/page"}
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "renderer": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "pdfinfo_sha256", "pdftoppm_sha256"],
      "properties": {
        "profile": {"const": "PDFTOPPM_PNG_SCALE_2400_V1"},
        "pdfinfo_sha256": {"$ref": "#/$defs/sha256"},
        "pdftoppm_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": [
        "physical_page", "member_path", "sha256", "content_length",
        "width_px", "height_px"
      ],
      "properties": {
        "physical_page": {"type": "integer", "minimum": 1, "maximum": 32},
        "member_path": {"type": "string", "pattern": "^pages/page-[0-9]{4}\\.png$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_length": {"type": "integer", "minimum": 24, "maximum": 16777216},
        "width_px": {"type": "integer", "minimum": 64, "maximum": 2400},
        "height_px": {"type": "integer", "minimum": 64, "maximum": 2400}
      }
    }
  }
}
