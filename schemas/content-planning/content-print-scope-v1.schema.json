{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/content-planning/print-scope/1.0",
  "title": "Immutable selected print scope, independent of unrelated section edits",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deliverable_id",
    "edition_id",
    "content_title",
    "edition_label",
    "academic_year",
    "forms",
    "scope_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "content-print-scope/1.0"
    },
    "deliverable_id": {
      "type": "string",
      "pattern": "^deliverable_[0-9a-f]{32}$"
    },
    "edition_id": {
      "type": "string",
      "pattern": "^edition_[0-9a-f]{32}$"
    },
    "content_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "edition_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "academic_year": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1900,
          "maximum": 3000
        },
        {
          "type": "null"
        }
      ]
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "eom://schemas/content-planning/print-scope/1.0#/$defs/scoped_form"
      }
    },
    "scope_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "scoped_form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "path",
        "form",
        "numbering",
        "start_number"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^section_[0-9a-f]{32}$"
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_id",
              "label"
            ],
            "properties": {
              "section_id": {
                "type": "string",
                "pattern": "^section_[0-9a-f]{32}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              }
            }
          }
        },
        "form": {
          "$ref": "eom://schemas/content-planning/edition-composition/1.0#/$defs/form_pointer"
        },
        "numbering": {
          "enum": [
            "RESET_PER_SECTION",
            "CONTINUE_WITHIN_GROUP"
          ]
        },
        "start_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      }
    }
  }
}
