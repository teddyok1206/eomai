{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/content-planning/usage/1.0",
  "$ref": "#/$defs/query",
  "$defs": {
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition_id",
        "year_key",
        "form_id",
        "placement_id",
        "target"
      ],
      "properties": {
        "edition_id": {
          "type": "string",
          "pattern": "^edition_[0-9a-f]{32}$"
        },
        "year_key": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        },
        "form_id": {
          "type": "string",
          "pattern": "^form_[0-9a-f]{32}$"
        },
        "placement_id": {
          "type": "string",
          "pattern": "^placement_[0-9a-f]{32}$"
        },
        "target": {
          "$ref": "eom://schemas/assessment-assembly/curated-slot/2.0#/$defs/resolved_target"
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_kind",
        "targets",
        "academic_year",
        "after",
        "limit"
      ],
      "properties": {
        "query_kind": {
          "const": "USAGE"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "$ref": "eom://schemas/assessment-assembly/curated-slot/2.0#/$defs/external"
              },
              {
                "$ref": "eom://schemas/assessment-assembly/curated-slot/2.0#/$defs/item"
              }
            ]
          }
        },
        "academic_year": {
          "anyOf": [
            {
              "const": "ALL"
            },
            {
              "type": "integer",
              "minimum": 1900,
              "maximum": 3000
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition_id",
        "deliverable_id",
        "revision_id",
        "content_title",
        "edition_label",
        "academic_year",
        "section_id",
        "section_label",
        "form_id",
        "placement_id",
        "position",
        "target",
        "currently_placed",
        "print_count",
        "sample_print_record_id",
        "matched_target_indices"
      ],
      "properties": {
        "edition_id": {
          "type": "string",
          "pattern": "^edition_[0-9a-f]{32}$"
        },
        "deliverable_id": {
          "type": "string",
          "pattern": "^deliverable_[0-9a-f]{32}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^delivrev_[0-9a-f]{32}$"
        },
        "content_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "edition_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "academic_year": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1900,
              "maximum": 3000
            },
            {
              "type": "null"
            }
          ]
        },
        "section_id": {
          "type": "string",
          "pattern": "^section_[0-9a-f]{32}$"
        },
        "section_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "form_id": {
          "type": "string",
          "pattern": "^form_[0-9a-f]{32}$"
        },
        "placement_id": {
          "type": "string",
          "pattern": "^placement_[0-9a-f]{32}$"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "target": {
          "$ref": "eom://schemas/assessment-assembly/curated-slot/2.0#/$defs/resolved_target"
        },
        "currently_placed": {
          "type": "boolean"
        },
        "print_count": {
          "type": "integer",
          "minimum": 0
        },
        "sample_print_record_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^print_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched_target_indices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_kind",
        "query_sha256",
        "coverage",
        "total_locations",
        "rows",
        "next_after"
      ],
      "properties": {
        "result_kind": {
          "const": "USAGE"
        },
        "query_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "coverage": {
          "const": "ACCESSIBLE_CONTENTS"
        },
        "total_locations": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "next_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
