{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/content-planning/print-command/2.0",
  "oneOf": [
    {
      "$ref": "eom://schemas/content-planning/print-command/1.0"
    },
    {
      "$ref": "#/$defs/recordOutput"
    }
  ],
  "$defs": {
    "recordOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_kind",
        "edition_id",
        "revision_id",
        "composition_sha256",
        "section_ids",
        "intent",
        "predecessor_print_record_id",
        "printed_on",
        "note",
        "output_build_id",
        "output_sha256"
      ],
      "properties": {
        "command_kind": {
          "const": "RECORD_PRINT_WITH_OUTPUT"
        },
        "edition_id": {
          "type": "string",
          "pattern": "^edition_[0-9a-f]{32}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^delivrev_[0-9a-f]{32}$"
        },
        "composition_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^section_[0-9a-f]{32}$"
          }
        },
        "intent": {
          "enum": [
            "INITIAL",
            "REPRINT",
            "CORRECTION"
          ]
        },
        "predecessor_print_record_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^print_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "printed_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$"
        },
        "output_build_id": {
          "type": "string",
          "pattern": "^hwpxbuild_[0-9a-f]{32}$"
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "intent": {
                "const": "INITIAL"
              }
            }
          },
          "then": {
            "properties": {
              "predecessor_print_record_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "predecessor_print_record_id": {
                "type": "string",
                "pattern": "^print_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "CORRECTION"
              }
            }
          },
          "then": {
            "properties": {
              "note": {
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    }
  }
}
