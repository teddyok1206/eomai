{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eom:schema:operator-identity:rbac-manifest:1",
  "title": "EOM Built-in RBAC Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "roles", "permissions", "role_permissions"],
  "properties": {
    "schema_version": {"const": "1"},
    "roles": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["VIEWER", "AUTHOR", "REVIEWER", "EDITOR", "ADMIN"]}
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z_]+:[a-z_]+$"}
    },
    "role_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["VIEWER", "AUTHOR", "REVIEWER", "EDITOR", "ADMIN"],
      "properties": {
        "VIEWER": {"$ref": "#/$defs/permissionSet"},
        "AUTHOR": {"$ref": "#/$defs/permissionSet"},
        "REVIEWER": {"$ref": "#/$defs/permissionSet"},
        "EDITOR": {"$ref": "#/$defs/permissionSet"},
        "ADMIN": {"$ref": "#/$defs/permissionSet"}
      }
    }
  },
  "$defs": {
    "permissionSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z_]+:[a-z_]+$"}
    }
  }
}
