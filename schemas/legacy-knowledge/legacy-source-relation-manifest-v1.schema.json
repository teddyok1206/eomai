{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/legacy-knowledge/legacy-source-relation-manifest/1.0",
  "title": "EOM Legacy Source Relation Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "relation_manifest_id", "inventory_id", "inventory_sha256",
    "relations", "reviewed_at", "reviewed_by", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "legacy-source-relation-manifest/1.0"},
    "relation_manifest_id": {"type": "string", "pattern": "^legacyrelationmanifest_[0-9a-f]{32}$"},
    "inventory_id": {"type": "string", "pattern": "^legacyinventory_[0-9a-f]{32}$"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "relations": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {"$ref": "#/$defs/relation"}
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewed_by": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer_type", "artifact_id", "artifact_revision_id", "member_path", "schema_ref", "media_type", "sha256"],
      "properties": {
        "pointer_type": {"const": "ARTIFACT_MEMBER"},
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "member_path": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^(?!/)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+/[^\\u0000-\\u001f\\u007f]+$"},
        "schema_ref": {"type": "string", "pattern": "^eom://schemas/[A-Za-z0-9._/-]{1,220}$"},
        "media_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inventoryPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer_type", "inventory_id", "inventory_sha256", "entry_key", "content_sha256"],
      "properties": {
        "pointer_type": {"const": "INVENTORY_ENTRY"},
        "inventory_id": {"type": "string", "pattern": "^legacyinventory_[0-9a-f]{32}$"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "entry_key": {"type": "string", "pattern": "^legacyentry_[0-9a-f]{32}$"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourcePointer": {"oneOf": [{"$ref": "#/$defs/artifactPointer"}, {"$ref": "#/$defs/inventoryPointer"}]},
    "pageRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_page", "last_page"],
      "properties": {
        "first_page": {"type": "integer", "minimum": 1, "maximum": 100000},
        "last_page": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "options_sha256"],
      "properties": {
        "implementation": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "options_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id", "relation_kind", "original", "derived", "transformation",
        "source_page_range", "confidence_milli", "review_state"
      ],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^legacyrelation_[0-9a-f]{32}$"},
        "relation_kind": {"enum": ["DERIVED_FROM", "RENDERS_PAGE_FROM", "EXTRACTS_TEXT_FROM", "NORMALIZES_FROM", "LEGACY_ITEM_REPRESENTATION_OF", "EVALUATION_BASELINE_FOR"]},
        "original": {"$ref": "#/$defs/sourcePointer"},
        "derived": {"$ref": "#/$defs/sourcePointer"},
        "transformation": {"anyOf": [{"$ref": "#/$defs/transformation"}, {"type": "null"}]},
        "source_page_range": {"anyOf": [{"$ref": "#/$defs/pageRange"}, {"type": "null"}]},
        "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "review_state": {"enum": ["CONFIRMED", "UNRESOLVED", "REJECTED"]}
      },
      "allOf": [
        {
          "if": {"properties": {"relation_kind": {"const": "RENDERS_PAGE_FROM"}}},
          "then": {"properties": {"source_page_range": {"$ref": "#/$defs/pageRange"}}}
        }
      ]
    }
  }
}
