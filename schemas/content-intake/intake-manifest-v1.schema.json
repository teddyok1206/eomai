{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/content-intake/intake-manifest-v1",
  "title": "EOM Content Intake Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "batch_name",
    "received_at",
    "received_by",
    "source_owner",
    "purpose",
    "files"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch_id": {"type": "string", "pattern": "^intake_[0-9a-f]{32}$"},
    "batch_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "received_at": {"type": "string", "format": "date-time"},
    "received_by": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "source_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["internal_team_member", "external_partner", "legacy_system", "other"]
        },
        "reference": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file_id",
          "relative_path",
          "original_filename",
          "media_type",
          "size_bytes",
          "sha256",
          "declared_role",
          "declared_description"
        ],
        "properties": {
          "source_file_id": {"type": "string", "pattern": "^sourcefile_[0-9a-f]{32}$"},
          "relative_path": {
            "type": "string",
            "pattern": "^source/[A-Za-z0-9._()가-힣/-]+$",
            "maxLength": 512
          },
          "original_filename": {"type": "string", "minLength": 1, "maxLength": 255},
          "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 104857600},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "declared_role": {
            "type": "string",
            "enum": ["REFERENCE", "GUIDELINE", "DATA", "ASSET", "OTHER"]
          },
          "declared_description": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
