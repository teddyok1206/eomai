{
  "$defs": {
    "page": {
      "additionalProperties": false,
      "properties": {
        "content_length": {
          "maximum": 67108864,
          "minimum": 1,
          "type": "integer"
        },
        "height_px": {
          "maximum": 2400,
          "minimum": 64,
          "type": "integer"
        },
        "member_path": {
          "pattern": "^pages/page-[0-9]{4}\\.png$",
          "type": "string"
        },
        "page_number": {
          "maximum": 2000,
          "minimum": 1,
          "type": "integer"
        },
        "rotation_degrees": {
          "const": 0
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "width_px": {
          "maximum": 2400,
          "minimum": 64,
          "type": "integer"
        }
      },
      "required": [
        "page_number",
        "member_path",
        "sha256",
        "content_length",
        "width_px",
        "height_px",
        "rotation_degrees"
      ],
      "type": "object"
    },
    "renderer": {
      "additionalProperties": false,
      "properties": {
        "output_format": {
          "const": "PNG"
        },
        "pdfinfo_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "pdftoppm_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "renderer_key": {
          "const": "poppler-pdftoppm"
        },
        "scale_to_px": {
          "const": 2400
        }
      },
      "required": [
        "renderer_key",
        "pdfinfo_sha256",
        "pdftoppm_sha256",
        "scale_to_px",
        "output_format"
      ],
      "type": "object"
    }
  },
  "$id": "eom://schemas/document-review/pdf-document-review-intake-manifest/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "pattern": "^document_[0-9a-f]{32}$",
      "type": "string"
    },
    "document_revision_id": {
      "pattern": "^documentrev_[0-9a-f]{32}$",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "original_filename": {
      "maxLength": 240,
      "minLength": 5,
      "pattern": "^[^/\\\\\\u0000-\\u001F]+\\.[Pp][Dd][Ff]$",
      "type": "string"
    },
    "page_count": {
      "maximum": 2000,
      "minimum": 1,
      "type": "integer"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/page"
      },
      "maxItems": 2000,
      "minItems": 1,
      "type": "array"
    },
    "renderer": {
      "$ref": "#/$defs/renderer"
    },
    "schema_version": {
      "const": "pdf-document-review-intake-manifest/1.0"
    },
    "source_pdf_bytes": {
      "maximum": 268435456,
      "minimum": 8,
      "type": "integer"
    },
    "source_pdf_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "document_revision_id",
    "original_filename",
    "source_pdf_sha256",
    "source_pdf_bytes",
    "renderer",
    "page_count",
    "pages",
    "manifest_sha256"
  ],
  "title": "EOM PDF Document Review Intake Manifest V1",
  "type": "object"
}
