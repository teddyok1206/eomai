{
  "$defs": {
    "memberDescriptor": {
      "additionalProperties": false,
      "properties": {
        "content_length": {
          "maximum": 268435456,
          "minimum": 8,
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "application/vnd.hancom.hwp",
            "application/vnd.hancom.hwpx"
          ]
        },
        "member_path": {
          "pattern": "^source/original\\.(?:pdf|hwp|hwpx)$",
          "type": "string"
        },
        "schema_ref": {
          "enum": [
            "eom://schemas/document-review/pdf-source/1.0",
            "eom://schemas/document-review/hwp-source/2.0",
            "eom://schemas/document-review/editable-hwpx/1.0"
          ]
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "member_path",
        "sha256",
        "content_length",
        "media_type",
        "schema_ref"
      ],
      "type": "object"
    }
  },
  "$id": "eom://schemas/document-review/document-review-source-upload-manifest/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "original_filename": {
      "maxLength": 240,
      "minLength": 5,
      "pattern": "^[^/\\\\\\u0000-\\u001f]+\\.(?:[Hh][Ww][Pp](?:[Xx])?)$",
      "type": "string"
    },
    "original_source": {
      "$ref": "#/$defs/memberDescriptor"
    },
    "schema_version": {
      "const": "document-review-source-upload-manifest/1.0"
    },
    "source_format": {
      "enum": [
        "HWP",
        "HWPX"
      ]
    }
  },
  "required": [
    "schema_version",
    "original_filename",
    "source_format",
    "original_source",
    "manifest_sha256"
  ],
  "title": "EOM Office Document Review Source Upload Manifest V1",
  "type": "object"
}
