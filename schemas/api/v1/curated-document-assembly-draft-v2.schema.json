{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/api/curated-document-assembly-draft/2.0",
  "title": "Titled curated assembly draft, placements retain the V1 selection contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "placements"
  ],
  "properties": {
    "schema_version": {
      "const": "curated-document-assembly-draft/2.0"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[^\\r\\n\\t]*$",
      "not": {
        "pattern": "[\\r\\n\\t]"
      }
    },
    "placements": {
      "$ref": "eom://schemas/api/curated-document-assembly-draft/1.0#/properties/placements"
    }
  }
}
