{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eom.local/schemas/api/v1/item-db-similarity-list-input-v1.schema.json",
  "title": "Owned DB search intent; one ordered list, no caller-supplied runtime or authority",
  "type": "object", "additionalProperties": false,
  "required": ["selections"],
  "properties": {
    "schema_version": {"const": "item-db-similarity-list-input/1.0", "default": "item-db-similarity-list-input/1.0"},
    "selections": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "eom://schemas/knowledge/item-db-similarity-selection/1.0#/$defs/selection"}
    },
    "top_k": {"type": "integer", "minimum": 1, "maximum": 64, "default": 5}
  }
}
