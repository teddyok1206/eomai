{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/api/pdf-document-review-result-view/1.0",
  "title": "EOM PDF Document Review Result View V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "state",
    "document_id",
    "document_revision_id",
    "original_filename",
    "source_pdf_sha256",
    "page_count",
    "pages",
    "preset_key",
    "preset_display_name",
    "additional_guidance_sha256",
    "result_artifact",
    "result",
    "failure_code",
    "created_at",
    "updated_at",
    "resource_version"
  ],
  "properties": {
    "workflow_id": {"type": "string", "pattern": "^workflow_[0-9a-f]{32}$"},
    "state": {"enum": ["SUBMITTED", "REVIEWING", "COMPLETED", "FAILED"]},
    "document_id": {"type": "string", "pattern": "^document_[0-9a-f]{32}$"},
    "document_revision_id": {"type": "string", "pattern": "^documentrev_[0-9a-f]{32}$"},
    "original_filename": {
      "type": "string",
      "minLength": 5,
      "maxLength": 240,
      "pattern": "^[^/\\\\\\u0000-\\u001f]+\\.[Pp][Dd][Ff]$"
    },
    "source_pdf_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "page_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/page"}
    },
    "preset_key": {"enum": ["PROBLEM_SET", "WEEKLY_WORKBOOK", "MOCK_EXAM"]},
    "preset_display_name": {"enum": ["N제", "주간지", "모의고사"]},
    "additional_guidance_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result_artifact": {
      "anyOf": [{"$ref": "#/$defs/result_artifact"}, {"type": "null"}]
    },
    "result": {
      "anyOf": [
        {
          "$ref": "https://eom.local/schemas/workflow/roles/pdf-document-review-result-v1.schema.json#/$defs/output"
        },
        {"type": "null"}
      ]
    },
    "failure_code": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "resource_version": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "COMPLETED"}}},
      "then": {
        "properties": {
          "result_artifact": {"$ref": "#/$defs/result_artifact"},
          "result": {
            "$ref": "https://eom.local/schemas/workflow/roles/pdf-document-review-result-v1.schema.json#/$defs/output"
          },
          "failure_code": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "result_artifact": {"type": "null"},
          "result": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "FAILED"}}},
      "then": {"properties": {"failure_code": {"type": "string"}}},
      "else": {"properties": {"failure_code": {"type": "null"}}}
    }
  ],
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "width_px",
        "height_px",
        "rotation_degrees",
        "image_sha256",
        "image_content_length",
        "image_url"
      ],
      "properties": {
        "page_number": {"type": "integer", "minimum": 1, "maximum": 32},
        "width_px": {"type": "integer", "minimum": 64, "maximum": 16384},
        "height_px": {"type": "integer", "minimum": 64, "maximum": 16384},
        "rotation_degrees": {"enum": [0, 90, 180, 270]},
        "image_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "image_content_length": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "image_url": {
          "type": "string",
          "pattern": "^/api/v1/pdf-document-reviews/workflow_[0-9a-f]{32}/pages/(?:[1-9]|[12][0-9]|3[0-2])/image$"
        }
      }
    },
    "result_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_revision_id", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
        "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
