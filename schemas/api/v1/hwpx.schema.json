{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eom:schema:api:v1:hwpx",
  "title": "EOM HWPX Application API V0",
  "type": "object",
  "$defs": {
    "capabilityState": {
      "enum": ["READY", "PREPARED_NOT_DEPLOYED", "UNAVAILABLE", "DEGRADED"]
    },
    "buildState": {
      "enum": ["REQUESTED", "RUNNING", "VALIDATING", "SUCCEEDED", "FAILED"]
    },
    "buildRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "options"],
      "properties": {
        "renderer": {"enum": ["kordoc", "eom-template"]},
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include_explanation": {"const": true},
            "require_native_equations": {"type": "boolean"},
            "require_native_tables": {"type": "boolean"},
            "document_preset": {"enum": ["report"]},
            "document_profile": {"enum": ["kordoc-report", "eom-question-template-v1"]},
            "item_number": {"type": "integer", "minimum": 1, "maximum": 999}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"renderer": {"const": "eom-template"}}},
          "then": {
            "properties": {
              "options": {
                "required": ["document_profile"],
                "properties": {
                  "document_profile": {"const": "eom-question-template-v1"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"renderer": {"const": "kordoc"}}},
          "then": {
            "properties": {
              "options": {
                "properties": {"document_profile": {"const": "kordoc-report"}}
              }
            }
          }
        }
      ]
    },
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_revision_id", "sha256"],
      "properties": {
        "artifact_id": {"pattern": "^artifact_[0-9a-f]{32}$", "type": "string"},
        "artifact_revision_id": {"pattern": "^rev_[0-9a-f]{32}$", "type": "string"},
        "sha256": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}
      }
    }
  }
}
