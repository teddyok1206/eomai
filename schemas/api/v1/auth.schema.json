{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eom:schema:api:v1:auth",
  "title": "EOM Application API Authentication Contracts",
  "$defs": {
    "login_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "password", "client_name"],
      "properties": {
        "username": {"type": "string", "minLength": 3, "maxLength": 64},
        "password": {"type": "string", "minLength": 1, "maxLength": 128},
        "client_name": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "refresh_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refresh_token"],
      "properties": {"refresh_token": {"type": "string", "minLength": 73, "maxLength": 73}}
    },
    "change_password_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_password", "new_password"],
      "properties": {
        "current_password": {"type": "string", "minLength": 1, "maxLength": 128},
        "new_password": {"type": "string", "minLength": 15, "maxLength": 128}
      }
    },
    "update_credentials_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_password", "expected_resource_version"],
      "properties": {
        "current_password": {"type": "string", "minLength": 1, "maxLength": 128},
        "new_username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "new_password": {"type": "string", "minLength": 15, "maxLength": 128},
        "expected_resource_version": {"type": "integer", "minimum": 1}
      },
      "anyOf": [
        {"required": ["new_username"]},
        {"required": ["new_password"]}
      ]
    },
    "token_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_token", "refresh_token", "token_type", "access_expires_at", "refresh_expires_at", "session_id", "password_change_required"],
      "properties": {
        "access_token": {"type": "string", "pattern": "^eom_at_"},
        "refresh_token": {"type": "string", "pattern": "^eom_rt_"},
        "token_type": {"const": "bearer"},
        "access_expires_at": {"type": "string", "format": "date-time"},
        "refresh_expires_at": {"type": "string", "format": "date-time"},
        "session_id": {"type": "string", "pattern": "^apisession_"},
        "password_change_required": {"type": "boolean"}
      }
    },
    "current_account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operator_id", "username", "display_name", "roles", "effective_permissions", "session_id", "authenticated_at", "access_expires_at", "password_change_required", "resource_version"],
      "properties": {
        "schema_version": {"const": "auth-current-account/1.0"},
        "operator_id": {"type": "string", "pattern": "^operator_[0-9a-f]{32}$"},
        "username": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["VIEWER", "AUTHOR", "REVIEWER", "EDITOR", "ADMIN"]}},
        "effective_permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "session_id": {"type": "string", "pattern": "^apisession_[0-9a-f]{32}$"},
        "authenticated_at": {"type": "string", "format": "date-time"},
        "access_expires_at": {"type": "string", "format": "date-time"},
        "password_change_required": {"type": "boolean"},
        "resource_version": {"type": "integer", "minimum": 1}
      }
    },
    "credential_update_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "operator"],
      "properties": {
        "tokens": {"$ref": "#/$defs/token_pair"},
        "operator": {"$ref": "#/$defs/current_account"}
      }
    }
  }
}
