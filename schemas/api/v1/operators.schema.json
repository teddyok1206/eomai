{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eom:schema:api:v1:operators",
  "title": "EOM Application API Operator Contracts",
  "$defs": {
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "username", "display_name", "status", "must_change_password", "roles", "effective_permissions", "resource_version", "created_at", "updated_at"],
      "properties": {
        "operator_id": {"type": "string", "pattern": "^operator_[0-9a-f]{32}$"},
        "username": {"type": "string"},
        "display_name": {"type": "string"},
        "status": {"enum": ["ACTIVE", "DISABLED"]},
        "must_change_password": {"type": "boolean"},
        "roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["VIEWER", "AUTHOR", "REVIEWER", "EDITOR", "ADMIN"]}},
        "effective_permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "resource_version": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "disabled_at": {"type": ["string", "null"], "format": "date-time"},
        "disable_reason": {"type": ["string", "null"], "maxLength": 1000},
        "last_login_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "display_name", "temporary_password", "initial_roles"],
      "properties": {
        "username": {"type": "string", "minLength": 3, "maxLength": 64},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "temporary_password": {"type": "string", "minLength": 15, "maxLength": 128},
        "initial_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["VIEWER", "AUTHOR", "REVIEWER", "EDITOR", "ADMIN"]}}
      }
    }
  }
}
