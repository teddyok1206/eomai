{
  "$id": "https://eom.local/schemas/api/assessment-learning-batch-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$defs": {
    "itemCounts": {
      "additionalProperties": false,
      "properties": {
        "expected": {"type": "integer", "minimum": 0, "maximum": 100000},
        "accepted": {"type": "integer", "minimum": 0, "maximum": 100000},
        "promoted": {"type": "integer", "minimum": 0, "maximum": 100000},
        "analysis_active": {"type": "integer", "minimum": 0, "maximum": 100000},
        "analysis_accepted": {"type": "integer", "minimum": 0, "maximum": 100000},
        "analysis_failed": {"type": "integer", "minimum": 0, "maximum": 100000},
        "graph_published": {"type": "integer", "minimum": 0, "maximum": 100000}
      },
      "required": ["expected", "accepted", "promoted", "analysis_active", "analysis_accepted", "analysis_failed", "graph_published"],
      "type": "object"
    },
    "workUnitCounts": {
      "additionalProperties": false,
      "properties": {
        "pending": {"type": "integer", "minimum": 0, "maximum": 10000},
        "claimed": {"type": "integer", "minimum": 0, "maximum": 10000},
        "submitted": {"type": "integer", "minimum": 0, "maximum": 10000},
        "awaiting_review": {"type": "integer", "minimum": 0, "maximum": 10000},
        "accepted": {"type": "integer", "minimum": 0, "maximum": 10000},
        "failed": {"type": "integer", "minimum": 0, "maximum": 10000},
        "cancelled": {"type": "integer", "minimum": 0, "maximum": 10000}
      },
      "required": ["pending", "claimed", "submitted", "awaiting_review", "accepted", "failed", "cancelled"],
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {"const": "assessment-learning-batch-view/1.0"},
    "extraction_batch_id": {"type": "string", "pattern": "^legacybatch_[0-9a-f]{32}$"},
    "inventory_id": {"type": "string", "pattern": "^legacyinventory_[0-9a-f]{32}$"},
    "inventory_sha256": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"},
    "state": {"enum": ["QUEUED", "RUNNING", "AWAITING_REVIEW", "SUCCEEDED", "COMPLETED_WITH_GAPS", "CANCELLED"]},
    "exam_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "total_work_unit_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "image_required_work_unit_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "image_observation_mode": {"const": "REQUIRED"},
    "text_evidence_mode": {"const": "AUXILIARY_WHEN_AVAILABLE"},
    "work_units": {"$ref": "#/$defs/workUnitCounts"},
    "items": {"$ref": "#/$defs/itemCounts"},
    "current_graph_snapshot_revision_id": {"anyOf": [{"type": "string", "pattern": "^graphrev_[0-9a-f]{32}$"}, {"type": "null"}]},
    "resource_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "completed_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "required": ["schema_version", "extraction_batch_id", "inventory_id", "inventory_sha256", "state", "exam_count", "total_work_unit_count", "image_required_work_unit_count", "image_observation_mode", "text_evidence_mode", "work_units", "items", "current_graph_snapshot_revision_id", "resource_version", "created_at", "started_at", "completed_at", "updated_at"],
  "title": "Assessment Learning Batch View V1",
  "type": "object"
}
