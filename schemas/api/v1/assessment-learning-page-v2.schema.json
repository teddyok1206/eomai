{
  "$id": "https://eom.local/schemas/api/assessment-learning-page-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "assessment-learning-page-view/2.0"},
    "assessment_occurrence_revision_id": {"type": "string", "pattern": "^occurrev_[0-9a-f]{32}$"},
    "page_input_id": {"type": "string", "pattern": "^assessmentpage_[0-9a-f]{32}$"},
    "source_role": {"enum": ["PROBLEM_DOCUMENT", "ANSWER_EXPLANATION_DOCUMENT"]},
    "physical_page": {"type": "integer", "minimum": 1, "maximum": 100000},
    "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{32}$"},
    "artifact_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
    "artifact_member": {"type": "string", "minLength": 1, "maxLength": 512},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "media_type": {"const": "image/png"},
    "content_length": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "width_px": {"type": "integer", "minimum": 1, "maximum": 20000},
    "height_px": {"type": "integer", "minimum": 1, "maximum": 20000}
  },
  "required": ["schema_version", "assessment_occurrence_revision_id", "page_input_id", "source_role", "physical_page", "artifact_id", "artifact_revision_id", "artifact_member", "sha256", "media_type", "content_length", "width_px", "height_px"],
  "title": "Assessment Learning Page View V2",
  "type": "object"
}
