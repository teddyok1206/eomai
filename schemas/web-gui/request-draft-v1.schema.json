{
  "$id": "https://eom.local/schemas/web-gui/request-draft-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "choice_count": {"const": 5, "type": "integer"},
    "created_at": {"format": "date-time", "type": "string"},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "equation_required": {"const": true, "type": "boolean"},
    "image_required": {"const": true, "type": "boolean"},
    "item_format": {"enum": ["multiple_choice"]},
    "language": {"enum": ["ko"]},
    "original_request_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "original_request_text": {"maxLength": 2000, "minLength": 10, "type": "string"},
    "quality_profile": {"enum": ["fast", "balanced", "deep"]},
    "request_draft_id": {"pattern": "^requestdraft_[0-9a-f]{32}$", "type": "string"},
    "schema_version": {"const": "1.0"},
    "source_intake_batch_id": {
      "anyOf": [
        {"pattern": "^intake_[0-9a-f]{32}$", "type": "string"},
        {"type": "null"}
      ]
    },
    "status": {"const": "DRAFT"},
    "subject": {"maxLength": 80, "minLength": 1, "type": "string"},
    "task_type": {"enum": ["calculation", "conceptual", "data_interpretation"]},
    "topic": {"maxLength": 160, "minLength": 1, "type": "string"},
    "updated_at": {"format": "date-time", "type": "string"}
  },
  "required": [
    "schema_version",
    "request_draft_id",
    "status",
    "language",
    "subject",
    "topic",
    "item_format",
    "task_type",
    "difficulty",
    "choice_count",
    "equation_required",
    "image_required",
    "quality_profile",
    "original_request_text",
    "original_request_sha256",
    "created_at",
    "updated_at"
  ],
  "title": "EOM Web GUI Request Draft V1",
  "type": "object"
}
