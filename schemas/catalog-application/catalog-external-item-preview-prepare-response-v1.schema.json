{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/catalog-application/catalog-external-item-preview-prepare-response/1.0",
  "title": "Catalog External Item Preview Prepare Response V1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "status", "sha256"],
      "properties": {
        "operation": {"const": "PREPARE_EXTERNAL_ITEM_PREVIEW"},
        "status": {"const": "OK"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "status", "error_code"],
      "properties": {
        "operation": {"const": "PREPARE_EXTERNAL_ITEM_PREVIEW"},
        "status": {"const": "ERROR"},
        "error_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}
      }
    }
  ]
}
