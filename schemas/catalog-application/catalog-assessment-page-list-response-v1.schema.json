{
  "$id": "eom://schemas/catalog-application/catalog-assessment-page-list-response/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "page": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {"pattern": "^artifact_[0-9a-f]{32}$", "type": "string"},
        "artifact_revision_id": {"pattern": "^rev_[0-9a-f]{32}$", "type": "string"},
        "content_length": {"maximum": 33554432, "minimum": 1, "type": "integer"},
        "height_px": {"maximum": 20000, "minimum": 1, "type": "integer"},
        "media_type": {"const": "image/png"},
        "member_path": {"maxLength": 512, "minLength": 1, "type": "string"},
        "page_input_id": {"pattern": "^assessmentpage_[0-9a-f]{32}$", "type": "string"},
        "physical_page": {"maximum": 100000, "minimum": 1, "type": "integer"},
        "sha256": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
        "source_role": {"enum": ["PROBLEM_DOCUMENT", "ANSWER_EXPLANATION_DOCUMENT"]},
        "width_px": {"maximum": 20000, "minimum": 1, "type": "integer"}
      },
      "required": ["page_input_id", "source_role", "physical_page", "artifact_id", "artifact_revision_id", "member_path", "sha256", "media_type", "content_length", "width_px", "height_px"],
      "type": "object"
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "operation": {"const": "GET_ASSESSMENT_PAGE_IMAGES"},
        "pages": {"items": {"$ref": "#/$defs/page"}, "maxItems": 1000, "minItems": 1, "type": "array"},
        "status": {"const": "OK"}
      },
      "required": ["status", "operation", "pages"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "error_code": {"pattern": "^[A-Z][A-Z0-9_]{2,127}$", "type": "string"},
        "operation": {"const": "GET_ASSESSMENT_PAGE_IMAGES"},
        "status": {"const": "ERROR"}
      },
      "required": ["status", "operation", "error_code"],
      "type": "object"
    }
  ],
  "title": "Catalog Assessment Page List Response V1"
}
