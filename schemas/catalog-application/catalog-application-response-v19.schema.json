{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/catalog-application/catalog-application-response-v19",
  "title": "EOM Catalog exact-score canonical Item read response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "OK"
        },
        "operation": {
          "const": "GET_ITEM_CONTENT"
        },
        "content": {
          "$ref": "eom://schemas/item-registry/assessment-item-content-v1_1"
        }
      },
      "required": [
        "status",
        "operation",
        "content"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ERROR"
        },
        "operation": {
          "const": "GET_ITEM_CONTENT"
        },
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        }
      },
      "required": [
        "status",
        "operation",
        "error_code"
      ]
    }
  ]
}
