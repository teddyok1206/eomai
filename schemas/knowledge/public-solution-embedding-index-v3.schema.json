{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/public-solution-embedding-index/3.0",
  "title": "Exact public-solution bindings over existing numerical shards",
  "$defs": {
    "AcceptedPublicSolutionEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ACCEPTED_SOLUTION_ANALYSIS",
          "default": "ACCEPTED_SOLUTION_ANALYSIS",
          "title": "Kind",
          "type": "string"
        },
        "solution": {
          "$ref": "#/$defs/KnowledgeSolutionEvidencePointer"
        }
      },
      "required": [
        "solution"
      ],
      "title": "AcceptedPublicSolutionEvidence",
      "type": "object"
    },
    "ApprovedItemKnowledgeSourceV2": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "const": "APPROVED_ITEM_REVISION",
          "default": "APPROVED_ITEM_REVISION",
          "title": "Source Kind",
          "type": "string"
        },
        "source_class": {
          "enum": [
            "APPROVED_ITEM",
            "PAST_EXAM"
          ],
          "title": "Source Class",
          "type": "string"
        },
        "item_id": {
          "pattern": "^item_[0-9a-f]{32}$",
          "title": "Item Id",
          "type": "string"
        },
        "item_revision_id": {
          "pattern": "^itemrev_[0-9a-f]{32}$",
          "title": "Item Revision Id",
          "type": "string"
        },
        "lifecycle_state": {
          "const": "APPROVED",
          "default": "APPROVED",
          "title": "Lifecycle State",
          "type": "string"
        },
        "artifact_member": {
          "$ref": "#/$defs/KnowledgeAnalysisSourceArtifactMemberV2"
        }
      },
      "required": [
        "source_class",
        "item_id",
        "item_revision_id",
        "artifact_member"
      ],
      "title": "ApprovedItemKnowledgeSourceV2",
      "type": "object"
    },
    "ApprovedPastExamItemKnowledgeSourceV3": {
      "additionalProperties": false,
      "description": "One approved past-exam Item plus its exact visually reviewed source pages.",
      "properties": {
        "source_kind": {
          "const": "APPROVED_ITEM_REVISION",
          "default": "APPROVED_ITEM_REVISION",
          "title": "Source Kind",
          "type": "string"
        },
        "source_class": {
          "const": "PAST_EXAM",
          "default": "PAST_EXAM",
          "title": "Source Class",
          "type": "string"
        },
        "item_id": {
          "pattern": "^item_[0-9a-f]{32}$",
          "title": "Item Id",
          "type": "string"
        },
        "item_revision_id": {
          "pattern": "^itemrev_[0-9a-f]{32}$",
          "title": "Item Revision Id",
          "type": "string"
        },
        "lifecycle_state": {
          "const": "APPROVED",
          "default": "APPROVED",
          "title": "Lifecycle State",
          "type": "string"
        },
        "artifact_member": {
          "$ref": "#/$defs/KnowledgeAnalysisSourceArtifactMemberV2"
        },
        "extraction_acceptance_id": {
          "pattern": "^itemacceptance_[0-9a-f]{32}$",
          "title": "Extraction Acceptance Id",
          "type": "string"
        },
        "extraction_acceptance_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Extraction Acceptance Sha256",
          "type": "string"
        },
        "extraction_acceptance_artifact": {
          "$ref": "#/$defs/AssessmentArtifactMemberPointer"
        },
        "extraction_result_id": {
          "pattern": "^itemextractresult_[0-9a-f]{32}$",
          "title": "Extraction Result Id",
          "type": "string"
        },
        "extraction_result_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Extraction Result Sha256",
          "type": "string"
        },
        "extraction_result_artifact": {
          "$ref": "#/$defs/AssessmentArtifactMemberPointer"
        },
        "item_proposal_id": {
          "pattern": "^itemproposal_[0-9a-f]{32}$",
          "title": "Item Proposal Id",
          "type": "string"
        },
        "item_number": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Item Number",
          "type": "integer"
        },
        "bundle": {
          "$ref": "#/$defs/AssessmentSourceBundlePointer"
        },
        "layout_observation": {
          "$ref": "#/$defs/AssessmentLayoutObservationPointer"
        },
        "page_inputs": {
          "items": {
            "$ref": "#/$defs/AssessmentPageImageInput"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Page Inputs",
          "type": "array"
        },
        "page_image_count": {
          "maximum": 32,
          "minimum": 1,
          "title": "Page Image Count",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "item_revision_id",
        "artifact_member",
        "extraction_acceptance_id",
        "extraction_acceptance_sha256",
        "extraction_acceptance_artifact",
        "extraction_result_id",
        "extraction_result_sha256",
        "extraction_result_artifact",
        "item_proposal_id",
        "item_number",
        "bundle",
        "layout_observation",
        "page_inputs",
        "page_image_count"
      ],
      "title": "ApprovedPastExamItemKnowledgeSourceV3",
      "type": "object"
    },
    "ArtifactMemberPointer": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Member Path",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "title": "ArtifactMemberPointer",
      "type": "object"
    },
    "AssessmentArtifactMemberPointer": {
      "additionalProperties": false,
      "description": "Compatibility name for the shared origin Artifact member pointer.",
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Member Path",
          "type": "string"
        },
        "schema_ref": {
          "pattern": "^eom://schemas/[A-Za-z0-9._/-]{1,220}$",
          "title": "Schema Ref",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$",
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "schema_ref",
        "media_type",
        "sha256"
      ],
      "title": "AssessmentArtifactMemberPointer",
      "type": "object"
    },
    "AssessmentLayoutObservationPointer": {
      "additionalProperties": false,
      "properties": {
        "assessment_layout_observation_id": {
          "pattern": "^assessmentlayout_[0-9a-f]{32}$",
          "title": "Assessment Layout Observation Id",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/AssessmentArtifactMemberPointer"
        },
        "workspace_relative_path": {
          "const": "source/layout-observation.json",
          "default": "source/layout-observation.json",
          "title": "Workspace Relative Path",
          "type": "string"
        },
        "observation_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        }
      },
      "required": [
        "assessment_layout_observation_id",
        "artifact",
        "observation_sha256"
      ],
      "title": "AssessmentLayoutObservationPointer",
      "type": "object"
    },
    "AssessmentPageImageInput": {
      "additionalProperties": false,
      "properties": {
        "page_input_id": {
          "pattern": "^assessmentpage_[0-9a-f]{32}$",
          "title": "Page Input Id",
          "type": "string"
        },
        "source_role": {
          "enum": [
            "PROBLEM_DOCUMENT",
            "ANSWER_EXPLANATION_DOCUMENT"
          ],
          "title": "Source Role",
          "type": "string"
        },
        "physical_page": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Physical Page",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/AssessmentArtifactMemberPointer"
        },
        "image": {
          "$ref": "#/$defs/AssessmentArtifactMemberPointer"
        },
        "workspace_relative_path": {
          "pattern": "^source/pages/assessmentpage_[0-9a-f]{32}\\.png$",
          "title": "Workspace Relative Path",
          "type": "string"
        },
        "width_px": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Height Px",
          "type": "integer"
        }
      },
      "required": [
        "page_input_id",
        "source_role",
        "physical_page",
        "source",
        "image",
        "workspace_relative_path",
        "width_px",
        "height_px"
      ],
      "title": "AssessmentPageImageInput",
      "type": "object"
    },
    "AssessmentSourceBundlePointer": {
      "additionalProperties": false,
      "properties": {
        "assessment_source_bundle_id": {
          "pattern": "^assessbundle_[0-9a-f]{32}$",
          "title": "Assessment Source Bundle Id",
          "type": "string"
        },
        "assessment_source_bundle_revision_id": {
          "pattern": "^assessbundlerev_[0-9a-f]{32}$",
          "title": "Assessment Source Bundle Revision Id",
          "type": "string"
        },
        "bundle_manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Bundle Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "assessment_source_bundle_id",
        "assessment_source_bundle_revision_id",
        "bundle_manifest_sha256"
      ],
      "title": "AssessmentSourceBundlePointer",
      "type": "object"
    },
    "CreativePublicSolutionEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "REGISTERED_CREATIVE_SOURCE_REPORT",
          "default": "REGISTERED_CREATIVE_SOURCE_REPORT",
          "title": "Kind",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/ArtifactMemberPointer"
        },
        "lineage_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Lineage Sha256",
          "type": "string"
        },
        "role_result": {
          "$ref": "#/$defs/ArtifactMemberPointer"
        },
        "result_id": {
          "pattern": "^extlearnresult_[0-9a-f]{32}$",
          "title": "Result Id",
          "type": "string"
        },
        "result_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        }
      },
      "required": [
        "lineage",
        "lineage_sha256",
        "role_result",
        "result_id",
        "result_sha256"
      ],
      "title": "CreativePublicSolutionEvidence",
      "type": "object"
    },
    "EmbeddingEncodingIdentity": {
      "additionalProperties": false,
      "properties": {
        "storage_partition": {
          "$ref": "#/$defs/StoragePartition"
        },
        "space_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Space Sha256",
          "type": "string"
        },
        "input_text_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Text Sha256",
          "type": "string"
        },
        "encoding_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Encoding Sha256",
          "type": "string"
        }
      },
      "required": [
        "storage_partition",
        "space_sha256",
        "input_text_sha256",
        "encoding_sha256"
      ],
      "title": "EmbeddingEncodingIdentity",
      "type": "object"
    },
    "EmbeddingExecutionRuntime": {
      "additionalProperties": false,
      "description": "Actual installed execution fingerprint is verified by the owner, not this pure DTO.",
      "properties": {
        "device": {
          "enum": [
            "CPU",
            "CUDA"
          ],
          "title": "Device",
          "type": "string"
        },
        "precision": {
          "const": "FLOAT32",
          "default": "FLOAT32",
          "title": "Precision",
          "type": "string"
        },
        "tf32_enabled": {
          "const": false,
          "default": false,
          "title": "Tf32 Enabled",
          "type": "boolean"
        },
        "execution_runtime_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Execution Runtime Sha256",
          "type": "string"
        }
      },
      "required": [
        "device",
        "execution_runtime_sha256"
      ],
      "title": "EmbeddingExecutionRuntime",
      "type": "object"
    },
    "EmbeddingSpace": {
      "additionalProperties": false,
      "properties": {
        "model_spec": {
          "$ref": "#/$defs/LocalEmbeddingModelSpec"
        },
        "purpose": {
          "enum": [
            "QUERY",
            "DOCUMENT"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/EmbeddingExecutionRuntime"
        },
        "space_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Space Sha256",
          "type": "string"
        }
      },
      "required": [
        "model_spec",
        "purpose",
        "runtime",
        "space_sha256"
      ],
      "title": "EmbeddingSpace",
      "type": "object"
    },
    "EmbeddingVectorRowRef": {
      "additionalProperties": false,
      "properties": {
        "shard_manifest": {
          "$ref": "#/$defs/ArtifactMemberPointer"
        },
        "row_index": {
          "maximum": 1023,
          "minimum": 0,
          "title": "Row Index",
          "type": "integer"
        },
        "encoding_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Encoding Sha256",
          "type": "string"
        }
      },
      "required": [
        "shard_manifest",
        "row_index",
        "encoding_sha256"
      ],
      "title": "EmbeddingVectorRowRef",
      "type": "object"
    },
    "KnowledgeAnalysisSourceArtifactMemberV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._()가-힣/-]+$",
          "title": "Member Path",
          "type": "string"
        },
        "materialized_path": {
          "maxLength": 512,
          "minLength": 8,
          "pattern": "^source/[A-Za-z0-9._()가-힣/-]+$",
          "title": "Materialized Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "maximum": 104857600,
          "minimum": 1,
          "title": "Bytes",
          "type": "integer"
        },
        "schema_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^eom(?:\\.assess(?:ment)?|://schemas/)[A-Za-z0-9._/@:-]{1,191}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Ref"
        },
        "media_type": {
          "maxLength": 128,
          "pattern": "^[a-z0-9.+-]+/[A-Za-z0-9.+-]+$",
          "title": "Media Type",
          "type": "string"
        },
        "logical_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$",
          "title": "Logical Name",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "member_path",
        "materialized_path",
        "sha256",
        "bytes",
        "media_type",
        "logical_name"
      ],
      "title": "KnowledgeAnalysisSourceArtifactMemberV2",
      "type": "object"
    },
    "KnowledgeArtifactMemberPointer": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^rev_[0-9a-f]{32}$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "schema_ref": {
          "maxLength": 256,
          "pattern": "^eom(?:\\.assess(?:ment)?|://schemas/)[A-Za-z0-9._/@:-]{1,191}$",
          "title": "Schema Ref",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "pattern": "^[a-z0-9.+-]+/[A-Za-z0-9.+-]+$",
          "title": "Media Type",
          "type": "string"
        },
        "logical_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$",
          "title": "Logical Name",
          "type": "string"
        },
        "member_path": {
          "maxLength": 512,
          "pattern": "^(source|normalized|projections|evidence)/[A-Za-z0-9._()가-힣/-]+$",
          "title": "Member Path",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "sha256",
        "schema_ref",
        "media_type",
        "logical_name",
        "member_path"
      ],
      "title": "KnowledgeArtifactMemberPointer",
      "type": "object"
    },
    "KnowledgeGraphSnapshotPointer": {
      "additionalProperties": false,
      "properties": {
        "graph_id": {
          "pattern": "^graph_[0-9a-f]{32}$",
          "title": "Graph Id",
          "type": "string"
        },
        "graph_snapshot_revision_id": {
          "pattern": "^graphrev_[0-9a-f]{32}$",
          "title": "Graph Snapshot Revision Id",
          "type": "string"
        },
        "manifest_artifact": {
          "$ref": "#/$defs/KnowledgeArtifactMemberPointer"
        },
        "manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "graph_id",
        "graph_snapshot_revision_id",
        "manifest_artifact",
        "manifest_sha256"
      ],
      "title": "KnowledgeGraphSnapshotPointer",
      "type": "object"
    },
    "KnowledgeSolutionEvidencePointer": {
      "additionalProperties": false,
      "description": "Exact accepted additive report pointers attached to one base analysis.",
      "properties": {
        "schema_version": {
          "const": "knowledge-solution-evidence-pointer/1.0",
          "default": "knowledge-solution-evidence-pointer/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "base_analysis_run_id": {
          "pattern": "^analysisrun_[0-9a-f]{32}$",
          "title": "Base Analysis Run Id",
          "type": "string"
        },
        "base_analysis_result_id": {
          "pattern": "^knowledgeanalysisresult_[0-9a-f]{32}$",
          "title": "Base Analysis Result Id",
          "type": "string"
        },
        "solution_analysis_run_id": {
          "pattern": "^analysisrun_[0-9a-f]{32}$",
          "title": "Solution Analysis Run Id",
          "type": "string"
        },
        "solution_analysis_result_id": {
          "pattern": "^knowledgeanalysisresult_[0-9a-f]{32}$",
          "title": "Solution Analysis Result Id",
          "type": "string"
        },
        "solution_result_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Solution Result Sha256",
          "type": "string"
        },
        "accepted_result_artifact": {
          "$ref": "#/$defs/KnowledgeArtifactMemberPointer"
        },
        "proposal_receipt": {
          "$ref": "#/$defs/KnowledgeArtifactMemberPointer"
        },
        "solution_report": {
          "$ref": "#/$defs/KnowledgeArtifactMemberPointer"
        },
        "proposal_content_set_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Proposal Content Set Sha256",
          "type": "string"
        },
        "pointer_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Pointer Sha256",
          "type": "string"
        }
      },
      "required": [
        "base_analysis_run_id",
        "base_analysis_result_id",
        "solution_analysis_run_id",
        "solution_analysis_result_id",
        "solution_result_sha256",
        "accepted_result_artifact",
        "proposal_receipt",
        "solution_report",
        "proposal_content_set_sha256",
        "pointer_sha256"
      ],
      "title": "KnowledgeSolutionEvidencePointer",
      "type": "object"
    },
    "LocalEmbeddingFile": {
      "additionalProperties": false,
      "properties": {
        "member_path": {
          "enum": [
            "config.json",
            "model.safetensors",
            "tokenizer.json",
            "tokenizer_config.json",
            "special_tokens_map.json",
            "sentencepiece.bpe.model",
            "README.md",
            "LICENSE",
            "1_Pooling/config.json"
          ],
          "title": "Member Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 8589934592,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "member_path",
        "sha256",
