{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/knowledge-analysis-worker-proposal/1.0",
  "title": "EOM Knowledge Analysis Worker Proposal V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_request_id",
    "normalized_markdown",
    "anchors",
    "nodes",
    "edges",
    "claims",
    "component_observations",
    "unresolved_ambiguities",
    "general_knowledge_used",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-analysis-worker-proposal/1.0"
    },
    "analysis_request_id": {
      "type": "string",
      "pattern": "^knowledgeanalysis_[0-9a-f]{32}$"
    },
    "normalized_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "eom://schemas/knowledge/knowledge-analysis-types/2.0#/$defs/sourceAnchor"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "eom://schemas/knowledge/knowledge-analysis-types/2.0#/$defs/proposedNode"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "eom://schemas/knowledge/knowledge-analysis-types/2.0#/$defs/proposedEdge"
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "eom://schemas/knowledge/knowledge-analysis-types/2.0#/$defs/proposedClaim"
      }
    },
    "component_observations": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "eom://schemas/knowledge/knowledge-analysis-types/2.0#/$defs/componentObservation"
      }
    },
    "unresolved_ambiguities": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "eom://schemas/knowledge/knowledge-analysis-types/2.0#/$defs/ambiguity"
      }
    },
    "general_knowledge_used": {
      "type": "boolean"
    },
    "completed_at": {
      "$ref": "eom://schemas/knowledge/knowledge-analysis-types/2.0#/$defs/utcTimestamp"
    }
  }
}
