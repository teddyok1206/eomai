{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/embedding-prefix-audit-input/1.1",
  "title": "Protected embedding prefix audit input1.1 with immutable host snapshot",
  "description": "Root-owner installation input, not runtime/source authority. Every bootstrap module and owner-input raw hash is independently checked before import; stdlib semantic checks remain mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "host_seed_sha256",
    "host_configuration",
    "conda_source",
    "conda_archives",
    "public_archives",
    "private_archives",
    "created_at",
    "history",
    "helper",
    "bootstrap"
  ],
  "properties": {
    "schema_version": {
      "const": "embedding-prefix-audit-input/1.1"
    },
    "profile": {
      "enum": [
        "CPU_INDEX_FP32",
        "CUDA_INDEX_FP32"
      ]
    },
    "host_seed_sha256": {
      "$ref": "#/$defs/hash"
    },
    "host_configuration": {
      "$ref": "eom://schemas/knowledge/embedding-host-configuration-snapshot/1.0#/$defs/pointer"
    },
    "conda_source": {
      "$ref": "#/$defs/member"
    },
    "conda_archives": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": {
        "$ref": "#/$defs/condaArchive"
      }
    },
    "public_archives": {
      "type": "array",
      "minItems": 55,
      "maxItems": 70,
      "items": {
        "$ref": "#/$defs/archive"
      }
    },
    "private_archives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/private"
      }
    },
    "created_at": {
      "allOf": [
        {
          "$ref": "#/$defs/member"
        },
        {
          "properties": {
            "size_bytes": {
              "maximum": 1048576
            }
          }
        }
      ]
    },
    "history": {
      "allOf": [
        {
          "$ref": "#/$defs/member"
        },
        {
          "properties": {
            "size_bytes": {
              "maximum": 1048576
            }
          }
        }
      ]
    },
    "helper": {
      "allOf": [
        {
          "$ref": "#/$defs/member"
        },
        {
          "properties": {
            "size_bytes": {
              "maximum": 1048576
            }
          }
        }
      ]
    },
    "bootstrap": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "filename": {
            "enum": [
              "__init__.py",
              "embedding_conda_runtime_closure.py",
              "embedding_host_configuration_capture.py",
              "embedding_runtime_files.py",
              "embedding_runtime_host_closure.py",
              "embedding_runtime_prefix_closure.py",
              "embedding_runtime_wheel_closure.py"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "CPU_INDEX_FP32"
          }
        }
      },
      "then": {
        "properties": {
          "public_archives": {
            "minItems": 55,
            "maxItems": 55
          },
          "private_archives": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "public_archives": {
            "minItems": 70,
            "maxItems": 70
          },
          "private_archives": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.+\\-]+\\.whl$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        }
      }
    },
    "private": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "archive",
        "source_commit",
        "source_archive"
      ],
      "properties": {
        "name": {
          "enum": [
            "eom-platform",
            "eom-gpu-lease"
          ]
        },
        "archive": {
          "$ref": "#/$defs/archive"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_archive": {
          "$ref": "#/$defs/sourceArchive"
        }
      }
    },
    "condaArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.+\\-]{0,249}\\.conda$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "sourceArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    }
  }
}
