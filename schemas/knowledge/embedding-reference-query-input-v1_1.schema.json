{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/embedding-reference-query-input/1.1",
  "title": "Approved-reference native QUERY input V1.1",
  "description": "One to three genuine reference rows with the configured numerical batch recipe (1-16), not the partial row count. Source-only input validation grants no source authority, native execution, installation, or benchmark admission. Result and context remain released V1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "query_request_id",
    "context_request_sha256",
    "spaces",
    "recipe",
    "rows",
    "batch_size",
    "threads",
    "input_set_sha256",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "embedding-reference-query-input/1.1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{32}$"
    },
    "query_request_id": {
      "type": "string",
      "pattern": "^embeddingquery_[0-9a-f]{32}$"
    },
    "context_request_sha256": {
      "$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/hash"
    },
    "spaces": {
      "$ref": "eom://schemas/knowledge/embedding-reference-query/1.0#/$defs/spaces"
    },
    "recipe": {
      "$ref": "eom://schemas/knowledge/item-inference-transfer-experiment/1.0#/$defs/recipe"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "eom://schemas/knowledge/embedding-reference-query/1.0#/$defs/inputRow"
      }
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "threads": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "input_set_sha256": {
      "$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/hash"
    },
    "request_sha256": {
      "$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/hash"
    }
  }
}
