{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/mixed-embedding-index/2.0",
  "title": "Mixed legacy solution and registered-review embedding index V2",
  "description": "Additive metadata only. Existing numerical space, encoding, shard and worker protocols are unchanged; these pointers grant no source authority.",
  "$defs": {
    "hash": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/hash"},
    "member": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/artifactMember"},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "content"],
      "properties": {
        "profile": {"$ref": "eom://schemas/knowledge/item-inference-transfer/2.0"},
        "content": {"oneOf": [{"type": "null"}, {"$ref": "eom://schemas/knowledge/item-inference-transfer-experiment/1.0#/$defs/content"}]},
        "metadata": {"type": "array", "maxItems": 32, "items": {"allOf": [
          {"$ref": "eom://schemas/knowledge/item-inference-transfer-experiment/1.0#/$defs/metadata"},
          {"properties": {"basis": {"const": "ORIGINAL_ITEM"}}}
        ]}}
      }
    },
    "binding": {
      "$id": "eom://schemas/knowledge/embedding-source-binding/2.0",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source", "base_analysis_run_id", "profile", "review_evidence", "graph_snapshot", "policy_revision_id", "policy_sha256", "recipe", "view", "projection_version", "encoding", "row_ref", "binding_sha256"],
      "properties": {
        "schema_version": {"const": "embedding-source-binding/2.0"},
        "source": {
          "allOf": [
            {"$ref": "eom://schemas/knowledge/knowledge-analysis-types/2.0#/$defs/approvedItemSource"},
            {"properties": {"source_class": {"const": "APPROVED_ITEM"}}}
          ]
        },
        "base_analysis_run_id": {"type": "string", "pattern": "^analysisrun_[0-9a-f]{32}$"},
        "profile": {"$ref": "eom://schemas/knowledge/item-inference-transfer/2.0#/$defs/profilePointer"},
        "review_evidence": {"$ref": "eom://schemas/knowledge/registered-item-review-solution-evidence/1.0"},
        "graph_snapshot": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/graphSnapshotPointer"},
        "policy_revision_id": {"type": "string", "pattern": "^accessrev_[0-9a-f]{32}$"},
        "policy_sha256": {"$ref": "eom://schemas/knowledge/mixed-embedding-index/2.0#/$defs/hash"},
        "recipe": {"$ref": "eom://schemas/knowledge/item-inference-transfer-experiment/1.0#/$defs/recipe"},
        "view": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/view"},
        "projection_version": {"const": "registered-item-review-comparison/1.0"},
        "encoding": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/encoding"},
        "row_ref": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/rowRef"},
        "binding_sha256": {"$ref": "eom://schemas/knowledge/mixed-embedding-index/2.0#/$defs/hash"}
      }
    },
    "index": {
      "$id": "eom://schemas/knowledge/embedding-index-manifest/2.0",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "index_id", "index_revision_id", "previous_manifest", "storage_partition", "space", "view", "recipe", "shards", "bindings", "created_at", "index_sha256"],
      "properties": {
        "schema_version": {"const": "embedding-index-manifest/2.0"},
        "index_id": {"type": "string", "pattern": "^embeddingindex_[0-9a-f]{32}$"},
        "index_revision_id": {"type": "string", "pattern": "^embeddingindexrev_[0-9a-f]{32}$"},
        "previous_manifest": {"oneOf": [
          {"type": "null"},
          {"allOf": [
            {"$ref": "eom://schemas/knowledge/mixed-embedding-index/2.0#/$defs/member"},
            {"properties": {"member_path": {"const": "index.json"}, "media_type": {"const": "application/json"}, "schema_ref": {"enum": ["eom://schemas/knowledge/embedding-index-manifest/1.0", "eom://schemas/knowledge/embedding-index-manifest/2.0"]}}}
          ]}
        ]},
        "storage_partition": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/partition"},
        "space": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/space"},
        "view": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/view"},
        "recipe": {"$ref": "eom://schemas/knowledge/item-inference-transfer-experiment/1.0#/$defs/recipe"},
        "shards": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "eom://schemas/knowledge/mixed-embedding-index/2.0#/$defs/member"}},
        "bindings": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"oneOf": [
          {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/binding"},
          {"$ref": "eom://schemas/knowledge/mixed-embedding-index/2.0#/$defs/binding"}
        ]}},
        "created_at": {"type": "string", "format": "date-time", "pattern": "Z$|\\+00:00$"},
        "index_sha256": {"$ref": "eom://schemas/knowledge/mixed-embedding-index/2.0#/$defs/hash"}
      }
    }
  },
  "oneOf": [
    {"$ref": "eom://schemas/knowledge/mixed-embedding-index/2.0#/$defs/entry"},
    {"$ref": "eom://schemas/knowledge/mixed-embedding-index/2.0#/$defs/binding"},
    {"$ref": "eom://schemas/knowledge/mixed-embedding-index/2.0#/$defs/index"}
  ]
}
