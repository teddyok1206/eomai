{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/embedding-prefix-audit-input/1.2",
  "title": "CUDA-only protected embedding prefix audit input1.2",
  "description": "Explicit CUDA extension and nine byte-pinned bootstrap modules; no runtime, root receipt, GPU device or execution authority. Input1.2 must use canonical JSON bytes. Bootstrap filenames are exact, unique and ordered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "host_seed_sha256",
    "cuda_host_extension",
    "conda_source",
    "conda_archives",
    "public_archives",
    "private_archives",
    "created_at",
    "history",
    "helper",
    "bootstrap"
  ],
  "properties": {
    "schema_version": {
      "const": "embedding-prefix-audit-input/1.2"
    },
    "profile": {
      "const": "CUDA_INDEX_FP32"
    },
    "host_seed_sha256": {
      "$ref": "#/$defs/hash"
    },
    "conda_source": {
      "$ref": "#/$defs/member"
    },
    "conda_archives": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": {
        "$ref": "#/$defs/condaArchive"
      }
    },
    "public_archives": {
      "type": "array",
      "minItems": 70,
      "maxItems": 70,
      "items": {
        "$ref": "#/$defs/archive"
      }
    },
    "private_archives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/private"
      }
    },
    "created_at": {
      "allOf": [
        {
          "$ref": "#/$defs/member"
        },
        {
          "properties": {
            "size_bytes": {
              "maximum": 1048576
            }
          }
        }
      ]
    },
    "history": {
      "allOf": [
        {
          "$ref": "#/$defs/member"
        },
        {
          "properties": {
            "size_bytes": {
              "maximum": 1048576
            }
          }
        }
      ]
    },
    "helper": {
      "allOf": [
        {
          "$ref": "#/$defs/member"
        },
        {
          "properties": {
            "size_bytes": {
              "maximum": 1048576
            }
          }
        }
      ]
    },
    "bootstrap": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "filename": {
            "enum": [
              "__init__.py",
              "embedding_conda_runtime_closure.py",
              "embedding_cuda_host_capture.py",
              "embedding_cuda_host_closure.py",
              "embedding_host_configuration_capture.py",
              "embedding_runtime_files.py",
              "embedding_runtime_host_closure.py",
              "embedding_runtime_prefix_closure.py",
              "embedding_runtime_wheel_closure.py"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          }
        }
      },
      "allOf": [
        {
          "prefixItems": [
            {
              "properties": {
                "filename": {
                  "const": "__init__.py"
                }
              }
            },
            {
              "properties": {
                "filename": {
                  "const": "embedding_conda_runtime_closure.py"
                }
              }
            },
            {
              "properties": {
                "filename": {
                  "const": "embedding_cuda_host_capture.py"
                }
              }
            },
            {
              "properties": {
                "filename": {
                  "const": "embedding_cuda_host_closure.py"
                }
              }
            },
            {
              "properties": {
                "filename": {
                  "const": "embedding_host_configuration_capture.py"
                }
              }
            },
            {
              "properties": {
                "filename": {
                  "const": "embedding_runtime_files.py"
                }
              }
            },
            {
              "properties": {
                "filename": {
                  "const": "embedding_runtime_host_closure.py"
                }
              }
            },
            {
              "properties": {
                "filename": {
                  "const": "embedding_runtime_prefix_closure.py"
                }
              }
            },
            {
              "properties": {
                "filename": {
                  "const": "embedding_runtime_wheel_closure.py"
                }
              }
            }
          ],
          "items": false
        }
      ]
    },
    "cuda_host_extension": {
      "$ref": "eom://schemas/knowledge/embedding-cuda-host-extension/1.0#/$defs/pointer"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.+\\-]+\\.whl$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        }
      }
    },
    "private": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "archive",
        "source_commit",
        "source_archive"
      ],
      "properties": {
        "name": {
          "enum": [
            "eom-platform",
            "eom-gpu-lease"
          ]
        },
        "archive": {
          "$ref": "#/$defs/archive"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_archive": {
          "$ref": "#/$defs/sourceArchive"
        }
      }
    },
    "condaArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.+\\-]{0,249}\\.conda$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "sourceArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    }
  }
}
