{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/educational-retrieval-requirement/1.0",
  "title": "EOM Educational Retrieval Requirement V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_key",
    "query_kind",
    "curriculum_root_key",
    "topic_keys",
    "required_item_elements",
    "source_classes"
  ],
  "properties": {
    "schema_version": {"const": "educational-retrieval-requirement/1.0"},
    "corpus_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "query_kind": {"enum": ["CURRICULUM_COMPONENTS", "APPROVED_ITEM_STRUCTURE", "ITEM_PREPARATION"]},
    "curriculum_root_key": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,191}$"},
        {"type": "null"}
      ]
    },
    "topic_keys": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"}
    },
    "required_item_elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["paragraph", "table", "image", "equation", "statement_set", "choice"]}
    },
    "source_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["CURRICULUM", "TEXTBOOK", "APPROVED_ITEM", "PAST_EXAM", "INTERNAL_GUIDE"]}
    }
  }
}
