{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/review-textbook-evidence/1.0",
  "title": "EOM Review Textbook Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_input_sha256",
    "requirement",
    "publication",
    "textbook_evidence_ids",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "review-textbook-evidence/1.0"
    },
    "review_input_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requirement": {
      "allOf": [
        {"$ref": "eom://schemas/knowledge/educational-retrieval-requirement/1.0"},
        {"properties": {"source_classes": {"const": ["TEXTBOOK"]}}}
      ]
    },
    "publication": {
      "oneOf": [
        {"$ref": "eom://schemas/knowledge/evidence-bundle-publication-result/3.0"},
        {"$ref": "eom://schemas/knowledge/evidence-bundle-publication-result/4.0"}
      ]
    },
    "textbook_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evidenceitem_[0-9a-f]{32}$"
      }
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
