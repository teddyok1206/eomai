{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/segmented-embedding-index/1.0",
  "title": "Immutable bounded segment pointers for an embedding population larger than one index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "index_id", "index_revision_id", "previous_root", "corpus_id", "graph_snapshot", "policy_revision_id", "policy_sha256", "storage_partition", "space", "view", "recipe", "segments", "binding_count", "target_set_sha256", "created_at", "root_sha256"],
  "properties": {
    "schema_version": {"const": "segmented-embedding-index/1.0"},
    "index_id": {"type": "string", "pattern": "^embeddingindex_[0-9a-f]{32}$"},
    "index_revision_id": {"type": "string", "pattern": "^embeddingindexrev_[0-9a-f]{32}$"},
    "previous_root": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rootMember"}]},
    "corpus_id": {"type": "string", "pattern": "^corpus_[0-9a-f]{32}$"},
    "graph_snapshot": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/graphSnapshotPointer"},
    "policy_revision_id": {"type": "string", "pattern": "^accessrev_[0-9a-f]{32}$"},
    "policy_sha256": {"$ref": "#/$defs/hash"},
    "storage_partition": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/partition"},
    "space": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/space"},
    "view": {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/view"},
    "recipe": {"$ref": "eom://schemas/knowledge/item-inference-transfer-experiment/1.0#/$defs/recipe"},
    "segments": {"type": "array", "minItems": 2, "maxItems": 1024, "items": {"$ref": "#/$defs/segment"}},
    "binding_count": {"type": "integer", "minimum": 1025, "maximum": 1048576},
    "target_set_sha256": {"$ref": "#/$defs/hash"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$|\\+00:00$"},
    "root_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rootMember": {
      "allOf": [
        {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/artifactMember"},
        {"properties": {"member_path": {"const": "root.json"}, "media_type": {"const": "application/json"}, "schema_ref": {"const": "eom://schemas/knowledge/segmented-embedding-index/1.0"}}}
      ]
    },
    "indexMember": {
      "allOf": [
        {"$ref": "eom://schemas/knowledge/item-inference-transfer-embedding/1.0#/$defs/artifactMember"},
        {"properties": {"member_path": {"const": "index.json"}, "media_type": {"const": "application/json"}, "schema_ref": {"enum": ["eom://schemas/knowledge/embedding-index-manifest/1.0", "eom://schemas/knowledge/embedding-index-manifest/2.0"]}}}
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_manifest", "first_source_revision_id", "last_source_revision_id", "binding_count", "target_set_sha256"],
      "properties": {
        "index_manifest": {"$ref": "#/$defs/indexMember"},
        "first_source_revision_id": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
        "last_source_revision_id": {"type": "string", "pattern": "^itemrev_[0-9a-f]{32}$"},
        "binding_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "target_set_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
