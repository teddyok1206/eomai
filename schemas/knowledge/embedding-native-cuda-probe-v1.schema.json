{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/embedding-native-cuda-probe/1.0",
  "title": "CUDA fixed-unit no-model probe observations; never installation or compute admission",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "executionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "minLength": 32,
      "maxLength": 32
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "denial": {
      "enum": [
        "DENIED",
        "ABSENT_IN_SANDBOX"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_id",
        "profile",
        "installed_proof",
        "payload",
        "configuration",
        "shared_lease_gid"
      ],
      "properties": {
        "schema_version": {
          "const": "embedding-native-cuda-probe-input/1.0"
        },
        "execution_id": {
          "$ref": "#/$defs/executionId"
        },
        "profile": {
          "const": "CUDA_INDEX_FP32"
        },
        "installed_proof": {
          "$ref": "eom://schemas/knowledge/embedding-installed-runtime-proof/1.0#/$defs/pointer",
          "properties": {
            "profile": {
              "const": "CUDA_INDEX_FP32"
            }
          }
        },
        "payload": {
          "$ref": "eom://schemas/knowledge/embedding-runtime-bundle/1.0#/$defs/payloadPointer"
        },
        "configuration": {
          "$ref": "#/$defs/configurationPin"
        },
        "shared_lease_gid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967294
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_state",
        "recipe",
        "execution_id",
        "input_raw_sha256",
        "pid",
        "worker_uid",
        "worker_gid",
        "supplementary_gids",
        "checked_model_members",
        "payload_file_set_sha256",
        "denials",
        "numerical_runtime",
        "start_time_ticks",
        "resource_fds",
        "device_capture",
        "cuda_initialization_calls",
        "cuda_synchronize_calls",
        "model_constructor_calls",
        "tokenizer_constructor_calls",
        "forward_calls"
      ],
      "properties": {
        "schema_version": {
          "const": "embedding-native-cuda-probe-result/1.0"
        },
        "evidence_state": {
          "const": "OBSERVED_NOT_ADMITTED"
        },
        "recipe": {
          "const": "NATIVE_CUDA_FIXED_UNIT_NO_MODEL_NO_FORWARD_NEGATIVES/1.0"
        },
        "execution_id": {
          "$ref": "#/$defs/executionId"
        },
        "input_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "worker_uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967294
        },
        "worker_gid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967294
        },
        "supplementary_gids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967294
          }
        },
        "checked_model_members": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "payload_file_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "denials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nas",
            "repository",
            "legacy_repository",
            "api_configuration",
            "root_auth",
            "worker_homes",
            "image_models",
            "api_runtime",
            "owner_workspace",
            "legacy_handoff",
            "probe_workspace",
            "postgres",
            "docker",
            "systemd",
            "dbus",
            "prefix_write",
            "model_write"
          ],
          "properties": {
            "nas": {
              "$ref": "#/$defs/denial"
            },
            "repository": {
              "$ref": "#/$defs/denial"
            },
            "legacy_repository": {
              "$ref": "#/$defs/denial"
            },
            "api_configuration": {
              "$ref": "#/$defs/denial"
            },
            "root_auth": {
              "$ref": "#/$defs/denial"
            },
            "worker_homes": {
              "$ref": "#/$defs/denial"
            },
            "image_models": {
              "$ref": "#/$defs/denial"
            },
            "api_runtime": {
              "$ref": "#/$defs/denial"
            },
            "owner_workspace": {
              "$ref": "#/$defs/denial"
            },
            "legacy_handoff": {
              "$ref": "#/$defs/denial"
            },
            "probe_workspace": {
              "$ref": "#/$defs/denial"
            },
            "postgres": {
              "$ref": "#/$defs/denial"
            },
            "docker": {
              "$ref": "#/$defs/denial"
            },
            "systemd": {
              "$ref": "#/$defs/denial"
            },
            "dbus": {
              "$ref": "#/$defs/denial"
            },
            "prefix_write": {
              "const": "DENIED"
            },
            "model_write": {
              "const": "DENIED"
            }
          }
        },
        "numerical_runtime": {
          "$ref": "eom://schemas/knowledge/embedding-numerical-runtime/1.0",
          "properties": {
            "device": {
              "properties": {
                "kind": {
                  "const": "CUDA"
                }
              }
            },
            "recipe": {
              "properties": {
                "batch_size": {
                  "const": 4
                },
                "threads": {
                  "const": 4
                },
                "cublas_workspace": {
                  "const": ":4096:8"
                }
              }
            },
            "torch_build_cuda_version": {
              "const": "12.8"
            }
          }
        },
        "start_time_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709552000
        },
        "resource_fds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nvidia0_fd",
            "nvidiactl_fd",
            "nvidia_uvm_fd",
            "nvidia_uvm_tools_fd",
            "lease_fd"
          ],
          "properties": {
            "nvidia0_fd": {
              "type": "integer",
              "minimum": 3,
              "maximum": 1048575
            },
            "nvidiactl_fd": {
              "type": "integer",
              "minimum": 3,
              "maximum": 1048575
            },
            "nvidia_uvm_fd": {
              "type": "integer",
              "minimum": 3,
              "maximum": 1048575
            },
            "nvidia_uvm_tools_fd": {
              "type": "integer",
              "minimum": 3,
              "maximum": 1048575
            },
            "lease_fd": {
              "type": "integer",
              "minimum": 3,
              "maximum": 1048575
            }
          }
        },
        "device_capture": {
          "$ref": "eom://schemas/knowledge/embedding-installed-runtime-proof/1.0#/$defs/cudaDeviceCapture"
        },
        "cuda_initialization_calls": {
          "type": "integer",
          "const": 1
        },
        "cuda_synchronize_calls": {
          "type": "integer",
          "const": 1
        },
        "model_constructor_calls": {
          "type": "integer",
          "const": 0
        },
        "tokenizer_constructor_calls": {
          "type": "integer",
          "const": 0
        },
        "forward_calls": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "configurationPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_id",
        "configuration_revision_id",
        "configuration_raw_sha256",
        "configuration_sha256"
      ],
      "properties": {
        "configuration_id": {
          "type": "string",
          "pattern": "^embeddingnativeconfig_[0-9a-f]{32}$",
          "minLength": 54,
          "maxLength": 54
        },
        "configuration_revision_id": {
          "type": "string",
          "pattern": "^embeddingnativeconfigrev_[0-9a-f]{32}$",
          "minLength": 57,
          "maxLength": 57
        },
        "configuration_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
