{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eom://schemas/knowledge/knowledge-graph-snapshot-manifest/3.0",
  "title": "EOM Knowledge Graph Snapshot Manifest V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "graph_id", "graph_snapshot_revision_id", "revision_number",
    "previous_graph_snapshot_revision_id", "state", "ontology_version", "publisher_version",
    "source_revisions", "analysis_results", "projections", "counts", "snapshot_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "knowledge-graph-snapshot-manifest/3.0"},
    "graph_id": {"type": "string", "pattern": "^graph_[0-9a-f]{32}$"},
    "graph_snapshot_revision_id": {
      "type": "string", "pattern": "^graphrev_[0-9a-f]{32}$"
    },
    "revision_number": {"type": "integer", "minimum": 1},
    "previous_graph_snapshot_revision_id": {
      "type": ["string", "null"], "pattern": "^graphrev_[0-9a-f]{32}$"
    },
    "state": {"const": "PUBLISHED"},
    "ontology_version": {"const": "education-knowledge-graph/1.0"},
    "publisher_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source_revisions": {
      "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true,
      "items": {"$ref": "eom://schemas/knowledge/knowledge-analysis-types/3.0#/$defs/analysisSource"}
    },
    "analysis_results": {
      "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true,
      "items": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/artifactMemberPointer"}
    },
    "projections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "curriculum_closure", "markdown", "lexical_index"],
      "properties": {
        "nodes": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/artifactMemberPointer"},
        "edges": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/artifactMemberPointer"},
        "curriculum_closure": {
          "anyOf": [
            {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/artifactMemberPointer"},
            {"type": "null"}
          ]
        },
        "markdown": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/artifactMemberPointer"},
        "lexical_index": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/artifactMemberPointer"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revisions", "nodes", "edges", "anchors"],
      "properties": {
        "source_revisions": {"type": "integer", "minimum": 1, "maximum": 10000},
        "nodes": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "edges": {"type": "integer", "minimum": 0, "maximum": 50000000},
        "anchors": {"type": "integer", "minimum": 1, "maximum": 20000000}
      }
    },
    "snapshot_sha256": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/sha256"},
    "created_at": {"$ref": "eom://schemas/knowledge/knowledge-types-v1#/$defs/utcTimestamp"}
  }
}
