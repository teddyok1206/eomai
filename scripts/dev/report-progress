#!/usr/bin/env bash
set -euo pipefail

REPOSITORY=/home/eom/EOM
PYTHON=/srv/eom/conda/envs/eom-api/bin/python

[[ "$(git -C "${REPOSITORY}" rev-parse --show-toplevel)" == "${REPOSITORY}" ]]
[[ -x "${PYTHON}" ]]
exec env PYTHONPATH="${REPOSITORY}/tools/dev_reporter" \
  "${PYTHON}" -m eom_dev_reporter "$@"
