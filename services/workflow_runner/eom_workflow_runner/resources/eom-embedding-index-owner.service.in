[Unit]
Description=EOM purpose-specific incremental embedding owner
After=postgresql.service

[Service]
Type=simple
User=eom-workflow-runner
Group=eom
StateDirectory=eom-local-indexing
StateDirectoryMode=0700
WorkingDirectory=/var/lib/eom-local-indexing
EnvironmentFile=/etc/eom/secrets/catalog-manager.env
Environment=TZ=UTC
Environment=LANG=C.UTF-8
Environment=PATH=/usr/bin:/bin
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/eom-local-indexing/staging /var/lib/eom-local-indexing/workspaces /var/lib/eom-local-indexing/catalog-staging
ExecStart=/opt/eom/conda/envs/eom-embedding-experiment/bin/python -I -B /opt/eom/embedding-owner-releases/@SOURCE_COMMIT@/site-packages/eom_workflow_runner/local_indexing_service_entry.py
Restart=no

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
BindReadOnlyPaths=/opt/eom/embedding-host-configurations/selected-cache:/etc/ld.so.cache
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

ReadOnlyPaths=/etc/eom/local-indexing-runtime.json /etc/eom/local-indexing-owner.json
ReadOnlyPaths=/etc/eom/embedding-native-cpu.env /etc/eom/embedding-native-owner.env
ReadOnlyPaths=/opt/eom/embedding-owner-releases
ReadOnlyPaths=/opt/eom/conda/envs/eom-embedding-experiment /opt/eom/conda/envs/eom-embedding-index-cpu
ReadOnlyPaths=/opt/eom/embedding-models /opt/eom/embedding-runtime-proofs
ReadOnlyPaths=/opt/eom/embedding-runtime-archives /opt/eom/embedding-runtime-bundles
ReadOnlyPaths=/opt/eom/embedding-native-config /opt/eom/embedding-runtime-admission
ReadOnlyPaths=/etc/systemd/system
ReadWritePaths=/mnt/nas/eom/artifacts /var/lib/eom-local-indexing
ReadWritePaths=/var/lib/eom-workflow-runner/incremental-embeddings/index

InaccessiblePaths=/home/eom/EOM /home/eom/EOMIS
InaccessiblePaths=/root/.codex /srv/eom/worker-homes /srv/eom/models/image
InaccessiblePaths=/srv/eom/workspaces /srv/eom/image-workspaces /srv/eom/image-reference-workspaces
InaccessiblePaths=/etc/eom/workflow-runtime.env /etc/eom-api
InaccessiblePaths=/etc/eom/secrets
InaccessiblePaths=/etc/eom/secrets/postgres.env /etc/eom/secrets/api.env
InaccessiblePaths=/etc/eom/secrets/hwpx-manager.env /etc/eom/secrets/observe.env
InaccessiblePaths=/etc/eom/secrets/web-gui.env
InaccessiblePaths=-/etc/eom/secrets/dev-slack.env -/var/run/docker.sock

UMask=0077
MemoryMax=1G
CPUQuota=200%
TasksMax=64
TimeoutStartSec=90
TimeoutStopSec=240
KillMode=control-group
LimitCORE=0
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
